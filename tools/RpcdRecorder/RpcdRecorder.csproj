<Project Sdk="Microsoft.NET.Sdk">
  <!-- Records the raw answers this PC gives to the checks, for record and replay tests (docs/record-replay.md). Read-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM for the package API (Store apps), shared with the app's SystemPackageSource. -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Each module project carries its own module.json (embedded in its DLL); the copies next to the exe are not used. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\RemotePCDiagnostics.Host\Platform\SystemPackageSource.cs" Link="SystemPackageSource.cs" />
    <!-- Core Audio for the Sound check, shared with the app. -->
    <Compile Include="..\..\src\RemotePCDiagnostics.Host\WasapiAudioStateSource.cs" Link="WasapiAudioStateSource.cs" />
    <Compile Include="..\..\src\RemotePCDiagnostics.Host\WasapiAudioEndpointControl.cs" Link="WasapiAudioEndpointControl.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- Security Center's antivirus list for Security essentials, shared with the app. -->
    <Compile Include="..\..\src\RemotePCDiagnostics.Host\WindowsAntivirusProductSource.cs" Link="WindowsAntivirusProductSource.cs" />
    <!-- What the Agent's alerts read (events, free space, memory, power), shared with the Agent. -->
    <Compile Include="..\..\src\RemotePCDiagnostics.Agent\WindowsAlertReadings.cs" Link="WindowsAlertReadings.cs" />
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Legacy\RemotePCDiagnostics.Legacy.csproj" />
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
    <ProjectReference Include="..\..\src\Modules\BatteryPower\RemotePCDiagnostics.Modules.BatteryPower.csproj" />
    <ProjectReference Include="..\..\src\Modules\Osquery\RemotePCDiagnostics.Modules.Osquery.csproj" />
    <ProjectReference Include="..\..\src\Modules\DeviceDrivers\RemotePCDiagnostics.Modules.DeviceDrivers.csproj" />
    <ProjectReference Include="..\..\src\Modules\Programs\RemotePCDiagnostics.Modules.Programs.csproj" />
    <ProjectReference Include="..\..\src\Modules\Network\RemotePCDiagnostics.Modules.Network.csproj" />
    <ProjectReference Include="..\..\src\Modules\SecurityEssentials\RemotePCDiagnostics.Modules.SecurityEssentials.csproj" />
    <ProjectReference Include="..\..\src\Modules\ResourceHogs\RemotePCDiagnostics.Modules.ResourceHogs.csproj" />
    <ProjectReference Include="..\..\src\Modules\EventLog\RemotePCDiagnostics.Modules.EventLog.csproj" />
    <ProjectReference Include="..\..\src\Modules\SleepWake\RemotePCDiagnostics.Modules.SleepWake.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sound\RemotePCDiagnostics.Modules.Sound.csproj" />
  </ItemGroup>
</Project>
