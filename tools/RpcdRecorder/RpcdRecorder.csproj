<Project Sdk="Microsoft.NET.Sdk">
  <!-- Records the raw answers this PC gives to the checks, for record and replay tests (docs/record-replay.md). Read-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Each module project carries its own module.json (embedded in its DLL); the copies next to the exe are not used. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Legacy\RemotePCDiagnostics.Legacy.csproj" />
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
    <ProjectReference Include="..\..\src\Modules\BatteryPower\RemotePCDiagnostics.Modules.BatteryPower.csproj" />
    <ProjectReference Include="..\..\src\Modules\Osquery\RemotePCDiagnostics.Modules.Osquery.csproj" />
    <ProjectReference Include="..\..\src\Modules\DeviceDrivers\RemotePCDiagnostics.Modules.DeviceDrivers.csproj" />
    <ProjectReference Include="..\..\src\Modules\Programs\RemotePCDiagnostics.Modules.Programs.csproj" />
  </ItemGroup>
</Project>
