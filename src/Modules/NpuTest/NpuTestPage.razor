@using RemotePCDiagnostics.Core.Npu
@inherits ModuleDetailsBase
@implements IStressTestPage
@* On-demand NPU test: finds NPUs (PnP + DXCore), checks the driver, and runs a short bounded workload on each one. Fully automatic.
   It isn't part of the stress run, so it takes the stress test layout through IStressTestPage instead of StressPageBase. *@
@if (Npu is not { } m)
{
    @* Hidden when no NPU was found (DetectAsync): a direct link lands here instead of on a broken page. *@
    <p class="meta" data-testid="npu-none">@(Diagnostics.IsDetectingHardware ? "Looking for an NPU…" : "No NPU detected on this machine.")</p>
}
else
{
    <StressTestShell TReport="NpuTestReport" Page="this" Prefix="npu" Icon="chip" Title="@m.DisplayName" CheckId="@m.Name"
                     StopId="cancel" ProgressId="run-progress"
                     Description="Checks the NPU (AI accelerator) and its driver, and runs a short workload on it. PCs without one are skipped, not failed."
                     DurationChoices="NpuTestModule.DurationChoices" Report="@(Report is { Devices.Count: > 0 } shown ? shown : null)">
        <Options>
            <button class="btn-small" data-testid="npu-refresh-devices" disabled="@Running" @onclick="() => LoadDevices(m)">Refresh devices</button>
        </Options>
        <Notices>
            @if (!Running && Report?.Notice is { } notice)
            {
                <p class="notice" data-testid="npu-notice">@notice</p>
            }
        </Notices>
        <ReportCards Context="rep">
            @foreach (var d in rep.Devices)
            {
                <StressCard Id="card" Title="@d.Device.Name" Tone="@DeviceTone(d.Verdict)"
                            Headline="@(d.Gflops is { } g ? $"{g:0.0} GFLOPS" : VerdictHeading(d.Verdict))" Facts="DeviceFacts(d)" />
            }
        </ReportCards>
        <ReportFooter Context="rep">
            <table class="detail" data-testid="npu-table">
                <tr><th>Workload</th><td>@rep.MatrixSize × @rep.MatrixSize float32 matrix multiply, @((int)rep.Budget.TotalSeconds) s</td></tr>
                <tr><th>CPU reference</th><td>@(rep.Devices.FirstOrDefault()?.CpuAverageMs is { } c ? $"{RemotePCDiagnostics.Core.History.MeasurementFormat.Significant(c)} ms per multiply (one core)" : "–")</td></tr>
            </table>
        </ReportFooter>
        <ChildContent>
            @if (!Running && Report is null)
            {
                <table class="detail" data-testid="npu-devices">
                    <tr><th>NPUs found</th><td>@(_devices.Count == 0 ? "None" : string.Join(", ", _devices.Select(d => d.Name)))</td></tr>
                </table>
            }
        </ChildContent>
    </StressTestShell>
}

@code {
    private IReadOnlyList<NpuDevice> _devices = [];

    private NpuTestModule? Npu => DiagnosticModule as NpuTestModule;
    private DiagnosticResult Result => Store.Get(Npu?.Name ?? "");
    private bool Running => Result.Status == DiagnosticStatus.Running;
    /// <summary>The last run's report: one result per NPU, combined into one report.</summary>
    private NpuTestReport? Report => Result.Report() as NpuTestReport;

    DiagnosticResult IStressTestPage.Result => Result;
    bool IStressTestPage.IsBlocked => Diagnostics.IsStressSuiteRunning;
    bool IStressTestPage.ShowStop => Running;
    bool IStressTestPage.CanStart => Npu is not null;
    TimeSpan IStressTestPage.Duration => Npu?.Settings.Duration ?? TimeSpan.Zero;
    RemotePCDiagnostics.Core.Stress.LiveProgress? IStressTestPage.Progress => Npu is { } m ? new("Testing the NPU…", null, [$"{(int)m.Settings.Duration.TotalSeconds} s matrix-multiply workload"]) : null;
    void IStressTestPage.SetDuration(TimeSpan duration) { if (Npu is { } m) m.Settings.Duration = duration; }
    void IStressTestPage.Start() { if (Npu is { } m && !Diagnostics.IsStressSuiteRunning) _ = Diagnostics.RunAsync(m.Name); }
    void IStressTestPage.Stop() => Npu?.Cancel();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Npu is { } m) _ = Task.Run(() => LoadDevices(m));
    }

    private void LoadDevices(NpuTestModule m) { _devices = m.Devices(); _ = InvokeAsync(StateHasChanged); }

    private static string VerdictHeading(NpuVerdict v) => v switch
    {
        NpuVerdict.Pass => "Passed",
        NpuVerdict.SmokeOnly => "Passed (smoke test)",
        NpuVerdict.NoAdapter => "Driver healthy",
        NpuVerdict.DriverProblem => "Driver problem",
        NpuVerdict.WorkloadFailed => "Workload failed",
        NpuVerdict.TimedOut => "Timed out",
        NpuVerdict.Mismatch => "Result mismatch",
        NpuVerdict.Slow => "Slow",
        NpuVerdict.NoNpu => "No NPU found",
        _ => v.ToString(),
    };

    private static string DeviceTone(NpuVerdict v) => NpuTestModule.StatusOf(v) switch { DiagnosticStatus.Ok => "ok", DiagnosticStatus.Warning => "warning", _ => "error" };

    private static IEnumerable<string?> DeviceFacts(NpuDeviceReport d) =>
    [
        d.Device.Vendor,
        $"Driver {d.Device.DriverVersion ?? "unknown"}",
        d.Device.ProblemCode is { } c ? NpuDetection.ProblemText(c) : d.Device.Status ?? "status unknown",
        d.AverageMs is { } avg ? $"{d.Iterations} runs · {RemotePCDiagnostics.Core.History.MeasurementFormat.Significant(avg)} ms each · first {(d.FirstRunMs is { } first ? RemotePCDiagnostics.Core.History.MeasurementFormat.Significant(first) : "—")} ms{(d.MaxAbsError is { } e ? $" · max error {e:0.##e+0}" : "")}" : null,
        d.Adapter is { } a ? $"Ran on: {a}" : null,
        d.Message,
    ];
}
