@using RemotePCDiagnostics.Core.Stress
@inherits StressPageBase<GpuStressModule, GpuStressProgress, GpuStressReport>
@* One result per GPU: the report is the worst one (or the one you stopped). *@
<StressTestShell TReport="GpuStressReport" Page="this" Prefix="gpustress" Icon="gpu" Title="GPU stress test"
                 Description="Runs the graphics chip at full load and checks every answer. The PC may get warm and loud. Stops if it gets too hot."
                 DurationChoices="GpuStressOptions.DurationChoices" Report="Report" Explanation="r => r.Explanation" Facts="Facts">
    <LiveCards>
        @{ var p = Progress; }
        <StressCard Id="live-checks" Title="Answers checked" Tone="@(p is null ? "neutral" : p.Mismatches > 0 ? "error" : "ok")"
                    Headline="@(p is null ? "—" : p.Mismatches == 0 ? $"{p.ValuesChecked:N0} correct" : $"{p.Mismatches:N0} wrong")"
                    Note="@(p?.BillionOpsPerSecond is { } g ? $"Working at {g:0.0} billion steps per second" : null)" />
        <StressSensorCards Title="Graphics temperature" TemperatureC="p?.GpuTemperatureC" SensorsAvailable="p?.SensorsAvailable" FanRpm="p?.FanRpm" />
    </LiveCards>
    <ReportCards Context="report">
        @if (report.Batches > 0)
        {
            <StressCard Id="card-checks" Title="Answers checked" Tone="@(report.Mismatches == 0 ? "ok" : "error")"
                        Headline="@(report.Mismatches == 0 ? $"{report.ValuesChecked:N0} correct" : $"{report.Mismatches:N0} wrong out of {report.ValuesChecked:N0}")"
                        Note="@(report.BillionOpsPerSecond is { } g ? $"Last speed {g:0.0} billion steps per second" : null)" />
            <StressCard Id="card-temp" Title="Hottest graphics temperature"
                        Headline="@(report.MaxGpuTemperatureC is { } t ? $"{t:0}°C" : "Not reported on this PC")"
                        Note="Many laptops with built-in graphics don't report this" />
        }
    </ReportCards>
</StressTestShell>

@code {
    private static IEnumerable<string?> Facts(GpuStressReport r) => [r.AdapterName, $"Ran for {Clock(r.Ran)}"];
}
