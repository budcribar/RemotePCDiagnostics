@using RemotePCDiagnostics.Core.Stress
@using RemotePCDiagnostics.Core.Osquery
@inherits StressPageBase<MemoryTestModule, MemoryTestProgress, MemoryTestReport>
@{
    var r = Store.Get(MemoryTestModule.ModuleName);
    var running = r.Status == DiagnosticStatus.Running;
    var otherBusy = Diagnostics.IsAnyStressRunning && !running;
    var report = r.Payload as MemoryTestReport;
    var p = running ? Module?.LastProgress : null;
    var planned = running ? null : Module?.PlannedBytes(_mode);
}
<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="mem" Size="20" /></span><h1 data-testid="memtest-title">Memory test</h1>
    <label class="meta">Test
        <select data-testid="memtest-mode" disabled="@(running || otherBusy)" @onchange="SetMode">
            <option value="Quick" selected="@(_mode == MemoryTestMode.Quick)">Quick (a small part of memory)</option>
            <option value="Full" selected="@(_mode == MemoryTestMode.Full)">Full (as much memory as is safe)</option>
        </select>
    </label>
    <label class="meta">Run for
        <select data-testid="memtest-duration" disabled="@(running || otherBusy)" @onchange="SetDuration">
            @foreach (var d in MemoryTestOptions.DurationChoices)
            {
                <option value="@d.TotalMinutes" selected="@(d == _duration)">@Minutes(d)</option>
            }
        </select>
    </label>
    @if (running || Diagnostics.IsStressSuiteRunning)
    {
        <button data-testid="memtest-stop" @onclick="Stop">Stop</button>
    }
    else
    {
        <button data-testid="memtest-start" @onclick="Start" disabled="@(running || otherBusy || Module is null)">Start</button>
    }
</div>
<p class="meta">Writes patterns to memory and reads them back to find faulty spots. Other programs keep working.
    @if (!running) { <span data-testid="memtest-plan">@(planned is { } pb ? $"This test will check about {HardwareInventory.FormatBytes(pb)} of memory." : "There isn't enough free memory to run this test right now. Close some programs and try again.")</span> }
</p>

<p data-testid="memtest-status" class="status-line @(running ? "is-running" : "")">
    <span class="@DotClass(r.Status)"></span>
    @(r.Status switch { DiagnosticStatus.NotRun => "Not run. Press Start when you're ready.", DiagnosticStatus.Running => "Running…", _ => r.Message })
    @if (running) { <span class="running-badge" data-testid="running-badge"><span class="running-badge-dot"></span>Running</span> }
</p>

@if (running)
{
    <div class="progress run-progress" data-testid="memtest-progress"><div style="width:@((p?.Fraction ?? 0) * 100)%"></div></div>
    <div class="cards">
        <div class="card is-running card-with-visual" data-testid="memtest-live-progress">
            <div class="card-main">
                <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                <div class="headline">@(p is null ? "Getting ready…" : $"{Clock(p.Elapsed)} of {Clock(p.Duration)}")</div>
                @if (p is not null)
                {
                    <CardList Text="@($"Testing {HardwareInventory.FormatBytes(p.TestBytes)} · {(p.Pass == 1 ? "1 full round done" : $"{p.Pass} full rounds done")}")" />
                    @if (p.Errors > 0) { <div class="meta error-text">Problems found so far: @p.Errors.ToString("N0")</div> }
                }
            </div>
            <TestRunningVisual Slug="@MemoryTestModule.ModuleName" TestId="memtest-visual" />
        </div>
        <div class="card" data-testid="memtest-live-temp">
            <div class="card-head"><span class="dot dot-neutral"></span><strong>CPU temperature</strong></div>
            <div class="headline">@(p?.CpuTemperatureC is { } t ? $"{t:0}°C" : p is { SensorsAvailable: false } ? "Not available on this PC" : "—")</div>
            <div class="meta">The test stops by itself if anything gets too hot</div>
        </div>
        @if (p?.FanRpm is not null)
        {
        <div class="card" data-testid="memtest-live-fan">
            <div class="card-head"><span class="dot dot-neutral"></span><strong>Fan speed</strong></div>
            <div class="headline">@($"{p.FanRpm:0} RPM")</div>
        </div>
        }
    </div>
}
else if (report is not null)
{
    <div class="cards">
        <div class="card" data-testid="memtest-result">
            <div class="card-head"><span class="@DotClass(r.Status)"></span><strong>@report.Headline</strong></div>
            <div class="headline">@report.Explanation</div>
            <CardList Items="@([ report.Mode == MemoryTestMode.Quick ? "Quick test" : "Full test", report.TestBytes > 0 ? $"{HardwareInventory.FormatBytes(report.TestBytes)} checked" : null, report.Passes > 0 ? (report.Passes == 1 ? "1 round" : $"{report.Passes} rounds") : null, report.MaxCpuTemperatureC is { } mt ? $"Hottest {mt:0}°C" : null, $"Finished {r.Timestamp.ToLocalTime():g}" ])" />

        </div>
    </div>
}

@{
    var off = Module?.Offline;
    var os = off?.State;
}
<div class="card" data-testid="memtest-deeper" style="margin-top:16px">
    <div class="card-head"><span class="@OfflineDot(os)"></span><strong>Windows boot memory test</strong></div>
    <div class="deeper-text">Windows has its own memory test that runs while the PC restarts, before Windows starts. It can check memory this app can't reach while Windows is running. The PC restarts again by itself when the test is done, and its result shows here.</div>
    @if (off is not null && os is not null)
    {
        <AgentData TestId="memdiag-data" CheckId="@MemoryTestModule.ModuleName" Json="@OfflineMemoryExport.ToJson(os, _mix, _when, _offlineConfirm)" />
        <div data-testid="memdiag" data-phase="@OfflineMemoryExport.Phase(os.Phase)">
        @if (os.Phase == OfflineMemoryPhase.Loading) { <div class="meta" data-testid="memdiag-loading">Checking the boot memory test…</div> }
        @if (os.LastResult is { } lr)
        {
            <div data-testid="memdiag-result" data-outcome="@(lr.Outcome == OfflineMemoryOutcome.NoErrors ? "no-errors" : "errors")">
                <div class="headline"><span class="dot @(lr.Outcome == OfflineMemoryOutcome.NoErrors ? "dot-ok" : "dot-error")"></span> @lr.Headline</div>
                <div class="meta">@(os.Phase == OfflineMemoryPhase.Done ? "Finished" : "Last run") @lr.TimeUtc.ToLocalTime().ToString("g"). @lr.Explanation</div>
            </div>
        }
        else if (os.Phase != OfflineMemoryPhase.Loading)
        {
            <div class="meta" data-testid="memdiag-no-result">Windows has no boot memory test result on this PC yet.</div>
        }
        @if (OfflineStatus(os) is { Length: > 0 } statusText) { <p class="meta" data-testid="memdiag-status">@statusText</p> }
        @if (os.Message is { } msg) { <div class="meta" data-testid="memdiag-message">@msg</div> }
        @if (os.CanCancel)
        {
            <button class="btn" data-testid="memdiag-cancel" @onclick="CancelOfflineAsync" disabled="@_offlineBusy">Don't run it</button>
        }
        @if (os.Phase != OfflineMemoryPhase.Loading)
        {
            <button class="btn" data-testid="memdiag-refresh" @onclick="RefreshOfflineAsync" disabled="@_offlineBusy">Check now</button>
        }
        @if (os.CanSchedule)
        {
            <div class="toolbar" style="margin-top:8px">
                <label class="meta">Test
                    <select data-testid="memdiag-mode" disabled="@(_offlineBusy || _offlineConfirm)" @onchange="SetMix">
                        <option value="standard" selected="@(_mix == OfflineMemoryMix.Standard)">Standard (about 15–30 minutes)</option>
                        <option value="extended" selected="@(_mix == OfflineMemoryMix.Extended)">Extended (much longer, finds more)</option>
                    </select>
                </label>
                <label class="meta">When
                    <select data-testid="memdiag-when" disabled="@(_offlineBusy || _offlineConfirm)" @onchange="SetWhen">
                        <option value="now" selected="@(_when == OfflineMemoryWhen.Now)">Restart now</option>
                        <option value="next" selected="@(_when == OfflineMemoryWhen.NextRestart)">Next time the PC restarts</option>
                    </select>
                </label>
                @if (!_offlineConfirm)
                {
                    <button class="btn" data-testid="memdiag-schedule" disabled="@(_offlineBusy || running)" @onclick="() => _offlineConfirm = true">Schedule the boot test…</button>
                }
            </div>
            @if (_offlineConfirm)
            {
                <div class="notice notice-error" data-testid="memdiag-confirm">
                    @if (_when == OfflineMemoryWhen.Now)
                    {
                        <p><strong>The PC restarts in 60 seconds.</strong> Programs close and unsaved work is lost: save your work first. The test runs before Windows starts and the PC restarts again when it's done.</p>
                    }
                    else
                    {
                        <p><strong>The test runs the next time the PC restarts.</strong> That restart takes longer than usual while the test runs.</p>
                    }
                    @foreach (var w in OfflineMemoryDiagnostic.Warnings(os.Agent, _when, _mix))
                    {
                        <p data-testid="memdiag-warning" data-warning-id="@w.Id">@(w.Serious ? "⚠ " : "")@w.Text</p>
                    }
                    <button data-testid="memdiag-confirm-yes" disabled="@_offlineBusy" @onclick="ScheduleOfflineAsync">@(_when == OfflineMemoryWhen.Now ? "Yes, restart and test" : "Yes, test at the next restart")</button>
                    <button data-testid="memdiag-confirm-no" disabled="@_offlineBusy" @onclick="() => _offlineConfirm = false">Cancel</button>
                </div>
            }
        }
        </div>
    }
    @if ((off is null || os?.Phase == OfflineMemoryPhase.NeedsAgent) && Module?.CanLaunchWindowsDiagnostic == true)
    {
        @if (!_confirm)
        {
            <button class="btn" data-testid="memtest-mdsched" @onclick="() => { _confirm = true; _launchMessage = null; }" disabled="@running">Open Windows Memory Diagnostic…</button>
        }
        else
        {
            <div class="notice notice-error" data-testid="memtest-mdsched-confirm">
                <p><strong>This can restart your PC.</strong> Windows will ask whether to restart now or check the next time you start your PC. If you restart, save your work and close your programs first. The check takes several minutes and the PC restarts on its own when it's done.</p>
                <button data-testid="memtest-mdsched-yes" @onclick="LaunchMdsched">Yes, open it</button>
                <button data-testid="memtest-mdsched-no" @onclick="() => _confirm = false">Cancel</button>
            </div>
        }
    }
    @if (_launchMessage is not null) { <div class="meta" data-testid="memtest-mdsched-result">@_launchMessage</div> }
</div>

@code {
    private static readonly TimeSpan OfflinePollInterval = TimeSpan.FromSeconds(15);

    private MemoryTestMode _mode = MemoryTestMode.Quick;
    private bool _confirm;
    private string? _launchMessage;
    private OfflineMemoryMix _mix = OfflineMemoryMix.Standard;
    private OfflineMemoryWhen _when = OfflineMemoryWhen.Now;
    private bool _offlineConfirm, _offlineBusy, _disposed;
    private System.Threading.Timer? _offlinePoll;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Module?.Offline is { } off) off.Changed += OnOfflineChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // Read the boot test's state each time the page opens: after a restart this is where its result comes in.
        if (Module?.Offline is { } off)
        {
            try { await off.RefreshAsync(); }
            catch (Exception) { }
            UpdateOfflinePolling(off.State.Phase);
        }
    }

    private void OnOfflineChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        UpdateOfflinePolling(Module?.Offline?.State.Phase);
        StateHasChanged();
    });

    private void UpdateOfflinePolling(OfflineMemoryPhase? phase)
    {
        if (_disposed) return;
        var shouldPoll = phase is OfflineMemoryPhase.WaitingForResult or OfflineMemoryPhase.Restarting;
        if (shouldPoll && _offlinePoll is null)
            _offlinePoll = new System.Threading.Timer(_ => _ = InvokeAsync(PollOfflineAsync), null, OfflinePollInterval, OfflinePollInterval);
        else if (!shouldPoll)
            Interlocked.Exchange(ref _offlinePoll, null)?.Dispose();
    }

    private async Task PollOfflineAsync()
    {
        if (_disposed || _offlineBusy || Module?.Offline is not { } off) return;
        if (off.State.Phase is not (OfflineMemoryPhase.WaitingForResult or OfflineMemoryPhase.Restarting))
        {
            UpdateOfflinePolling(off.State.Phase);
            return;
        }
        try { await off.RefreshAsync(); }
        catch (Exception) { }
    }

    public override void Dispose()
    {
        _disposed = true;
        Interlocked.Exchange(ref _offlinePoll, null)?.Dispose();
        if (Module?.Offline is { } off) off.Changed -= OnOfflineChanged;
        base.Dispose();
    }

    private void SetMix(ChangeEventArgs e) => _mix = e.Value?.ToString() == "extended" ? OfflineMemoryMix.Extended : OfflineMemoryMix.Standard;
    private void SetWhen(ChangeEventArgs e) => _when = e.Value?.ToString() == "next" ? OfflineMemoryWhen.NextRestart : OfflineMemoryWhen.Now;

    private async Task RefreshOfflineAsync()
    {
        if (Module?.Offline is not { } off || _offlineBusy) return;
        _offlineBusy = true;
        try { await off.RefreshAsync(); }
        catch (Exception) { }
        finally { _offlineBusy = false; }
    }

    private async Task ScheduleOfflineAsync()
    {
        if (Module?.Offline is not { } off || _offlineBusy) return;
        _offlineBusy = true;
        try { await off.ScheduleAsync(_mix, _when); }
        finally { _offlineBusy = false; _offlineConfirm = false; }
    }

    private async Task CancelOfflineAsync()
    {
        if (Module?.Offline is not { } off || _offlineBusy) return;
        _offlineBusy = true;
        try { await off.CancelAsync(); }
        finally { _offlineBusy = false; }
    }

    private static string OfflineDot(OfflineMemoryState? s) => s switch
    {
        { Phase: OfflineMemoryPhase.Scheduled or OfflineMemoryPhase.Restarting or OfflineMemoryPhase.WaitingForResult } => "dot dot-running",
        { LastResult.Outcome: OfflineMemoryOutcome.Errors } => "dot dot-error",
        { Phase: OfflineMemoryPhase.NotRun } => "dot dot-warning",
        { LastResult.Outcome: OfflineMemoryOutcome.NoErrors } => "dot dot-ok",
        _ => "dot dot-neutral",
    };

    private static string OfflineStatus(OfflineMemoryState s) => s.Phase switch
    {
        OfflineMemoryPhase.Loading => "",
        OfflineMemoryPhase.NeedsAgent => "Needs the Agent: scheduling the boot test needs administrator rights, which this app gets only through the Agent." + (s.Error is { Length: > 0 } e ? $" ({e})" : ""),
        OfflineMemoryPhase.Unavailable => "The boot memory test can't be scheduled on this PC: " + s.Error,
        OfflineMemoryPhase.Scheduled => $"Set to run the next time Windows restarts ({MixText(s.Agent?.Mix)}).",
        OfflineMemoryPhase.Restarting => $"The PC is restarting into the {MixText(s.Agent?.Mix)}.",
        OfflineMemoryPhase.WaitingForResult => "The PC has restarted. Windows records the boot test's result a few minutes after sign-in; this page shows it then.",
        OfflineMemoryPhase.NotRun => "The PC restarted, but Windows recorded no boot memory test result, so the test didn't run. If the PC was shut down with Fast Startup on, schedule it again and use Restart.",
        OfflineMemoryPhase.Done => "The boot memory test is finished.",
        _ => "",
    };

    private static string MixText(OfflineMemoryMix? m) => m == OfflineMemoryMix.Extended ? "extended test" : "standard test";

    protected override void SyncFromModule(MemoryTestModule m) { _mode = m.Mode; _duration = m.Duration; }
    protected override void ApplyToModule(MemoryTestModule m) { m.Mode = _mode; m.Duration = _duration; }

    private void SetMode(ChangeEventArgs e)
    {
        if (Enum.TryParse<MemoryTestMode>(e.Value?.ToString(), out var m)) { _mode = m; _duration = MemoryTestOptions.DefaultDuration(m); }
    }

    private void LaunchMdsched()
    {
        _confirm = false;
        _launchMessage = Module?.LaunchWindowsMemoryDiagnostic() == true
            ? "Windows Memory Diagnostic is open. Choose whether to restart now or check the next time you start your PC."
            : "Windows Memory Diagnostic couldn't be opened on this PC.";
    }
}

