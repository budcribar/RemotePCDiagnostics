@using RemotePCDiagnostics.Core.Stress
@inherits StressPageBase<CpuStressModule, CpuStressProgress, CpuStressReport>
<StressTestShell TReport="CpuStressReport" Page="this" Prefix="cpustress" Icon="cpu" Title="CPU stress test" ProgressCardId="live-time"
                 Description="Runs every processor core at full load and checks the answers. The PC may get loud and slow. Stops if it gets too hot."
                 DurationChoices="CpuStressOptions.DurationChoices" Report="Report" Explanation="r => r.Explanation" Facts="Facts">
    <LiveCards>
        <StressSensorCards Title="CPU temperature" TemperatureC="Progress?.CpuTemperatureC" SensorsAvailable="Progress?.SensorsAvailable"
                           LimitC="Progress?.CpuCriticalC" FanRpm="Progress?.FanRpm" />
    </LiveCards>
</StressTestShell>

@code {
    private static IEnumerable<string?> Facts(CpuStressReport r) =>
        [$"Ran for {Clock(r.Ran)} on {r.Threads} processor threads", r.MaxCpuTemperatureC is { } mt ? $"Hottest {mt:0}°C" : null];
}
