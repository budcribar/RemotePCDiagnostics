@using RemotePCDiagnostics.Core.Stress
@using RemotePCDiagnostics.Core.Osquery
@inherits StressPageBase<DiskSpeedModule, DiskSpeedProgress, DiskSpeedReport>
@{ var health = Store.Get(RemotePCDiagnostics.Core.Areas.DriveHealthModule.ModuleName); }
<StressTestShell TReport="DiskSpeedReport" Page="this" Prefix="diskspeed" Icon="disk" Title="Disk speed test"
                 Description="Measures read and write speed and checks the data comes back intact. Uses a temporary file; your files are never touched."
                 DurationChoices="DiskSpeedOptions.DurationChoices" DurationLabel="Run for at most" ProgressCardId="live-step"
                 Report="Report" Explanation="r => r.Explanation" Facts="Facts">
    <Options>
        <label class="meta">Drive
            <select data-testid="diskspeed-drive" disabled="@Locked" @onchange="SetDrive">
                @foreach (var d in _drives)
                {
                    <option value="@d.Root" selected="@(d.Root == _drive)">@d.DisplayName · @HardwareInventory.FormatBytes(d.FreeBytes) free</option>
                }
            </select>
        </label>
        <label class="meta">Test size
            <select data-testid="diskspeed-size" disabled="@Locked" @onchange="SetSize">
                @foreach (var s in DiskSpeedOptions.SizeChoices)
                {
                    <option value="@s" selected="@(s == _size)">@HardwareInventory.FormatBytes(s)</option>
                }
            </select>
        </label>
    </Options>
    <Notices>
        @if (_drives.Count == 0)
        {
            <div class="notice notice-error">No drives that can be tested were found.</div>
        }
        @if (health.Status is DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error)
        {
            <p data-testid="diskspeed-health" class="status-line"><span class="@DotClass(health.Status)"></span><span>Drive health check: @health.Message</span></p>
        }
    </Notices>
    <LiveCards>
        <StressSensorCards Title="Drive temperature" TemperatureC="Progress?.DriveTemperatureC" SensorsAvailable="Progress?.SensorsAvailable" FanRpm="Progress?.FanRpm" />
    </LiveCards>
    <ReportCards Context="report">
        @if (report.TestBytes > 0)
        {
            <StressCard Id="speeds" Title="Speeds" Tone="@StressCard.ToneOf(Result.Status)">
                <table class="detail">
                    <tr><th>Reading large files</th><td>@DiskSpeedReport.Speed(report.SequentialReadMBps)</td></tr>
                    <tr><th>Writing large files</th><td>@DiskSpeedReport.Speed(report.SequentialWriteMBps)</td></tr>
                    <tr><th>Reading small pieces</th><td>@DiskSpeedReport.Ops(report.RandomReadIops)</td></tr>
                    <tr><th>Writing small pieces</th><td>@DiskSpeedReport.Ops(report.RandomWriteIops)</td></tr>
                    <tr><th>Data checked</th><td>@(report.DataErrors > 0 ? $"{report.DataErrors:N0} mismatch(es) found" : report.BlocksVerified > 0 ? "All data matched" : "—")</td></tr>
                </table>
            </StressCard>
        }
    </ReportCards>
</StressTestShell>

@code {
    private IReadOnlyList<TestDrive> _drives = [];
    private string? _drive;
    private long _size = DiskSpeedOptions.GB;

    protected override bool CanStart => Module is not null && _drives.Count > 0;

    private static IEnumerable<string?> Facts(DiskSpeedReport r) =>
        [r.Drive, r.TestBytes > 0 ? $"Tested with {HardwareInventory.FormatBytes(r.TestBytes)}" : null, r.MaxDriveTemperatureC is { } mt ? $"Hottest {mt:0}°C" : null];

    protected override void SyncFromModule(DiskSpeedModule m)
    {
        if (_drives.Count == 0)
        {
            _drives = m.ListDrives();
            _drive = m.DriveRoot is { } d && _drives.Any(x => x.Root == d) ? d : _drives.FirstOrDefault(x => x.IsSystem)?.Root ?? _drives.FirstOrDefault()?.Root;
            _size = m.SizeBytes;
        }
        _duration = m.Duration;
    }

    protected override void ApplyToModule(DiskSpeedModule m) { m.DriveRoot = _drive; m.SizeBytes = _size; m.Duration = _duration; }
    private void SetDrive(ChangeEventArgs e) => _drive = e.Value?.ToString();
    private void SetSize(ChangeEventArgs e) { if (long.TryParse(e.Value?.ToString(), out var v)) _size = v; }
}
