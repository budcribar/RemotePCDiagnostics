@using RemotePCDiagnostics.Core.Stress
@inherits StressPageBase<NetworkTestModule, NetworkTestProgress, NetworkTestReport>
<StressTestShell TReport="NetworkTestReport" Page="this" Prefix="nettest" Icon="net" Title="Network test"
                 Description="Pings the router and the internet every second, measures speed once and looks for network errors."
                 DurationChoices="NetworkTestOptions.DurationChoices" Report="Report" Explanation="r => r.Explanation" Facts="Facts">
    <LiveCards>
        @{
            var p = Progress;
            var live = p is null ? null : PingStats.From(p.Samples.Select(s => s.InternetMs));
        }
        <StressCard Id="live-latency" Title="Delay right now" Headline="@NetworkTestReport.Ms(p?.Samples.LastOrDefault()?.InternetMs)"
                    Facts="@([$"Average {NetworkTestReport.Ms(live?.AverageMs)}", LostText(live?.LossPercent)])" />
        <StressSensorCards Title="CPU temperature" TemperatureC="p?.CpuTemperatureC" SensorsAvailable="p?.SensorsAvailable" FanRpm="p?.FanRpm" />
    </LiveCards>
    <LiveFooter>
        @if (Progress is { Samples.Count: > 0 } p)
        {
            <h3>Connection over time</h3>
            <LatencyChart Samples="p.Samples" Duration="p.Duration" TestId="nettest-live-chart" />
        }
    </LiveFooter>
    <ReportCards Context="report">
        @if (report.Samples.Count > 0)
        {
            var net = report.Internet;
            <StressCard Id="card-latency" Title="Latency" Tone="@StressCard.ToneOf(net.AverageMs is null ? null : net.AverageMs < 100)"
                        Headline="@($"{NetworkTestReport.Ms(net.AverageMs)} average")"
                        Facts="@([$"Slowest {NetworkTestReport.Ms(net.WorstMs)}", report.HasGateway ? $"Router {NetworkTestReport.Ms(report.Gateway.AverageMs)}" : null])" />
            <StressCard Id="card-loss" Title="Loss" Tone="@StressCard.ToneOf(net.LossPercent is null || net.Received == 0 ? null : net.LossPercent < 0.5)"
                        Headline="@(net.Received == 0 ? "No replies" : NetworkTestReport.Pct(net.LossPercent))"
                        Note="@($"{net.Sent - net.Received} of {net.Sent} checks got no reply")" />
            <StressCard Id="card-jitter" Title="Jitter" Tone="@StressCard.ToneOf(net.JitterMs is null ? null : net.JitterMs < 30)"
                        Headline="@NetworkTestReport.Ms(net.JitterMs)" Note="How much the delay jumps around" />
            <StressCard Id="card-speed" Title="Speed" Tone="@StressCard.ToneOf(report.DownloadMbps is null ? null : true)"
                        Headline="@($"↓ {NetworkTestReport.Speed(report.DownloadMbps)} · ↑ {NetworkTestReport.Speed(report.UploadMbps)}")"
                        Note="@((report.DownloadMbps is null ? "Speed couldn't be measured" : "Download · Upload") + (!string.IsNullOrWhiteSpace(report.WifiLinkRateText) ? $" · Wi-Fi link {report.WifiLinkRateText}" : ""))" />
            @if (report.Bufferbloat is { } bloat)
            {
                <StressCard Id="card-bufferbloat" Title="Bufferbloat" Tone="@StressCard.ToneOf(bloat.Grade is null ? null : bloat.Grade is "A" or "B")"
                            Headline="@bloat.HeadlineText" Facts="@(bloat.Grade is null ? null : BloatFacts(bloat))" Note="@bloat.UngradedReason" />
            }
            <StressCard Id="card-adapter" Title="Adapter errors"
                        Tone="@StressCard.ToneOf(report.NewAdapterErrors is null ? null : report.NewAdapterErrors == 0 && report.NewAdapterDrops == 0)"
                        Headline="@(report.NewAdapterErrors is null ? "Not reported" : report.NewAdapterErrors == 0 && report.NewAdapterDrops == 0 ? "No new errors" : $"{report.NewAdapterErrors:N0} new errors · {report.NewAdapterDrops:N0} dropped")"
                        Note="Problems counted by your network adapter during the test" />
        }
    </ReportCards>
    <ReportFooter Context="report">
        @if (report.Samples.Count > 0)
        {
            <h3>Connection over time</h3>
            <LatencyChart Samples="report.Samples" Duration="report.Ran" TestId="nettest-chart" />
        }
    </ReportFooter>
</StressTestShell>

@code {
    private static IEnumerable<string?> Facts(NetworkTestReport r) => [$"Ran for {Clock(r.Ran)}"];

    private static string LostText(double? pct) => NetworkTestReport.Pct(pct) switch { "None" => "no replies lost", "—" => "loss not measured yet", var p => $"{p} of replies lost" };

    private static IEnumerable<string?> BloatFacts(BufferbloatResult b) =>
        [$"Idle {NetworkTestReport.Ms(b.IdleMedianMs)}", b.DownloadAddedMs is { } da ? $"↓ +{da:0} ms" : null, b.UploadAddedMs is { } ua ? $"↑ +{ua:0} ms" : null];
}
