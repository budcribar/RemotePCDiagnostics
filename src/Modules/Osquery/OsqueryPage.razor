@using RemotePCDiagnostics.Core.Osquery
@inherits ModuleDetailsBase
@{
    var r = Store.Get(ModuleSlugs.Osquery);
    var liveInv = r.Payload as HardwareInventory;
    if (liveInv is not null) _lastInventory = liveInv;
    var inv = liveInv ?? (r.Status == DiagnosticStatus.Running ? _lastInventory : null);
    var sys = inv?.System.Items.FirstOrDefault();
    var busy = r.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
}
<CheckToolbar IconName="hw" Title="Hardware inventory" />
@* The app reads the hardware inventory in the background at startup (AutoRun), so before its first result it reads as querying, not as not run. *@
<CheckStatusLine TestId="osquery-status" Status="r.Status" Message="@r.Message" Busy="busy" RunningText="Querying hardware…"
                 ActionTestId="osquery-requery" ActionText="Check again" ShowAction="@(!busy && r.Message != OsqueryModule.ToolMissingMessage && inv?.ToolMissing != true)"
                 OnAction="() => Diagnostics.RunAsync(ModuleSlugs.Osquery)" />
@if (!busy)
{
    <time hidden data-testid="osquery-completed" datetime="@r.Timestamp.ToString("O")"></time>
}

<RunProgress TestId="osquery-progress" Progress="@(r.Status == DiagnosticStatus.Running ? Diagnostics.GetProgress(ModuleSlugs.Osquery) : null)" />
@if (inv is not null)
{
    @* The same machine-readable copy every other check has, so an agent reads the inventory itself and not only three numbers. *@
    @if (!busy) { <AreaReportData Report="@HardwareInventoryReport.Build(inv, r.Status, r.Message)" CheckId="@ModuleSlugs.Osquery" RunId="r.RunId" /> }
    <div class="cards">
        <SummaryCard Id="system" Title="Computer" Expanded="@_expandedCards.Contains("system")" DetailsTestId="osquery-drawer-system" OnOpen="Toggle"
                     ErrorText="@(inv.System.Success ? null : "Couldn't read computer details on this PC.")"
                     EmptyText="@(inv.System.Success && sys is null ? "Computer details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline">@Join(sys?.HardwareVendor, sys?.HardwareModel)</div>
                <CardList Text="@(sys is null ? "" : (sys.ComputerName.Length > 0 ? sys.ComputerName : sys.Hostname))" />
            </ChildContent>
            <Details>
                <div class="card-details-scroll">
                    <DetailTable Section="inv.System" Columns="SystemCols" ErrorText="Couldn't read computer details on this PC." EmptyText="Computer details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
        @{ var c = inv.Cpus.Items.FirstOrDefault(); }
        <SummaryCard Id="cpu" Title="Processor" Expanded="@_expandedCards.Contains("cpu")" DetailsTestId="osquery-drawer-cpu" OnOpen="Toggle"
                     ErrorText="@(inv.Cpus.Success || sys?.CpuBrand is { Length: > 0 } ? null : "Couldn't read processor details on this PC.")"
                     EmptyText="@(inv.Cpus.Success && c is null ? "Processor details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline">@(c?.Model is { Length: > 0 } m ? m : Dash(sys?.CpuBrand))</div>
                <CardList Text="@CpuMeta(c ?? (sys is null ? null : HardwareInventory.CpuFromSystemPublic(sys)))" />
                <span hidden data-field="logical-processor-count" data-unit="count" data-value="@(c?.LogicalProcessors ?? sys?.CpuLogicalCores)"></span>
            </ChildContent>
            <Details>
                @{
                    var cpus = inv.Cpus.Items.Count == 0 && sys is not null && sys.CpuBrand.Length > 0
                        ? inv.Cpus with { Items = [HardwareInventory.CpuFromSystemPublic(sys)], Error = null } : inv.Cpus;
                }
                <div class="card-details-scroll">
                    <DetailTable Section="cpus" Columns="CpuCols" ErrorText="Couldn't read processor details on this PC." EmptyText="Processor details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
        @{ var pop = inv.Memory.Items.Where(d => d.IsPopulated).ToList(); }
        <SummaryCard Id="memory" Title="Memory" Expanded="@_expandedCards.Contains("memory")" DetailsTestId="osquery-drawer-memory" OnOpen="Toggle"
                     ErrorText="@(inv.Memory.Success || inv.TotalMemoryBytes is > 0 ? null : "Couldn't read memory details on this PC.")"
                     EmptyText="@(inv.TotalMemoryBytes is > 0 ? null : "Memory details aren't available on this PC.")">
            <ChildContent>
                <div class="headline" data-field="installed-memory" data-unit="bytes" data-value="@inv.TotalMemoryBytes">@HardwareInventory.FormatBytes(inv.TotalMemoryBytes)</div>
                <CardList Text="@(pop.Count > 0 ? $"{pop.Count} of {inv.Memory.Items.Count} slots in use · {Dash(pop[0].MemoryType)}" : "Installed memory")" />
            </ChildContent>
            <Details>
                <div class="card-details-scroll">
                    @if (inv.Memory.Items.Count == 0 && inv.TotalMemoryBytes is > 0) { <table class="detail"><tr><th>Installed memory</th><td>@HardwareInventory.FormatBytes(inv.TotalMemoryBytes)</td></tr></table> }
                    else { <DetailTable Section="inv.Memory" Columns="MemCols" ErrorText="Couldn't read memory details on this PC." EmptyText="Memory details aren't available on this PC." /> }
                </div>
            </Details>
        </SummaryCard>
        <SummaryCard Id="disks" Title="Storage" Expanded="@_expandedCards.Contains("disks")" DetailsTestId="osquery-drawer-disks" OnOpen="Toggle"
                     ErrorText="@(inv.Disks.Success ? null : "Couldn't read storage details on this PC.")"
                     EmptyText="@(inv.Disks.Success && inv.Disks.Items.Count == 0 ? "Storage details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline" data-field="physical-drive-count" data-unit="count" data-value="@(inv.Disks.Success ? (int?)inv.Disks.Items.Count : null)">@(inv.Disks.Items.Count == 1 ? "1 drive" : $"{inv.Disks.Items.Count} drives")@(inv.TotalDiskBytes > 0 ? $" ({HardwareInventory.FormatBytes(inv.TotalDiskBytes)})" : "")</div>
                <CardList Items="@inv.Disks.Items.Select(d => Dash(d.HardwareModel)).Take(3)" />
            </ChildContent>
            <Details>
                <div class="card-details-scroll">
                    <DetailTable Section="inv.Disks" Columns="DiskCols" ErrorText="Couldn't read storage details on this PC." EmptyText="Storage details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
        @{ var gpus = inv.Gpus.Items.Where(g => g.Model.Length > 0).ToList(); }
        <SummaryCard Id="gpu" Title="Graphics" Expanded="@_expandedCards.Contains("gpu")" DetailsTestId="osquery-drawer-gpu" OnOpen="Toggle"
                     ErrorText="@(inv.Gpus.Success ? null : "Couldn't read graphics details on this PC.")"
                     EmptyText="@(inv.Gpus.Success && gpus.Count == 0 ? "Graphics details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline">@(gpus.Count > 0 ? gpus[0].Model : "—")</div>
                <CardList Items="@gpus.Skip(1).Select(g => g.Model).Take(2)" />
            </ChildContent>
            <Details>
                <div class="card-details-scroll">
                    <DetailTable Section="inv.Gpus" Columns="GpuCols" ErrorText="Couldn't read graphics details on this PC." EmptyText="Graphics details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
        @{ var nics = inv.PhysicalNetworkAdapters.Where(a => a.Description.Length > 0).ToList(); }
        <SummaryCard Id="network" Title="Network adapters" Expanded="@_expandedCards.Contains("network")" DetailsTestId="osquery-drawer-network" OnOpen="Toggle"
                     ErrorText="@(inv.NetworkAdapters.Success ? null : "Couldn't read network adapter details on this PC.")"
                     EmptyText="@(inv.NetworkAdapters.Success && nics.Count == 0 ? "Network adapter details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline" data-field="network-adapter-count" data-unit="count" data-value="@(inv.NetworkAdapters.Success ? (int?)nics.Count : null)">@(nics.Count == 1 ? "1 adapter" : $"{nics.Count} adapters")</div>
                <CardList Items="@nics.Select(a => a.Description).Take(3)" />
            </ChildContent>
            <Details>
                @{ var nicSection = inv.NetworkAdapters with { Items = inv.PhysicalNetworkAdapters }; }
                <div class="card-details-scroll">
                    <DetailTable Section="nicSection" Columns="NetCols" ErrorText="Couldn't read network adapter details on this PC." EmptyText="Network adapter details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
        @{ var bios = inv.Bios.Items.FirstOrDefault(b => b.Vendor.Length + b.Version.Length > 0); }
        <SummaryCard Id="bios" Title="BIOS" Expanded="@_expandedCards.Contains("bios")" DetailsTestId="osquery-drawer-bios" OnOpen="Toggle"
                     ErrorText="@(inv.Bios.Success ? null : "Couldn't read BIOS details on this PC.")"
                     EmptyText="@(inv.Bios.Success && bios is null ? "BIOS details aren't available on this PC." : null)">
            <ChildContent>
                <div class="headline">@Join(bios?.Vendor, bios?.Version)</div>
                <CardList Text="@(bios?.Date ?? "")" />
            </ChildContent>
            <Details>
                <div class="card-details-scroll">
                    <DetailTable Section="inv.Bios" Columns="BiosCols" ErrorText="Couldn't read BIOS details on this PC." EmptyText="BIOS details aren't available on this PC." />
                </div>
            </Details>
        </SummaryCard>
    </div>
}

@code {
    private readonly HashSet<string> _expandedCards = new(StringComparer.OrdinalIgnoreCase);
    private HardwareInventory? _lastInventory;
    protected override bool ShouldReactTo(DiagnosticResult r) =>
        string.Equals(r.ModuleName, ModuleSlugs.Osquery, StringComparison.OrdinalIgnoreCase);
    private void Toggle(string id) { if (!_expandedCards.Remove(id)) _expandedCards.Add(id); }
    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    private static string Join(params string?[] s) => Dash(string.Join(" ", s.Where(x => !string.IsNullOrWhiteSpace(x))));
    private static string N(long? v) => v?.ToString() ?? "";
    private static string CpuMeta(CpuInfo? c) => c is null ? "" :
        string.Join(" · ", new[] { c.NumberOfCores is > 0 ? $"{c.NumberOfCores} cores" : null, c.LogicalProcessors is > 0 ? $"{c.LogicalProcessors} threads" : null, c.MaxClockSpeedMhz is > 0 ? $"up to {c.MaxClockSpeedMhz / 1000.0:0.0#} GHz" : null }.Where(x => x is not null));

    private static readonly (string, Func<SystemInfo, string>)[] SystemCols =
    [
        ("Manufacturer", x => x.HardwareVendor), ("Model", x => x.HardwareModel), ("Version", x => x.HardwareVersion), ("Serial number", x => x.HardwareSerial),
        ("Motherboard", x => Join(x.BoardVendor, x.BoardModel, x.BoardVersion)), ("Computer name", x => x.ComputerName.Length > 0 ? x.ComputerName : x.Hostname),
        ("Installed memory", x => x.PhysicalMemoryBytes is > 0 ? HardwareInventory.FormatBytes(x.PhysicalMemoryBytes) : ""),
    ];
    private static readonly (string, Func<CpuInfo, string>)[] CpuCols =
    [
        ("Processor", x => x.Model), ("Manufacturer", x => x.Manufacturer), ("Socket", x => x.SocketDesignation),
        ("Cores", x => N(x.NumberOfCores)), ("Threads", x => N(x.LogicalProcessors)),
        ("Current speed", x => x.CurrentClockSpeedMhz is > 0 ? $"{x.CurrentClockSpeedMhz} MHz" : ""), ("Maximum speed", x => x.MaxClockSpeedMhz is > 0 ? $"{x.MaxClockSpeedMhz} MHz" : ""),
        ("Current load", x => x.LoadPercentage is not null ? $"{x.LoadPercentage}%" : ""),
    ];
    private static readonly (string, Func<MemoryDevice, string>)[] MemCols =
    [
        ("Slot", x => x.DeviceLocator), ("Bank", x => x.BankLocator), ("Size", x => x.SizeMb is > 0 ? HardwareInventory.FormatBytes(x.SizeMb * 1024 * 1024) : "Empty"),
        ("Type", x => x.MemoryType), ("Form factor", x => x.FormFactor), ("Speed", x => x.ConfiguredClockSpeedMts is > 0 ? $"{x.ConfiguredClockSpeedMts} MT/s" : ""),
        ("Manufacturer", x => x.Manufacturer), ("Part number", x => x.PartNumber), ("Serial number", x => x.SerialNumber),
    ];
    private static readonly (string, Func<DiskInfo, string>)[] DiskCols =
    [
        ("Model", x => x.HardwareModel), ("Manufacturer", x => x.Manufacturer), ("Size", x => x.SizeBytes is > 0 ? HardwareInventory.FormatBytes(x.SizeBytes) : ""),
        ("Connection", x => x.Type), ("Partitions", x => N(x.Partitions)), ("Serial number", x => x.Serial),
    ];
    private static readonly (string, Func<GpuInfo, string>)[] GpuCols =
    [
        ("Model", x => x.Model), ("Manufacturer", x => x.Manufacturer), ("Driver version", x => x.DriverVersion),
        ("Driver date", x => x.DriverDate), ("Display mode", x => x.VideoMode),
    ];
    private static readonly (string, Func<NetworkAdapterInfo, string>)[] NetCols =
    [
        ("Name", x => x.Name), ("Model", x => x.Description), ("Manufacturer", x => x.Manufacturer),
        ("Status", x => x.Status), ("Speed", x => HardwareInventoryReport.FormatSpeed(x.SpeedBps)),
    ];
    private static readonly (string, Func<BiosInfo, string>)[] BiosCols =
    [
        ("Vendor", x => x.Vendor), ("Version", x => x.Version), ("Release date", x => x.Date), ("Revision", x => x.Revision),
    ];
}
