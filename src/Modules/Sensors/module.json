{
  "id": "0693da7b-093d-4f58-9e31-de22588fc0e7",
  "slug": "Sensors",
  "displayName": "Temperatures & fans",
  "contract": "2.0",
  "entryType": "RemotePCDiagnostics.Modules.Sensors.SensorsPlugin",
  "needsAdmin": false,
  // Ships in process. The About page can run it out of process in user mode (RemotePCDiagnostics.ModuleHost, restricted token): the
  // reads that need administrator rights then come from the app, and only these.
  "capabilities": [ "sensors.read" ],
  "outOfProcess": false,
  "hasUi": true,
  "portableUi": false,
  // Its page reads only the module's results, so out of process the app still renders it.
  "resultOnlyUi": true,
  // Read every few seconds while it is shown, so out of process its module host stays running (others exit after each run).
  "keepAlive": true,
  "detailsReplaceReport": true
}
