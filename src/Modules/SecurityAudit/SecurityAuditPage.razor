@* The security audit module's own page, shown at /security-audit (SecurityAuditRoute in the app's UI) and on its module page. *@
@using RemotePCDiagnostics.Core.Security
@inherits ModuleDetailsBase
@* On-demand security baseline audit (bundled HardeningKitty, read-only Audit mode). Only friendly text here; detail goes to the log. *@
@{
    // The module itself in process; out of process the app's stand-in for it (the page then reads only its results).
    var m = Module;
}
@if (m is null)
{
    <p class="meta" data-testid="area-missing">This page isn't available.</p>
}
else
{
    var r = Store.Get(m.Name);
    var rep = r.Payload as SecurityAuditReport;
    var running = r.Status == DiagnosticStatus.Running;
    var suiteBusy = Diagnostics.IsStressSuiteRunning;
    <div class="toolbar toolbar-grouped">
        <span class="icon-badge page-icon"><Icon Name="sec" Size="20" /></span><h1 data-testid="audit-title">@m.DisplayName</h1>
        @if (running) { <button data-testid="audit-cancel" @onclick="() => Cancel(m)">Cancel</button> }
        else { <button data-testid="audit-start" disabled="@suiteBusy" @onclick="() => Start(m)">@(r.Status == DiagnosticStatus.NotRun ? "Start audit" : "Run again")</button> }
    </div>
    <p class="meta" data-testid="audit-intro">Checks this PC's Windows security settings against a recommended baseline. It only reads settings — nothing is changed. The audit runs only when you start it and can take a few minutes (it stops automatically after @SecurityAuditModule.FormatDuration(AuditTimeout(m))).</p>
    <p data-testid="audit-status" class="@(r.Status == DiagnosticStatus.Error && rep is null ? "status-line error-text" : running ? "status-line is-running" : "status-line")">
        <span class="@DotClass(r.Status)"></span>
        @if (r.Status == DiagnosticStatus.NotRun && _lastRun is { } lr)
        {
            @* Not run in this session, but an earlier audit is in the Event Log: say so, so nobody re-runs a 5-minute audit for nothing. *@
            <span data-testid="audit-lastrun">Not run in this session · last run @lr.LocalTime.ToString("g"): @lr.Outcome · @lr.Summary <a href="@($"history?module={Uri.EscapeDataString(lr.Module)}&run={lr.TimeUtc.UtcTicks}")">View details in History</a></span>
        }
        else
        {
            <span>@(r.Status switch { DiagnosticStatus.NotRun => "Not run yet. Press Start audit to begin.", DiagnosticStatus.Running => $"Auditing security settings… {Elapsed}", _ => r.Message })</span>
        }
        @if (running) { <span class="running-badge" data-testid="running-badge"><span class="running-badge-dot"></span>Running</span> }
    </p>
    @if (running)
    {
        <div class="run-progress run-progress-indeterminate" data-testid="audit-run-progress" aria-hidden="true"><div></div></div>
        <TestRunningVisual Slug="@m.Name" TestId="audit-visual" Caption="Auditing Windows security baseline policies (read-only)" />
    }
    @if (!running && rep?.Notice is { } notice) { <p class="notice" data-testid="audit-notice">@notice</p> }

    @if (!running && rep is not null)
    {
        var visible = Visible(rep);
        int Count(AuditOutcome o) => visible.Count(f => f.Outcome == o);
        @if (rep.Hidden > 0)
        {
            <p class="meta" data-testid="audit-profile">
                @if (_showAll) { <span>Showing all @rep.Findings.Count settings, including @rep.Hidden enterprise-only ones.</span> }
                else { <span>This PC is @rep.Profile!.Reason, so the @rep.Hidden settings only organizations use (Group Policy, audit logging, domain sign-in rules) are hidden.</span> }
                <button class="btn-small" data-testid="audit-show-all" @onclick="() => _showAll = !_showAll">@(_showAll ? "Show only home PC settings" : "Show all settings")</button>
            </p>
        }
        <div class="cards">
            @Card("failed", "Failed", "error", Count(AuditOutcome.Failed), "Important settings that differ from the recommendation", AuditOutcome.Failed)
            @Card("warning", "Warnings", "warning", Count(AuditOutcome.Warning), "Lower-risk settings that differ", AuditOutcome.Warning)
            @Card("passed", "Passed", "ok", Count(AuditOutcome.Passed), "Settings that match the recommendation", AuditOutcome.Passed)
            @if (Count(AuditOutcome.NotChecked) > 0) { @Card("notchecked", "Not checked", "neutral", Count(AuditOutcome.NotChecked), "Settings that couldn't be read", AuditOutcome.NotChecked) }
        </div>

        var categories = visible.Select(f => f.Category).Where(c => c.Length > 0).Distinct().OrderBy(c => c).ToList();
        var rows = Filtered(rep).ToList();
        var hasFilters = _outcome is not null || _category.Length > 0 || _text.Length > 0;
        <div class="toolbar audit-filters">
            <select data-testid="audit-filter-outcome" aria-label="Filter by result" value="@(_outcome?.ToString() ?? "")" @onchange="SetOutcome">
                <option value="">All results</option>
                <option value="Failed">Failed</option>
                <option value="Warning">Warnings</option>
                <option value="Passed">Passed</option>
                <option value="NotChecked">Not checked</option>
            </select>
            <select data-testid="audit-filter-category" aria-label="Filter by category" value="@_category" @onchange="SetCategory">
                <option value="">All categories</option>
                @foreach (var c in categories) { <option value="@c">@c</option> }
            </select>
            <input type="search" data-testid="audit-filter-text" aria-label="Search settings" placeholder="Search settings…" value="@_text" @oninput="SetText" />
            @if (hasFilters) { <button class="btn-small" data-testid="audit-filter-clear" @onclick="ClearFilters">Clear filters</button> }
            <span class="meta">@rows.Count of @visible.Count</span>
        </div>
        <table class="detail grid sticky-head sortable" data-testid="audit-table">
            <tr>
                @foreach (var (col, title) in AuditSort.Columns)
                {
                    var c = col;
                    <th @key="c" class="sortable-th" scope="col" aria-sort="@(_sort.Col == c ? (_sort.Desc ? "descending" : "ascending") : "none")"
                        data-testid="audit-th-@c.ToString().ToLowerInvariant()"><button type="button" class="th-btn" @onclick="() => _sort = AuditSort.Toggle(_sort, c)">@title<span class="sort-arrow" aria-hidden="true">@(_sort.Col == c ? (_sort.Desc ? " ▼" : " ▲") : "")</span></button></th>
                }
            </tr>
            @foreach (var f in rows)
            {
                <tr class="clickable" role="button" tabindex="0" data-testid="audit-row-@f.Id" @onclick="() => _open = f"
                    @onkeydown='e => { if (e.Key is "Enter" or " ") _open = f; }'>
                    <td><span class="dot dot-@Dot(f.Outcome)"></span>@f.OutcomeText</td>
                    <td>@f.Id</td><td>@f.Category</td><td>@f.Name</td><td>@f.SeverityText</td><td>@Show(f.CurrentValue)</td><td>@Show(f.RecommendedValue)</td>
                </tr>
            }
        </table>
        @if (rows.Count == 0) { <p class="meta" data-testid="audit-empty">No settings match these filters.</p> }

        @if (_open is { } o)
        {
            <div class="drawer-backdrop" @onclick="() => _open = null"></div>
            <aside class="drawer" role="dialog" aria-modal="true" aria-label="@o.Name" tabindex="-1" @onkeydown='e => { if (e.Key == "Escape") _open = null; }' data-testid="audit-drawer">
                <div class="drawer-head"><strong title="@o.Name">@o.Name</strong><button data-testid="audit-drawer-close" @onclick="() => _open = null">Close</button></div>
                <p class="meta"><span class="dot dot-@Dot(o.Outcome)"></span>@o.Explanation</p>
                <table class="detail">
                    <tr><th>Result</th><td>@o.OutcomeText</td></tr>
                    <tr><th>ID</th><td>@o.Id</td></tr>
                    <tr><th>Category</th><td>@Show(o.Category)</td></tr>
                    <tr><th>Severity</th><td>@o.SeverityText</td></tr>
                    <tr><th>Current value</th><td>@Show(o.CurrentValue)</td></tr>
                    <tr><th>Recommended value</th><td>@Show(o.RecommendedValue)</td></tr>
                </table>
            </aside>
        }
    }
}

@code {
    private AuditOutcome? _outcome;
    private bool _showAll;

    private IReadOnlyList<AuditFinding> Visible(SecurityAuditReport rep) => _showAll ? rep.Findings : rep.Shown;
    private string _category = "", _text = "";
    private AuditFinding? _open;
    // Static so the chosen sort survives re-runs, live updates and navigation.
    private static (AuditColumn Col, bool Desc) _sort = AuditSort.Default;
    private DateTimeOffset _started;
    private System.Threading.Timer? _tick;

    private string Elapsed
    {
        get
        {
            var start = _started != default ? _started : Store.Get(SecurityAuditModule.ModuleName) is { Status: DiagnosticStatus.Running } r ? r.Timestamp : default;
            if (start == default) return "";
            var e = DateTimeOffset.Now - start;
            if (e < TimeSpan.Zero) e = TimeSpan.Zero;
            return $"({(int)e.TotalMinutes}:{e.Seconds:00})";
        }
    }

    private RemotePCDiagnostics.Core.History.HistoryEntry? _lastRun;

    // The latest audit from earlier sessions (Event Log), shown while it hasn't run in this session. Read once, off the render thread.
    private async Task LoadLastRunAsync(string module)
    {
        try
        {
            if (Services.GetService(typeof(RemotePCDiagnostics.Core.History.IHistoryStore)) is not RemotePCDiagnostics.Core.History.IHistoryStore history) return;
            var read = await Task.Run(() => history.Read(TimeSpan.FromDays(30)));
            var latest = RemotePCDiagnostics.Core.History.HistoryQuery.LatestByModule(RemotePCDiagnostics.Core.History.HistoryNames.Normalize(read.Entries, Diagnostics.Catalog));
            _lastRun = latest.GetValueOrDefault(module);
            await InvokeAsync(StateHasChanged);
        }
        catch { /* no history source: keep "Not run yet" */ }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Module is { } m)
        {
            _ = LoadLastRunAsync(m.Name);
            if (Store.Get(m.Name).Status == DiagnosticStatus.Running) StartTicker(m);
        }
    }

    /// <summary>The security audit: the module in process, or the app's stand-in for it out of process.</summary>
    private IDiagnosticModule? Module =>
        (DiagnosticModule ?? Diagnostics.Catalog.ModuleFor(ModuleIds.SecurityAudit)) is { Id: var id } am && id == ModuleIds.SecurityAudit ? am : null;

    private static TimeSpan AuditTimeout(IDiagnosticModule m) => (m as SecurityAuditModule)?.Timeout ?? new SecurityAuditOptions().Timeout;

    /// <summary>Stops the audit: the module's own Cancel in process; out of process the module host is asked to stop it.</summary>
    private static void Cancel(IDiagnosticModule m)
    {
        if (m is SecurityAuditModule audit) audit.Cancel();
        else if (m is RemotePCDiagnostics.Core.Plugins.IUserModeModule outOfProcess) outOfProcess.Stop();
    }

    private void StartTicker(IDiagnosticModule m)
    {
        _tick?.Dispose();
        _tick = new System.Threading.Timer(_ =>
        {
            if (!Diagnostics.IsRunning(m.Name)) { _tick?.Dispose(); return; }
            try { _ = InvokeAsync(StateHasChanged); } catch { /* page closed */ }
        }, null, 1000, 1000);
    }

    private void Start(IDiagnosticModule m)
    {
        if (Diagnostics.IsStressSuiteRunning) return;
        _started = DateTimeOffset.Now; _open = null; _outcome = null; _category = ""; _text = "";
        StartTicker(m);
        _ = Diagnostics.RunAsync(m.Name);
    }

    private void ClearFilters() { _outcome = null; _category = ""; _text = ""; }

    private IEnumerable<AuditFinding> Filtered(SecurityAuditReport rep) => AuditSort.Sort(Visible(rep)
        .Where(f => _outcome is null || f.Outcome == _outcome)
        .Where(f => _category.Length == 0 || f.Category == _category)
        .Where(f => _text.Length == 0 || f.Name.Contains(_text, StringComparison.OrdinalIgnoreCase) || f.Id.Contains(_text, StringComparison.OrdinalIgnoreCase) || f.Category.Contains(_text, StringComparison.OrdinalIgnoreCase)),
        _sort.Col, _sort.Desc);

    private RenderFragment Card(string id, string title, string dot, int count, string meta, AuditOutcome outcome) => __builder =>
    {
        <div class="card clickable @(_outcome == outcome ? "selected" : "")" data-testid="audit-card-@id" role="button" tabindex="0"
             aria-pressed="@(_outcome == outcome ? "true" : "false")"
             @onclick="() => _outcome = _outcome == outcome ? null : outcome"
             @onkeydown='e => { if (e.Key is "Enter" or " ") _outcome = _outcome == outcome ? null : outcome; }'>
            <div class="card-head"><span class="dot dot-@dot"></span><strong>@title</strong></div>
            <div class="headline">@count</div>
            <div class="meta">@meta</div>
        </div>
    };

    private void SetCategory(ChangeEventArgs e) => _category = e.Value?.ToString() ?? string.Empty;
    private void SetText(ChangeEventArgs e) => _text = e.Value?.ToString() ?? string.Empty;
    private void SetOutcome(ChangeEventArgs e) => _outcome = Enum.TryParse<AuditOutcome>(e.Value?.ToString(), out var o) ? o : null;

    public override void Dispose()
    {
        _tick?.Dispose();
        _tick = null;
        base.Dispose();
    }

    private static string Show(string v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    private static string Dot(AuditOutcome o) => o switch
    {
        AuditOutcome.Passed => "ok", AuditOutcome.Warning => "warning", AuditOutcome.Failed => "error", _ => "neutral",
    };
}
