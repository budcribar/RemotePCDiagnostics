<Project Sdk="Microsoft.NET.Sdk">
  <!-- Memory test helper: runs the pattern sweep in its own process so running out of memory or a crash can't take down the app.
       Referenced by the Host so RemotePCDiagnostics.MemTest.exe lands next to RemotePCDiagnostics.Host.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
  </ItemGroup>
</Project>
