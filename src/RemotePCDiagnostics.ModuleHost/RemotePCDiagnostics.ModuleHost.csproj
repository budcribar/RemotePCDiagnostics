<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs one unsigned module out of process, started by the app with a restricted, Medium-integrity token (user mode). Talks to the app
       over its stdin/stdout only (ModuleHostMessage lines). Referenced by the Host so the exe lands next to RemotePCDiagnostics.Host.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
  </ItemGroup>
</Project>
