<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs one unsigned module out of process, started by the app with a restricted, Medium-integrity token (user mode). Talks to the app
       over its stdin/stdout only (ModuleHostMessage lines). Referenced by the Host so the exe lands next to RemotePCDiagnostics.Host.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same shared framework as the app: the exe lands in the app's folder, where DI, Components and JSInterop are not copied as files
         (the app gets them from Microsoft.AspNetCore.App), and modules with their own UI reference Components types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
  </ItemGroup>
</Project>
