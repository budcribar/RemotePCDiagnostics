<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM: WebView2CompositionControl (used by RemoteBlazorWebView) needs Microsoft.Windows.SDK.NET at runtime. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\diagnostics.ico</ApplicationIcon>
    <RootNamespace>RemotePCDiagnostics.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\diagnostics.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- RemoteBlazorWebView: sibling-repo source when present (UseRbwvSource, see Directory.Build.props), else the package. -->
    <PackageReference Include="PeakSWC.RemoteBlazorWebView.Wpf" Version="$(RbwvVersion)" Condition="'$(UseRbwvSource)' != 'true'" />
    <!-- The in-process relay that serves unsigned modules' UIs to the module page in Local mode (ModuleUiFrames). -->
    <PackageReference Include="PeakSWC.RemoteWebViewService.Lib" Version="$(RbwvLibVersion)" Condition="'$(UseRbwvSource)' != 'true'" />
    <ProjectReference Include="$(RbwvSourceRoot)\src\RemoteBlazorWebView.Wpf\RemoteBlazorWebView.Wpf.csproj" Condition="'$(UseRbwvSource)' == 'true'" />
    <ProjectReference Include="$(RbwvSourceRoot)\src\RemoteWebViewService.Lib\RemoteWebViewService.Lib.csproj" Condition="'$(UseRbwvSource)' == 'true'" />
    <!-- The [RemoteBlazor] source generator (MainWindow). The package brings it as an analyzer; a project reference does not. -->
    <ProjectReference Include="$(RbwvSourceRoot)\src\RemoteBlazorWebView.SourceGenerators\RemoteBlazorWebView.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(UseRbwvSource)' == 'true'" />
    <!-- Live temperatures/fans. 0.9.6 = latest stable (Oct 2026); ships a net10.0 lib. MPL-2.0. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- GPU stress test: Direct3D 11 compute via Vortice (MIT, managed only; uses the d3d11/dxgi/d3dcompiler_47 DLLs that ship with Windows, so no native binaries to copy). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <!-- NPU test: Direct3D 12 on the DXCore NPU adapter (MIT, managed only; d3d12.dll/dxcore.dll ship with Windows). -->
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <!-- Start/stop/restart from the Services page (WindowsServiceControlBackend). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
    <ProjectReference Include="..\RemotePCDiagnostics.UI\RemotePCDiagnostics.UI.csproj" />
    <!-- Memory test helper process (RemotePCDiagnostics.MemTest.exe is copied next to the Host exe). -->
    <ProjectReference Include="..\RemotePCDiagnostics.MemTest\RemotePCDiagnostics.MemTest.csproj" />
    <!-- User-mode module host for unsigned modules (RemotePCDiagnostics.ModuleHost.exe is copied next to the Host exe). -->
    <ProjectReference Include="..\RemotePCDiagnostics.ModuleHost\RemotePCDiagnostics.ModuleHost.csproj" />
    <!-- On-demand elevated repair helper (RemotePCDiagnostics.Admin.exe is copied next to the Host exe). -->
    <ProjectReference Include="..\RemotePCDiagnostics.Admin\RemotePCDiagnostics.Admin.csproj" />
  </ItemGroup>
  <!-- The modules that ship with the app, one DLL each, in builtin-modules\ next to the exe. -->
  <Import Project="..\..\build\BundledModules.targets" />
  <!-- The module UI host (an unsigned module's own UI, RemotePCDiagnostics.ModuleUiHost.exe) lands in moduleui\ next to the Host exe.
       Built and copied rather than referenced: a ProjectReference would merge its static web assets into the Host's and collide on
       _framework files, and its wwwroot\index.html would overwrite the Host's. -->
  <PropertyGroup>
    <ModuleUiHostProject>..\RemotePCDiagnostics.ModuleUiHost\RemotePCDiagnostics.ModuleUiHost.csproj</ModuleUiHostProject>
  </PropertyGroup>
  <Target Name="BuildModuleUiHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(ModuleUiHostProject)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(ModuleUiHostProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <ModuleUiHostFiles Include="..\RemotePCDiagnostics.ModuleUiHost\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleUiHostFiles)" DestinationFiles="@(ModuleUiHostFiles->'$(OutDir)moduleui\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <None Include="tools\osquery\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Bundled osquery (third_party/osquery, v5.24.0). Lands at <output>\tools\osquery\osqueryi.exe = OsqueryRunner.RelativePath. -->
    <None Include="..\..\third_party\osquery\osqueryi.exe" Link="tools\osquery\osqueryi.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\third_party\osquery\LICENSE*" Link="tools\osquery\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Bundled HardeningKitty (third_party/HardeningKitty, v0.9.4, MIT). Lands at <output>\tools\HardeningKitty\ = HardeningKittyRunner.RelativeFolder. -->
    <None Include="..\..\third_party\HardeningKitty\module\**" Link="tools\HardeningKitty\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logging: ILogger plus the plain-line helpers (LoggerLines), without importing Microsoft.Extensions.Logging, whose LogLevel
         would clash with RemotePCDiagnostics.Core.Logging.LogLevel. -->
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
  </ItemGroup>
</Project>
