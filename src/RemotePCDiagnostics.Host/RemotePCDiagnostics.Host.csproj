<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM: WebView2CompositionControl (used by RemoteBlazorWebView) needs Microsoft.Windows.SDK.NET at runtime. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RemotePCDiagnostics.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Drop-in replacement for Microsoft.AspNetCore.Components.WebView.Wpf. 10.0.13 is the latest stable on nuget.org (Oct 2026). -->
    <PackageReference Include="PeakSWC.RemoteBlazorWebView.Wpf" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
    <ProjectReference Include="..\RemotePCDiagnostics.UI\RemotePCDiagnostics.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- osqueryi.exe (not committed) is copied from tools\osquery; see tools/osquery/README.txt. -->
    <None Include="tools\osquery\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
