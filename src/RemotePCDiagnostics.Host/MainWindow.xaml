<Window x:Class="RemotePCDiagnostics.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:PeakSWC.RemoteBlazorWebView.Wpf;assembly=PeakSWC.RemoteBlazorWebView.Wpf"
        xmlns:ui="clr-namespace:RemotePCDiagnostics.UI;assembly=RemotePCDiagnostics.UI"
        Title="RemotePCDiagnostics" Icon="Assets/diagnostics.ico" Height="768" Width="1200">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- HostPage is set in code-behind AFTER Id/ServerUri/event handlers: the control throws
             "ServerUri must be set before HostPage" (and starts in local mode) if HostPage comes first. -->
        <blazor:BlazorWebView x:Name="RemoteBlazorWebView" Grid.Row="1" Services="{DynamicResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
        <!-- Remote mode only: native panel (neutral colors, independent of web CSS/theme). -->
        <Border x:Name="RemotePanel" Grid.Row="0" Visibility="Collapsed" Background="#FF2B2F36" BorderBrush="#FF5A6270"
                BorderThickness="0,0,0,1" Padding="16,10" Panel.ZIndex="10">
            <StackPanel>
                <TextBlock Text="Remote session" FontSize="16" FontWeight="SemiBold" Foreground="#FFF2F4F7" />
                <TextBlock x:Name="RemoteStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FFD0D5DD" Text="Connecting to server…" />
                <StackPanel x:Name="RemoteLinkRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center" FontSize="14">
                        <Hyperlink x:Name="RemoteHyperlink" Foreground="#FF7CB7FF" RequestNavigate="RemoteHyperlink_RequestNavigate">
                            <Run x:Name="RemoteLinkText" />
                        </Hyperlink>
                    </TextBlock>
                    <Button x:Name="CopyLinkButton" Content="Copy link" Margin="12,0,0,0" Padding="10,3" Click="CopyLinkButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Reverse-mirror demo: a small "Remote" bubble instead of the top card; click to copy the view-only link. -->
        <Border x:Name="RemoteBubble" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="20" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                Background="#E62B2F36" BorderBrush="#FF5A6270" BorderThickness="1" CornerRadius="16" Padding="14,8"
                MouseLeftButtonUp="RemoteBubble_Click" ToolTip="Click to copy the view-only link">
            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#FF22E58A" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="RemoteBubbleText" Text="Remote" Foreground="#FFF2F4F7" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
