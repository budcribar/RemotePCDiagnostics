<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Publish the out-of-process module UI host (moduleui\RemotePCDiagnostics.ModuleUiHost.exe) as self-contained
       into $(PublishDir)moduleui\ so isolated module UIs run without requiring a machine-wide .NET installation.
       Inno Setup's solid LZMA2 compression deduplicates the shared runtime assemblies in the final Setup .exe. -->
  <Target Name="PublishInstallerModuleUiHost" AfterTargets="Publish">
    <PropertyGroup>
      <_DotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotNetHost>
      <_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
      <_ModuleUiPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)moduleui'))</_ModuleUiPublishDir>
      <_ExtraPublishArgs Condition="'$(EnableWindowsTargeting)' != ''">-p:EnableWindowsTargeting=$(EnableWindowsTargeting)</_ExtraPublishArgs>
      <_ExtraPublishArgs Condition="'$(UseRbwvSource)' != ''">$(_ExtraPublishArgs) -p:UseRbwvSource=$(UseRbwvSource)</_ExtraPublishArgs>
      <_ExtraPublishArgs Condition="'$(RbwvSourceRoot)' != ''">$(_ExtraPublishArgs) -p:RbwvSourceRoot=&quot;$(RbwvSourceRoot)&quot;</_ExtraPublishArgs>
    </PropertyGroup>
    <Exec Command="&quot;$(_DotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.ModuleUiHost/RemotePCDiagnostics.ModuleUiHost.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=false -p:GeneratePackageOnBuild=false -p:DebugType=None -p:DebugSymbols=false $(_ExtraPublishArgs) -o &quot;$(_ModuleUiPublishDir)&quot;" />
  </Target>
</Project>
