<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Extract helpers, audit scripts, runtime and physical WebView assets together. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="PublishPortableHelpers" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_DotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotNetHost>
      <_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
      <PortableMemoryDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)portable-memory'))</PortableMemoryDir>
      <PortableModuleHostDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)portable-modulehost'))</PortableModuleHostDir>
      <PortableAgentDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)portable-agent'))</PortableAgentDir>
      <PortableModuleUiDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)portable-moduleui'))</PortableModuleUiDir>
      <_ExtraPortableArgs Condition="'$(EnableWindowsTargeting)' != ''">-p:EnableWindowsTargeting=$(EnableWindowsTargeting)</_ExtraPortableArgs>
      <_ExtraPortableArgs Condition="'$(UseRbwvSource)' != ''">$(_ExtraPortableArgs) -p:UseRbwvSource=$(UseRbwvSource)</_ExtraPortableArgs>
      <_ExtraPortableArgs Condition="'$(RbwvSourceRoot)' != ''">$(_ExtraPortableArgs) -p:RbwvSourceRoot=&quot;$(RbwvSourceRoot)&quot;</_ExtraPortableArgs>
    </PropertyGroup>
    <!-- Child helper apphosts need their own bundled runtime when Host is a single-file bundle. -->
    <Exec Command="&quot;$(_DotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.MemTest/RemotePCDiagnostics.MemTest.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:GeneratePackageOnBuild=false -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PortableMemoryDir)&quot;" />
    <Exec Command="&quot;$(_DotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.ModuleHost/RemotePCDiagnostics.ModuleHost.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:GeneratePackageOnBuild=false -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PortableModuleHostDir)&quot;" />
    <Exec Command="&quot;$(_DotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.Agent/RemotePCDiagnostics.Agent.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:GeneratePackageOnBuild=false -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PortableAgentDir)&quot;" />
    <Exec Command="&quot;$(_DotNetHost)&quot; publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.ModuleUiHost/RemotePCDiagnostics.ModuleUiHost.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true -p:IncludeAllContentForSelfExtract=true -p:GeneratePackageOnBuild=false -p:DebugType=None -p:DebugSymbols=false $(_ExtraPortableArgs) -o &quot;$(PortableModuleUiDir)&quot;" />
  </Target>
  <Target Name="BundlePortableHelpers" DependsOnTargets="PublishPortableHelpers" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeResolvedFilesToPublishTypes;_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'RemotePCDiagnostics.MemTest.exe' or '%(ResolvedFileToPublish.RelativePath)' == 'RemotePCDiagnostics.ModuleHost.exe' or '%(ResolvedFileToPublish.RelativePath)' == 'RemotePCDiagnostics.Agent.exe'" />
      <ResolvedFileToPublish Include="$(PortableMemoryDir)/RemotePCDiagnostics.MemTest.exe" RelativePath="RemotePCDiagnostics.MemTest.exe" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
      <ResolvedFileToPublish Include="$(PortableModuleHostDir)/RemotePCDiagnostics.ModuleHost.exe" RelativePath="RemotePCDiagnostics.ModuleHost.exe" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
      <ResolvedFileToPublish Include="$(PortableAgentDir)/RemotePCDiagnostics.Agent.exe" RelativePath="RemotePCDiagnostics.Agent.exe" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false" />
      <PortableModuleUiFile Include="$(PortableModuleUiDir)/**/*" />
      <ResolvedFileToPublish Include="@(PortableModuleUiFile)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="false">
        <RelativePath>moduleui\$([MSBuild]::MakeRelative('$(PortableModuleUiDir)', '%(FullPath)'))</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Razor copies these independently of ResolvedFileToPublish. Add them to the bundle too. -->
  <Target Name="BundlePortableWebAssets" AfterTargets="PrepareForBundle" DependsOnTargets="CopyStaticWebAssetsToPublishDirectory">
    <ItemGroup>
      <PortableWebAsset Include="$(PublishDir)wwwroot\**\*;$(PublishDir)*.staticwebassets.endpoints.json" />
      <FilesToBundle Include="@(PortableWebAsset)">
        <RelativePath>$([MSBuild]::MakeRelative('$(PublishDir)', '%(FullPath)'))</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
  <Target Name="RemoveBundledPortableWebAssets" AfterTargets="Publish">
    <Delete Files="@(PortableWebAsset)" />
  </Target>
</Project>

