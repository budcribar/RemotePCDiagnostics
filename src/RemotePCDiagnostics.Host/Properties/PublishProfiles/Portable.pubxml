<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Extract helpers, audit scripts, runtime and physical WebView assets together. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="PublishPortableMemoryHelper" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <PortableMemoryDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)portable-memory'))</PortableMemoryDir>
    </PropertyGroup>
    <!-- Its apphost needs its own bundled runtime when launched as a child process. -->
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../RemotePCDiagnostics.MemTest/RemotePCDiagnostics.MemTest.csproj&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PortableMemoryDir)&quot;" />
  </Target>
  <Target Name="BundlePortableMemoryHelper" DependsOnTargets="PublishPortableMemoryHelper" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeResolvedFilesToPublishTypes;_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'RemotePCDiagnostics.MemTest.exe'" />
      <ResolvedFileToPublish Include="$(PortableMemoryDir)/RemotePCDiagnostics.MemTest.exe" RelativePath="RemotePCDiagnostics.MemTest.exe" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Razor copies these independently of ResolvedFileToPublish. Add them to the bundle too. -->
  <Target Name="BundlePortableWebAssets" AfterTargets="PrepareForBundle" DependsOnTargets="CopyStaticWebAssetsToPublishDirectory">
    <ItemGroup>
      <PortableWebAsset Include="$(PublishDir)wwwroot\**\*;$(PublishDir)*.staticwebassets.endpoints.json" />
      <FilesToBundle Include="@(PortableWebAsset)">
        <RelativePath>$([MSBuild]::MakeRelative('$(PublishDir)', '%(FullPath)'))</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
  <Target Name="RemoveBundledPortableWebAssets" AfterTargets="Publish">
    <Delete Files="@(PortableWebAsset)" />
  </Target>
</Project>

