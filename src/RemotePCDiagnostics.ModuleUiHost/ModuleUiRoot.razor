@using RemotePCDiagnostics.ModuleUi
@implements IDisposable
@inject ModuleUiReceiver Receiver
@* The module's own details UI, given the module it describes (the IPluginContext.SetDetailsComponent contract) and the module's latest
   result in the app (IModuleUi.LastResult, sent by the module page) as the ModuleDetails.LastResult cascading value. *@
@if (Program.Ui is { DetailsComponent: { } component } ui)
{
    <CascadingValue Value="_last" Name="@RemotePCDiagnostics.Core.Plugins.ModuleDetails.LastResult">
        <ErrorBoundary>
            <ChildContent>
                <DynamicComponent Type="component" Parameters="@(new Dictionary<string, object> { ["DiagnosticModule"] = ui.Module })" />
            </ChildContent>
            <ErrorContent Context="ex">
                <p class="module-ui-error">The module's UI failed: @ex.Message</p>
            </ErrorContent>
        </ErrorBoundary>
    </CascadingValue>
}

@code {
    private RemotePCDiagnostics.Core.DiagnosticResult? _last;

    protected override void OnInitialized()
    {
        Receiver.Changed += OnChanged;
        Receiver.BadValue += OnBadValue;
        _last = Current();
    }

    /// <summary>The app's latest result for the module (not run yet until the app sends one).</summary>
    private RemotePCDiagnostics.Core.DiagnosticResult? Current() => Program.Ui is not { } ui ? null
        : Receiver.LastResult?.ToResult(ui.Module.Name) ?? RemotePCDiagnostics.Core.DiagnosticResult.NotRun(ui.Module.Name);

    private void OnChanged() => InvokeAsync(() =>
    {
        _last = Current();
        Program.Log($"result from the app: {_last?.Status} {_last?.Timestamp:O}");
        StateHasChanged();
    });

    private void OnBadValue(string name, Exception ex) => Program.Log($"bad value {name} from the app: {ex.Message}");

    public void Dispose()
    {
        Receiver.Changed -= OnChanged;
        Receiver.BadValue -= OnBadValue;
    }
}
