<Project Sdk="Microsoft.NET.Sdk">
  <!-- What crosses between the app and an unsigned module's UI process (RemotePCDiagnostics.ModuleUiHost): the IModuleUi contract, from
       which the RemoteComponents source generator writes ModuleUiFrame (the app's sandboxed iframe) and ModuleUiReceiver (the UI
       process's side). A library of its own because Razor can't use a component generated in its own project, and so Core stays free of
       Blazor. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- RemoteBlazorWebView: sibling-repo source when present (UseRbwvSource, see Directory.Build.props), else the package.
         The package ships the [RemoteComponentContract] source generator as an analyzer; a ProjectReference does not flow it,
         so add the generator project explicitly as an Analyzer (ModuleUi.cs uses [RemoteComponentContract]). -->
    <PackageReference Include="PeakSWC.RemoteBlazorWebView.RemoteComponents" Version="$(RbwvVersion)" Condition="'$(UseRbwvSource)' != 'true'" />
    <ProjectReference Include="$(RbwvSourceRoot)\src\RemoteBlazorWebView.RemoteComponents\RemoteBlazorWebView.RemoteComponents.csproj" Condition="'$(UseRbwvSource)' == 'true'" />
    <ProjectReference Include="$(RbwvSourceRoot)\src\RemoteBlazorWebView.RemoteComponents.Generators\RemoteBlazorWebView.RemoteComponents.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(UseRbwvSource)' == 'true'" />
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
  </ItemGroup>
</Project>
