@page "/history"
@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.History
@using RemotePCDiagnostics.Core.Optimizations
@implements IDisposable
@inject IHistoryStore History
@inject AppServices App
@* Past test results and automated fix impact summary from the Windows Event Log and current session. *@
@{
    var all = _result?.Entries ?? [];
    var diagEntries = all.Where(e => !HistorySummary.IsFixEntry(e)).ToList();
    var remSvc = App.Remediation;
    var memSvc = App.Memory;
    var svcAct = App.ServiceActions;
    var rows = HistoryQuery.Sort(HistoryQuery.Filter(diagEntries, _module, _outcome, _range, DateTimeOffset.UtcNow), _sort.Col, _sort.Desc);
    // Tiles follow the filters: fixes as before, runs = the rows listed below.
    var impact = HistorySummary.Build(all.Where(HistorySummary.IsFixEntry).Concat(rows).ToList(), remSvc, memSvc, svcAct, _range, DateTimeOffset.UtcNow);
    var localNow = DateTimeOffset.Now;
    var ascendingDays = _sort.Col == HistoryColumn.Time && !_sort.Desc;
    var dayGroups = HistoryQuery.GroupByDay(rows, localNow, ascendingDays);
    DateOnly? latestDay = dayGroups.Count > 0 ? dayGroups.MaxBy(g => g.Date)!.Date : null;
    var fixGroups = HistorySummary.GroupFixesByDay(impact.Fixes, localNow);
    DateOnly? latestFixDay = fixGroups.Count > 0 ? fixGroups.MaxBy(g => g.Date)!.Date : null;
    var totalExpandedRows = dayGroups.Where(g => IsDayExpanded(g.Date, latestDay)).Sum(g => g.Entries.Count);
    var renderedRows = 0;
    var tests = HistoryNames.FilterOptions(diagEntries, Diagnostics.Catalog);
    var trends = tests.Where(t => HistoryQuery.TrendKey(t.Module) is not null && (_module.Length == 0 || string.Equals(_module, t.Module, StringComparison.OrdinalIgnoreCase)))
        .Select(t => (t.Test, Key: HistoryQuery.TrendKey(t.Module)!.Value, Points: HistoryQuery.Trend(diagEntries, t.Module))).Where(t => t.Points.Count > 0).ToList();
}
<div class="toolbar toolbar-grouped">
    <span class="icon-badge page-icon"><Icon Name="hist" Size="20" /></span><h1 data-testid="history-title">History</h1>
    <button data-testid="history-refresh" disabled="@_loading" @onclick="Load">@(_loading ? "Loading…" : "Refresh")</button>
</div>
<p class="meta" data-testid="history-source">Summary of automated fixes (disk space reclaimed, system memory saved, updates and settings applied) and past check/test results from the Windows Event Log.</p>

@if (_result is not null)
{
    <div class="cards" data-testid="history-summary-cards" style="margin-bottom: 16px;">
        <div class="card" data-testid="history-summary-disk">
            <div class="card-head"><span class="icon-badge"><Icon Name="disk" /></span><strong>Disk space reclaimed</strong></div>
            <div class="headline">@impact.DiskHeadline</div>
            <CardList Text="@impact.DiskMeta" />
        </div>
        <div class="card" data-testid="history-summary-memory">
            <div class="card-head"><span class="icon-badge"><Icon Name="mem" /></span><strong>System memory saved</strong></div>
            <div class="headline">@impact.MemoryHeadline</div>
            <CardList Text="@impact.MemoryMeta" />
        </div>
        <div class="card" data-testid="history-summary-fixes">
            <div class="card-head"><span class="icon-badge"><Icon Name="svc" /></span><strong>Automated fixes</strong></div>
            <div class="headline">@impact.FixesHeadline</div>
            <CardList Text="@impact.FixesMeta" />
        </div>
        <div class="card" data-testid="history-summary-runs">
            <div class="card-head"><span class="icon-badge"><Icon Name="health" /></span><strong>Checks &amp; test runs</strong></div>
            <div class="headline">@impact.RunsHeadline</div>
            <CardList Text="@impact.RunsMeta" />
        </div>
    </div>

    <UndoAllPanel />

    @if (fixGroups.Count > 0)
    {
        <h2 class="section-title">Automated fixes &amp; optimizations</h2>
        <table class="detail grid sticky-head history-table" data-testid="history-fixes-table" style="margin-bottom: 18px;">
            <tr>
                <th>Time</th>
                <th>Area</th>
                <th>Triggered by</th>
                <th>Result</th>
                <th>What changed</th>
            </tr>
            @foreach (var fg in fixGroups)
            {
                var fixGroup = fg;
                var fixDayOpen = IsFixDayExpanded(fixGroup.Date, latestFixDay);
                <tr @key="fixGroup.Date" class="history-day clickable" role="button" tabindex="0" aria-expanded="@(fixDayOpen ? "true" : "false")" data-testid="history-fix-day"
                    @onclick="() => ToggleFixDay(fixGroup.Date, latestFixDay)" @onkeydown='k => { if (k.Key is "Enter" or " ") ToggleFixDay(fixGroup.Date, latestFixDay); }'>
                    <td colspan="5">
                        <div class="history-day-bar">
                            <span class="history-day-title">
                                <span class="history-day-chevron" aria-hidden="true">@(fixDayOpen ? "▾" : "▸")</span>
                                <span>@fixGroup.Label</span>
                                @if (fixGroup.Label is "Today" or "Yesterday")
                                {
                                    <span class="history-day-date meta">(@fixGroup.Date.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture))</span>
                                }
                            </span>
                            <span class="history-day-summary">
                                <span class="chip chip-na">@fixGroup.CountText</span>
                                @if (fixGroup.AppliedCount > 0)
                                {
                                    <span class="chip chip-ok"><span class="dot dot-ok"></span>@fixGroup.AppliedCount applied</span>
                                }
                                @if (fixGroup.FailedCount > 0)
                                {
                                    <span class="chip chip-warn"><span class="dot dot-warning"></span>@fixGroup.FailedCount failed</span>
                                }
                            </span>
                        </div>
                    </td>
                </tr>
                @if (fixDayOpen)
                {
                    @foreach (var fx in fixGroup.Fixes)
                    {
                        <tr data-testid="history-fix-row">
                            <td title="@fx.TimeUtc.ToLocalTime().ToString("g")">@fx.TimeUtc.ToLocalTime().ToString("t")</td>
                            <td>@fx.Category</td>
                            <td>@fx.Actor</td>
                            <td>
                                <span class="dot dot-@(fx.Success ? "ok" : "warning")"></span>@(fx.Success ? "Applied" : "Failed")
                                @if (fx.ImpactBadge is { } badge)
                                {
                                    <span class="chip chip-ok" style="margin-left: 6px;">@badge</span>
                                }
                            </td>
                            <td class="summary">@fx.Summary</td>
                        </tr>
                    }
                }
            }
        </table>
    }
}

@if (_result is { LegacyEntries: > 0 } pendingUpdate)
{
    <p class="notice" data-testid="history-update-pending">History update pending: @pendingUpdate.LegacyEntries older @(pendingUpdate.LegacyEntries == 1 ? "result is" : "results are") converted the next time the app starts as administrator.</p>
}
@if (_result is null)
{
    <p class="status-line" data-testid="history-loading">Loading history…</p>
}
else if (diagEntries.Count == 0 && _range == HistoryRange.All)
{
    <p class="status-line" data-testid="history-empty">@(_result.Available
        ? "No results yet. Results appear here after a check or test finishes."
        : "Windows Event Log isn't available or has no results yet; run the app once as administrator so it can register the event source.")</p>
}
else
{
    @if (!_result.Available) { <p class="notice" data-testid="history-partial">Some history couldn't be read from the Windows Event Log.</p> }

    <div class="toolbar audit-filters">
        <select data-testid="history-filter-test" aria-label="Filter by test" @bind="_module" @bind:after="ResetPaging">
            <option value="">All tests</option>
            @foreach (var t in tests) { <option value="@t.Module">@t.Test</option> }
        </select>
        <select data-testid="history-filter-outcome" aria-label="Filter by result" @bind="_outcome" @bind:after="ResetPaging">
            <option value="">All results</option>
            @foreach (var o in HistoryQuery.Outcomes) { <option value="@o">@o</option> }
        </select>
        <select data-testid="history-filter-range" aria-label="Time range" value="@_range.ToString()" @onchange="SetRange">
            <option value="Last24Hours">Last 24 hours</option>
            <option value="Last7Days">Last 7 days</option>
            <option value="Last30Days">Last 30 days</option>
            <option value="All">All</option>
        </select>
        <span class="meta">@rows.Count of @diagEntries.Count · @dayGroups.Count @(dayGroups.Count == 1 ? "day" : "days")</span>
        @if (dayGroups.Count > 1)
        {
            <button type="button" data-testid="history-expand-all" @onclick="() => SetAllDays(dayGroups, true)">Expand all</button>
            <button type="button" data-testid="history-collapse-all" @onclick="() => SetAllDays(dayGroups, false)">Collapse all</button>
        }
    </div>

    @if (trends.Count > 0)
    {
        <div class="cards" data-testid="history-trends">
            @foreach (var t in trends)
            {
                var max = t.Points.Max(p => p.Value);
                <div class="card">
                    <div class="card-head"><strong>@t.Test</strong></div>
                    <div class="meta">@t.Key.Label, last @t.Points.Count run(s)</div>
                    <div class="trend" role="img" aria-label="@($"{t.Key.Label}: {string.Join(", ", t.Points.Select(p => MeasurementFormat.Display(t.Key.Name, p.Value)))} {t.Key.Unit}")">
                        @foreach (var p in t.Points)
                        {
                            <span style="height:@((max > 0 ? Math.Max(5, p.Value / max * 100) : 5).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%" title="@($"{p.Time.ToLocalTime():g}: {MeasurementFormat.Display(t.Key.Name, p.Value)} {t.Key.Unit}")"></span>
                        }
                    </div>
                    <div class="meta">Latest: @MeasurementFormat.Display(t.Key.Name, t.Points[^1].Value) @t.Key.Unit</div>
                </div>
            }
        </div>
    }

    <table class="detail grid sticky-head sortable history-table" data-testid="history-table">
        <tr>
            @foreach (var (col, title) in HistoryQuery.Columns)
            {
                var c = col;
                <th @key="c" class="sortable-th" scope="col" aria-sort="@(_sort.Col == c ? (_sort.Desc ? "descending" : "ascending") : "none")"
                    data-testid="history-th-@c.ToString().ToLowerInvariant()"><button type="button" class="th-btn" @onclick="() => _sort = HistoryQuery.Toggle(_sort, c)">@title<span class="sort-arrow" aria-hidden="true">@(_sort.Col == c ? (_sort.Desc ? " ▼" : " ▲") : "")</span></button></th>
            }
        </tr>
        @foreach (var g in dayGroups)
        {
            var group = g;
            var dayOpen = IsDayExpanded(group.Date, latestDay);
            <tr @key="group.Date" class="history-day clickable" role="button" tabindex="0" aria-expanded="@(dayOpen ? "true" : "false")" data-testid="history-day"
                @onclick="() => ToggleDay(group.Date, latestDay)" @onkeydown='k => { if (k.Key is "Enter" or " ") ToggleDay(group.Date, latestDay); }'>
                <td colspan="5">
                    <div class="history-day-bar">
                        <span class="history-day-title">
                            <span class="history-day-chevron" aria-hidden="true">@(dayOpen ? "▾" : "▸")</span>
                            <span>@group.Label</span>
                            @if (group.Label is "Today" or "Yesterday")
                            {
                                <span class="history-day-date meta">(@group.Date.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture))</span>
                            }
                        </span>
                        <span class="history-day-summary" data-testid="history-day-summary">
                            <span class="chip chip-na">@group.CountText</span>
                            @if (group.PassedCount > 0)
                            {
                                <span class="chip chip-ok"><span class="dot dot-ok"></span>@group.PassedCount OK</span>
                            }
                            @if (group.WarningCount > 0)
                            {
                                <span class="chip chip-warn"><span class="dot dot-warning"></span>@group.WarningCount warning</span>
                            }
                            @if (group.CriticalCount > 0)
                            {
                                <span class="chip chip-err"><span class="dot dot-error"></span>@group.CriticalCount critical</span>
                            }
                            @if (group.OtherCount > 0)
                            {
                                <span class="chip chip-na">@group.OtherCount other</span>
                            }
                        </span>
                    </div>
                </td>
            </tr>
            @if (dayOpen)
            {
                @foreach (var e in group.Entries)
                {
                    if (renderedRows >= _shown) break;
                    renderedRows++;
                    var entry = e;
                    var open = ReferenceEquals(_open, entry);
                    <tr class="clickable" role="button" tabindex="0" aria-expanded="@(open ? "true" : "false")" data-testid="history-row"
                        @onclick="() => _open = open ? null : entry" @onkeydown='k => { if (k.Key is "Enter" or " ") _open = open ? null : entry; }'>
                        <td title="@entry.LocalTime.ToString("g")">@entry.LocalTime.ToString("t")</td>
                        <td>@entry.Test@if (!string.IsNullOrEmpty(entry.Instance)) {<span class="meta" data-testid="history-instance"> · @entry.Instance</span>}</td>
                        <td><span class="dot dot-@Dot(entry.Outcome)"></span>@entry.Outcome</td>
                        <td class="summary">@entry.Summary</td>
                        <td>@HistoryQuery.FormatDuration(entry.DurationSeconds)</td>
                    </tr>
                    @if (open)
                    {
                        <tr class="history-details" data-testid="history-details"><td colspan="5">
                            <div class="meta">@(entry.Suite is { } s ? $"Part of the stress tests ({s}). " : "")Machine: @entry.Machine · App version @entry.AppVersion</div>
                            @if (HistoryPresentation.Measurements(entry).Count > 0)
                            {
                                <div class="meta"><strong>Measurements</strong></div>
                                <ul>@foreach (var m in HistoryPresentation.Measurements(entry)) { <li>@HistoryLabels.Measurement(m.Name): @MeasurementFormat.Display(m.Name, m.Value)</li> }</ul>
                            }
                            @if (HistoryPresentation.Details(entry) is { Count: > 0 } det)
                            {
                                <div class="meta"><strong>Details</strong></div>
                                <ul data-testid="history-details-lines">@foreach (var line in det) { <li>@line</li> }</ul>
                            }
                            @if (HistoryPresentation.Measurements(entry).Count == 0 && HistoryPresentation.Details(entry).Count == 0) { <div class="meta">Detailed measurements were not recorded for this result.</div> }
                        </td></tr>
                    }
                }
            }
        }
    </table>
    @if (totalExpandedRows > renderedRows)
    {
        <div class="history-more"><button data-testid="history-more" @onclick="() => _shown += HistoryQuery.PageSize">Show @Math.Min(HistoryQuery.PageSize, totalExpandedRows - renderedRows) more (@renderedRows of @totalExpandedRows expanded rows shown)</button></div>
    }
    @if (rows.Count == 0) { <p class="meta" data-testid="history-nomatch">No results match these filters.</p> }
}

@code {
    [Inject] private ResultStore Store { get; set; } = default!;
    [Inject] private DiagnosticsService Diagnostics { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "module")] public string? LinkedModule { get; set; }
    [SupplyParameterFromQuery(Name = "run")] public long? LinkedRun { get; set; }
    private string _module = "", _outcome = "";
    private HistoryRange _range = HistoryRange.All;
    private static (HistoryColumn Col, bool Desc) _sort = HistoryQuery.DefaultSort;
    private HistoryEntry? _open;
    private int _shown = HistoryQuery.PageSize;
    private readonly Dictionary<DateOnly, bool> _dayOverrides = [];
    private readonly Dictionary<DateOnly, bool> _fixDayOverrides = [];
    private HistoryReadResult? _result;
    private bool _loading, _disposed;
    private int _reloadPending;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnResult;
        await Load();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(LinkedModule)) return;
        _module = LinkedModule;
        _outcome = "";
        _sort = HistoryQuery.DefaultSort;
        ResetPaging();
        ApplyLinkedEntrySelection();
    }

    private void ApplyLinkedEntrySelection()
    {
        if (string.IsNullOrWhiteSpace(LinkedModule) || _result is null) return;
        _open = _result.Entries.FirstOrDefault(entry =>
            string.Equals(entry.Module, LinkedModule, StringComparison.OrdinalIgnoreCase) &&
            entry.TimeUtc.UtcTicks == LinkedRun);
        if (_open is not null)
            _dayOverrides[DateOnly.FromDateTime(_open.LocalTime.Date)] = true;
    }

    private bool IsDayExpanded(DateOnly date, DateOnly? latestDay) =>
        _dayOverrides.TryGetValue(date, out var open) ? open : (latestDay is not null && date == latestDay.Value);

    private void ToggleDay(DateOnly date, DateOnly? latestDay) =>
        _dayOverrides[date] = !IsDayExpanded(date, latestDay);

    private void SetAllDays(IEnumerable<HistoryDayGroup> groups, bool expanded)
    {
        foreach (var g in groups)
            _dayOverrides[g.Date] = expanded;
    }

    private bool IsFixDayExpanded(DateOnly date, DateOnly? latestFixDay) =>
        _fixDayOverrides.TryGetValue(date, out var open) ? open : (latestFixDay is not null && date == latestFixDay.Value);

    private void ToggleFixDay(DateOnly date, DateOnly? latestFixDay) =>
        _fixDayOverrides[date] = !IsFixDayExpanded(date, latestFixDay);

    private async Task Load()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            var within = HistoryQuery.RangeSpan(_range);
            // Event Log reads can take a moment: never on the render thread.
            var read = await Task.Run(() => History.Read(within));
            // Cancelled runs produced no result: they're left out of history entirely.
            _result = read with { Entries = HistoryQuery.WithoutCancelled(HistoryNames.Normalize(read.Entries, Diagnostics.Catalog)) };
            if (_open is null && !string.IsNullOrWhiteSpace(LinkedModule))
                ApplyLinkedEntrySelection();
            else if (_open is not null && !_result.Entries.Contains(_open))
                _open = null;
        }
        catch { _result = new HistoryReadResult([], false); }
        finally { _loading = false; }
    }

    private void ResetPaging()
    {
        _shown = HistoryQuery.PageSize;
        _dayOverrides.Clear();
    }

    private async Task SetRange(ChangeEventArgs e)
    {
        ResetPaging();
        _fixDayOverrides.Clear();
        _range = Enum.TryParse<HistoryRange>(e.Value?.ToString(), out var r) ? r : HistoryRange.All;
        await Load();
    }

    // A test finished: its event is written in the background, so re-read shortly after.
    private void OnResult(object? sender, DiagnosticResult r)
    {
        if (r.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun || System.Threading.Interlocked.Exchange(ref _reloadPending, 1) == 1) return;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            System.Threading.Interlocked.Exchange(ref _reloadPending, 0);
            if (_disposed) return;
            try { await InvokeAsync(async () => { await Load(); StateHasChanged(); }); } catch { }
        });
    }

    public void Dispose() { _disposed = true; Store.Changed -= OnResult; }

    private static string Dot(string outcome) => outcome switch
    {
        "OK" => "ok", "Warning" => "warning", "Critical" => "error", _ => "neutral",
    };
}
