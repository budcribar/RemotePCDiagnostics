@page "/benchmark"
@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Benchmarks
@using RemotePCDiagnostics.Core.Workflow
@implements IDisposable
@inject BenchmarkService Bench
@inject AppServices App
@inject ISessionContext Session
@inject BenchmarkUploader Uploader
@inject IJSRuntime JS
@* Simplified step-by-step performance benchmark: (1) Select or capture & save a baseline, (2) Pick modifications, (3) Run comparison, (4) Review, save, undo, or upload results. *@
@{
    var s = Bench.Settings;
    var running = Bench.Running is not null || Bench.Settling is not null || Bench.RunningDeveloperAction || Bench.ExperimentRunning;
    var cmp = Bench.Comparison;
    var before = Bench.Before;
    var after = Bench.After;
    var available = Bench.AvailableBenchmarks;
    var hasDevEnv = Bench.IsKindAvailable(BenchmarkKind.DeveloperCSharp);
    var savedBaselines = Bench.SavedBaselines;
    var activeBaseline = Bench.ActiveBaseline;
    var hasUnsavedBaseline = before is not null && activeBaseline is null && after is null;

    // Determine current wizard stage (one clean screen at a time)
    var stage = running
        ? (Bench.ExperimentRunning || Bench.Running == BenchmarkPhase.After || Bench.Settling == BenchmarkPhase.After ? "running-comparison" : "running-baseline")
        : after is not null
            ? "results"
            : _forceSetup
                ? "setup"
                : hasUnsavedBaseline
                    ? "review-baseline"
                    : before is not null
                        ? "modify"
                        : "setup";

    var stepIndex = stage switch
    {
        "setup" or "running-baseline" or "review-baseline" => 0,
        "modify" => 1,
        "running-comparison" => 2,
        "results" => 3,
        _ => 0,
    };
}
<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="health" Size="20" /></span>
    <h1 data-rpcd-page="benchmark" data-rpcd-contract="@BrowserContract.Benchmark" data-testid="bench-title">Performance benchmark</h1>
</div>

@* 4-stage clickable stepper *@
<nav class="bench-stepper" data-testid="bench-stepper" aria-label="Benchmark workflow steps">
    @{
        var canClickBaseline = !running && (stepIndex > 0 || (stage == "setup" && savedBaselines.Count > 0 && (_newBaselineSelected || _setupCategory is not null)));
        var canClickModify = !running && stepIndex > 1 && before is not null;
    }
    @if (canClickBaseline)
    {
        <button type="button" class="bench-step @(stepIndex > 0 ? "is-done" : "is-active") is-clickable" data-testid="bench-step-baseline" @onclick="GoToBaselineSetup">
            <span class="bench-step-dot">@(stepIndex > 0 ? "✓" : "1")</span>
            <span class="bench-step-text"><strong>Baseline</strong><span class="meta">@(stage == "running-baseline" ? "Running…" : stage == "review-baseline" ? "Save or delete" : "Select or capture")</span></span>
        </button>
    }
    else
    {
        <div class="bench-step @(stepIndex == 0 ? "is-active" : stepIndex > 0 ? "is-done" : "is-todo")" data-testid="bench-step-baseline">
            <span class="bench-step-dot">@(stepIndex > 0 ? "✓" : "1")</span>
            <span class="bench-step-text"><strong>Baseline</strong><span class="meta">@(stage == "running-baseline" ? "Running…" : stage == "review-baseline" ? "Save or delete" : "Select or capture")</span></span>
        </div>
    }

    @if (canClickModify)
    {
        <button type="button" class="bench-step is-done is-clickable" data-testid="bench-step-modify" @onclick="GoToModify">
            <span class="bench-step-dot">✓</span>
            <span class="bench-step-text"><strong>Modifications</strong><span class="meta">Pick changes to test</span></span>
        </button>
    }
    else
    {
        <div class="bench-step @(stepIndex == 1 ? "is-active" : stepIndex > 1 ? "is-done" : "is-todo")" data-testid="bench-step-modify">
            <span class="bench-step-dot">@(stepIndex > 1 ? "✓" : "2")</span>
            <span class="bench-step-text"><strong>Modifications</strong><span class="meta">Pick changes to test</span></span>
        </div>
    }

    <div class="bench-step @(stepIndex == 2 ? "is-active" : stepIndex > 2 ? "is-done" : "is-todo")" data-testid="bench-step-compare">
        <span class="bench-step-dot">@(stepIndex > 2 ? "✓" : "3")</span>
        <span class="bench-step-text"><strong>Compare</strong><span class="meta">@(stage == "running-comparison" ? "Applying & measuring…" : "Run After pass")</span></span>
    </div>

    <div class="bench-step @(stepIndex == 3 ? "is-active" : "is-todo")" data-testid="bench-step-results">
        <span class="bench-step-dot">4</span>
        <span class="bench-step-text"><strong>Results</strong><span class="meta">@(Uploader.CanUpload || _isRemoteDisplay ? "Save, undo, or upload" : "Save or undo")</span></span>
    </div>
</nav>

<AgentData TestId="bench-report-data" Json="@RemotePCDiagnostics.Core.Areas.AgentExports.Benchmark(Bench)" />
@if (!running && Bench.Message is { } msg) { <p class="notice" data-testid="bench-message">@msg</p> }

@* ===================== STAGE 1: SETUP BASELINE ===================== *@
@if (stage == "setup")
{
    var hasSaved = savedBaselines.Count > 0;
    var showNewFlow = !hasSaved || _newBaselineSelected;

    @if (!showNewFlow)
    {
        @* 1a. Saved baselines exist: show ONLY the Baseline picker dropdown *@
        <section class="card bench-wizard-card" data-testid="bench-baseline-picker">
            <div class="bench-inline-field">
                <label for="bench-baseline-select"><strong>Baseline</strong></label>
                <select id="bench-baseline-select" data-testid="bench-baseline-select" class="bench-select" @onchange="OnBaselineSelected">
                    <option value="" selected>Choose a baseline…</option>
                    <option value="__new__">+ New baseline</option>
                    @foreach (var sb in savedBaselines)
                    {
                        <option value="@sb.Id">@sb.Name (@sb.SavedUtc.ToLocalTime().ToString("g"))</option>
                    }
                </select>
            </div>
        </section>
    }
    else if (_setupCategory is null)
    {
        @* 1b. New baseline: first choose category (no tests shown yet) *@
        <section class="card bench-wizard-card" data-testid="bench-goals">
            <div class="card-head">
                <strong>Choose a baseline category</strong>
                <span class="meta">Pick what you want to benchmark.</span>
            </div>
            <div class="bench-category-grid">
                @if (hasDevEnv)
                {
                    <button type="button" class="bench-category-card" data-testid="bench-goal-build" @onclick="() => SelectCategory(BenchmarkGoals.Build)">
                        <strong>Build speed</strong>
                        <span class="meta">C# clean build &amp; disk latency</span>
                    </button>
                }
                <button type="button" class="bench-category-card" data-testid="bench-goal-browsing" @onclick="() => SelectCategory(BenchmarkGoals.Browsing)">
                    <strong>Web browsing</strong>
                    <span class="meta">DNS lookup &amp; web browsing speed</span>
                </button>
                <button type="button" class="bench-category-card" data-testid="bench-goal-tuneup" @onclick="() => SelectCategory(BenchmarkGoals.TuneUp)">
                    <strong>Full tune-up</strong>
                    <span class="meta">Start-up, memory, CPU, disk &amp; web</span>
                </button>
            </div>
        </section>
    }
    else
    {
        @* 1c. Category chosen: choose tests to include & run baseline *@
        var catTitle = _setupCategory switch
        {
            BenchmarkGoals.Build => "Build speed",
            BenchmarkGoals.Browsing => "Web browsing",
            _ => "Full tune-up",
        };
        var includesBoot = s.IsEnabled(BenchmarkKind.BootTime);
        var enabledCount = s.Enabled.Count(Bench.IsKindAvailable);
        <section class="card bench-wizard-card" data-testid="bench-settings">
            <div class="bench-card-header-row">
                <div>
                    <strong>@catTitle — choose tests to include</strong>
                    <div class="meta">@enabledCount of @available.Count selected · @s.Runs @(s.Runs == 1 ? "run" : "runs") each · about @Minutes(s.EstimatedSeconds())</div>
                </div>
                <div class="bench-header-controls">
                    <label class="meta">Runs
                        <select data-testid="bench-runs" @onchange="SetRuns">
                            @foreach (var n in BenchmarkSettings.RunChoices) { <option value="@n" selected="@(n == s.Runs)">@n</option> }
                        </select>
                    </label>
                    <button type="button" class="linklike" data-testid="bench-change-category" @onclick="() => _setupCategory = null">← Change category</button>
                </div>
            </div>

            <div class="bench-kinds" style="margin-top:var(--space-6)">
                @foreach (var info in available)
                {
                    var k = info.Kind;
                    <label class="bench-kind" title="@info.ClientMeaning">
                        <input type="checkbox" data-testid="@BenchmarkTestRules.Control(k)" data-bench-test="@k"
                               data-enabled="@(s.IsEnabled(k) ? "true" : "false")" checked="@s.IsEnabled(k)" disabled="@running"
                               @onclick="() => Toggle(k, !s.IsEnabled(k))" @onclick:preventDefault="true" />
                        <span>
                            @info.Title
                            @if (k == BenchmarkKind.BootTime)
                            {
                                <span class="meta"> · restarts PC to measure fresh boot</span>
                            }
                        </span>
                    </label>
                }
            </div>

            @if (s.HasDeveloperKindEnabled)
            {
                <div class="bench-inline-field" style="margin-top:var(--space-6)">
                    <label for="bench-custom-solution" class="meta"><strong>Solution / project (optional):</strong></label>
                    <input id="bench-custom-solution"
                           type="text"
                           class="bench-input"
                           data-testid="bench-custom-solution"
                           value="@(s.CustomSolutionPath ?? string.Empty)"
                           @onchange="OnBaselineSolutionChanged"
                           placeholder="Leave blank for built-in C# benchmark, or paste path to .sln / .slnx / .csproj" />
                </div>
                <p class="notice" data-testid="bench-dev-warning" style="margin-top:var(--space-5)">@DeveloperScoring.BusyPcWarning</p>
            }

            <div class="bench-wizard-footer">
                @if (includesBoot)
                {
                    <span class="meta">Includes a Windows restart for Start-up time.</span>
                }
                else
                {
                    <span></span>
                }
                @StartButton(BenchmarkPhase.Before, includesBoot, true, includesBoot ? "Restart & Run Baseline →" : "Run Baseline Benchmark →")
            </div>
        </section>
    }
}

@* ===================== STAGE 2 / 4: RUNNING (DISTRACTION-FREE, FIXED HEIGHT) ===================== *@
else if (stage is "running-baseline" or "running-comparison")
{
    var runTitle = stage == "running-baseline" ? "Capturing baseline benchmark…" : "Applying changes & running comparison…";
    var liveLine = Bench.ExperimentRunning && !string.IsNullOrWhiteSpace(Bench.ExperimentStep)
        ? (Bench.Progress ?? Bench.ExperimentStep)
        : (Bench.Progress ?? "Starting…");
    <section class="card bench-running-card" data-testid="bench-live-progress">
        <div class="bench-running-pill">
            <span class="dot dot-running"></span>
            <span>Running — keep the PC idle for repeatable results</span>
        </div>
        <h2 class="bench-running-title">@runTitle</h2>
        @if (Bench.Settling is { } && Bench.SettleFraction is { } sf && Bench.SettleRemaining is { } rem && Bench.SettleTotal is { } total)
        {
            <p class="meta bench-running-line" data-testid="bench-settle-status">Letting Windows finish starting up… @BenchmarkService.FormatCountdown(rem) left</p>
            <div class="progress run-progress bench-running-bar" data-testid="bench-settle-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@((int)Math.Ceiling(total.TotalSeconds))" aria-valuenow="@((int)Math.Round(total.TotalSeconds - rem.TotalSeconds))">
                <div class="progress-bar" style="width:@($"{sf * 100:0.#}%")"></div>
            </div>
        }
        else
        {
            <p class="meta bench-running-line" data-testid="bench-progress">@liveLine</p>
            <div class="run-progress run-progress-indeterminate bench-running-bar" data-testid="bench-run-progress" aria-hidden="true"><div></div></div>
        }

        <div class="bench-progress-log" data-testid="bench-progress-log">
            @for (var i = 0; i < _progressLog.Count; i++)
            {
                var isLast = i == _progressLog.Count - 1;
                <div class="@(isLast ? "bench-log-current" : "meta")">@(isLast ? "▸" : "✓") @_progressLog[i]</div>
            }
        </div>

        <div class="bench-running-actions">
            <button type="button" class="btn btn-stop" data-testid="bench-stop" @onclick="Bench.Stop">Stop</button>
        </div>
    </section>
}

@* ===================== STAGE 2B: REVIEW & SAVE NEW BASELINE ===================== *@
else if (stage == "review-baseline" && before is not null)
{
    EnsureBaselineNameDefault(before);
    <section class="card bench-wizard-card" data-testid="bench-review-baseline">
        <div class="bench-inline-field">
            <label for="bench-baseline-name"><strong>Baseline:</strong></label>
            <input id="bench-baseline-name"
                   type="text"
                   class="bench-input"
                   data-testid="bench-baseline-name"
                   value="@_baselineNameInput"
                   @oninput="e => _baselineNameInput = e.Value?.ToString() ?? string.Empty"
                   placeholder="Name this baseline…" />
        </div>

        @{
            var beforeCautions = before.Conditions.FormatCautions();
        }
        @if (beforeCautions.Count > 0)
        {
            <p class="notice" data-testid="bench-conditions-warning" style="margin-top:var(--space-5)">@string.Join(" · ", beforeCautions)</p>
        }

        <div class="bench-wizard-footer">
            <div class="bench-btn-group">
                <button type="button" class="btn btn-secondary" data-testid="bench-rerun-baseline" @onclick="RerunBaselineAsync">
                    <Icon Name="refresh" Size="12" /> Re-run
                </button>
                <button type="button" class="btn btn-danger-outline" data-testid="bench-delete-unsaved" @onclick="DiscardUnsavedBaseline">
                    Delete
                </button>
            </div>
            <button type="button" class="btn btn-primary" data-testid="bench-save-baseline" @onclick="SaveBaselineAndContinue">
                Save &amp; Continue →
            </button>
        </div>
    </section>
}

@* ===================== STAGE 3: SELECT MODIFICATIONS ===================== *@
else if (stage == "modify" && before is not null)
{
    var activeGoal = BenchmarkGoals.Normalize(before.Goal ?? s.Goal) ?? BenchmarkGoals.TuneUp;
    var impCtx = Bench.GetImprovementContext();
    var allImprovements = BenchmarkImprovements.ForGoal(activeGoal, impCtx);
    var actionableImprovements = allImprovements.Where(i => !i.AlreadyApplied).ToList();
    var existingDevDriveRoot = activeGoal == BenchmarkGoals.Build && !string.IsNullOrWhiteSpace(impCtx.ExistingDevDriveRoot)
        ? impCtx.ExistingDevDriveRoot
        : null;
    var alreadyNotes = new List<string>();
    if (existingDevDriveRoot is not null)
        alreadyNotes.Add($"Dev Drive on {existingDevDriveRoot}");
    foreach (var applied in allImprovements.Where(i => i.AlreadyApplied))
        alreadyNotes.Add(string.IsNullOrWhiteSpace(applied.AlreadyAppliedNote) ? applied.Title : $"{applied.Title} ({applied.AlreadyAppliedNote})");

    var baselineSdkMajor = before.Get(BenchmarkKind.DeveloperCSharp)?.DeveloperBuild?.ToolchainMajor ?? impCtx.DotNetSdkMajorVersion;
    var showSdkOption = activeGoal == BenchmarkGoals.Build && hasDevEnv;
    var installedSdks = impCtx.InstalledDotNetSdkMajors ?? [];
    int? singleAltSdkMajor = baselineSdkMajor == 10 ? 11 : baselineSdkMajor == 11 ? 10 : null;
    var selectedImprovements = _manualChangesMode ? [] : actionableImprovements.Where(i => _selectedImprovements.Contains(i.Id)).ToList();
    var selectedDevDriveRoot = !_manualChangesMode && existingDevDriveRoot is not null && _useExistingDevDrive ? existingDevDriveRoot : null;
    int? selectedSdkTarget = _manualChangesMode || !showSdkOption
        ? null
        : singleAltSdkMajor is { } alt
            ? (_switchOtherSdk ? alt : null)
            : (_targetDotNetSdkMajor is 10 or 11 ? _targetDotNetSdkMajor : null);
    var afterSolutionClean = string.IsNullOrWhiteSpace(_afterSolutionPath) ? null : _afterSolutionPath.Trim();
    var baselineSolutionClean = string.IsNullOrWhiteSpace(s.CustomSolutionPath) ? null : s.CustomSolutionPath.Trim();
    var hasCustomSolution = afterSolutionClean is not null;
    var solutionChanged = !string.Equals(afterSolutionClean, baselineSolutionClean, StringComparison.OrdinalIgnoreCase);
    var totalSelected = selectedImprovements.Count
        + (selectedDevDriveRoot is not null ? 1 : 0)
        + (selectedSdkTarget is not null ? 1 : 0)
        + (solutionChanged ? 1 : 0);

    <section class="card bench-active-baseline-bar" data-testid="bench-active-baseline">
        <div class="bench-active-baseline-info">
            <span class="chip chip-na">Baseline</span>
            <strong>@(activeBaseline?.Name ?? BenchmarkService.SuggestRunName(before))</strong>
            <span class="meta">· @before.TimeUtc.ToLocalTime().ToString("g")</span>
        </div>
        @if (activeBaseline is not null)
        {
            <button type="button" class="btn-small btn-danger-outline" data-testid="bench-delete-baseline" @onclick="() => DeleteActiveBaseline(activeBaseline.Id)">Delete</button>
        }
    </section>

    <section class="card bench-wizard-card" data-testid="bench-improvements">
        <div class="bench-card-header-row">
            <div>
                <strong>Select modifications to test</strong>
                @if (alreadyNotes.Count > 0)
                {
                    <div class="meta" data-testid="bench-already-applied">Already in place: @string.Join(" · ", alreadyNotes)</div>
                }
                @if (activeGoal == BenchmarkGoals.Build && impCtx.HasUnmountedDevDrive && existingDevDriveRoot is null)
                {
                    <div class="notice" data-testid="bench-unmounted-devdrive" style="margin-top:var(--space-3)">
                        Dev Drive detected, but it has no drive letter assigned. Assign a drive letter (e.g. D:) in Windows Settings → System → Storage → Disks &amp; volumes → Properties to use it for builds and package caches.
                    </div>
                }
            </div>
            <label class="bench-kind meta">
                <input type="checkbox" data-testid="bench-manual-mode" checked="@_manualChangesMode" @onchange="() => _manualChangesMode = !_manualChangesMode" />
                <span>I made manual changes myself</span>
            </label>
        </div>

        @if (activeGoal == BenchmarkGoals.Build && hasDevEnv)
        {
            <div class="bench-inline-field" style="margin-top:var(--space-6)">
                <label for="bench-after-solution" class="meta"><strong>Solution / project:</strong></label>
                <input id="bench-after-solution"
                       type="text"
                       class="bench-input"
                       data-testid="bench-after-solution"
                       value="@_afterSolutionPath"
                       @oninput="e => _afterSolutionPath = e.Value?.ToString() ?? string.Empty"
                       placeholder="Built-in C# benchmark (or paste path to .sln / .slnx / .csproj)" />
            </div>
        }

        @if (_manualChangesMode)
        {
            <p class="meta" style="margin:var(--space-6) 0">No automatic changes will be applied. Clicking <strong>Run Comparison →</strong> measures the After pass directly against your baseline.</p>
        }
        else
        {
            <div class="bench-kinds" style="margin-top:var(--space-6)">
                @if (existingDevDriveRoot is not null && !hasCustomSolution)
                {
                    <label class="bench-kind" title="Runs the After build on your existing Dev Drive (@existingDevDriveRoot) without creating a new drive.">
                        <input type="checkbox"
                               data-testid="bench-use-devdrive"
                               checked="@_useExistingDevDrive"
                               @onchange="() => _useExistingDevDrive = !_useExistingDevDrive" />
                        <span>Use existing Dev Drive (@existingDevDriveRoot) for the comparison build <span class="meta">· no new drive created</span></span>
                    </label>
                }
                @foreach (var imp in actionableImprovements)
                {
                    var isChecked = _selectedImprovements.Contains(imp.Id);
                    <label class="bench-kind" title="@imp.Description">
                        <input type="checkbox"
                               data-testid="bench-imp-@imp.Id"
                               checked="@isChecked"
                               @onchange="() => ToggleImprovement(imp, actionableImprovements)" />
                        <span>
                            @imp.Title
                            @if (imp.Reversible)
                            {
                                <span class="meta"> · reversible</span>
                            }
                        </span>
                    </label>
                }
                @if (showSdkOption && singleAltSdkMajor is { } altMajor)
                {
                    var altInstalled = installedSdks.Contains(altMajor);
                    var altLabel = altMajor == 10 ? ".NET 10 LTS SDK" : ".NET 11 SDK";
                    <label class="bench-kind" title="Runs the comparison build on @altLabel (installed silently via Agent if missing).">
                        <input type="checkbox"
                               data-testid="bench-sdk-@altMajor"
                               checked="@_switchOtherSdk"
                               @onchange="() => _switchOtherSdk = !_switchOtherSdk" />
                        <span>Test on @altLabel <span class="meta">· @(altInstalled ? "installed" : "silent install if missing")</span></span>
                    </label>
                }
            </div>

            @if (showSdkOption && singleAltSdkMajor is null)
            {
                <div data-testid="bench-sdk-choice" style="margin-top:var(--space-6);padding-top:var(--space-5);border-top:1px solid var(--border)">
                    <div class="meta" style="margin-bottom:var(--space-3)"><strong>.NET SDK for comparison</strong></div>
                    <div class="bench-kinds" role="radiogroup" aria-label=".NET SDK for comparison">
                        <label class="bench-kind">
                            <input type="radio" name="bench-sdk-target" data-testid="bench-sdk-10" checked="@(_targetDotNetSdkMajor == 10)" @onchange="() => _targetDotNetSdkMajor = 10" />
                            <span>.NET 10 LTS SDK <span class="meta">@(installedSdks.Contains(10) ? "(installed)" : "(silent install)")</span></span>
                        </label>
                        <label class="bench-kind">
                            <input type="radio" name="bench-sdk-target" data-testid="bench-sdk-11" checked="@(_targetDotNetSdkMajor == 11)" @onchange="() => _targetDotNetSdkMajor = 11" />
                            <span>.NET 11 SDK <span class="meta">@(installedSdks.Contains(11) ? "(installed)" : "(silent install)")</span></span>
                        </label>
                    </div>
                </div>
            }
        }

        @if (Bench.LastExperiment is { Outcomes.Count: > 0 } prevExp && !prevExp.Completed)
        {
            <div data-testid="bench-experiment-summary" style="margin-top:var(--space-5)">
                <div class="meta"><strong>Last attempt:</strong></div>
                <ul class="meta" style="margin:var(--space-2) 0 0 var(--space-9);padding:0">
                    @foreach (var o in prevExp.Outcomes)
                    {
                        <li>@(o.Succeeded ? "✓" : o.Skipped ? "–" : "✗") <strong>@o.Title</strong> — @o.Message</li>
                    }
                </ul>
            </div>
        }

        <div class="bench-wizard-footer">
            <span class="meta">
                @(_manualChangesMode
                    ? "Ready to measure against your baseline."
                    : totalSelected == 0
                        ? (hasCustomSolution ? "Tweaked your solution? Click Run Comparison → or select modifications above." : "Select at least one modification above (or check manual changes).")
                        : $"{totalSelected} {(totalSelected == 1 ? "modification" : "modifications")} selected")
            </span>
            @if (_manualChangesMode)
            {
                @StartButton(BenchmarkPhase.After, s.IsEnabled(BenchmarkKind.BootTime), true, s.IsEnabled(BenchmarkKind.BootTime) ? "Restart & Run Comparison →" : "Run Comparison →")
            }
            else
            {
                <button type="button"
                        class="btn btn-primary"
                        data-testid="bench-run-experiment"
                        disabled="@((totalSelected == 0 && !hasCustomSolution) || s.Enabled.Count == 0)"
                        @onclick="() => RunComparisonAsync(selectedImprovements, selectedSdkTarget, selectedDevDriveRoot, afterSolutionClean)">
                    <Icon Name="play" Size="12" /> @(totalSelected == 0 ? "Run Comparison →" : $"Apply {totalSelected} & Run Comparison →")
                </button>
            }
        </div>
    </section>
}

@* ===================== STAGE 5: RESULTS ===================== *@
else if (stage == "results" && before is not null && after is not null)
{
    EnsureAfterNameDefault(after);
    var kind = cmp.OverallPercent switch { >= 2 => "ok", <= -2 => "err", _ => "na" };
    var condCautions = new List<string>();
    foreach (var c in before.Conditions.FormatCautions()) condCautions.Add($"Before: {c}");
    foreach (var c in after.Conditions.FormatCautions()) condCautions.Add($"After: {c}");

    <section class="card bench-results-card" data-testid="bench-results">
        <div class="bench-results-head" data-testid="bench-overall">
            <div class="bench-card-header-row">
                <h2 class="bench-verdict bench-verdict-@kind">@cmp.OverallText</h2>
                <span class="meta">Baseline: <strong>@(activeBaseline?.Name ?? BenchmarkService.SuggestRunName(before))</strong></span>
            </div>
            <div class="bench-inline-field" style="margin-top:var(--space-5)">
                <label for="bench-after-name"><strong>After:</strong></label>
                <input id="bench-after-name"
                       type="text"
                       class="bench-input"
                       data-testid="bench-after-name"
                       value="@_afterNameInput"
                       @oninput="e => _afterNameInput = e.Value?.ToString() ?? string.Empty"
                       placeholder="Name this result…" />
            </div>
        </div>

        @if (condCautions.Count > 0)
        {
            <p class="notice" data-testid="bench-conditions-warning" style="margin:var(--space-5) var(--space-8) 0">@string.Join(" · ", condCautions)</p>
        }
        @foreach (var w in cmp.Warnings)
        {
            <p class="notice" data-testid="bench-warning" style="margin:var(--space-4) var(--space-8) 0">@w</p>
        }

        <div class="table-scroll">
            <table class="detail grid bench-table" data-testid="bench-table">
                <tr><th scope="col">Test</th><th scope="col">Baseline</th><th scope="col">After</th><th scope="col">Change</th></tr>
                @foreach (var info in Benchmarks.All)
                {
                    var b = before.Get(info.Kind);
                    var a = after.Get(info.Kind);
                    if (b is null && a is null) continue;
                    var d = cmp.Deltas.FirstOrDefault(x => x.Info.Kind == info.Kind);
                    <tr data-testid="bench-row-@info.Kind.ToString().ToLowerInvariant()">
                        <td><strong>@info.Title</strong><div class="meta">@info.ClientMeaning</div></td>
                        <td>@Cell(info, b)</td>
                        <td>@Cell(info, a)</td>
                        <td>
                            @if (d is null) { <span class="meta">—</span> }
                            else
                            {
                                <span class="chip chip-@(d.Verdict switch { BenchmarkVerdict.Better => "ok", BenchmarkVerdict.Worse => "err", _ => "na" })">@d.ChangeSummary</span>
                                @if (d.Note is { } n) { <div class="meta">@n</div> }
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>

        @if (Bench.LastExperiment is { Outcomes.Count: > 0 } exp)
        {
            <div class="bench-results-meta" data-testid="bench-experiment-summary">
                <strong>Changes tested:</strong>
                @string.Join(" · ", exp.Outcomes.Select(o => $"{(o.Succeeded ? "✓" : o.Skipped ? "–" : "✗")} {o.Title}"))
            </div>
        }

        <div class="bench-results-meta" data-testid="bench-conditions">
            @RunLine("Baseline", before) · @RunLine("After", after)
        </div>

        @if (Uploader.Message is { } um)
        {
            <p class="@(Uploader.Failed ? "notice notice-error" : "notice")" data-testid="bench-upload-status"
               data-upload-seq="@Uploader.Seq" data-upload-failed="@(Uploader.Failed ? "true" : "false")" data-uploading="@(Uploader.Uploading ? "true" : "false")"
               style="margin:var(--space-4) var(--space-8) 0">@um</p>
        }

        <div class="bench-wizard-footer bench-results-footer">
            <div class="bench-btn-group">
                <button type="button" class="btn btn-secondary" data-testid="bench-toggle-undo" @onclick="() => _showUndo = !_showUndo">
                    @(_showUndo ? "Hide Undo" : "Undo changes…")
                </button>
                <button type="button" class="btn btn-danger-outline" data-testid="bench-delete-after" @onclick="DeleteAfterResult">
                    Delete
                </button>
            </div>
            <div class="bench-btn-group">
                @if (Uploader.CompareUrl is { } compareUrl)
                {
                    <a class="linklike" data-testid="bench-upload-link" href="@compareUrl" target="_blank" rel="noopener noreferrer">Open comparison →</a>
                }
                @* No relay or shop key here (and not a technician's browser): nowhere to upload to, so no button. *@
                @if (Uploader.CanUpload || _isRemoteDisplay)
                {
                    <button type="button" class="btn btn-secondary" data-testid="bench-upload"
                            disabled="@Uploader.Uploading"
                            @onclick="UploadResultsAsync">
                        <Icon Name="upload" Size="12" /> @(Uploader.Uploading ? "Uploading…" : "Upload to Admin")
                    </button>
                }
                <button type="button" class="btn btn-primary" data-testid="bench-save-after-baseline" @onclick="SaveAfterAsBaseline">
                    Save as Baseline →
                </button>
            </div>
        </div>
    </section>

    @if (_showUndo)
    {
        <UndoAllPanel />
    }
}

@code {
    private bool _isRemoteDisplay;
    private bool _forceSetup;
    private bool _newBaselineSelected;
    private string? _setupCategory;
    private bool _manualChangesMode;
    private bool _useExistingDevDrive;
    private bool _switchOtherSdk;
    private int? _targetDotNetSdkMajor;
    private bool _showUndo;
    private string _baselineNameInput = string.Empty;
    private DateTimeOffset? _namedBeforeUtc;
    private string _afterNameInput = string.Empty;
    private DateTimeOffset? _namedAfterUtc;
    private string _afterSolutionPath = string.Empty;
    private readonly HashSet<string> _selectedImprovements = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> _progressLog = [];

    protected override void OnInitialized()
    {
        Bench.Changed += OnChanged;
        Uploader.Changed += OnChanged;
        _afterSolutionPath = Bench.Settings.CustomSolutionPath ?? string.Empty;
    }

    protected override Task OnInitializedAsync() => Bench.RefreshDeveloperEnvironmentAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var remote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
            if (remote != _isRemoteDisplay)
            {
                _isRemoteDisplay = remote;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void OnChanged()
    {
        try
        {
            var line = Bench.Progress ?? Bench.ExperimentStep;
            if (!string.IsNullOrWhiteSpace(line) && (_progressLog.Count == 0 || !string.Equals(_progressLog[^1], line, StringComparison.Ordinal)))
            {
                _progressLog.Add(line);
                if (_progressLog.Count > 50) _progressLog.RemoveAt(0);
            }
            if (Bench.Running is null && Bench.Settling is null && !Bench.ExperimentRunning && !Bench.RunningDeveloperAction)
            {
                _forceSetup = false;
            }
            _ = InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose() { Bench.Changed -= OnChanged; Uploader.Changed -= OnChanged; }

    [SupplyParameterFromQuery(Name = "goal")] public string? GoalQuery { get; set; }
    private string? _appliedGoalQuery;

    protected override void OnParametersSet()
    {
        if (GoalQuery is { Length: > 0 } q && !string.Equals(q, _appliedGoalQuery, StringComparison.OrdinalIgnoreCase))
        {
            _appliedGoalQuery = q;
            var norm = BenchmarkGoals.Normalize(q);
            if (norm is not null && BenchmarkGoals.IsGoalAvailable(norm, Bench.AvailableBenchmarks.Select(b => b.Kind)))
            {
                _newBaselineSelected = true;
                SelectCategory(norm);
            }
        }
    }

    private void GoToBaselineSetup()
    {
        _forceSetup = true;
        _newBaselineSelected = Bench.SavedBaselines.Count == 0;
        _setupCategory = null;
        _showUndo = false;
    }

    private void GoToModify()
    {
        Bench.DiscardAfter();
        _forceSetup = false;
        _showUndo = false;
    }

    private void OnBaselineSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) return;
        if (val == "__new__")
        {
            _newBaselineSelected = true;
            _setupCategory = null;
            return;
        }
        if (Bench.LoadSavedBaseline(val))
        {
            _forceSetup = false;
            _newBaselineSelected = false;
            _setupCategory = null;
            ResetModificationSelections();
        }
    }

    private void SelectCategory(string goal)
    {
        var avail = Bench.AvailableBenchmarks.Select(b => b.Kind).ToList();
        if (!BenchmarkGoals.IsGoalAvailable(goal, avail)) return;
        var norm = BenchmarkGoals.Normalize(goal);
        var kinds = BenchmarkGoals.KindsFor(goal, avail);
        _setupCategory = norm;
        ResetModificationSelections();
        Bench.UpdateSettings(Bench.Settings with { Goal = norm, Enabled = [.. kinds] });
    }

    private void OnBaselineSolutionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim();
        var clean = string.IsNullOrWhiteSpace(val) ? null : val;
        _afterSolutionPath = clean ?? string.Empty;
        Bench.UpdateSettings(Bench.Settings with { CustomSolutionPath = clean });
    }

    private void ResetModificationSelections()
    {
        _selectedImprovements.Clear();
        _useExistingDevDrive = false;
        _switchOtherSdk = false;
        _targetDotNetSdkMajor = null;
        _manualChangesMode = false;
        _showUndo = false;
        _afterSolutionPath = Bench.Settings.CustomSolutionPath ?? string.Empty;
    }

    private void EnsureBaselineNameDefault(BenchmarkRun run)
    {
        if (_namedBeforeUtc != run.TimeUtc)
        {
            _namedBeforeUtc = run.TimeUtc;
            _baselineNameInput = BenchmarkService.SuggestRunName(run);
        }
    }

    private void EnsureAfterNameDefault(BenchmarkRun run)
    {
        if (_namedAfterUtc != run.TimeUtc)
        {
            _namedAfterUtc = run.TimeUtc;
            _afterNameInput = BenchmarkService.SuggestRunName(run);
        }
    }

    private void SaveBaselineAndContinue()
    {
        Bench.SaveCurrentBaseline(_baselineNameInput);
        _forceSetup = false;
        _newBaselineSelected = false;
        _setupCategory = null;
        ResetModificationSelections();
    }

    private void DiscardUnsavedBaseline()
    {
        Bench.Clear();
        _forceSetup = true;
        _newBaselineSelected = Bench.SavedBaselines.Count == 0;
        _setupCategory = null;
    }

    private Task RerunBaselineAsync()
    {
        _progressLog.Clear();
        return Bench.BeginPassAsync(BenchmarkPhase.Before, Bench.Settings.IsEnabled(BenchmarkKind.BootTime));
    }

    private void DeleteActiveBaseline(string id)
    {
        Bench.DeleteSavedBaseline(id);
        _forceSetup = true;
        _newBaselineSelected = Bench.SavedBaselines.Count == 0;
        _setupCategory = null;
        ResetModificationSelections();
    }

    private void DeleteAfterResult()
    {
        Bench.DiscardAfter();
        _showUndo = false;
    }

    private void SaveAfterAsBaseline()
    {
        Bench.SaveAfterAsBaseline(_afterNameInput);
        _showUndo = false;
        ResetModificationSelections();
    }

    private void ToggleImprovement(BenchmarkImprovement imp, IReadOnlyList<BenchmarkImprovement> all)
    {
        if (imp.AlreadyApplied) return;
        if (!_selectedImprovements.Add(imp.Id))
        {
            _selectedImprovements.Remove(imp.Id);
            if (string.Equals(imp.Id, BenchmarkImprovements.CreateDevDriveId, StringComparison.OrdinalIgnoreCase))
            {
                foreach (var dep in all.Where(x => x.RequiresDevDrive))
                    _selectedImprovements.Remove(dep.Id);
            }
        }
        else if (imp.RequiresDevDrive)
        {
            if (all.Any(x => string.Equals(x.Id, BenchmarkImprovements.CreateDevDriveId, StringComparison.OrdinalIgnoreCase) && !x.AlreadyApplied))
                _selectedImprovements.Add(BenchmarkImprovements.CreateDevDriveId);
        }
    }

    private Task RunComparisonAsync(IReadOnlyList<BenchmarkImprovement> selected, int? targetDotNetSdkMajor, string? afterBuildWorkRoot, string? afterCustomSolutionPath)
    {
        if (selected.Count == 0 && targetDotNetSdkMajor is null && string.IsNullOrWhiteSpace(afterBuildWorkRoot) && string.IsNullOrWhiteSpace(afterCustomSolutionPath))
            return Task.CompletedTask;
        _progressLog.Clear();
        _showUndo = false;
        return Bench.RunComparisonAsync(selected, targetDotNetSdkMajor: targetDotNetSdkMajor, afterBuildWorkRoot: afterBuildWorkRoot, afterCustomSolutionPath: afterCustomSolutionPath);
    }

    private void Toggle(BenchmarkKind k, bool on) =>
        Bench.UpdateSettings(Bench.Settings with { Enabled = BenchmarkTestRules.WithEnabled(Bench.Settings, k, on, Bench.IsKindAvailable(k)) });

    private void SetRuns(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) Bench.UpdateSettings(Bench.Settings with { Runs = n });
    }

    private Task UploadResultsAsync() =>
        Uploader.CanUpload ? Uploader.UploadAsync() : Uploader.UploadViaBrowserAsync(JS);

    private Task Start(BenchmarkPhase phase, bool restart)
    {
        _progressLog.Clear();
        _forceSetup = false;
        return Bench.BeginPassAsync(phase, restart);
    }

    private RenderFragment StartButton(BenchmarkPhase phase, bool restart, bool primary, string label) => __builder =>
    {
        var block = Bench.BlockFor(phase, restart);
        var pass = phase == BenchmarkPhase.Before ? "before" : "after";
        <button class="@(primary ? "btn btn-primary" : "btn-small")"
                data-testid="@BenchmarkStartRules.Control(phase, restart)"
                data-action="start-benchmark" data-pass="@pass" data-restart="@(restart ? "true" : "false")"
                data-blocked-setting="@block?.Setting" data-blocked-reason="@block?.Reason"
                disabled="@(block is not null)" title="@block?.Reason"
                @onclick="async () => await Start(phase, restart)">
            @if (primary)
            {
                <Icon Name="@(restart ? "refresh" : "play")" Size="12" />
            }
            @label
        </button>
    };

    private static string Minutes(int seconds) => seconds < 90 ? $"{seconds} s" : $"{Math.Round(seconds / 60.0, 1):0.#} min";

    private static RenderFragment Cell(BenchmarkInfo info, BenchmarkMeasurement? m) => __builder =>
    {
        if (m?.Median is { } v)
        {
            <span>@info.Show(v)</span>
            @if (m.Samples.Count > 1) { <div class="meta" title="@string.Join(", ", m.Samples.Select(x => info.Show(x)))">@m.Samples.Count runs · @((m.Spread * 100).ToString("0"))% spread</div> }
            @if (m.Detail is { } detail) { <div class="meta">@detail</div> }
        }
        else { <span class="meta">@(m?.Note ?? "—")</span> }
    };

    private static string RunLine(string label, BenchmarkRun r) =>
        $"{label}: {r.TimeUtc.ToLocalTime():g}{Conditions(r.Conditions)}{(r.Completed ? "" : " · stopped early")}";

    private static string Conditions(BenchmarkConditions c)
    {
        var power = c.PowerMode is { Length: > 0 } m
            ? (c.PowerPlan is { Length: > 0 } p && !string.Equals(m, p, StringComparison.OrdinalIgnoreCase) ? $" · {m} ({p} plan)" : $" · {m}")
            : (c.PowerPlan is { Length: > 0 } p2 ? $" · {p2} plan" : "");
        return (c.OnBattery is { } b ? (b ? " · on battery" : " · plugged in") : "") + (c.CpuTemperatureC is { } t ? $" · CPU {t:0}°C" : "") + power;
    }
}
