@page "/benchmark"
@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Benchmarks
@using RemotePCDiagnostics.Core.Workflow
@implements IDisposable
@inject BenchmarkService Bench
@inject AppServices App
@inject ISessionContext Session
@inject BenchmarkUploader Uploader
@inject IJSRuntime JS
@* Before/after performance benchmarks for a service call: shows the client what the fixes actually changed. *@
@{
    var s = Bench.Settings;
    var running = Bench.Running is not null || Bench.Settling is not null || Bench.RunningDeveloperAction;
    var cmp = Bench.Comparison;
    var before = Bench.Before;
    var after = Bench.After;
    var available = Bench.AvailableBenchmarks;
}
<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="health" Size="20" /></span><h1 data-rpcd-page="benchmark" data-rpcd-contract="@BrowserContract.Benchmark" data-testid="bench-title">Performance benchmark</h1>
</div>
<p class="meta">Quick standalone performance snapshots to verify manual changes. Running a full automated tune-up?
    <a href="/workflow">Use Service workflow →</a></p>

<section class="card bench-hero" data-testid="bench-hero">
    <div class="bench-hero-main">
        <div class="bench-hero-title">
            @(before is null
                ? "Take a performance snapshot"
                : after is null
                    ? "Baseline captured — take next snapshot to compare"
                    : "Comparison ready")
        </div>
        <label class="bench-restart-toggle">
            @* Read-only: the start buttons below choose, and the choice is saved once that pass starts. *@
            <input type="checkbox" data-testid="bench-restart" checked="@s.RestartBeforeAfter" disabled aria-readonly="true"
                   title="Set by the button you start a pass with" />
            <span>Restart the PC first (needed for a fair start-up time). The button you start with sets this.</span>
        </label>
    </div>
    <div class="bench-hero-actions">
        @if (running)
        {
            <button class="btn btn-stop" data-testid="bench-stop" @onclick="Bench.Stop">Stop</button>
        }
        else if (before is null)
        {
            @if (s.RestartBeforeAfter)
            {
                @StartButton(BenchmarkPhase.Before, true, true, "Restart & Run Snapshot")
            }
            else
            {
                @StartButton(BenchmarkPhase.Before, false, true, "Run Benchmark Snapshot")
            }
            @StartButton(BenchmarkPhase.Before, !s.RestartBeforeAfter, false, s.RestartBeforeAfter ? "Run Benchmark Snapshot" : "Restart & Run Snapshot")
        }
        else
        {
            @if (s.RestartBeforeAfter)
            {
                @StartButton(BenchmarkPhase.After, true, true, after is null ? "Restart & Run Next Snapshot" : "Restart & Re-run After")
                @StartButton(BenchmarkPhase.Before, true, false, "Re-run baseline")
            }
            else
            {
                @StartButton(BenchmarkPhase.After, false, true, after is null ? "Run Next Snapshot" : "Re-run After")
                @StartButton(BenchmarkPhase.Before, false, false, "Re-run baseline")
            }
            <button class="btn-small" data-testid="bench-clear" @onclick="Bench.Clear">Start over</button>
            @StartButton(BenchmarkPhase.After, !s.RestartBeforeAfter, false, s.RestartBeforeAfter
                ? (after is null ? "Run Next Snapshot" : "Re-run After")
                : (after is null ? "Restart & Run Next Snapshot" : "Restart & Re-run After"))
            @StartButton(BenchmarkPhase.Before, !s.RestartBeforeAfter, false, s.RestartBeforeAfter ? "Re-run baseline without restart" : "Restart and re-run baseline")
        }
    </div>
</section>

@{
    var hasDevEnv = Bench.IsKindAvailable(BenchmarkKind.DeveloperCSharp);
    var activeGoal = BenchmarkGoals.Normalize(s.Goal);
    var latestRun = BenchmarkUpload.LatestRun(before, after);
    var currentPowerMode = latestRun?.Conditions.PowerMode ?? latestRun?.Conditions.PowerPlan;
}
<section class="card" data-testid="bench-goals" style="margin-bottom:12px">
    <div class="bench-presets" style="margin:0">
        <div class="bench-preset-group" role="tablist" aria-label="Benchmark goal preset">
            <button type="button"
                    class="@(activeGoal is null or BenchmarkGoals.TuneUp ? "btn-small btn-primary" : "btn-small")"
                    data-testid="bench-goal-tuneup"
                    disabled="@running"
                    @onclick="() => ApplyGoalPreset(BenchmarkGoals.TuneUp)">
                Full tune-up
            </button>
            <button type="button"
                    class="@(activeGoal == BenchmarkGoals.Browsing ? "btn-small btn-primary" : "btn-small")"
                    data-testid="bench-goal-browsing"
                    disabled="@running"
                    @onclick="() => ApplyGoalPreset(BenchmarkGoals.Browsing)">
                Web browsing
            </button>
            @if (hasDevEnv)
            {
                <button type="button"
                        class="@(activeGoal == BenchmarkGoals.Build ? "btn-small btn-primary" : "btn-small")"
                        data-testid="bench-goal-build"
                        disabled="@running"
                        @onclick="() => ApplyGoalPreset(BenchmarkGoals.Build)">
                    Build speed
                </button>
            }
        </div>
        <span class="meta" data-testid="bench-goal-context">
            @if (activeGoal == BenchmarkGoals.Browsing)
            {
                <span>DNS lookup &amp; Speedometer@(currentPowerMode is { Length: > 0 } pm ? $" · {pm}" : "") · <a href="/checks">Network &amp; Wi-Fi →</a> · <a href="/stress">Bufferbloat test →</a></span>
            }
            else if (activeGoal == BenchmarkGoals.Build && hasDevEnv)
            {
                <span>C# clean build &amp; disk latency@(currentPowerMode is { Length: > 0 } pm2 ? $" · {pm2}" : "") · <a href="/checks">Dev Drive &amp; setup →</a></span>
            }
            else
            {
                <span>Before / After tune-up suite@(currentPowerMode is { Length: > 0 } pm3 ? $" · {pm3}" : "") · customize tests under Advanced below</span>
            }
        </span>
    </div>
</section>

<details class="card bench-customize" data-testid="bench-settings" open="@_customizeOpen">
    @* The click saves the open state, so a view-only mirror and a controlling mirror show the same panel the start buttons do. *@
    <summary class="bench-customize-summary" data-testid="bench-settings-toggle" aria-expanded="@(_customizeOpen ? "true" : "false")"
             @onclick="ToggleCustomize" @onclick:preventDefault="true">
        <span class="bench-customize-title">
            <span class="bench-customize-caret" aria-hidden="true">▸</span>
            <span>Advanced: customize tests</span>
            <span class="meta">(@s.Enabled.Count(Bench.IsKindAvailable) of @available.Count selected · @s.Runs @(s.Runs == 1 ? "run" : "runs") each · about @Minutes(s.EstimatedSeconds()))</span>
        </span>
    </summary>
    <div class="bench-customize-body">
        <div class="bench-presets">
            <div class="bench-preset-group">
                <button type="button" class="btn-small" data-testid="bench-preset-standard" disabled="@running" @onclick="ApplyStandardPreset">Standard (All · 3 runs)</button>
                <button type="button" class="btn-small" data-testid="bench-preset-quick" disabled="@running" @onclick="ApplyQuickPreset">Quick (Core · 1 run)</button>
                <button type="button" class="btn-small" data-testid="bench-select-all" disabled="@running" @onclick="() => Bench.UpdateSettings(s with { Goal = BenchmarkGoals.TuneUp, Enabled = available.Select(i => i.Kind).ToList() })">Select all</button>
                <button type="button" class="btn-small" data-testid="bench-select-none" disabled="@running" @onclick="() => Bench.UpdateSettings(s with { Goal = null, Enabled = [] })">Select none</button>
            </div>
            <label class="meta">Runs per test
                <select data-testid="bench-runs" disabled="@running" @onchange="SetRuns">
                    @foreach (var n in BenchmarkSettings.RunChoices) { <option value="@n" selected="@(n == s.Runs)">@n</option> }
                </select>
            </label>
        </div>
        <div class="bench-kinds">
            @foreach (var info in available)
            {
                var k = info.Kind;
                <label class="bench-kind" title="@info.ClientMeaning">
                    @* Click saves the enabled list (UpdateSettings). preventDefault keeps the box on that saved value until the redraw. *@
                    <input type="checkbox" data-testid="@BenchmarkTestRules.Control(k)" data-bench-test="@k"
                           data-enabled="@(s.IsEnabled(k) ? "true" : "false")" checked="@s.IsEnabled(k)" disabled="@running"
                           @onclick="() => Toggle(k, !s.IsEnabled(k))" @onclick:preventDefault="true" /> @info.Title
                </label>
            }
        </div>
        @if (s.HasDeveloperKindEnabled)
        {
            <p class="notice" data-testid="bench-dev-warning">@DeveloperScoring.BusyPcWarning</p>
        }
    </div>
</details>

@if (Bench.IsKindAvailable(BenchmarkKind.DeveloperCSharp))
{
    <section class="card" data-testid="bench-dev-comparisons">
        <div class="card-head"><strong>Developer comparisons (opt-in, one approval per run)</strong></div>
        <p class="meta">@DeveloperScoring.BusyPcWarning</p>
        <div class="bench-hero-actions">
            <label class="bench-restart-toggle">
                <input type="checkbox" data-testid="bench-dev-av-confirm" @bind="_confirmAvRun" disabled="@running" />
                <span>Approve temporary Defender exclusion on the RPCD build temp folder for this run</span>
            </label>
            <button type="button" class="btn-small" data-testid="bench-dev-av-run" disabled="@(running || !_confirmAvRun)" @onclick="RunAvComparison">
                Measure antivirus cost (C#)
            </button>
        </div>
        @if (Bench.LastAntivirusComparison is { } avRes)
        {
            <p class="meta" data-testid="bench-dev-av-result">@avRes.FormatDetail()</p>
        }
        @if (Bench.DevDrivePrecheck is { Eligible: true })
        {
            <div class="bench-hero-actions">
                <label class="bench-restart-toggle">
                    <input type="checkbox" data-testid="bench-dev-devdrive-confirm" @bind="_confirmDevDriveRun" disabled="@running" />
                    <span>Approve temporary ~50 GB Dev Drive VHDX (created &amp; removed by Agent) for this run</span>
                </label>
                <button type="button" class="btn-small" data-testid="bench-dev-devdrive-run" disabled="@(running || !_confirmDevDriveRun)" @onclick="RunDevDriveComparison">
                    Compare NTFS vs Dev Drive (C#)
                </button>
                <button type="button" class="btn-small btn-primary" data-testid="bench-dev-combined-run" disabled="@(running || !_confirmAvRun || !_confirmDevDriveRun)" @onclick="RunCombinedComparison"
                        title="@((!_confirmAvRun || !_confirmDevDriveRun) ? "Approve both Defender exclusion and temporary Dev Drive above to compare all four" : "Compare NTFS, NTFS + Defender exclusion, Dev Drive, and Dev Drive + Defender exclusion in one pass")">
                    Compare all four (NTFS vs AV excl vs Dev Drive vs Dev Drive + AV excl)
                </button>
            </div>
        }
        else if (Bench.DevDrivePrecheck is { Reason: { Length: > 0 } ddReason })
        {
            <p class="meta" data-testid="bench-dev-devdrive-note">Dev Drive comparison unavailable: @ddReason</p>
        }
        @if (Bench.RunningDeveloperAction)
        {
            var devPct = Bench.DeveloperActionFraction is { } f ? Math.Clamp(f * 100.0, 0, 100) : (double?)null;
            <div class="notice" data-testid="bench-dev-running" style="margin-top: 10px">
                <span class="dash-spin" aria-hidden="true"><Icon Name="refresh" Size="14" /></span>
                <span class="meta" data-testid="bench-dev-progress-text">@(Bench.Progress ?? "Running developer comparison…")@(devPct is { } p ? $" ({p:0}%)" : "")</span>
                <button type="button" class="btn-small" data-testid="bench-dev-cancel" @onclick="Bench.Stop">Cancel</button>
            </div>
            @if (devPct is { } barPct)
            {
                <div class="progress wf-overall-progress" style="max-width:none;margin:6px 0 0" data-testid="bench-dev-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(barPct))">
                    <div style="width:@($"{barPct:0.#}%")"></div>
                </div>
            }
            else
            {
                <div class="run-progress run-progress-indeterminate" data-testid="bench-dev-progress" aria-hidden="true"><div></div></div>
            }
        }
        @if (Bench.LastDevDriveComparison is { } ddRes)
        {
            <p class="meta" data-testid="bench-dev-devdrive-result">@ddRes.FormatSummary()</p>
        }
    </section>
}

@if (before is not null && !running) { <UndoAllPanel /> }

@if (Bench.Running is not null)
{
    <p class="status-line is-running" data-testid="bench-progress"><span class="dot dot-running"></span>@(Bench.Running == BenchmarkPhase.Before ? "Before" : "After"): @(Bench.Progress ?? "Starting…")<span class="running-badge" data-testid="running-badge"><span class="running-badge-dot"></span>Running</span></p>
    <div class="run-progress run-progress-indeterminate" data-testid="bench-run-progress" aria-hidden="true"><div></div></div>
    <div class="cards">
        <div class="card is-running card-with-visual" data-testid="bench-live-progress">
            <div class="card-main">
                <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                <div class="headline">@(Bench.Running == BenchmarkPhase.Before ? "Before benchmark" : "After benchmark")</div>
                <div class="meta">@(Bench.Progress ?? "Starting…")</div>
            </div>
            <TestRunningVisual Slug="benchmark" TestId="bench-visual" />
        </div>
    </div>
}
else if (Bench.Settling is { } settlePhase && Bench.SettleFraction is { } sf && Bench.SettleRemaining is { } rem && Bench.SettleTotal is { } total)
{
    <p class="status-line is-running" data-testid="bench-settle-status"><span class="dot dot-running"></span>@(settlePhase == BenchmarkPhase.Before ? "Before" : "After"): Letting Windows finish starting up…<span class="running-badge" data-testid="bench-settle-countdown"><span class="running-badge-dot"></span>@BenchmarkService.FormatCountdown(rem) left</span></p>
    <div class="progress run-progress" data-testid="bench-settle-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@((int)Math.Ceiling(total.TotalSeconds))" aria-valuenow="@((int)Math.Round(total.TotalSeconds - rem.TotalSeconds))">
        <div class="progress-bar" style="width:@($"{sf * 100:0.#}%")"></div>
    </div>
}
<AgentData TestId="bench-report-data" Json="@RemotePCDiagnostics.Core.Areas.AgentExports.Benchmark(Bench)" />
@if (Bench.Message is { } msg) { <p class="notice" data-testid="bench-message">@msg</p> }
@{
    var condCautions = new List<string>();
    if (before is not null)
        foreach (var c in before.Conditions.FormatCautions())
            condCautions.Add(after is not null ? $"Before: {c}" : c);
    if (after is not null)
        foreach (var c in after.Conditions.FormatCautions())
            condCautions.Add($"After: {c}");
}
@if (condCautions.Count > 0)
{
    <p class="notice" data-testid="bench-conditions-warning">@string.Join(" · ", condCautions)</p>
}

@if (before is not null && after is not null)
{
    var kind = cmp.OverallPercent switch { >= 2 => "ok", <= -2 => "err", _ => "na" };
    <section class="banner banner-@(kind == "ok" ? "ok" : kind == "err" ? "warn" : "run") bench-overall" data-testid="bench-overall">
        <span class="banner-icon"><Icon Name="health" Size="24" /></span>
        <div class="banner-text">
            <div class="banner-title">@cmp.OverallText</div>
            <div class="banner-sub">@cmp.Deltas.Count(d => d.Verdict == BenchmarkVerdict.Better) better · @cmp.Deltas.Count(d => d.Verdict == BenchmarkVerdict.NoChange) unchanged · @cmp.Deltas.Count(d => d.Verdict == BenchmarkVerdict.Worse) worse · @cmp.Deltas.Count(d => d.Verdict == BenchmarkVerdict.Uncertain) need confirmation
                — weighted across the tests below; unconfirmed changes count as neutral in the overall score.</div>
        </div>
    </section>
    @foreach (var w in cmp.Warnings) { <p class="notice" data-testid="bench-warning">@w</p> }
}

@if (before is not null)
{
    <div class="table-scroll">
    <table class="detail grid bench-table" data-testid="bench-table">
        <tr><th scope="col">Test</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr>
        @foreach (var info in Benchmarks.All)
        {
            var b = before.Get(info.Kind);
            var a = after?.Get(info.Kind);
            if (b is null && a is null) continue;
            var d = cmp.Deltas.FirstOrDefault(x => x.Info.Kind == info.Kind);
            <tr data-testid="bench-row-@info.Kind.ToString().ToLowerInvariant()">
                <td><strong>@info.Title</strong><div class="meta">@info.ClientMeaning</div></td>
                <td>@Cell(info, b)</td>
                <td>@if (after is null) { <span class="meta">—</span> } else { @Cell(info, a) }</td>
                <td>
                    @if (d is null || after is null) { <span class="meta">—</span> }
                    else
                    {
                        <span class="chip chip-@(d.Verdict switch { BenchmarkVerdict.Better => "ok", BenchmarkVerdict.Worse => "err", _ => "na" })">
                            @d.ChangeSummary</span>
                        @if (d.Note is { } n) { <div class="meta">@n</div> }
                    }
                </td>
            </tr>
        }
    </table>
    </div>
    <p class="meta" data-testid="bench-conditions">@RunLine("Before", before)
        @if (after is not null) { <br />@RunLine("After", after) }</p>

    <section class="card bench-upload" data-testid="bench-upload-card">
        <div class="card-head"><strong>Compare with other computers</strong></div>
        <p class="meta">Uploads the @(after is null ? "baseline" : "latest (after)") results with this PC's model, processor, memory and graphics card to your shop's Admin site,
            where your computers are ranked side by side for each test.</p>
        <div class="bench-hero-actions">
            <button class="btn-small" data-testid="bench-upload" disabled="@(running || Uploader.Uploading || !(Uploader.CanUpload || _isRemoteDisplay))" @onclick="UploadResultsAsync">
                <Icon Name="upload" Size="12" /> @(Uploader.Uploading ? "Uploading…" : "Upload results")</button>
            @if (Uploader.CompareUrl is { } compareUrl)
            {
                <a class="linklike" data-testid="bench-upload-link" href="@compareUrl" target="_blank" rel="noopener noreferrer">Open the comparison →</a>
            }
        </div>
        @if (Uploader.Message is { } um)
        {
            <p class="@(Uploader.Failed ? "notice notice-error" : "notice")" data-testid="bench-upload-status"
               data-upload-seq="@Uploader.Seq" data-upload-failed="@(Uploader.Failed ? "true" : "false")" data-uploading="@(Uploader.Uploading ? "true" : "false")">@um</p>
        }
    </section>
}
else if (!running)
{
    <p class="status-line" data-testid="bench-empty">No snapshot yet. Click the button above to capture a baseline, then run another snapshot after changes to compare.</p>
}

@code {
    private static readonly BenchmarkKind[] QuickCoreKinds =
    [
        BenchmarkKind.MemoryUsedMb,
        BenchmarkKind.IdleCpu,
        BenchmarkKind.CpuMulti,
        BenchmarkKind.DiskLatency,
        BenchmarkKind.EnabledStartupApps,
    ];

    private bool _customizeOpen;
    private bool _confirmAvRun;
    private bool _confirmDevDriveRun;
    private bool _isRemoteDisplay;

    protected override void OnInitialized() { Bench.Changed += OnChanged; Uploader.Changed += OnChanged; }
    protected override Task OnInitializedAsync() => Bench.RefreshDeveloperEnvironmentAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var remote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
            if (remote != _isRemoteDisplay)
            {
                _isRemoteDisplay = remote;
                StateHasChanged();
            }
        }
        catch { }
    }

    private Task UploadResultsAsync() =>
        Uploader.CanUpload ? Uploader.UploadAsync() : Uploader.UploadViaBrowserAsync(JS);
    private void OnChanged() { try { _ = InvokeAsync(StateHasChanged); } catch { } }
    public void Dispose() { Bench.Changed -= OnChanged; Uploader.Changed -= OnChanged; }

    [SupplyParameterFromQuery(Name = "goal")] public string? GoalQuery { get; set; }
    private string? _appliedGoalQuery;

    protected override void OnParametersSet()
    {
        if (GoalQuery is { Length: > 0 } q && !string.Equals(q, _appliedGoalQuery, StringComparison.OrdinalIgnoreCase))
        {
            _appliedGoalQuery = q;
            var norm = BenchmarkGoals.Normalize(q);
            if (norm is not null && BenchmarkGoals.IsGoalAvailable(norm, Bench.AvailableBenchmarks.Select(b => b.Kind)))
                ApplyGoalPreset(norm);
        }
    }

    private void ApplyGoalPreset(string goal)
    {
        var avail = Bench.AvailableBenchmarks.Select(b => b.Kind).ToList();
        if (!BenchmarkGoals.IsGoalAvailable(goal, avail)) return;
        var kinds = BenchmarkGoals.KindsFor(goal, avail);
        Bench.UpdateSettings(Bench.Settings with { Goal = BenchmarkGoals.Normalize(goal), Enabled = [.. kinds] });
    }

    private void ApplyStandardPreset() =>
        Bench.UpdateSettings(Bench.Settings with { Goal = BenchmarkGoals.TuneUp, Enabled = [.. Benchmarks.DefaultEnabled], Runs = 3 });

    private void ApplyQuickPreset() =>
        Bench.UpdateSettings(Bench.Settings with { Goal = null, Enabled = [.. QuickCoreKinds], Runs = 1 });

    private void RunAvComparison()
    {
        if (!_confirmAvRun) return;
        _confirmAvRun = false; // one explicit yes per run; never remembered
        _ = Bench.RunAntivirusComparisonAsync(userConfirmed: true);
    }

    private void RunDevDriveComparison()
    {
        if (!_confirmDevDriveRun) return;
        _confirmDevDriveRun = false; // one explicit yes per run; never remembered
        _ = Bench.RunDevDriveComparisonAsync(userConfirmed: true);
    }

    private void RunCombinedComparison()
    {
        if (!_confirmAvRun || !_confirmDevDriveRun) return;
        _confirmAvRun = false;
        _confirmDevDriveRun = false; // one explicit yes per run; never remembered
        _ = Bench.RunDevDriveComparisonAsync(userConfirmed: true, includeAntivirusComparison: true);
    }

    private void ToggleCustomize() => _customizeOpen = !_customizeOpen;

    private void Toggle(BenchmarkKind k, bool on) =>
        Bench.UpdateSettings(Bench.Settings with { Goal = null, Enabled = BenchmarkTestRules.WithEnabled(Bench.Settings, k, on, Bench.IsKindAvailable(k)) });

    private void SetRuns(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) Bench.UpdateSettings(Bench.Settings with { Runs = n });
    }

    private Task Start(BenchmarkPhase phase, bool restart) => Bench.BeginPassAsync(phase, restart);

    private RenderFragment StartButton(BenchmarkPhase phase, bool restart, bool primary, string label) => __builder =>
    {
        var block = Bench.BlockFor(phase, restart);
        var pass = phase == BenchmarkPhase.Before ? "before" : "after";
        <button class="@(primary ? "btn btn-primary" : "btn-small")"
                data-testid="@BenchmarkStartRules.Control(phase, restart)"
                data-action="start-benchmark" data-pass="@pass" data-restart="@(restart ? "true" : "false")"
                data-blocked-setting="@block?.Setting" data-blocked-reason="@block?.Reason"
                disabled="@(block is not null)" title="@block?.Reason"
                @onclick="async () => await Start(phase, restart)">
            @if (primary)
            {
                <Icon Name="@(restart ? "refresh" : "play")" Size="12" />
            }
            @label
        </button>
    };

    private static string Minutes(int seconds) => seconds < 90 ? $"{seconds} s" : $"{Math.Round(seconds / 60.0, 1):0.#} min";

    private static RenderFragment Cell(BenchmarkInfo info, BenchmarkMeasurement? m) => __builder =>
    {
        if (m?.Median is { } v)
        {
            <span>@info.Show(v)</span>
            @if (m.Samples.Count > 1) { <div class="meta" title="@string.Join(", ", m.Samples.Select(x => info.Show(x)))">@m.Samples.Count runs · @((m.Spread * 100).ToString("0"))% full range</div> }
            @if (m.Detail is { } detail) { <div class="meta">@detail</div> }
        }
        else { <span class="meta">@(m?.Note ?? "—")</span> }
    };

    private static string RunLine(string label, BenchmarkRun r) =>
        $"{label}: {r.TimeUtc.ToLocalTime():g}{Conditions(r.Conditions)}{(r.Completed ? "" : " · stopped early")}";

    private static string Conditions(BenchmarkConditions c)
    {
        var power = c.PowerMode is { Length: > 0 } m
            ? (c.PowerPlan is { Length: > 0 } p && !string.Equals(m, p, StringComparison.OrdinalIgnoreCase) ? $" · {m} ({p} plan)" : $" · {m}")
            : (c.PowerPlan is { Length: > 0 } p2 ? $" · {p2} plan" : "");
        return (c.OnBattery is { } b ? (b ? " · on battery" : " · plugged in") : "") + (c.CpuTemperatureC is { } t ? $" · CPU {t:0}°C" : "") + power;
    }
}
