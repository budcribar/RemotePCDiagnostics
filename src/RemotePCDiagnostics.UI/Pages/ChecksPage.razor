@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.Checks
@page "/checks"
@page "/stress"
@using Microsoft.JSInterop
@inherits StoreAwareComponent
@inject ChecksScreenState Screen
@inject IJSRuntime JS
@inject RemotePCDiagnostics.Core.History.IHistoryStore History
@inject NavigationManager Nav
@inject AppServices App
@* Two pages share this screen: /checks (read-only system checks) and /stress (stress tests, audio, webcam, NPU). The list is on the left,
   the selected test's real page on the right. *@
@{
    var summary = DashboardSummary.Build(Diagnostics.Modules.Select(m => { var r = Store.Get(m.Name); return new BannerModule(m.Name, m.DisplayName, !m.IncludeInRunAll, m is IStressSuiteModule, r.Status, r.Message, r.Cancelled, CheckEnableRules.IsTurnedOff(r)); }), Diagnostics.LastStressSuiteProgress);
    // Only this page's tests count: the auto-run sensor and inventory checks alone don't make the Stress tests page say "healthy".
    var anyResult = Screen.Modules(_group).Any(m => { var r = Store.Get(m.Name); return r.Status is not (DiagnosticStatus.NotRun or DiagnosticStatus.Running) && !CheckEnableRules.IsTurnedOff(r); });
    var banner = ChecksBanner.Build(summary, Screen.Progress, anyResult, _group == CheckGroup.Stress ? "No tests run in this session" : "Not checked yet");
    var selected = Screen.SelectedIn(_group);
    var checkChoices = _group == CheckGroup.Checks ? Diagnostics.CheckChoices() : [];
    var availableChecks = checkChoices.Where(c => c.Available).ToList();
    var enabledChecks = availableChecks.Count(c => c.Enabled);
}
<div class="ct-page">
    <div class="toolbar"><span class="icon-badge page-icon"><Icon Name="dash" Size="20" /></span><h1 data-rpcd-page="@(_group == CheckGroup.Stress ? "stress" : "checks")" data-rpcd-contract="@(_group == CheckGroup.Stress ? BrowserContract.Stress : BrowserContract.Checks)" data-testid="checks-title">@(_group == CheckGroup.Stress ? "Stress tests" : "Checks")</h1>
        <span class="ct-expand-group">
            <button class="btn-small" data-testid="checks-expand-all" @onclick="() => Screen.SetAllCollapsed(false)">Expand all</button>
            <button class="btn-small" data-testid="checks-collapse-all" @onclick="() => Screen.SetAllCollapsed(true)">Collapse all</button>
        </span>
    </div>
    @if (_group == CheckGroup.Stress || Screen.Progress is not null)
    {
    <section class="banner banner-@banner.Kind ct-banner" data-testid="checks-banner">
        <span class="banner-icon"><Icon Name="@(banner.Kind is "warn" or "err" ? "crash" : "sec")" Size="22" /></span>
        <div class="banner-text">
            <div class="banner-title" data-testid="checks-banner-title">@banner.Title</div>
            @if (Screen.Progress is null && Screen.LastRunNote is { } runNote) { <div class="banner-note" data-testid="checks-run-note">@runNote</div> }
            @if (Screen.Progress is null && _group == CheckGroup.Stress && summary.StressNotRunNote is { } note) { <div class="banner-note">@note</div> }
            else if (Screen.Progress is null) { <div class="banner-sub">Expand a group or click a test to see its full results on the right.</div> }
        </div>
    </section>
    }
    else if (Screen.LastRunNote is { } lastRunNote)
    {
        <p class="meta" data-testid="checks-run-note">@lastRunNote</p>
    }

    @if (_group == CheckGroup.Stress)
    {
        <AgentData TestId="stress-data" Json="@StressJson()" />
    }
    else
    {
        <AgentData TestId="checks-report-data" Json="@AgentExports.CheckEnablement(checkChoices)" />
        <details class="card bench-customize" data-testid="checks-settings" open="@_checksOpen">
            @* The click saves the open state, so a view-only mirror and a controlling mirror show the same panel the start buttons do. *@
            <summary class="bench-customize-summary" data-testid="checks-settings-toggle" aria-expanded="@(_checksOpen ? "true" : "false")"
                     @onclick="ToggleChecksPanel" @onclick:preventDefault="true">
                <span class="bench-customize-title">
                    <span class="bench-customize-caret" aria-hidden="true">▸</span>
                    <span>Which checks run</span>
                    <span class="meta">(@enabledChecks of @availableChecks.Count on)</span>
                </span>
            </summary>
            <div class="bench-customize-body">
                <div class="bench-preset-group">
                    <button type="button" class="btn-small" data-testid="checks-enable-all" disabled="@ChecksLocked" @onclick="() => SetAllChecks(true)">Enable all</button>
                    <button type="button" class="btn-small" data-testid="checks-disable-all" disabled="@ChecksLocked" @onclick="() => SetAllChecks(false)">Disable all</button>
                </div>
                <div class="bench-kinds">
                    @foreach (var choice in availableChecks)
                    {
                        var check = choice;
                        <label class="bench-kind">
                            @* Click saves the enabled set. preventDefault keeps the box on that saved value until the redraw. *@
                            <input type="checkbox" data-testid="@CheckEnableRules.Control(check.Id)" data-check-id="@check.Id"
                                   data-enabled="@(check.Enabled ? "true" : "false")" data-available="true" checked="@check.Enabled" disabled="@ChecksLocked"
                                   @onclick="() => ToggleCheck(check)" @onclick:preventDefault="true" /> @check.Title
                        </label>
                    }
                </div>
            </div>
        </details>
    }
    <div class="ct-workspace" data-testid="checks-workspace">
        <section class="ct-list" aria-label="@(_group == CheckGroup.Stress ? "Stress tests" : "Checks")">
            @if (_group == CheckGroup.Checks)
            {
                <AgentData TestId="checks-list-data" Json="@AgentExports.Checks(CheckList())" />
            }
            @if (_group == CheckGroup.Checks) { @Group(CheckGroup.Checks, "System checks", "Quick, read-only checks of Windows logs, drives, services, programs and hardware.") }
            else { @Group(CheckGroup.Stress, "Hardware stress & deep scans", "Run one at a time · stop automatically if the PC gets too hot.") }
        </section>
        <div class="ct-splitter" role="separator" aria-orientation="vertical" aria-label="Resize panes" tabindex="0" data-testid="checks-splitter"
             aria-valuemin="28" aria-valuemax="75"><span class="ct-grip"></span></div>
        <section class="ct-detail" aria-label="Details" data-testid="checks-detail">
            @if (selected is not null) { @Detail(selected) }
        </section>
    </div>
</div>

@code {
    // Details expand in place, below the check's card. A passed check starts collapsed (its bullets say it all); a warning or a
    // problem starts open, with its fixes. Once open, details stay open across re-runs (a fix re-runs the check) until collapsed.
    private readonly Dictionary<string, bool> _detailsOpen = new(StringComparer.OrdinalIgnoreCase);
    private static bool Collapsible(RowKind k) => k is RowKind.Passed or RowKind.Warning or RowKind.Critical or RowKind.CouldNotRun or RowKind.Blocked;
    private bool DetailsOpen(string module, RowKind k)
    {
        if (_detailsOpen.TryGetValue(module, out var open)) return open;
        if (k == RowKind.Passed) return false;
        return _detailsOpen[module] = true;
    }
    private void ToggleDetails(string module, RowKind k) => _detailsOpen[module] = !DetailsOpen(module, k);

    /// <summary>The fix dialog and result for the integrity scan shown in the detail panel.</summary>
    private RemediationActions? _scanFixUi;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Screen.Changed += OnScreenChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (App.CheckSettings is { } checks) checks.Changed += OnScreenChanged;
        _ = LoadLastRunsAsync();
    }

    // Results from earlier sessions (Event Log), shown for tests not run yet in this session. Read once, off the render thread.
    private IReadOnlyDictionary<string, RemotePCDiagnostics.Core.History.HistoryEntry> _lastRuns = new Dictionary<string, RemotePCDiagnostics.Core.History.HistoryEntry>();
    private async Task LoadLastRunsAsync()
    {
        try
        {
            var read = await Task.Run(() => History.Read(TimeSpan.FromDays(30)));
            _lastRuns = RemotePCDiagnostics.Core.History.HistoryQuery.LatestByModule(RemotePCDiagnostics.Core.History.HistoryNames.Normalize(read.Entries, Diagnostics.Catalog));
            await InvokeAsync(StateHasChanged);
        }
        catch { /* no history source: rows just say "Not run" */ }
    }
    private RemotePCDiagnostics.Core.History.HistoryEntry? LastRun(IDiagnosticModule m) => _lastRuns.GetValueOrDefault(m.Name);

    // Which page this is, from the address: /stress is the Stress tests page, anything else (/checks) the Checks page.
    // /checks and /stress use this same component, so Blazor keeps the instance (and, with no parameters, doesn't redraw it) when
    // switching between them: redraw on every address change.
    private CheckGroup _group => ChecksScreenState.GroupForPath(Nav.ToBaseRelativePath(Nav.Uri));
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { try { _ = InvokeAsync(StateHasChanged); } catch { } }

    private void OnScreenChanged() { try { _ = InvokeAsync(StateHasChanged); } catch { } }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("rpdSplit.init"); } catch { /* no JS helper (older host page): fixed 55% split */ }
    }

    public override void Dispose()
    {
        Screen.Changed -= OnScreenChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (App.CheckSettings is { } checks) checks.Changed -= OnScreenChanged;
        base.Dispose();
    }

    private bool _checksOpen;
    /// <summary>The enablement checkboxes stay on the saved set while a check, a group run or a stress test is going.</summary>
    private bool ChecksLocked => Screen.IsBusy || Diagnostics.IsAnyRunning;

    private void ToggleChecksPanel() => _checksOpen = !_checksOpen;

    private void ToggleCheck(CheckChoice check)
    {
        if (ChecksLocked || App.CheckSettings is null) return;
        App.CheckSettings.SetEnabled(check.Id, !check.Enabled, check.Available);
    }

    private void SetAllChecks(bool on)
    {
        if (ChecksLocked || App.CheckSettings is null) return;
        App.CheckSettings.SetAll(Diagnostics.CheckChoices().Where(c => c.Available).Select(c => c.Id), on);
    }

    /// <summary>The Stress tests page's state for browser agents (stress-data).</summary>
    private string StressJson()
    {
        var tests = Screen.Modules(CheckGroup.Stress)
            .Select(m => new StressExport.Test(m.Name, m.DisplayName, Screen.IsSelected(m.Name), Store.Get(m.Name), Screen.RunLabel(m.Name)))
            .ToList();
        var running = Screen.RunningGroup == CheckGroup.Stress || Diagnostics.IsAnyStressRunning;
        return StressExport.ToJson(Screen.Mode, running, Diagnostics.LastStressSuiteProgress, Screen.LastSuiteResult, Screen.LastRunNote, tests);
    }

    private void Select(IDiagnosticModule m) { Screen.SelectedModule = m.Name; }
    /// <summary>Row click: select, and in the stacked (narrow) layout scroll the details panel into view.</summary>
    private async Task SelectAndShowAsync(IDiagnosticModule m)
    {
        Select(m);
        StateHasChanged();
        await Task.Yield();
        try { await JS.InvokeVoidAsync("rpdSplit.showDetail"); } catch { /* older host page without the helper */ }
    }
    private readonly Dictionary<string, ElementReference> _rowRefs = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Every check on the Checks list, for the agent copy (checks-list-data): including collapsed groups.</summary>
    private IEnumerable<AgentExports.CheckListItem> CheckList() => Screen.Modules(CheckGroup.Checks).Select(m =>
    {
        var r = Store.Get(m.Name);
        var kind = CheckRows.KindOf(r);
        var onDemand = Diagnostics.Catalog.Get(m.Id)?.Kind == ModuleKind.OnDemand || !m.IncludeInRunAll;
        var finished = kind is not (RowKind.NotRun or RowKind.Running);
        return new AgentExports.CheckListItem(m.Name, m.DisplayName, onDemand ? "on-demand" : "check", m is ICancellableScan,
            HasOwnStart(m) ? "own-page" : "run-one", kind.ToString().ToLowerInvariant(),
            kind == RowKind.NotRun ? null : r.RunId, finished ? r.Timestamp : null, finished ? r.Message : null);
    });

    private static bool HasOwnStart(IDiagnosticModule m) => m is IStressSuiteModule ||
        (m is not ICancellableScan && ChecksScreenState.IsSeparateStep(m));

    /// <summary>Enter/Space selects; ↑/↓ move to the previous/next visible test (and select it).</summary>
    private async Task RowKey(KeyboardEventArgs e, IDiagnosticModule m)
    {
        if (e.Key is "Enter" or " ") { Select(m); return; }
        if (e.Key is not ("ArrowDown" or "ArrowUp")) return;
        var visible = Screen.IsCollapsed(_group) ? [] : Screen.Modules(_group).ToList();
        var i = visible.FindIndex(x => string.Equals(x.Name, m.Name, StringComparison.OrdinalIgnoreCase));
        var next = i < 0 ? -1 : e.Key == "ArrowDown" ? i + 1 : i - 1;
        if (next < 0 || next >= visible.Count) return;
        Select(visible[next]);
        StateHasChanged();
        await Task.Yield();
        if (_rowRefs.TryGetValue(visible[next].Name, out var el)) { try { await el.FocusAsync(); } catch { } }
    }

    private string RunLabel(IDiagnosticModule m) => Screen.RunLabel(m.Name) ?? "";

    private readonly Dictionary<string, int> _checkRanks = new(StringComparer.OrdinalIgnoreCase);

    private RenderFragment Group(CheckGroup g, string title, string sub) => __builder =>
    {
        var mods = Screen.Modules(g);
        var collapsed = Screen.IsCollapsed(g);
        var count = Screen.SelectedCount(g);
        var all = Screen.AllSelected(g);
        var running = Screen.RunningGroup == g;
        var otherBusy = Screen.IsBusy && !running || Diagnostics.IsStressSuiteRunning && !running || (g == CheckGroup.Stress && !running && Diagnostics.IsAnyStressRunning);
        var checkModules = mods;
        var attentionCount = 0;
        if (g == CheckGroup.Checks)
        {
            var results = mods.Select(m => (Module: m, Kind: CheckRows.KindOf(Store.Get(m.Name)))).ToList();
            if (!running && results.All(r => r.Kind != RowKind.Running))
            {
                foreach (var result in results)
                    _checkRanks[result.Module.Name] = result.Kind switch
                    {
                        RowKind.Critical => 0,
                        RowKind.Warning => 1,
                        _ => 2
                    };
            }
            int Rank(IDiagnosticModule m) => _checkRanks.GetValueOrDefault(m.Name, 2);
            checkModules = mods.OrderBy(Rank).ToList();
            attentionCount = checkModules.Count(m => Rank(m) < 2);
        }
        var id = g.ToString().ToLowerInvariant();
        var pills = CheckRows.Pills(mods.Select(m => CheckRows.KindOf(Store.Get(m.Name))));
        <div class="card ct-group" data-testid="checks-group-@id">
            <div class="ct-group-head">
                <button class="ct-chevron" aria-expanded="@(collapsed ? "false" : "true")" aria-label="@(collapsed ? "Expand" : "Collapse") @title"
                        data-testid="checks-chevron-@id" @onclick="() => Screen.ToggleCollapsed(g)">@(collapsed ? "▸" : "▾")</button>
                <button class="ct-check" role="checkbox" aria-checked="@(all is null ? "mixed" : all.Value ? "true" : "false")" aria-label="Select all @title"
                        data-testid="checks-selectall-@id" @onclick="() => Screen.SelectAll(g, all != true)">@(all is null ? "–" : all.Value ? "✓" : "")</button>
                <div class="ct-group-title" @onclick="() => Screen.ToggleCollapsed(g)">
                    <div class="ct-group-line"><strong>@title</strong><span class="meta" data-testid="checks-count-@id">@count of @mods.Count selected</span>
                        @foreach (var p in pills) { <span class="chip chip-@p.Kind">@p.Text</span> }</div>
                    <div class="meta">@sub</div>
                </div>
                <div class="ct-group-actions">
                    @if (g == CheckGroup.Stress)
                    {
                        <div class="theme-switch" role="group" aria-label="Stress test length" data-testid="checks-mode">
                            <button class="@(Screen.Mode == StressSuiteMode.Short ? "on" : "")" aria-pressed="@(Screen.Mode == StressSuiteMode.Short ? "true" : "false")" disabled="@running"
                                    data-testid="checks-mode-quick" @onclick="() => Screen.Mode = StressSuiteMode.Short">Short (~1 min each)</button>
                            <button class="@(Screen.Mode == StressSuiteMode.Extended ? "on" : "")" aria-pressed="@(Screen.Mode == StressSuiteMode.Extended ? "true" : "false")" disabled="@running"
                                    data-testid="checks-mode-extended" @onclick="() => Screen.Mode = StressSuiteMode.Extended">Extended (~5 min each)</button>
                        </div>
                    }
                    @if (running) { <button class="btn btn-stop" data-testid="checks-run-@id" @onclick="Screen.Stop">Stop</button> }
                    else
                    {
                        <button class="btn btn-primary" data-testid="checks-run-@id" data-action="run-selected" data-check-group="@id"
                                data-selected-check-ids="@string.Join(" ", mods.Where(m => Screen.IsSelected(m.Name)).Select(m => m.Name))" disabled="@(count == 0 || otherBusy)"
                                @onclick="() => { _ = Screen.RunGroupAsync(g); }"><Icon Name="play" Size="12" /> Run selected (@count)</button>
                    }
                </div>
            </div>
            @if (!collapsed)
            {
                <div class="ct-rows">
                    @for (var index = 0; index < checkModules.Count; index++)
                    {
                        @if (attentionCount > 0 && (index == 0 || index == attentionCount))
                        {
                            <h2 class="ct-section-label">@(index == 0 ? $"Needs attention · {attentionCount}" : "Other checks")</h2>
                        }
                        var m = checkModules[index];
                        var mod = m;
                        var r = Store.Get(m.Name);
                        var kind = CheckRows.KindOf(r);
                        var label = CheckRows.Label(kind, RunLabel(m));
                        var isSel = string.Equals(Screen.SelectedModule, m.Name, StringComparison.OrdinalIgnoreCase);
                        var prog = kind == RowKind.Running ? Diagnostics.GetProgress(m.Name) : null;
                        var line = kind == RowKind.NotRun ? "Not run" : kind == RowKind.Running ? (string.IsNullOrWhiteSpace(r.Message) || r.Message == "Running..." ? "In progress" : r.Message) : r.Message;
                        <div @key="mod.Name" class="ct-row @(isSel ? "selected" : "") @(kind == RowKind.Running ? "is-running" : "")" role="button" tabindex="0" aria-pressed="@(isSel ? "true" : "false")" @ref="_rowRefs[mod.Name]"
                             data-testid="checks-row-@m.Name.ToLowerInvariant()" @onclick="() => SelectAndShowAsync(mod)" @onkeydown="e => RowKey(e, mod)" @onkeydown:preventDefault="false">
                            <button class="ct-check" role="checkbox" aria-checked="@(Screen.IsSelected(m.Name) ? "true" : "false")" aria-label="Include @m.DisplayName"
                                    data-testid="checks-select-@m.Name.ToLowerInvariant()" @onclick="() => Screen.SetSelected(mod.Name, !Screen.IsSelected(mod.Name))" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@(Screen.IsSelected(m.Name) ? "✓" : "")</button>
                            <span class="dot dot-@CheckRows.DotKind(kind)"></span>
                            <div class="ct-row-text">
                                <div class="ct-row-name">@m.DisplayName</div>
                                <div class="ct-row-summary meta" title="@line">@line</div>
                                @if (prog is { HasProgress: true })
                                {
                                    <div class="progress run-progress ct-row-progress" data-testid="checks-progress-@m.Name.ToLowerInvariant()"><div class="progress-bar" style="width:@($"{prog.Percent:0.#}%")"></div></div>
                                }
                            </div>
                            <div class="ct-row-side">
                                <span class="chip chip-@CheckRows.ChipKind(kind)" data-testid="checks-status-@m.Name.ToLowerInvariant()">@label</span>
                                <span class="meta">@SideText(m, r, kind)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    };

    private string SideText(IDiagnosticModule m, DiagnosticResult r, RowKind kind)
    {
        if (kind is RowKind.Running) return Diagnostics.GetProgress(m.Name) is { HasProgress: true } cp ? $"{cp.Step}/{cp.Total}" : "";
        if (kind is RowKind.NotRun)
            return m is IStressSuiteModule ? (Screen.Mode == StressSuiteMode.Extended ? "~5 min" : "~1 min") : "";
        return r.Timestamp.ToLocalTime().ToString("t");
    }

    private RenderFragment Detail(IDiagnosticModule m) => __builder =>
    {
        var r = Store.Get(m.Name);
        var kind = CheckRows.KindOf(r);
        var last = kind == RowKind.Cancelled ? Screen.LastCompleted(m.Name) : null;
        var canRun = Screen.CanRunSingle(m);
        var history = $"history?module={Uri.EscapeDataString(m.Name)}";
        var done = kind is not (RowKind.NotRun or RowKind.Running);
        @* The selected check's card. Not run: a dashed card with the title, "Not run", History and Play, nothing else (earlier
           results live in History only). After a run: a solid card with a status-coloured left edge, the result's facts as bullets
           and a Details toggle that expands the full result in place. *@
        <div class="ct-detail-head ct-card ct-card-@(kind == RowKind.NotRun ? "notrun" : kind == RowKind.Running ? "running" : CheckRows.ChipKind(kind))" data-check-id="@m.Name" data-run-state="@kind.ToString().ToLowerInvariant()"
             data-run-id="@r.RunId" data-result-run-id="@(kind is RowKind.NotRun or RowKind.Running ? null : r.RunId)"
             data-result-source="@(kind == RowKind.NotRun ? (LastRun(m) is null ? "none" : "history") : kind == RowKind.Running ? "pending" : "current")"
             data-completed-at="@(kind is RowKind.NotRun or RowKind.Running ? null : r.Timestamp.ToString("O"))"
             data-run-message="@(kind is RowKind.NotRun or RowKind.Running ? null : AreaReportExport.Text(r.Message, AreaReportExport.MaxTextLength))">
            <div class="ct-card-top">
                <span class="icon-badge"><Icon Name="@Icon.ForModule(m.Name)" /></span>
                <h2 data-testid="checks-detail-title">@m.DisplayName</h2>
                <span class="chip chip-@CheckRows.ChipKind(kind)" data-testid="checks-detail-status" title="@(done ? $"Finished {r.Timestamp.ToLocalTime():g}" : null)">@CheckRows.Label(kind, RunLabel(m))</span>
                <span class="ct-card-actions">
                    @* History lists every run of this check. *@
                    <a class="ct-history-link" data-testid="checks-detail-history" data-check-id="@m.Name" href="@history"><Icon Name="hist" Size="14" /> History</a>
                    @* Stress tests, the security audit and the audio tests have their own Start/Stop (with length) below, so no second start button here. *@
                    @if (m is ICancellableScan scan && kind == RowKind.Running)
                    {
                        <button type="button" class="btn btn-stop ct-run-one" data-testid="checks-cancel-scan" data-action="cancel-check" data-check-id="@m.Name" @onclick="scan.Cancel">Cancel scan</button>
                    }
                    else if (!HasOwnStart(m))
                    {
                        var runText = kind == RowKind.NotRun ? "Run this check" : "Run again";
                        <button class="btn btn-outline ct-run-one ct-play" data-testid="checks-run-one" data-check-id="@m.Name" data-action="run-check" data-blocked-by="@Screen.BlockingIntegrityScan(m)?.Name" disabled="@(!canRun)"
                                aria-label="@runText" title="@(canRun ? runText : ChecksScreenState.UnavailableTooltip)" @onclick="() => { _ = Screen.RunSingleAsync(m); }"><Icon Name="play" Size="14" /></button>
                    }
                </span>
            </div>
            <div class="ct-detail-title meta" data-testid="checks-detail-sub">
                @if (kind == RowKind.Running) { <span>Started @r.Timestamp.ToLocalTime().ToString("t")</span> }
                else if (done)
                {
                    <CardList Text="@r.Message" Class="ct-result-facts" TestId="checks-detail-facts" />
                    @if (last is { } l)
                    {
                        <div data-testid="checks-detail-last">Last result before it was cancelled: @CheckRows.Label(CheckRows.KindOf(l.Result), l.RunLabel) · @l.Result.Message</div>
                    }
                    @if (Collapsible(kind))
                    {
                        var open = DetailsOpen(m.Name, kind);
                        <button type="button" class="linklike ct-details-toggle" data-testid="checks-details-toggle" data-check-id="@m.Name" aria-expanded="@(open ? "true" : "false")"
                                aria-controls="ct-detail-body-@m.Name" @onclick="() => ToggleDetails(m.Name, kind)"><span class="ct-caret" aria-hidden="true">@(open ? "▾" : "▸")</span> Details</button>
                    }
                }
            </div>
        </div>
        @* Collapsed details stay in the page (hidden), so the result data is still there for the shop's tools; they expand it to click. *@
        <div class="ct-detail-body" id="ct-detail-body-@m.Name" @key="m.Name" hidden="@(Collapsible(kind) && !DetailsOpen(m.Name, kind))" data-testid="checks-detail-body">
            @* The Windows integrity scans (DISM, SFC) show their result here, not on an area page: their single repair steps and the fix
               dialog live here too. Mounted while the scan re-runs after a fix, so the fix's result stays visible.
               The other long scans (large files, duplicate files) only share the live card and Cancel while they run: their result is
               cards and drawers like any other check's (ModuleDetailsView), not a scan command and its output. *@
            @if (m is WindowsIntegrityModule && App.Remediation is { } scanFixes && (kind == RowKind.Running || (r.Payload is AreaReport && kind != RowKind.Cancelled)))
            {
                <RemediationActions @ref="_scanFixUi" Actions="scanFixes" ShowRecent="false" Origin="@m.Name" OnCompleted="() => { _ = Screen.RunSingleAsync(m); }" />
            }
            @if (m is ICancellableScan && kind == RowKind.Running)
            {
                <div class="cards">
                    <div class="card is-running card-with-visual" data-testid="checks-scan-live">
                        <div class="card-main">
                            <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                            <p role="status">Running @m.DisplayName. This can take several minutes.</p>
                            @if (r.Payload is double percent)
                            {
                                <progress max="100" value="@percent" aria-label="@($"{m.DisplayName} scan progress")"></progress>
                                <span role="status"> @percent.ToString("0.#")% complete</span>
                            }
                            else
                            {
                                <progress aria-label="@($"{m.DisplayName} scan in progress")"></progress>
                            }
                        </div>
                        <TestRunningVisual Slug="@m.Name" TestId="checks-scan-visual" />
                    </div>
                </div>
            }
            else if (m is WindowsIntegrityModule && r.Payload is AreaReport integrity && kind != RowKind.Cancelled)
            {
                <AreaReportData Report="integrity" CheckId="@m.Name" RunId="r.RunId" />
                @foreach (var card in integrity.Cards)
                {
                    <p class="meta">@card.Meta</p>
                    @if (App.Remediation is not null && card.Actions is { Count: > 0 })
                    {
                        <div class="svc-actions" data-testid="checks-scan-fixes">
                            @foreach (var act in card.Actions)
                            {
                                var a = act;
                                <button class="btn-small" data-testid="remediation-card-@card.Id-@a.Kind" data-action="remediate" data-card-id="@card.Id" data-action-kind="@a.Kind" data-action-target="@a.Target" @onclick="() => _scanFixUi?.Ask(a)">@a.ButtonText</button>
                            }
                        </div>
                    }
                    @foreach (var summary in card.Rows.Where(row => row.Values.Count > 0 && row.Values[0] == "CBS summary"))
                    {
                        <strong>CBS summary</strong>
                        <div class="row-detail-text">@(summary.Values.Count > 1 ? summary.Values[1] : "")</div>
                    }
                    <details>
                        <summary>Scan command and output</summary>
                        @foreach (var row in card.Rows.Where(row => row.Values.Count > 0 && row.Values[0] != "CBS summary"))
                        {
                            <strong>@row.Values[0]</strong>
                            <div class="row-detail-text">@(row.Values.Count > 1 ? row.Values[1] : "")</div>
                        }
                    </details>
                }
            }
            else if (kind == RowKind.NotRun && !HasOwnStart(m))
            {
                @* Not run: the head's Play button is the only call to action, so no "run the check" hint here too. *@
            }
            else
            {
                <ModuleDetailsView DiagnosticModule="m" />
            }
        </div>
    };
}
