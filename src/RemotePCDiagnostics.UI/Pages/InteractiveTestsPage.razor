    private async Task RunSelectedAsync()
    {
        if (Diagnostics.IsStressSuiteRunning || _isBatchRunning || _isRemoteDisplay) return;

        _isBatchRunning = true;
        _batchCts = new CancellationTokenSource();
        var ct = _batchCts.Token;

        try
        {
            foreach (var id in AllTestIds)
            {
                if (!_selected.Contains(id) || ct.IsCancellationRequested) continue;

                _selectedTestId = id;

                switch (id)
                {
                    case "keyboard":
                        await WaitForPhysicalQaAsync("keyboard", ct);
                        break;
                    case "display":
                        await WaitForPhysicalQaAsync("display", ct);
                        break;
                    case "pointer":
                        await WaitForPointerTestAsync(ct);
                        break;
                    case "webcam":
                        await StartWebcamAsync();
                        break;
                    case "speakertomic":
                        await StartSpeakerToMicAsync();
                        break;
                    case "mictospeaker":
                        await StartMicToSpeakerAsync();
                        break;
                    case "soundcheck":
                        await StartSoundCheckAsync();
                        break;
                    case "charger":
                        await StartChargerAsync();
                        break;
                    case "devicesensors":
                        await WaitForSensorTestAsync(ct);
                        break;
                    case "wifi":
                        await StartWifiAsync();
                        break;
                    case "ethernet":
                        await StartEthernetAsync();
                        break;
                    case "usbports":
                        await StartUsbPortCheckAsync();
                        break;
                    case "audiodevices":
                        // Lists the devices only: each one plays or records when the person presses its button.
                        await Diagnostics.RunAsync(ModuleSlugs.AudioDevices);
                        break;
                    case "displayoutputs":
                        await StartDisplayOutputCheckAsync();
                        break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isBatchRunning = false;
            _batchCts?.Dispose();
            _batchCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopRunning()
    {
        _batchCts?.Cancel();
        _interactiveWaitTcs?.TrySetCanceled();
        ActivePointerTest.Cancel();
        CancelWebcam();
        CancelSpeakerToMic();
        CancelMicToSpeaker();
        CancelSoundCheck();
        CancelCharger();
        ActiveSensorTest.Cancel();
        CancelWifi();
        CancelEthernet();
        CancelUsbPortCheck();
        CancelAudioDevices();
        CancelDisplayOutputCheck();
        Diagnostics.CancelStressSuite();
    }

