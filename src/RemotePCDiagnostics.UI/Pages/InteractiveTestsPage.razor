                                    {
                                        var busy = adBusyId == d.Id;
                                        <li class="ad-dev @(busy ? "on" : "")" data-testid="audiodevices-device" data-device-id="@d.Id" data-flow="@(flow == AudioFlow.Output ? "output" : "input")"
                                            data-result="@d.Outcome.ToString().ToLowerInvariant()">
                                            <div class="ad-dev-head">
                                                <span class="@DotClass(ToStatus(d.Outcome))"></span>
                                                <div class="ad-dev-name">
                                                    <b>@d.Name</b>
                                                    <div class="meta">@d.Kind@(d.IsDefault ? " · Windows default" : "") · @StateText(d)</div>
                                                </div>
                                                <span class="chip chip-@(d.WaitingForAnswer ? "run" : OutcomeChip(ToStatus(d.Outcome)))" data-testid="audiodevices-device-result">@d.Result</span>
                                            </div>
                                            @if (busy && flow == AudioFlow.Input && adModule is not null)
                                            {
                                                <div class="ad-meter" data-testid="audiodevices-meter" role="meter" aria-label="Microphone level" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@MeterPercent(adModule.LiveLevelDbfs)">
                                                    <span style="width: @(MeterPercent(adModule.LiveLevelDbfs))%"></span>
                                                </div>
                                            }
                                            @if (d.Flow == AudioFlow.Input && d.LevelDbfs is { } lvl && !busy)
                                            {
                                                <div class="meta" data-testid="audiodevices-level">Level @Db(lvl) · peak @Db(d.PeakDbfs ?? AudioMath.SilenceDbfs)</div>
                                            }
                                            @if (d.Hint is { } hint) { <div class="meta" data-testid="audiodevices-hint">@hint</div> }
                                            <div class="phys-qa-actions">
                                                @if (d.Testable && flow == AudioFlow.Output)
                                                {
                                                    <button type="button" class="btn-small @(d.Channels is null ? "btn-primary" : "")" data-testid="audiodevices-play" disabled="@(adBusyId is not null || Diagnostics.IsStressSuiteRunning)"
                                                            @onclick="() => PlayDeviceAsync(d.Id)">▶ @(d.Channels is null ? "Play" : "Play again")</button>
                                                    @if (d.Channels is not null && !busy)
                                                    {
                                                        @foreach (var (ans, text, id) in d.Channels == 1 ? MonoAnswerButtons : AnswerButtons)
                                                        {
                                                            <button type="button" class="btn-small @(d.Heard == ans ? "btn-primary" : "")" data-testid="audiodevices-answer-@id" data-answer="@id"
                                                                    aria-pressed="@(d.Heard == ans ? "true" : "false")" @onclick="() => AnswerDevice(d.Id, ans)">@text</button>
                                                        }
                                                    }
                                                }
                                                else if (d.Testable)
                                                {
                                                    <button type="button" class="btn-small @(d.LevelDbfs is null ? "btn-primary" : "")" data-testid="audiodevices-record" disabled="@(adBusyId is not null || Diagnostics.IsStressSuiteRunning)"
                                                            @onclick="() => RecordDeviceAsync(d.Id)">● @(busy ? "Recording…" : d.LevelDbfs is null ? "Record 3 s" : "Record again")</button>
                                                    @if (adModule?.HasRecording(d.Id) == true)
                                                    {
                                                        <button type="button" class="btn-small" data-testid="audiodevices-playback" disabled="@(adBusyId is not null)" @onclick="() => PlayBackAsync(d.Id)">Play back</button>
                                                    }
                                                }
                                                @if (App.Remediation is not null && FixAccess.Offerable(d.Actions, App.AgentFixes) is { Count: > 0 } fixes)
                                                {
                                                    @foreach (var a in fixes)
                                                    {
                                                        <button type="button" class="btn-small" data-testid="audiodevices-fix-@a.Kind" data-action="remediate"
                                                                data-action-kind="@a.Kind" data-action-target="@a.Target" disabled="@(adBusyId is not null)" @onclick="() => _audioDevicesFixUi?.Ask(a)">@a.ButtonText</button>
                                                    }
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    @if (App.Remediation is not null)
                    {
                        <RemediationActions @ref="_audioDevicesFixUi" Actions="App.Remediation" ShowRecent="false" Origin="@ModuleSlugs.AudioDevices" OnStateChanged="StateHasChanged"
                                            OnCompleted="() => Diagnostics.RunAsync(ModuleSlugs.AudioDevices)" />
                    }
                    <label class="phys-qa-note">
                        <span class="meta">Optional note (e.g. headset mic crackles)</span>
                        <input data-testid="audiodevices-notes" value="@_audioDevicesNotes" @oninput="e => _audioDevicesNotes = e.Value?.ToString() ?? string.Empty" maxlength="240" placeholder="Optional note…" />
                    </label>
                    <div class="phys-qa-actions">
                        <button type="button" class="btn-small" data-testid="audiodevices-refresh" disabled="@(adBusyId is not null)" @onclick="() => Diagnostics.RunAsync(ModuleSlugs.AudioDevices)">Check devices again</button>
                        <button type="button" class="btn-small" data-testid="audiodevices-note-btn" @onclick="() => SetAudioOutcome(ModuleSlugs.AudioDevices, DiagnosticStatus.Warning, _audioDevicesNotes)">Pass with note</button>
                        <button type="button" class="btn-small" data-testid="audiodevices-fail" @onclick="() => SetAudioOutcome(ModuleSlugs.AudioDevices, DiagnosticStatus.Error, _audioDevicesNotes)">Fail with note</button>
                        <button type="button" class="btn-small" data-testid="audiodevices-reset" disabled="@(adBusyId is not null)" @onclick="ResetAudioDevices">Reset</button>
                    </div>
                </div>
            }
            else if (_selectedTestId == "displayoutputs")
            {
                var dvWaitingAnswer = !dvRunning && dvRep is { Watching: false, Unanswered: > 0 };
                <div class="phys-qa-pane" data-testid="interactive-displayoutputs-pane">
