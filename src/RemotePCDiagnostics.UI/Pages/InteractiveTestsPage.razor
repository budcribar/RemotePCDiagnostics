    private async Task RunSelectedAsync()
    {
        if (Diagnostics.IsStressSuiteRunning || _isBatchRunning || _isRemoteDisplay) return;

        _isBatchRunning = true;
        _batchCts = new CancellationTokenSource();
        var ct = _batchCts.Token;

        try
        {
            foreach (var id in AllTestIds)
            {
                if (!_selected.Contains(id) || ct.IsCancellationRequested) continue;

                _selectedTestId = id;

                switch (id)
                {
                    case "keyboard":
                        await WaitForPhysicalQaAsync("keyboard", ct);
                        break;
                    case "display":
                        await WaitForPhysicalQaAsync("display", ct);
                        break;
                    case "pointer":
                        await WaitForPointerTestAsync(ct);
                        break;
                    case "webcam":
                        await StartWebcamAsync();
                        break;
                    case "speakertomic":
                        await StartSpeakerToMicAsync();
                        break;
                    case "mictospeaker":
                        await StartMicToSpeakerAsync();
                        break;
                    case "soundcheck":
                        await StartSoundCheckAsync();
                        break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isBatchRunning = false;
            _batchCts?.Dispose();
            _batchCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopRunning()
    {
        _batchCts?.Cancel();
        _interactiveWaitTcs?.TrySetCanceled();
        ActivePointerTest.Cancel();
        CancelWebcam();
        CancelSpeakerToMic();
        CancelMicToSpeaker();
        CancelSoundCheck();
        Diagnostics.CancelStressSuite();
    }

    private void LoadDevices()
    {
        if (GetWebcamModule() is { } cam)
        {
            _camDevices = cam.Devices();
            _selectedCamId ??= _camDevices.FirstOrDefault()?.Id;
            _camDuration = cam.Duration;
        }

        if (GetMicToSpeakerModule() is { } m2s)
        {
            _outputs = m2s.Devices(AudioFlow.Output);
            _inputs = m2s.Devices(AudioFlow.Input);
            _selectedOutputId ??= m2s.Settings.OutputId;
            _selectedInputId ??= m2s.Settings.InputId;
            _audioHalfDuplex = m2s.Settings.HalfDuplex;
        }
        else if (GetSpeakerToMicModule() is { } s2m)
        {
            _outputs = s2m.Devices(AudioFlow.Output);
            _inputs = s2m.Devices(AudioFlow.Input);
            _selectedOutputId ??= s2m.Settings.OutputId;
            _selectedInputId ??= s2m.Settings.InputId;
            _audioHalfDuplex = s2m.Settings.HalfDuplex;
        }
        else if (GetSoundCheckModule() is { } sc)
        {
            _outputs = sc.Devices(AudioFlow.Output);
            _selectedOutputId ??= sc.Settings.OutputId;
        }
    }

