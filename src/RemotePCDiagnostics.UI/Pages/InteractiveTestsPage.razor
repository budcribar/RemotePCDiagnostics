    /// selected camera's result (each camera runs as its own instance, so the module's result only lists them).
    /// </summary>
    private DiagnosticResult CamShown(DiagnosticResult module)
    {
        if (module.Status == DiagnosticStatus.Running || module.Payload is not InstanceResults all) return module;
        var key = _selectedCamId is { } id ? InstanceKeys.From(id) : null;
        return (key is null ? null : Store.GetInstance(ModuleSlugs.Webcam, key)) ?? all.Results.LastOrDefault() ?? module;
    }

    /// <summary>"Do you see yourself?": saved with the measured verdict, on the result shown.</summary>
    private void AnswerWebcam(DiagnosticResult shown, bool seen)
    {
        if (shown.Payload is not WebcamReport rep) return;
        // After Pass/Fail camera the person's verdict stays; the answer is added to the report beside the measured one.
        var personEntered = _personResults.TryGetValue(ModuleSlugs.Webcam, out var entered) && ReferenceEquals(entered, shown);
        var updated = personEntered ? shown with { Payload = rep with { PersonSawPicture = seen } } : WebcamVerdicts.WithPersonAnswer(shown, seen);
        WebcamVerdicts.SaveAnswer(Store, updated);
        if (personEntered) _personResults[ModuleSlugs.Webcam] = updated;
    }

