                        <strong>Video output check</strong>
                        <span class="chip chip-@(dvRunning || dvWaitingAnswer ? "run" : OutcomeChip(dvResult.Status))" data-testid="displayoutputs-status-chip">
                            @(dvRunning ? "Watching…" : dvWaitingAnswer ? "Waiting for answer" : OutcomeLabel(dvResult.Status))
                        </span>
                        @if (dvRunning)
                        {
                            <button type="button" class="btn-small btn-primary" data-testid="displayoutputs-finish-btn" @onclick="FinishDisplayOutputCheck">Finish</button>
                            <button type="button" class="btn-small" data-testid="displayoutputs-cancel-btn" @onclick="CancelDisplayOutputCheck">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="btn-small btn-primary" data-testid="displayoutputs-start-btn"
                                    disabled="@(Diagnostics.IsStressSuiteRunning || _isRemoteDisplay || dvModule is null)"
                                    title="@(_isRemoteDisplay ? "Interactive tests must run locally on the physical machine" : null)"
                                    @onclick="StartDisplayOutputCheckAsync">
                                @(dvRep is null ? "Start watching" : "Start again")
                            </button>
                        }
                    </div>
                    <p class="meta" data-testid="displayoutputs-instructions">
                        Plug a monitor into each video port in turn: HDMI, DisplayPort, USB-C, VGA and the ports on a dock. Each one shows below
                        with its connector and mode as Windows finds it. Say whether the picture appeared on each, then press Finish.
                    </p>
                    <p data-testid="displayoutputs-status" class="@(dvRunning ? "status-line is-running" : "status-line")">
                        <span class="@DotClass(dvRunning ? DiagnosticStatus.Running : dvResult.Status)"></span>
                        <span>@(dvRunning && dvRep is not null ? DisplayOutputCheck.Outcome(dvRep).Message : dvResult.Status == DiagnosticStatus.NotRun ? "Not run. Press Start watching to begin." : dvResult.Message)</span>
                        @if (dvRunning)
                        {
                            <span class="running-badge" data-testid="displayoutputs-running-badge"><span class="running-badge-dot"></span>Watching</span>
                        }
                    </p>
                    @if (dvRep?.Notice is { } dvNotice) { <p class="notice" data-testid="displayoutputs-notice">@dvNotice</p> }
                    @if (dvRep is { Arrivals.Count: > 0 })
                    {
                        <table class="detail" data-testid="displayoutputs-table">
                            <thead><tr><th>Monitor</th><th>Connector</th><th>Graphics</th><th>Mode</th><th>Notes</th><th>Did the picture appear?</th></tr></thead>
                            <tbody>
                                @foreach (var a in dvRep.Arrivals)
                                {
                                    var notes = new List<string>();
                                    if (!a.Active) notes.Add("Windows isn't showing anything on it");
                                    if (a.EdidProblem is { } ep) notes.Add(ep);
                                    if (a.BelowNative) notes.Add("Below its native resolution");
                                    if (a.Flapping) notes.Add($"Dropped {a.Unplugged} times: check the cable");
                                    <tr data-testid="displayoutputs-port" data-key="@a.Key" data-active="@(a.Active ? "true" : "false")"
                                        data-picture="@(a.PictureAppeared switch { true => "yes", false => "no", _ => "" })">
                                        <td>@a.Monitor</td>
                                        <td>@a.Connector</td>
                                        <td>@a.Adapter</td>
                                        <td>@(a.Active ? $"{a.Mode} {Displays.Hz(a.RefreshHz)}".Trim() : "Not active")</td>
                                        <td>@(notes.Count > 0 ? string.Join(" · ", notes) : "OK")</td>
                                        <td>
                                            @if (a.PictureAppeared is null)
                                            {
                                                <button type="button" class="btn-small btn-primary" data-testid="displayoutputs-answer-yes" @onclick="() => AnswerDisplayOutput(a.Key, true)">Yes</button>
                                                <button type="button" class="btn-small" data-testid="displayoutputs-answer-no" @onclick="() => AnswerDisplayOutput(a.Key, false)">No</button>
                                            }
                                            else
                                            {
                                                <span>@(a.PictureAppeared == true ? "Yes" : "No")</span>
                                                <button type="button" class="btn-link" data-testid="displayoutputs-answer-change" @onclick="() => AnswerDisplayOutput(a.Key, a.PictureAppeared != true)">Change</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (dvRep is { NoSignal.Count: > 0 })
                    {
                        <p class="notice" data-testid="displayoutputs-nosignal">
                            Nothing appeared on: @string.Join(", ", dvRep.NoSignal.Select(n => n.Port))
                        </p>
                    }
                    @if (dvRunning || dvRep is { Watching: false })
                    {
                        <div class="phys-qa-actions" data-testid="displayoutputs-nosignal-form">
                            <label>
                                Plugged in but nothing appeared?
                                <input data-testid="displayoutputs-nosignal-port" value="@_noSignalPort" @oninput="e => _noSignalPort = e.Value?.ToString() ?? string.Empty"
                                       maxlength="80" placeholder="Which port (for example: left HDMI)" />
                            </label>
                            <button type="button" class="btn-small" data-testid="displayoutputs-nosignal-btn" @onclick="ReportNoSignal">Nothing appeared</button>
                            @if (!dvRunning)
                            {
                                <button type="button" class="btn-small" data-testid="displayoutputs-reset" @onclick="ResetDisplayOutputCheck">Reset</button>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private readonly PhysicalBenchQaService _fallbackPhysicalQa = new();
    private PhysicalBenchQaService ActivePhysicalQa => App.PhysicalQa ?? _fallbackPhysicalQa;

    private DeviceSensorTestService? _fallbackSensorTest;
    private DeviceSensorTestService ActiveSensorTest => App.SensorTest ?? (_fallbackSensorTest ??= new DeviceSensorTestService());

    private PointerTestService? _fallbackPointerTest;
    private PointerTestService ActivePointerTest => App.PointerTest ?? (_fallbackPointerTest ??= new PointerTestService(App.PhysicalInput));
    private bool RemoteSessionActive => Session.Mode == SessionMode.Remote || _hasRemoteSession;

    private static readonly string[] AllTestIds = ["keyboard", "display", "pointer", "webcam", "speakertomic", "mictospeaker", "soundcheck", "charger", "wifi", "ethernet", "usbports", "audiodevices", "displayoutputs", "devicesensors"];
    private readonly HashSet<string> _selected = new(AllTestIds, StringComparer.OrdinalIgnoreCase);

    // The Wi-Fi connect pane: the last scan's networks, the one picked (null = the network the PC is on), and the typed password.
    private IReadOnlyList<WifiNetworkSeen> _wifiNetworks = [];
    private string? _wifiPickedSsid;
    private string _wifiPassword = "";
    private bool _wifiScanning;
    private bool _wifiScanned;
    private bool _wifiDropsSession;
    private string? _wifiInterfaceId;

    private WifiNetworkSeen? WifiPicked =>
        _wifiNetworks.FirstOrDefault(n => n.Ssid == _wifiPickedSsid) ?? _wifiNetworks.FirstOrDefault(n => n.Connected) ?? _wifiNetworks.FirstOrDefault(n => n.HasProfile);

    private static string WifiOptionText(WifiNetworkSeen n) =>
        $"{(n.Ssid.Length > 0 ? n.Ssid : "(hidden)")} · {n.Security} · {WifiRadio.FormatRssi(n.Rssi)}{(n.Connected ? " · connected" : n.HasProfile ? " · saved" : "")}";

    // The Ethernet port pane: the wired ports, the one picked (null = the first), and what is plugged in.
    private IReadOnlyList<EthernetPortChoice> _ethPorts = [];
    private string? _ethPicked;
    private EthernetPortMode _ethMode;
    private bool _ethLoading;
    private bool _ethLoaded;
    private bool _ethDropsSession;

    private EthernetPortChoice? EthernetPicked => _ethPorts.FirstOrDefault(p => p.Name == _ethPicked) ?? _ethPorts.FirstOrDefault();

    /// <summary>Opens a test's pane from a link ("interactive?test=soundcheck"); help=cant-hear also opens the Can't hear sound list.</summary>
    [SupplyParameterFromQuery(Name = "test")] public string? TestQuery { get; set; }
    [SupplyParameterFromQuery(Name = "help")] public string? HelpQuery { get; set; }

    // The Sound check pane's list: "cant-hear", "one-side" or null.
    private string? _soundHelp;
    private string _soundNotes = "";
    private RemediationActions? _soundFixUi;
    private RemediationActions? _audioDevicesFixUi;
    private string _audioDevicesNotes = "";
    private IAudioDevicesTestModule? _levelSource;
    private long _lastMeterTick;
    private static readonly (SoundCheckAnswer Answer, string Text, string Id)[] MonoAnswerButtons =
        [(SoundCheckAnswer.Both, "Heard it", "both"), (SoundCheckAnswer.Nothing, "Nothing", "nothing")];
    private static readonly (SoundCheckAnswer Answer, string Text, string Id)[] AnswerButtons =
        [(SoundCheckAnswer.Both, "Heard both", "both"), (SoundCheckAnswer.OnlyLeft, "Only left", "only-left"),
         (SoundCheckAnswer.OnlyRight, "Only right", "only-right"), (SoundCheckAnswer.Nothing, "Nothing", "nothing")];
    private string _selectedTestId = "keyboard";

    private static readonly TimeSpan[] CamDurationChoices = [TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10)];
    private IReadOnlyList<WebcamDevice> _camDevices = [];
    private string? _selectedCamId;
    private TimeSpan _camDuration = TimeSpan.FromSeconds(5);
    private string _webcamNotes = "";

    // Results whose verdict a person entered with the Pass/Fail buttons, so the agent copy can tell them from a measured result.
    private readonly Dictionary<string, DiagnosticResult> _personResults = new(StringComparer.Ordinal);

    private InteractiveExport.ModuleState PersonState(DiagnosticResult r) =>
        new(r, _personResults.TryGetValue(r.ModuleName, out var entered) && ReferenceEquals(entered, r));

    /// <summary>The page's state for browser agents (interactive-data): measured evidence and person-entered verdicts kept apart.</summary>
    private string InteractiveJson(RemotePCDiagnostics.Core.Workflow.PhysicalBenchQaSnapshot kb, DiagnosticResult cam, DiagnosticResult s2m, DiagnosticResult m2s,
        DiagnosticResult sc, InteractiveExport.SoundCheckHelp help, DiagnosticResult wifi, DiagnosticResult ethernet, DiagnosticResult charger, DiagnosticResult usb, UsbPortCheckReport? usbLive, DiagnosticResult ad, string? adBusyId, DiagnosticResult dv, DisplayOutputCheckReport? dvLive, SensorTestSnapshot sensors) =>
        InteractiveExport.ToJson(
            new InteractiveExport.PageState(_selectedTestId, _selected, _isBatchRunning, _isRemoteDisplay, Session.Mode == SessionMode.Remote || _hasRemoteSession, _technicianHasControl),
            kb, PersonState(cam), PersonState(s2m), PersonState(m2s), PersonState(sc), help, wifi,
            new InteractiveExport.WifiPane(_wifiNetworks, WifiPicked?.Ssid, _wifiPassword.Length > 0, _wifiDropsSession, _wifiScanning),
            ethernet, new InteractiveExport.EthernetPane(_ethPorts, EthernetPicked?.Name, _ethMode, _ethDropsSession, _ethLoading), charger,
            new InteractiveExport.UsbPortCheckState(PersonState(usb), usbLive ?? UsbPortCheckReport.Empty), PersonState(ad), adBusyId, ActivePointerTest.Current,
            new InteractiveExport.DisplayOutputCheckState(PersonState(dv), dvLive ?? DisplayOutputCheckReport.Empty), sensors);

    private IReadOnlyList<AudioDevice> _outputs = [];
    private IReadOnlyList<AudioDevice> _inputs = [];
    private string? _selectedOutputId;
    private string? _selectedInputId;
    private bool _audioHalfDuplex;
    private string _audioNotes = "";

    public sealed class RemoteControlInfo
    {
        public bool IsRemoteDisplay { get; set; }
        public bool HasRemoteSession { get; set; }
        public bool TechnicianHasControl { get; set; }
        public bool LocalHasControl { get; set; }
    }

    private DotNetObjectReference<InteractiveTestsPage>? _dotNetRef;
    private IUsbPortCheckModule? _usbPortCheckModule;
    private volatile bool _disposed;
    private bool _isRemoteDisplay;
    private bool _hasRemoteSession;
    private bool _technicianHasControl;
    private bool _isBatchRunning;
    private CancellationTokenSource? _batchCts;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadDevices();
        _usbPortCheckModule = GetUsbPortCheckModule();
        if (_usbPortCheckModule is not null) _usbPortCheckModule.Changed += OnUsbPortCheckChanged;
        // The row's chip and interactive-data follow the pointer test as it runs.
        ActivePointerTest.Changed += OnPointerTestChanged;
        if (GetDisplayOutputCheckModule() is { } dvCheck) dvCheck.Changed += OnDisplayOutputCheckChanged;
        // The row's chip and interactive-data follow the Sensor test as it runs.
        ActiveSensorTest.Changed += OnSensorTestChanged;
        if (TestQuery is { Length: > 0 } t && AllTestIds.Contains(t, StringComparer.OrdinalIgnoreCase)) _selectedTestId = t.ToLowerInvariant();
        if (_selectedTestId == "ethernet") _ = LoadEthernetPortsAsync();
        if (_selectedTestId == "soundcheck" && HelpQuery == "cant-hear") _ = OpenCantHearAsync();
        if (_selectedTestId == "wifi") _ = ScanWifiAsync();
        _levelSource = GetAudioDevicesModule();
        if (_levelSource is not null) _levelSource.LevelChanged += OnMicLevel;
        if (_selectedTestId == "audiodevices") _ = ReadAudioDevicesIfNeededAsync();
    }

    /// <summary>Redraws the meter while a microphone records, at most 10 times a second.</summary>
    private void OnMicLevel()
    {
        if (_disposed) return;
        var now = Environment.TickCount64;
        if (now - Interlocked.Read(ref _lastMeterTick) < 100 && _levelSource?.BusyId is not null) return;
        Interlocked.Exchange(ref _lastMeterTick, now);
        try { _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); } catch (ObjectDisposedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("rpdSplit.init"); } catch { }
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("rpdSession.subscribeControl", _dotNetRef);
        }
        catch { }
    }

    [JSInvokable]
    public void OnControlStateChanged(RemoteControlInfo? info)
    {
        if (info is null) return;
        _isRemoteDisplay = info.IsRemoteDisplay;
        _hasRemoteSession = info.HasRemoteSession;
        _technicianHasControl = info.TechnicianHasControl;
        InvokeAsync(StateHasChanged);
    }

    private async Task ReleaseControlAsync()
    {
        try { await JS.InvokeVoidAsync("rpdSession.releaseControlToLocal"); } catch { }
    }

    private void OnPointerTestChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnSensorTestChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        _disposed = true;
        base.Dispose();
        if (_usbPortCheckModule is not null)
        {
            _usbPortCheckModule.Changed -= OnUsbPortCheckChanged;
            _usbPortCheckModule = null;
        }
        if (_levelSource is not null) _levelSource.LevelChanged -= OnMicLevel;
        CancelAudioDevices();
        ActivePointerTest.Changed -= OnPointerTestChanged;
        _fallbackPointerTest?.Dispose();
        _fallbackPointerTest = null;
        if (GetDisplayOutputCheckModule() is { } dvCheck) dvCheck.Changed -= OnDisplayOutputCheckChanged;
        if (App.SensorTest is { } sensorTest)
        {
            sensorTest.Changed -= OnSensorTestChanged;
            if (sensorTest.IsRunning) sensorTest.Cancel();
        }
        else if (_fallbackSensorTest is { } fallbackSensorTest)
        {
            fallbackSensorTest.Changed -= OnSensorTestChanged;
            if (fallbackSensorTest.IsRunning) fallbackSensorTest.Cancel();
            fallbackSensorTest.Dispose();
            _fallbackSensorTest = null;
        }
        _batchCts?.Cancel();
        _interactiveWaitTcs?.TrySetCanceled();
        _batchCts?.Dispose();
        _batchCts = null;
        CancelCharger();
        if (_dotNetRef is not null)
        {
            try { _ = JS.InvokeVoidAsync("rpdSession.unsubscribeControl", _dotNetRef); } catch { }
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private void SelectTest(string id)
    {
        _selectedTestId = id;
        if (id == "wifi" && !_wifiScanned) _ = ScanWifiAsync();
        if (id == "ethernet" && !_ethLoaded) _ = LoadEthernetPortsAsync();
        if (id == "audiodevices") _ = ReadAudioDevicesIfNeededAsync();
    }

    private IWifiConnectModule? GetWifiModule() =>
        Diagnostics.Modules.OfType<IWifiConnectModule>().FirstOrDefault()
        ?? (Diagnostics.Catalog.Find(ModuleSlugs.WifiConnect) is { } d ? Diagnostics.Catalog.ModuleFor(d.Id) as IWifiConnectModule : null);

    private async Task ScanWifiAsync()
    {
        if (_wifiScanning || GetWifiModule() is not { } m) return;
        _wifiScanning = true;
        _wifiScanned = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var reading = await m.ScanAsync(CancellationToken.None);
            var adapter = reading.Interfaces.FirstOrDefault(i => i.RadioOn);
            _wifiInterfaceId = adapter?.Id;
            _wifiNetworks = adapter?.Networks.Where(n => n.Ssid.Length > 0)
                .OrderByDescending(n => n.Connected).ThenByDescending(n => n.HasProfile).ThenByDescending(n => n.Rssi ?? int.MinValue).ToList() ?? [];
            _wifiDropsSession = adapter is { IsConnected: true } && m.DropsSession(adapter.Id);
        }
        catch (Exception) { _wifiNetworks = []; }
        finally
        {
            _wifiScanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEthernetPortModule? GetEthernetModule() =>
        Diagnostics.Modules.OfType<IEthernetPortModule>().FirstOrDefault()
        ?? (Diagnostics.Catalog.Find(ModuleSlugs.EthernetPort) is { } d ? Diagnostics.Catalog.ModuleFor(d.Id) as IEthernetPortModule : null);

    private async Task LoadEthernetPortsAsync()
    {
        if (_disposed || _ethLoading || GetEthernetModule() is not { } m) return;
        _ethLoading = true;
        _ethLoaded = true;
        if (!_disposed) await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        try
        {
            _ethPorts = await m.ListPortsAsync(CancellationToken.None);
            _ethDropsSession = EthernetPicked is { Connected: true } p && m.DropsSession(p.Name);
        }
        catch (Exception) { _ethPorts = []; }
        finally
        {
            _ethLoading = false;
            if (!_disposed) await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        }
    }

    private void PickWifi(string? ssid)
    {
        _wifiPickedSsid = string.IsNullOrEmpty(ssid) ? null : ssid;
        _wifiPassword = "";
    }

    private async Task StartWifiAsync()
    {
