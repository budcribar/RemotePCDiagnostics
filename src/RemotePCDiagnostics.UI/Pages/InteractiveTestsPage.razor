    /// <summary>Run selected: the pane starts the Sensor test when it opens; waits until it ends (passed, failed, skipped or stopped).</summary>
    private async Task WaitForSensorTestAsync(CancellationToken ct)
    {
        var tcs = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        var before = ActiveSensorTest.Current.StartedUtc;
        void Check()
        {
            var snap = ActiveSensorTest.Current;
            if (snap.StartedUtc != before && snap.Verdict != SensorTestVerdict.Running)
                tcs.TrySetResult();
        }
        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        ActiveSensorTest.Changed += Check;
        try
        {
            Check();
            await InvokeAsync(StateHasChanged);
            Check();
            await tcs.Task;
        }
        finally
        {
            ActiveSensorTest.Changed -= Check;
        }
    }

