@page "/interactive"
@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Audio
@using RemotePCDiagnostics.Core.Webcam
@using RemotePCDiagnostics.Core.Workflow
@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.Input
@inherits StoreAwareComponent
@inject ISessionContext Session
@inject IJSRuntime JS
@inject AppServices App

@{
    var camResult = Store.Get(ModuleSlugs.Webcam);
    var camRep = camResult.Payload as WebcamReport;
    var camRunning = camResult.Status == DiagnosticStatus.Running;

    var s2mResult = Store.Get(ModuleSlugs.SpeakerToMic);
    var s2mRep = s2mResult.Payload as SpeakerToMicReport;
    var s2mRunning = s2mResult.Status == DiagnosticStatus.Running;

    var m2sResult = Store.Get(ModuleSlugs.MicToSpeaker);
    var m2sRep = m2sResult.Payload as MicToSpeakerReport;
    var m2sRunning = m2sResult.Status == DiagnosticStatus.Running;

    var scResult = Store.Get(ModuleSlugs.SoundCheck);
    var scRep = scResult.Payload as SoundCheckReport;
    var scRunning = scResult.Status == DiagnosticStatus.Running;
    var soundResult = Store.Get(ModuleSlugs.Sound);
    var soundRep = soundResult.Report() as AreaReport;
    var soundReading = soundResult.Status == DiagnosticStatus.Running;
    var scSteps = soundRep is null || _soundHelp is null ? [] : _soundHelp == "one-side" ? SoundCheck.OneSideSteps(soundRep) : SoundCheck.CantHearSteps(soundRep);
    var scServicesOk = soundRep is not null && SoundCheck.ServicesOk(soundRep);

    var kbSnap = ActivePhysicalQa.Current;
    var ptrSnap = ActivePointerTest.Current;
    var anyRunning = _isBatchRunning || ptrSnap.Verdict == PointerTestVerdict.Running || camRunning || s2mRunning || m2sRunning || scRunning;

    var allSelected = _selected.Count == AllTestIds.Length;
    var mixedSelected = _selected.Count > 0 && _selected.Count < AllTestIds.Length;
}

<div class="ct-page">
    <AgentData TestId="interactive-data" Json="@InteractiveJson(kbSnap, camResult, s2mResult, m2sResult, scResult, new InteractiveExport.SoundCheckHelp(_soundHelp, soundReading, scSteps, scServicesOk))" />
    <div class="toolbar">
        <span class="icon-badge page-icon"><Icon Name="eye" Size="20" /></span>
        <h1 data-rpcd-page="interactive" data-rpcd-contract="@BrowserContract.Interactive" data-testid="interactive-title">Interactive tests</h1>
    </div>

    <section class="banner banner-neutral ct-banner" data-testid="interactive-guidance-banner" style="margin-bottom: 16px">
        <span class="banner-icon"><Icon Name="eye" Size="22" /></span>
        <div class="banner-text">
            <div class="banner-title" data-testid="interactive-banner-title">Hands-on physical hardware verification</div>
            <div class="banner-sub" data-testid="interactive-banner-desc">
                Select and run interactive hardware tests (keyboard matrix, LCD uniformity &amp; touch digitizer, mouse, touchpad &amp; touchscreen, live webcam feed, and microphone/speaker loopback).
            </div>
            @if (Session.Mode == SessionMode.Remote || _hasRemoteSession)
            {
                <div class="banner-note" data-testid="interactive-remote-note">
                    @if (_technicianHasControl)
                    {
                        <span>Remote technician has control. Release control to the local user so they can interact with the physical hardware.</span>
                        @if (_isRemoteDisplay)
                        {
                            <button type="button" class="btn btn-small btn-primary" style="margin-left: 8px" data-testid="interactive-release-control" @onclick="ReleaseControlAsync">
                                Release control
                            </button>
                        }
                    }
                    else
                    {
                        <span>Local user has control of the session to interact with the physical hardware.</span>
                    }
                </div>
            }
        </div>
    </section>

    <div class="ct-workspace" data-testid="interactive-workspace">
        <section class="ct-list" aria-label="Interactive tests">
            <div class="card ct-group" data-testid="interactive-group">
                <div class="ct-group-head">
                    <button class="ct-check" role="checkbox" aria-checked="@(mixedSelected ? "mixed" : allSelected ? "true" : "false")"
                            aria-label="Select all interactive tests"
                            data-testid="interactive-select-all" @onclick="ToggleSelectAll">
                        @(mixedSelected ? "–" : allSelected ? "✓" : "")
                    </button>
                    <div class="ct-group-title">
                        <div class="ct-group-line">
                            <strong>Interactive checks</strong>
                            <span class="meta" data-testid="interactive-selected-count">@_selected.Count of @AllTestIds.Length selected</span>
                        </div>
                        <div class="meta">Run selected tests together or interact individually · click any test to open controls</div>
                    </div>
                    <div class="ct-group-actions">
                        @if (anyRunning)
                        {
                            <button class="btn btn-stop" data-testid="interactive-stop" @onclick="StopRunning">Stop</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" data-testid="interactive-run-selected"
                                    disabled="@(_selected.Count == 0 || _isRemoteDisplay)"
                                    title="@(_isRemoteDisplay ? "Interactive tests must run locally on the physical machine" : null)"
                                    @onclick="RunSelectedAsync">
                                <Icon Name="play" Size="12" /> Run selected (@_selected.Count)
                            </button>
                        }
                    </div>
                </div>

                <div class="ct-rows">
                    @* 1. Keyboard matrix *@
                    @{
                        var kbIsSel = _selectedTestId == "keyboard";
                        var kbChip = OutcomeChip(kbSnap.KeyboardOutcome);
                        var kbDot = DotKind(kbSnap.KeyboardOutcome);
                        var kbLabel = OutcomeLabel(kbSnap.KeyboardOutcome);
                        var kbSummary = kbSnap.KeyboardNotes ?? (kbSnap.UniqueKeysPressed > 0 ? $"{kbSnap.UniqueKeysPressed} unique keys, {kbSnap.PeakKeyRollover}-key peak rollover" : "Test key switches and NKRO simultaneous rollover");
                    }
                    <div class="ct-row @(kbIsSel ? "selected" : "")" role="button" tabindex="0" aria-pressed="@(kbIsSel ? "true" : "false")"
                         data-testid="interactive-row-keyboard" @onclick='() => SelectTest("keyboard")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("keyboard") ? "true" : "false")"
                                aria-label="Include Keyboard matrix test"
                                data-testid="interactive-check-keyboard"
                                @onclick='() => ToggleItem("keyboard")' @onclick:stopPropagation="true">
                            @(_selected.Contains("keyboard") ? "✓" : "")
                        </button>
                        <span class="dot dot-@kbDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Keyboard matrix &amp; rollover (NKRO)</div>
                            <div class="ct-row-summary meta" title="@kbSummary">@kbSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@kbChip" data-testid="interactive-status-keyboard">@kbLabel</span>
                        </div>
                    </div>

                    @* 2. Display test *@
                    @{
                        var dispIsSel = _selectedTestId == "display";
                        var dispChip = OutcomeChip(kbSnap.DisplayOutcome);
                        var dispDot = DotKind(kbSnap.DisplayOutcome);
                        var dispLabel = OutcomeLabel(kbSnap.DisplayOutcome);
                        var dispSummary = kbSnap.DisplayNotes ?? (kbSnap.SolidColorsInspected > 0 ? $"{kbSnap.SolidColorsInspected} color patterns, {kbSnap.MaxTouchPoints}-pt touch" : "Inspect pure black, white, RGB and uniformity");
                    }
                    <div class="ct-row @(dispIsSel ? "selected" : "")" role="button" tabindex="0" aria-pressed="@(dispIsSel ? "true" : "false")"
                         data-testid="interactive-row-display" @onclick='() => SelectTest("display")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("display") ? "true" : "false")"
                                aria-label="Include Display test"
                                data-testid="interactive-check-display"
                                @onclick='() => ToggleItem("display")' @onclick:stopPropagation="true">
                            @(_selected.Contains("display") ? "✓" : "")
                        </button>
                        <span class="dot dot-@dispDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Display dead-pixel &amp; touch check</div>
                            <div class="ct-row-summary meta" title="@dispSummary">@dispSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@dispChip" data-testid="interactive-status-display">@dispLabel</span>
                        </div>
                    </div>

                    @* Pointer and touch *@
                    @{
                        var ptrIsSel = _selectedTestId == "pointer";
                        var ptrChip = PointerChip(ptrSnap.Verdict);
                        var ptrLabel = PointerLabel(ptrSnap.Verdict);
                        var ptrSummary = ptrSnap.Notes ?? (ptrSnap.Device is { } ptrDev
                            ? $"{ptrDev.Name}: {ptrSnap.Steps.Count(st => st.State == PointerStepState.Passed)} of {ptrSnap.Steps.Count} steps passed"
                            : "Pointer, buttons, scroll, drag, touchpad fingers and touchscreen coverage");
                    }
                    <div class="ct-row @(ptrIsSel ? "selected" : "")" role="button" tabindex="0" aria-pressed="@(ptrIsSel ? "true" : "false")"
                         data-testid="interactive-row-pointer" @onclick='() => SelectTest("pointer")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("pointer") ? "true" : "false")"
                                aria-label="Include Mouse, touchpad and touchscreen test"
                                data-testid="interactive-check-pointer"
                                @onclick='() => ToggleItem("pointer")' @onclick:stopPropagation="true">
                            @(_selected.Contains("pointer") ? "✓" : "")
                        </button>
                        <span class="dot dot-@(ptrChip == "ok" ? "ok" : ptrChip == "err" ? "critical" : ptrChip == "run" ? "running" : "na")"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Mouse, touchpad &amp; touchscreen</div>
                            <div class="ct-row-summary meta" title="@ptrSummary">@ptrSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@ptrChip" data-testid="interactive-status-pointer">@ptrLabel</span>
                        </div>
                    </div>

                    @* 3. Webcam test *@
                    @{
                        var camIsSel = _selectedTestId == "webcam";
                        var camChip = OutcomeChip(camResult.Status);
                        var camDot = DotKind(camResult.Status);
                        var camLabel = OutcomeLabel(camResult.Status);
                        var camSummary = camRunning ? "Capturing from camera…" : camResult.Status == DiagnosticStatus.NotRun ? "Inspect live camera feed, resolution, and frame rate" : camResult.Message;
                    }
                    <div class="ct-row @(camIsSel ? "selected" : "") @(camRunning ? "is-running" : "")" role="button" tabindex="0" aria-pressed="@(camIsSel ? "true" : "false")"
                         data-testid="interactive-row-webcam" @onclick='() => SelectTest("webcam")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("webcam") ? "true" : "false")"
                                aria-label="Include Webcam test"
                                data-testid="interactive-check-webcam"
                                @onclick='() => ToggleItem("webcam")' @onclick:stopPropagation="true">
                            @(_selected.Contains("webcam") ? "✓" : "")
                        </button>
                        <span class="dot dot-@camDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Webcam video stream</div>
                            <div class="ct-row-summary meta" title="@camSummary">@camSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@camChip" data-testid="interactive-status-webcam">@camLabel</span>
                        </div>
                    </div>

                    @* 4. Speaker to Microphone Loopback *@
                    @{
                        var s2mIsSel = _selectedTestId == "speakertomic";
                        var s2mChip = OutcomeChip(s2mResult.Status);
                        var s2mDot = DotKind(s2mResult.Status);
                        var s2mLabel = OutcomeLabel(s2mResult.Status);
                        var s2mSummary = s2mRunning ? "Playing tone & listening…" : s2mResult.Status == DiagnosticStatus.NotRun ? "Automatic speaker output to microphone verification" : s2mResult.Message;
                    }
                    <div class="ct-row @(s2mIsSel ? "selected" : "") @(s2mRunning ? "is-running" : "")" role="button" tabindex="0" aria-pressed="@(s2mIsSel ? "true" : "false")"
                         data-testid="interactive-row-speakertomic" @onclick='() => SelectTest("speakertomic")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("speakertomic") ? "true" : "false")"
                                aria-label="Include Speaker to Microphone test"
                                data-testid="interactive-check-speakertomic"
                                @onclick='() => ToggleItem("speakertomic")' @onclick:stopPropagation="true">
                            @(_selected.Contains("speakertomic") ? "✓" : "")
                        </button>
                        <span class="dot dot-@s2mDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Speaker to mic loopback test</div>
                            <div class="ct-row-summary meta" title="@s2mSummary">@s2mSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@s2mChip" data-testid="interactive-status-speakertomic">@s2mLabel</span>
                        </div>
                    </div>

                    @* 5. Microphone to Speaker Monitoring *@
                    @{
                        var m2sIsSel = _selectedTestId == "mictospeaker";
                        var m2sChip = OutcomeChip(m2sResult.Status);
                        var m2sDot = DotKind(m2sResult.Status);
                        var m2sLabel = OutcomeLabel(m2sResult.Status);
                        var m2sSummary = m2sRunning ? "Monitoring microphone…" : m2sResult.Status == DiagnosticStatus.NotRun ? "Live speech playback through speakers with feedback brake" : m2sResult.Message;
                    }
                    <div class="ct-row @(m2sIsSel ? "selected" : "") @(m2sRunning ? "is-running" : "")" role="button" tabindex="0" aria-pressed="@(m2sIsSel ? "true" : "false")"
                         data-testid="interactive-row-mictospeaker" @onclick='() => SelectTest("mictospeaker")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("mictospeaker") ? "true" : "false")"
                                aria-label="Include Mic to Speaker test"
                                data-testid="interactive-check-mictospeaker"
                                @onclick='() => ToggleItem("mictospeaker")' @onclick:stopPropagation="true">
                            @(_selected.Contains("mictospeaker") ? "✓" : "")
                        </button>
                        <span class="dot dot-@m2sDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Mic to speaker live monitor</div>
                            <div class="ct-row-summary meta" title="@m2sSummary">@m2sSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@m2sChip" data-testid="interactive-status-mictospeaker">@m2sLabel</span>
                        </div>
                    </div>

                    @* 6. Sound check: left/right test sound and Can't hear sound *@
                    @{
                        var scIsSel = _selectedTestId == "soundcheck";
                        var scWaiting = !scRunning && scRep is { Answer: null } && scResult.Status == DiagnosticStatus.Warning;
                        var scChip = scWaiting ? "run" : OutcomeChip(scResult.Status);
                        var scDot = scWaiting ? "running" : DotKind(scResult.Status);
                        var scLabel = scWaiting ? "Waiting for answer" : OutcomeLabel(scResult.Status);
                        var scSummary = scRunning ? "Playing the test sound…" : scResult.Status == DiagnosticStatus.NotRun ? "Left/right test sound, and help when there's no sound" : scResult.Message;
                    }
                    <div class="ct-row @(scIsSel ? "selected" : "") @(scRunning ? "is-running" : "")" role="button" tabindex="0" aria-pressed="@(scIsSel ? "true" : "false")"
                         data-testid="interactive-row-soundcheck" @onclick='() => SelectTest("soundcheck")'>
                        <button class="ct-check" role="checkbox" aria-checked="@(_selected.Contains("soundcheck") ? "true" : "false")"
                                aria-label="Include Sound check"
                                data-testid="interactive-check-soundcheck"
                                @onclick='() => ToggleItem("soundcheck")' @onclick:stopPropagation="true">
                            @(_selected.Contains("soundcheck") ? "✓" : "")
                        </button>
                        <span class="dot dot-@scDot"></span>
                        <div class="ct-row-text">
                            <div class="ct-row-name">Sound check (left and right)</div>
                            <div class="ct-row-summary meta" title="@scSummary">@scSummary</div>
                        </div>
                        <div class="ct-row-side">
                            <span class="chip chip-@scChip" data-testid="interactive-status-soundcheck">@scLabel</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="ct-splitter" role="separator" aria-orientation="vertical" aria-label="Resize panes" tabindex="0" data-testid="interactive-splitter">
            <span class="ct-grip"></span>
        </div>

        <section class="ct-detail" aria-label="Interactive test details" data-testid="interactive-detail">
            @if (_selectedTestId == "keyboard")
            {
                <PhysicalBenchQaCard Service="ActivePhysicalQa" FilterSection="keyboard" CardShell="false" IsRemoteDisplay="_isRemoteDisplay" RemoteSessionActive="RemoteSessionActive" OnOutcomeChanged="OnPhysicalQaOutcomeCompleted" />
            }
            else if (_selectedTestId == "pointer")
            {
                <PointerTestPane Service="ActivePointerTest" IsRemoteDisplay="_isRemoteDisplay" RemoteSessionActive="RemoteSessionActive" AutoStart="_isBatchRunning" />
            }
            else if (_selectedTestId == "display")
            {
                <PhysicalBenchQaCard Service="ActivePhysicalQa" FilterSection="display" CardShell="false" IsRemoteDisplay="_isRemoteDisplay" AutoLaunchDisplay="_isBatchRunning" OnOutcomeChanged="OnPhysicalQaOutcomeCompleted" />
            }
            else if (_selectedTestId == "webcam")
            {
                <div class="phys-qa-pane" data-testid="interactive-webcam-pane">
                    <div class="card-head" style="margin-bottom: 8px; flex-wrap: wrap">
                        <strong>Webcam test</strong>
                        <span class="chip chip-@camChip" data-testid="webcam-status-chip">@camLabel</span>
                        @if (camRunning)
                        {
                            <button type="button" class="btn-small" data-testid="webcam-cancel-btn" @onclick="CancelWebcam">Cancel</button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-small btn-primary"
                                    data-testid="webcam-start-btn"
                                    disabled="@(Diagnostics.IsStressSuiteRunning || _isRemoteDisplay)"
                                    title="@(_isRemoteDisplay ? "Interactive tests must run locally on the physical machine" : null)"
                                    @onclick="StartWebcamAsync">
                                @(camResult.Status == DiagnosticStatus.NotRun ? "Start test" : "Run again")
                            </button>
                        }
                    </div>

                    <p class="meta" style="margin-top: 0">
                        Opens the camera to inspect live video feed, capture resolution, frame rate, stalls, and brightness. A live preview window opens on the PC screen.
                    </p>

                    <div class="toolbar" style="margin-bottom: 4px; flex-wrap: wrap">
                        <label class="meta">Camera
                            <select data-testid="webcam-device-select" disabled="@camRunning" @onchange="OnCamDeviceChange">
                                @if (_camDevices.Count == 0)
                                {
                                    <option value="">None found</option>
                                }
                                else
                                {
                                    foreach (var d in _camDevices)
                                    {
                                        <option value="@d.Id" selected="@(d.Id == _selectedCamId)">@d.Label</option>
                                    }
                                }
                            </select>
                        </label>
                        <label class="meta">Length
                            <select data-testid="webcam-duration-select" disabled="@camRunning" @onchange="OnCamDurationChange">
                                @foreach (var d in CamDurationChoices)
                                {
                                    <option value="@((int)d.TotalSeconds)" selected="@(d == _camDuration)">@((int)d.TotalSeconds) s</option>
                                }
                            </select>
                        </label>
                        <button type="button" class="btn-small" data-testid="webcam-refresh-btn" disabled="@camRunning" @onclick="RefreshWebcamDevicesAsync">Refresh devices</button>
                    </div>

                    <p data-testid="webcam-status" class="@(camRunning ? "status-line is-running" : camResult.Status == DiagnosticStatus.Error && camRep is null ? "status-line error-text" : "status-line")">
                        <span class="@DotClass(camResult.Status)"></span>
                        <span>@(camRunning ? "Capturing from the camera…" : camResult.Status == DiagnosticStatus.NotRun ? "Not run. Press Start test to begin." : camResult.Message)</span>
                        @if (camRunning)
                        {
                            <span class="running-badge" data-testid="webcam-running-badge"><span class="running-badge-dot"></span>Running</span>
                        }
                    </p>
                    @if (camRunning)
                    {
                        <div class="run-progress run-progress-indeterminate" data-testid="webcam-run-progress" aria-hidden="true"><div></div></div>
                    }

                    @if (!camRunning && camRep?.Notice is { } camNotice)
                    {
                        <p class="notice" data-testid="webcam-notice">@camNotice</p>
                    }

                    @if (!camRunning && camRep is not null && camRep.Stats.Frames > 0)
                    {
                        <table class="detail" data-testid="webcam-table">
                            <tr><th>Camera</th><td>@camRep.Device@(camRep.Bus switch { WebcamBus.BuiltIn => " (built-in)", WebcamBus.Usb => " (USB)", _ => "" })</td></tr>
                            <tr><th>Resolution</th><td>@camRep.Width × @camRep.Height@(camRep.Format is { } f ? $" ({f})" : "")@(camRep.RequestedFps > 0 ? $", {camRep.RequestedFps:0.#} fps requested" : "")</td></tr>
                            <tr><th>Frames</th><td>@camRep.Stats.Frames in @camRep.Duration.TotalSeconds.ToString("0") s · @camRep.Stats.Fps.ToString("0.#") fps</td></tr>
                            <tr><th>Stalls / dropped</th><td>@camRep.Stats.Stalls stall(s) · ~@camRep.Stats.EstimatedDropped frame(s) dropped</td></tr>
                            <tr><th>Brightness / contrast</th><td>@camRep.Stats.MeanBrightness.ToString("0") / @camRep.Stats.MeanContrast.ToString("0.0") (0–255)</td></tr>
                            <tr><th>Sharpness</th><td>@camRep.Stats.Sharpness.ToString("0.0")</td></tr>
                        </table>
                    }

                    <label class="phys-qa-note">
                        <span class="meta">Optional webcam note (e.g. 1080p stream clear, lens clean, autofocus tested)</span>
                        <input data-testid="webcam-notes"
                               value="@_webcamNotes"
                               @oninput="OnWebcamNotesInput"
                               maxlength="240"
                               placeholder="Optional webcam note…" />
                    </label>

                    <div class="phys-qa-actions">
                        <button type="button" class="btn-small btn-primary" data-testid="webcam-pass" @onclick="() => SetWebcamOutcome(DiagnosticStatus.Ok)">Pass camera</button>
                        <button type="button" class="btn-small" data-testid="webcam-note-btn" @onclick="() => SetWebcamOutcome(DiagnosticStatus.Warning)">Pass with note</button>
                        <button type="button" class="btn-small" data-testid="webcam-fail" @onclick="() => SetWebcamOutcome(DiagnosticStatus.Error)">Fail camera</button>
                        <button type="button" class="btn-small" data-testid="webcam-reset" @onclick="ResetWebcam">Reset</button>
                    </div>
                </div>
            }
            else if (_selectedTestId == "speakertomic")
            {
                <div class="phys-qa-pane" data-testid="interactive-speakertomic-pane">
                    <div class="card-head" style="margin-bottom: 8px; flex-wrap: wrap">
                        <strong>Speaker to mic loopback test</strong>
                        <span class="chip chip-@s2mChip" data-testid="speakertomic-status-chip">@s2mLabel</span>
                        @if (s2mRunning)
                        {
                            <button type="button" class="btn-small" data-testid="speakertomic-cancel-btn" @onclick="CancelSpeakerToMic">Cancel</button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-small btn-primary"
                                    data-testid="speakertomic-start-btn"
                                    disabled="@(Diagnostics.IsStressSuiteRunning || _isRemoteDisplay)"
                                    title="@(_isRemoteDisplay ? "Interactive tests must run locally on the physical machine" : null)"
                                    @onclick="StartSpeakerToMicAsync">
                                @(s2mResult.Status == DiagnosticStatus.NotRun ? "Start test" : "Run again")
                            </button>
                        }
                    </div>

                    <p class="meta" style="margin-top: 0">
                        Plays a short 1 kHz tone through the speakers while the microphone listens to verify speaker output and microphone capture automatically.
                    </p>

                    <div class="toolbar" style="margin-bottom: 4px; flex-wrap: wrap">
                        <label class="meta">Speaker
                            <select data-testid="speakertomic-output-select" disabled="@s2mRunning" @onchange="OnAudioOutputChange">
                                @DeviceOptions(_outputs, _selectedOutputId)
                            </select>
                        </label>
                        <label class="meta">Microphone
                            <select data-testid="speakertomic-input-select" disabled="@s2mRunning" @onchange="OnAudioInputChange">
                                @DeviceOptions(_inputs, _selectedInputId)
                            </select>
                        </label>
                        <label class="meta" title="Plays the tone twice or records then plays back, for PCs that cannot do both simultaneously.">
                            <input type="checkbox" data-testid="speakertomic-halfduplex" checked="@_audioHalfDuplex" disabled="@s2mRunning"
                                   @onchange="e => _audioHalfDuplex = e.Value is true" /> Half-duplex
                        </label>
                        <button type="button" class="btn-small" data-testid="speakertomic-refresh-btn" disabled="@s2mRunning" @onclick="RefreshAudioDevicesAsync">Refresh devices</button>
                    </div>

                    <p data-testid="speakertomic-status" class="@(s2mRunning ? "status-line is-running" : s2mResult.Status == DiagnosticStatus.Error ? "status-line error-text" : "status-line")">
                        <span class="@DotClass(s2mResult.Status)"></span>
                        <span>@(s2mRunning ? "Playing the test tone and listening…" : s2mResult.Status == DiagnosticStatus.NotRun ? "Not run. Press Start test to begin." : s2mResult.Message)</span>
                        @if (s2mRunning)
                        {
                            <span class="running-badge" data-testid="speakertomic-running-badge"><span class="running-badge-dot"></span>Running</span>
                        }
                    </p>
                    @if (s2mRunning)
                    {
                        <div class="run-progress run-progress-indeterminate" data-testid="speakertomic-run-progress" aria-hidden="true"><div></div></div>
                    }

                    @if (!s2mRunning && s2mRep is not null)
                    {
                        @if (s2mRep.Notice is { } s2mNotice)
                        {
                            <p class="notice" data-testid="speakertomic-notice">@s2mNotice</p>
                        }
                        <div class="kb-stats meta" style="margin: 4px 0">
                            <span>Tone: <strong>@(s2mRep.Mic.ToneDetected ? "Detected" : "Not detected")</strong> (SNR @s2mRep.Mic.SnrDb.ToString("0.0") dB)</span>
                            <span> · Output: <strong>@Db(s2mRep.Loopback?.PeakDbfs ?? s2mRep.Mic.PeakDbfs)</strong></span>
                            <span> · Raw mic: <strong>@(s2mRep.RawMic ? "Yes" : "No")</strong></span>
                        </div>
                        @if (SoundCheck.SuggestFor(s2mRep.Verdict))
                        {
                            <p class="meta" data-testid="speakertomic-cant-hear-link">No sound? <button type="button" class="linklike" data-testid="speakertomic-open-cant-hear" @onclick="OpenCantHearAsync">Find the cause with Can't hear sound →</button></p>
                        }
                    }

                    <label class="phys-qa-note">
                        <span class="meta">Optional audio note (e.g. speakers clear, tone detected at high SNR)</span>
                        <input data-testid="speakertomic-notes"
                               value="@_audioNotes"
                               @oninput="OnAudioNotesInput"
                               maxlength="240"
                               placeholder="Optional audio note…" />
                    </label>

                    <div class="phys-qa-actions">
                        <button type="button" class="btn-small btn-primary" data-testid="speakertomic-pass" @onclick="() => SetAudioOutcome(ModuleSlugs.SpeakerToMic, DiagnosticStatus.Ok)">Pass audio</button>
                        <button type="button" class="btn-small" data-testid="speakertomic-note-btn" @onclick="() => SetAudioOutcome(ModuleSlugs.SpeakerToMic, DiagnosticStatus.Warning)">Pass with note</button>
                        <button type="button" class="btn-small" data-testid="speakertomic-fail" @onclick="() => SetAudioOutcome(ModuleSlugs.SpeakerToMic, DiagnosticStatus.Error)">Fail audio</button>
                        <button type="button" class="btn-small" data-testid="speakertomic-reset" @onclick="ResetAudio">Reset</button>
                    </div>
                </div>
            }
            else if (_selectedTestId == "mictospeaker")
            {
                <div class="phys-qa-pane" data-testid="interactive-mictospeaker-pane">
                    <div class="card-head" style="margin-bottom: 8px; flex-wrap: wrap">
                        <strong>Mic to speaker live monitor</strong>
                        <span class="chip chip-@m2sChip" data-testid="mictospeaker-status-chip">@m2sLabel</span>
                        @if (m2sRunning)
                        {
                            <button type="button" class="btn-small" data-testid="mictospeaker-cancel-btn" @onclick="CancelMicToSpeaker">Cancel</button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-small btn-primary"
                                    data-testid="mictospeaker-start-btn"
                                    disabled="@(Diagnostics.IsStressSuiteRunning || _isRemoteDisplay)"
                                    title="@(_isRemoteDisplay ? "Interactive tests must run locally on the physical machine" : null)"
                                    @onclick="StartMicToSpeakerAsync">
                                @(m2sResult.Status == DiagnosticStatus.NotRun ? "Start monitor" : "Run again")
                            </button>
                        }
                    </div>

                    <p class="meta" style="margin-top: 0">
                        Plays the microphone through the speakers so someone at the PC can speak and hear themselves live (or recorded in half-duplex). Capped volume and automatic feedback brake.
                    </p>

                    <div class="toolbar" style="margin-bottom: 4px; flex-wrap: wrap">
                        <label class="meta">Speaker
                            <select data-testid="mictospeaker-output-select" disabled="@m2sRunning" @onchange="OnAudioOutputChange">
                                @DeviceOptions(_outputs, _selectedOutputId)
                            </select>
                        </label>
                        <label class="meta">Microphone
                            <select data-testid="mictospeaker-input-select" disabled="@m2sRunning" @onchange="OnAudioInputChange">
                                @DeviceOptions(_inputs, _selectedInputId)
                            </select>
                        </label>
                        <label class="meta" title="Plays the tone twice or records then plays back, for PCs that cannot do both simultaneously.">
                            <input type="checkbox" data-testid="mictospeaker-halfduplex" checked="@_audioHalfDuplex" disabled="@m2sRunning"
                                   @onchange="e => _audioHalfDuplex = e.Value is true" /> Half-duplex
                        </label>
                        <button type="button" class="btn-small" data-testid="mictospeaker-refresh-btn" disabled="@m2sRunning" @onclick="RefreshAudioDevicesAsync">Refresh devices</button>
                    </div>

                    <p data-testid="mictospeaker-status" class="@(m2sRunning ? "status-line is-running" : m2sResult.Status == DiagnosticStatus.Error ? "status-line error-text" : "status-line")">
                        <span class="@DotClass(m2sResult.Status)"></span>
                        <span>@(m2sRunning ? (_audioHalfDuplex ? "Recording, then playing it back… speak now." : "Playing the microphone through the speaker… speak now.") : m2sResult.Status == DiagnosticStatus.NotRun ? "Not run. Press Start monitor to begin." : m2sResult.Message)</span>
                        @if (m2sRunning)
                        {
                            <span class="running-badge" data-testid="mictospeaker-running-badge"><span class="running-badge-dot"></span>Running</span>
                        }
                    </p>
                    @if (m2sRunning)
                    {
                        <div class="run-progress run-progress-indeterminate" data-testid="mictospeaker-run-progress" aria-hidden="true"><div></div></div>
                    }

                    @if (!m2sRunning && m2sRep is not null)
                    {
                        @if (m2sRep.Notice is { } m2sNotice)
                        {
                            <p class="notice" data-testid="mictospeaker-notice">@m2sNotice</p>
                        }
                        <div class="kb-stats meta" style="margin: 4px 0">
                            <span>Microphone peak: <strong>@Db(m2sRep.MicPeakDbfs)</strong></span>
                            <span> · RMS: <strong>@Db(m2sRep.MicRmsDbfs)</strong></span>
                            @if (m2sRep.FeedbackDetected)
                            {
                                <span> · <strong class="error-text">Feedback detected</strong></span>
                            }
                        </div>
                        @if (m2sRep.MicHeardSomething && !m2sRep.FeedbackDetected)
                        {
                            <div class="toolbar" style="margin-top: 4px; align-items: center">
                                <span class="meta">Did the person at the PC hear the microphone through @m2sRep.Output?</span>
                                <button type="button"
                                        class="btn-small @(m2sRep.HeardByListener == true ? "btn-primary" : "")"
                                        data-testid="audio-heard"
                                        @onclick="() => ConfirmAudioHeard(true)">
                                    I heard it
                                </button>
                                <button type="button"
                                        class="btn-small @(m2sRep.HeardByListener == false ? "btn-primary" : "")"
                                        data-testid="audio-not-heard"
                                        @onclick="() => ConfirmAudioHeard(false)">
                                    I didn't hear it
                                </button>
                            </div>
                        }
                    }

                    <label class="phys-qa-note">
                        <span class="meta">Optional monitor note (e.g. microphone clear, no latency or echo)</span>
                        <input data-testid="mictospeaker-notes"
                               value="@_audioNotes"
                               @oninput="OnAudioNotesInput"
                               maxlength="240"
                               placeholder="Optional audio note…" />
                    </label>

                    <div class="phys-qa-actions">
                        <button type="button" class="btn-small btn-primary" data-testid="mictospeaker-pass" @onclick="() => SetAudioOutcome(ModuleSlugs.MicToSpeaker, DiagnosticStatus.Ok)">Pass audio</button>
                        <button type="button" class="btn-small" data-testid="mictospeaker-note-btn" @onclick="() => SetAudioOutcome(ModuleSlugs.MicToSpeaker, DiagnosticStatus.Warning)">Pass with note</button>
                        <button type="button" class="btn-small" data-testid="mictospeaker-fail" @onclick="() => SetAudioOutcome(ModuleSlugs.MicToSpeaker, DiagnosticStatus.Error)">Fail audio</button>
                        <button type="button" class="btn-small" data-testid="mictospeaker-reset" @onclick="ResetAudio">Reset</button>
                    </div>
                </div>
            }
            else if (_selectedTestId == "soundcheck")
            {
                var scLeftDone = scRunning && (scResult.Message ?? "").Contains("right", StringComparison.OrdinalIgnoreCase);
                <div class="phys-qa-pane" data-testid="interactive-soundcheck-pane">
                    <div class="card-head" style="margin-bottom: 8px; flex-wrap: wrap">
                        <strong>Sound check (left and right)</strong>
                        <span class="chip chip-@(scRep is { Answer: null } && !scRunning && scResult.Status == DiagnosticStatus.Warning ? "run" : OutcomeChip(scResult.Status))" data-testid="soundcheck-status-chip">
                            @(scRep is { Answer: null } && !scRunning && scResult.Status == DiagnosticStatus.Warning ? "Waiting for answer" : OutcomeLabel(scResult.Status))
                        </span>
                        @if (scRunning)
                        {
                            <button type="button" class="btn-small" data-testid="soundcheck-cancel-btn" @onclick="CancelSoundCheck">Cancel</button>
                        }
                    </div>
                    <p class="meta" style="margin-top: 0">Plays a short chime on the left speaker, then the right. Say what you heard. Mute and volume are left as they are.</p>
                    <div class="toolbar">
                        <label class="meta">Speaker
                            <select data-testid="soundcheck-output-select" disabled="@scRunning" @onchange="OnAudioOutputChange">
                                @DeviceOptions(_outputs, _selectedOutputId)
                            </select>
                        </label>
                        <button type="button" class="btn-small btn-primary" data-testid="soundcheck-play-btn"
                                disabled="@(scRunning || Diagnostics.IsStressSuiteRunning)" @onclick="StartSoundCheckAsync">
                            ▶ @(scResult.Status == DiagnosticStatus.NotRun ? "Play test sound" : "Play again")
                        </button>
                    </div>
                    <div class="sc-lr" data-testid="soundcheck-sides">
                        <div class="sc-side @(scRunning && !scLeftDone ? "on" : "")" data-testid="soundcheck-side-left">Left<b>@(scRunning ? scLeftDone ? "✓ played" : "♪ playing…" : scRep?.Answer is SoundCheckAnswer.Both or SoundCheckAnswer.OnlyLeft ? "Heard" : scRep?.Answer is not null ? "Not heard" : "")</b></div>
                        <div class="sc-side @(scLeftDone ? "on" : "")" data-testid="soundcheck-side-right">Right<b>@(scLeftDone ? "♪ playing…" : scRep?.Answer is SoundCheckAnswer.Both or SoundCheckAnswer.OnlyRight ? "Heard" : scRep?.Answer is not null ? "Not heard" : "")</b></div>
                    </div>
                    @if (!scRunning && scRep?.Notice is { } scNotice) { <p class="notice" data-testid="soundcheck-notice">@scNotice</p> }
                    <p data-testid="soundcheck-status" class="status-line"><span class="@DotClass(scResult.Status)"></span><span>@(scRunning ? "Playing the test sound…" : scResult.Status == DiagnosticStatus.NotRun ? "Not run. Press Play test sound to begin." : scResult.Message)</span></p>
                    @if (!scRunning && scRep is not null)
                    {
                        <strong class="sc-q">What did you hear?</strong>
                        <div class="phys-qa-actions" data-testid="soundcheck-answers">
                            @foreach (var (ans, text, id) in AnswerButtons)
                            {
                                <button type="button" class="btn-small @(scRep.Answer == ans ? "btn-primary" : "")" data-testid="soundcheck-answer-@id" data-answer="@id"
                                        aria-pressed="@(scRep.Answer == ans ? "true" : "false")" @onclick="() => AnswerSoundCheckAsync(ans)">@text</button>
                            }
                        </div>
                    }

                    @if (_soundHelp is not null)
                    {
                        <div class="sc-help" data-testid="soundcheck-help" data-mode="@_soundHelp">
                            <div class="card-head"><strong>@(_soundHelp == "one-side" ? "Only one side heard" : "Can't hear sound")</strong>
                                @if (!soundReading && soundRep is not null)
                                {
                                    <span class="chip chip-@(scSteps.Any(s => s.Row.Level >= AreaLevel.Warning) ? "warn" : "ok")" data-testid="soundcheck-help-chip">
                                        @(scSteps.Count(s => s.Row.Level >= AreaLevel.Warning || s.Row.Actions is { Count: > 0 }) is var n and > 0 ? $"{n} thing{(n == 1 ? "" : "s")} to try" : "Nothing found")
                                    </span>
                                }
                            </div>
                            @if (soundReading)
                            {
                                <p class="status-line is-running" data-testid="soundcheck-help-reading"><span class="dot dot-running"></span><span>Checking the sound settings…</span></p>
                            }
                            else if (soundRep is null)
                            {
                                <p class="meta" data-testid="soundcheck-help-unread">@(soundResult.Status == DiagnosticStatus.Error ? soundResult.Message : "The sound settings couldn't be read.")</p>
                            }
                            else
                            {
                                <p class="meta">@(_soundHelp == "one-side" ? "One side missing points to a speaker, earbud or cable, or to the balance or mono audio." : "Try these in order. Play the test sound again after each one.")</p>
                                <ul class="sc-steps" data-testid="soundcheck-steps">
                                    @if (_soundHelp == "cant-hear" && scServicesOk)
                                    {
                                        <li class="done" data-testid="soundcheck-step-services-ok"><div class="sc-step-text"><b>Windows Audio services</b><div class="meta">Running.</div></div></li>
                                    }
                                    @foreach (var step in scSteps)
                                    {
                                        <li class="@(step.Row.Level <= AreaLevel.Ok ? "done" : "")" data-testid="soundcheck-step" data-card-id="@step.CardId" data-row-key="@step.Row.Key" data-level="@step.Row.Level.ToString().ToLowerInvariant()">
                                            <div class="sc-step-text">
                                                <b>@step.Title</b>
                                                @if (step.Text.Length > 0) { <div class="meta">@step.Text</div> }
                                                @if (App.Remediation is not null && FixAccess.Offerable(step.Row.Actions, App.AgentFixes) is { Count: > 0 } acts)
                                                {
                                                    <div class="phys-qa-actions">
                                                        @foreach (var a in acts)
                                                        {
                                                            <button type="button" class="btn-small btn-primary" data-testid="soundcheck-fix-@a.Kind" data-action="remediate" data-card-id="@step.CardId"
                                                                    data-row-key="@step.Row.Key" data-action-kind="@a.Kind" data-action-target="@a.Target" @onclick="() => _soundFixUi?.Ask(a, step.CardId)">@a.ButtonText</button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </li>
                                    }
                                    @if (_soundHelp == "one-side")
                                    {
                                        <li data-testid="soundcheck-step-hardware"><div class="sc-step-text"><b>Still only one side?</b><div class="meta">The speaker on the silent side, the headphone cable or one earbud is likely faulty. Try other headphones to tell which.</div></div></li>
                                    }
                                    else if (scSteps.Count == 0)
                                    {
                                        <li data-testid="soundcheck-step-app"><div class="sc-step-text"><b>The speakers and Windows Audio look fine</b><div class="meta">If one app is still silent, it's probably set to another device or turned down in its own settings. Run Speaker to mic to confirm the speakers play.</div></div></li>
                                    }
                                </ul>
                                <div class="phys-qa-actions">
                                    <button type="button" class="btn-small" data-testid="soundcheck-help-play" disabled="@(scRunning || Diagnostics.IsStressSuiteRunning)" @onclick="StartSoundCheckAsync">▶ Play test sound</button>
                                    @if (_soundHelp == "cant-hear")
                                    {
                                        <button type="button" class="btn-small" data-testid="soundcheck-help-s2m" disabled="@(s2mRunning || Diagnostics.IsStressSuiteRunning || _isRemoteDisplay)" @onclick="RunSpeakerToMicFromHelpAsync">Run Speaker to mic</button>
                                    }
                                    <button type="button" class="btn-small" data-testid="soundcheck-help-refresh" disabled="@soundReading" @onclick="() => Diagnostics.RunAsync(ModuleSlugs.Sound)">Check again</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sc-help" data-testid="soundcheck-cant-hear-section">
                            <strong>No sound at all?</strong>
                            <p class="meta" style="margin: 2px 0 6px">Finds what's stopping sound and lists the fixes in the order to try them.</p>
                            <button type="button" class="btn-small" data-testid="soundcheck-cant-hear-btn" @onclick="OpenCantHearAsync">Can't hear sound</button>
                        </div>
                    }
                    @if (App.Remediation is not null)
                    {
                        <RemediationActions @ref="_soundFixUi" Actions="App.Remediation" ShowRecent="false" Origin="@ModuleSlugs.Sound" OnStateChanged="StateHasChanged"
                                            OnCompleted="() => Diagnostics.RefreshQuietlyAsync(ModuleSlugs.Sound)" />
                    }

                    <label class="phys-qa-note">
                        <span class="meta">Optional note (e.g. right earbud crackles)</span>
                        <input data-testid="soundcheck-notes" value="@_soundNotes" @oninput="e => _soundNotes = e.Value?.ToString() ?? string.Empty" maxlength="240" placeholder="Optional note…" />
                    </label>
                    <div class="phys-qa-actions">
                        <button type="button" class="btn-small" data-testid="soundcheck-note-btn" @onclick="() => SetAudioOutcome(ModuleSlugs.SoundCheck, DiagnosticStatus.Warning, _soundNotes)">Pass with note</button>
                        <button type="button" class="btn-small" data-testid="soundcheck-fail" @onclick="() => SetAudioOutcome(ModuleSlugs.SoundCheck, DiagnosticStatus.Error, _soundNotes)">Fail with note</button>
                        <button type="button" class="btn-small" data-testid="soundcheck-reset" @onclick="ResetSoundCheck">Reset</button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private readonly PhysicalBenchQaService _fallbackPhysicalQa = new();
    private PhysicalBenchQaService ActivePhysicalQa => App.PhysicalQa ?? _fallbackPhysicalQa;

    private PointerTestService? _fallbackPointerTest;
    private PointerTestService ActivePointerTest => App.PointerTest ?? (_fallbackPointerTest ??= new PointerTestService(App.PhysicalInput));
    private bool RemoteSessionActive => Session.Mode == SessionMode.Remote || _hasRemoteSession;

    private static readonly string[] AllTestIds = ["keyboard", "display", "pointer", "webcam", "speakertomic", "mictospeaker", "soundcheck"];
    private readonly HashSet<string> _selected = new(["keyboard", "display", "pointer", "webcam", "speakertomic", "mictospeaker", "soundcheck"], StringComparer.OrdinalIgnoreCase);

    /// <summary>Opens a test's pane from a link ("interactive?test=soundcheck"); help=cant-hear also opens the Can't hear sound list.</summary>
    [SupplyParameterFromQuery(Name = "test")] public string? TestQuery { get; set; }
    [SupplyParameterFromQuery(Name = "help")] public string? HelpQuery { get; set; }

    // The Sound check pane's list: "cant-hear", "one-side" or null.
    private string? _soundHelp;
    private string _soundNotes = "";
    private RemediationActions? _soundFixUi;
    private static readonly (SoundCheckAnswer Answer, string Text, string Id)[] AnswerButtons =
        [(SoundCheckAnswer.Both, "Heard both", "both"), (SoundCheckAnswer.OnlyLeft, "Only left", "only-left"),
         (SoundCheckAnswer.OnlyRight, "Only right", "only-right"), (SoundCheckAnswer.Nothing, "Nothing", "nothing")];
    private string _selectedTestId = "keyboard";

    private static readonly TimeSpan[] CamDurationChoices = [TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10)];
    private IReadOnlyList<WebcamDevice> _camDevices = [];
    private string? _selectedCamId;
    private TimeSpan _camDuration = TimeSpan.FromSeconds(5);
    private string _webcamNotes = "";

    // Results whose verdict a person entered with the Pass/Fail buttons, so the agent copy can tell them from a measured result.
    private readonly Dictionary<string, DiagnosticResult> _personResults = new(StringComparer.Ordinal);

    private InteractiveExport.ModuleState PersonState(DiagnosticResult r) =>
        new(r, _personResults.TryGetValue(r.ModuleName, out var entered) && ReferenceEquals(entered, r));

    /// <summary>The page's state for browser agents (interactive-data): measured evidence and person-entered verdicts kept apart.</summary>
    private string InteractiveJson(RemotePCDiagnostics.Core.Workflow.PhysicalBenchQaSnapshot kb, DiagnosticResult cam, DiagnosticResult s2m, DiagnosticResult m2s,
        DiagnosticResult sc, InteractiveExport.SoundCheckHelp help) =>
        InteractiveExport.ToJson(
            new InteractiveExport.PageState(_selectedTestId, _selected, _isBatchRunning, _isRemoteDisplay, Session.Mode == SessionMode.Remote || _hasRemoteSession, _technicianHasControl),
            kb, PersonState(cam), PersonState(s2m), PersonState(m2s), PersonState(sc), help, ActivePointerTest.Current);

    private IReadOnlyList<AudioDevice> _outputs = [];
    private IReadOnlyList<AudioDevice> _inputs = [];
    private string? _selectedOutputId;
    private string? _selectedInputId;
    private bool _audioHalfDuplex;
    private string _audioNotes = "";

    public sealed class RemoteControlInfo
    {
        public bool IsRemoteDisplay { get; set; }
        public bool HasRemoteSession { get; set; }
        public bool TechnicianHasControl { get; set; }
        public bool LocalHasControl { get; set; }
    }

    private DotNetObjectReference<InteractiveTestsPage>? _dotNetRef;
    private bool _isRemoteDisplay;
    private bool _hasRemoteSession;
    private bool _technicianHasControl;
    private bool _isBatchRunning;
    private CancellationTokenSource? _batchCts;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadDevices();
        // The row's chip and interactive-data follow the pointer test as it runs.
        ActivePointerTest.Changed += OnPointerTestChanged;
        if (TestQuery is { Length: > 0 } t && AllTestIds.Contains(t, StringComparer.OrdinalIgnoreCase)) _selectedTestId = t.ToLowerInvariant();
        if (_selectedTestId == "soundcheck" && HelpQuery == "cant-hear") _ = OpenCantHearAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("rpdSplit.init"); } catch { }
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("rpdSession.subscribeControl", _dotNetRef);
        }
        catch { }
    }

    [JSInvokable]
    public void OnControlStateChanged(RemoteControlInfo? info)
    {
        if (info is null) return;
        _isRemoteDisplay = info.IsRemoteDisplay;
        _hasRemoteSession = info.HasRemoteSession;
        _technicianHasControl = info.TechnicianHasControl;
        InvokeAsync(StateHasChanged);
    }

    private async Task ReleaseControlAsync()
    {
        try { await JS.InvokeVoidAsync("rpdSession.releaseControlToLocal"); } catch { }
    }

    private void OnPointerTestChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        base.Dispose();
        ActivePointerTest.Changed -= OnPointerTestChanged;
        _batchCts?.Cancel();
        _interactiveWaitTcs?.TrySetCanceled();
        _batchCts?.Dispose();
        _batchCts = null;
        if (_dotNetRef is not null)
        {
            try { _ = JS.InvokeVoidAsync("rpdSession.unsubscribeControl", _dotNetRef); } catch { }
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private void SelectTest(string id)
    {
        _selectedTestId = id;
    }

    private void ToggleItem(string id)
    {
        if (_selected.Contains(id)) _selected.Remove(id);
        else _selected.Add(id);
    }

    private void ToggleSelectAll()
    {
        if (_selected.Count == AllTestIds.Length)
            _selected.Clear();
        else
        {
            _selected.Clear();
            foreach (var id in AllTestIds) _selected.Add(id);
        }
    }

    private string? _waitingTestId;
    private TaskCompletionSource<bool>? _interactiveWaitTcs;

    private void OnPhysicalQaOutcomeCompleted(string section, PhysicalCheckOutcome outcome)
    {
        if (outcome != PhysicalCheckOutcome.NotRun && (_waitingTestId == null || string.Equals(section, _waitingTestId, StringComparison.OrdinalIgnoreCase)))
            _interactiveWaitTcs?.TrySetResult(true);
    }

    private async Task WaitForPhysicalQaAsync(string testId, CancellationToken ct)
    {
        var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _interactiveWaitTcs = tcs;
        _waitingTestId = testId;

        // Reset the target test outcome to NotRun for this run so stale previous results do not skip the test
        if (testId == "keyboard")
        {
            ActivePhysicalQa.Update(s => s with { KeyboardOutcome = PhysicalCheckOutcome.NotRun });
        }
        else if (testId == "display")
        {
            ActivePhysicalQa.Update(s => s with { DisplayOutcome = PhysicalCheckOutcome.NotRun });
        }

        void OnChanged()
        {
            var snap = ActivePhysicalQa.Current;
            var currentOutcome = testId == "keyboard" ? snap.KeyboardOutcome : snap.DisplayOutcome;
            if (currentOutcome is PhysicalCheckOutcome.Passed or PhysicalCheckOutcome.PassedWithNote or PhysicalCheckOutcome.Failed)
            {
                tcs.TrySetResult(true);
            }
        }

        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        ActivePhysicalQa.Changed += OnChanged;
        try
        {
            await tcs.Task;
        }
        finally
        {
            ActivePhysicalQa.Changed -= OnChanged;
            if (ReferenceEquals(_interactiveWaitTcs, tcs))
            {
                _interactiveWaitTcs = null;
                _waitingTestId = null;
            }
        }
    }

    /// <summary>Run selected: the pane starts the test when it opens; waits until it ends (passed, failed, skipped or stopped).</summary>
    private async Task WaitForPointerTestAsync(CancellationToken ct)
    {
        var tcs = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        var started = false;
        void OnChanged()
        {
            var v = ActivePointerTest.Current.Verdict;
            if (v == PointerTestVerdict.Running) started = true;
            else if (started) tcs.TrySetResult();
        }
        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        ActivePointerTest.Changed += OnChanged;
        try
        {
            await InvokeAsync(StateHasChanged);
            await tcs.Task;
        }
        finally
        {
            ActivePointerTest.Changed -= OnChanged;
        }
    }

