    private async Task StartWebcamAsync()
    {
        if (Diagnostics.IsStressSuiteRunning) return;
        var cam = GetWebcamModule();
        if (cam is not null)
        {
            cam.DeviceId = _selectedCamId;
            cam.Duration = _camDuration;
            if (_selectedCamId is not null)
            {
                var dev = _camDevices.FirstOrDefault(d => d.Id == _selectedCamId);
                if (dev is not null)
                {
                    var key = InstanceKeys.From(dev.Id);
                    if (!Diagnostics.InstancesOf(cam).Any(i => i.Key == key))
                        await Diagnostics.RedetectAsync();
                    await Diagnostics.RunInstanceAsync(cam.Name, key);
                    return;
                }
            }
            await Diagnostics.RunAsync(cam.Name);
        }
        else
        {
            await Diagnostics.RunAsync(ModuleSlugs.Webcam);
        }
    }

