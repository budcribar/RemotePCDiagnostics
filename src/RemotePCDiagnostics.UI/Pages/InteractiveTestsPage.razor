        {
            DiagnosticStatus.Ok => "Webcam verified by technician",
            DiagnosticStatus.Warning => "Webcam passed with notes",
            DiagnosticStatus.Error => "Webcam failed inspection",
            _ => "Not run"
        });
        var entered = new DiagnosticResult(ModuleSlugs.Webcam, status, msg, DateTimeOffset.Now, r.Payload);
        Store.Set(entered);
        _personResults[ModuleSlugs.Webcam] = entered;
    }

