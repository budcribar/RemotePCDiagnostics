    private string? _waitingTestId;
    private TaskCompletionSource<bool>? _interactiveWaitTcs;

    private void OnPhysicalQaOutcomeCompleted(string section, PhysicalCheckOutcome outcome)
    {
        if (outcome != PhysicalCheckOutcome.NotRun && (_waitingTestId == null || string.Equals(section, _waitingTestId, StringComparison.OrdinalIgnoreCase)))
            _interactiveWaitTcs?.TrySetResult(true);
    }

    private async Task WaitForPhysicalQaAsync(string testId, CancellationToken ct)
    {
        var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _interactiveWaitTcs = tcs;
        _waitingTestId = testId;

        // Reset the target test outcome to NotRun for this run so stale previous results do not skip the test
        if (testId == "keyboard")
        {
            ActivePhysicalQa.Update(s => s with { KeyboardOutcome = PhysicalCheckOutcome.NotRun });
        }
        else if (testId == "display")
        {
            ActivePhysicalQa.Update(s => s with { DisplayOutcome = PhysicalCheckOutcome.NotRun });
        }

        void OnChanged()
        {
            var snap = ActivePhysicalQa.Current;
            var currentOutcome = testId == "keyboard" ? snap.KeyboardOutcome : snap.DisplayOutcome;
            if (currentOutcome is PhysicalCheckOutcome.Passed or PhysicalCheckOutcome.PassedWithNote or PhysicalCheckOutcome.Failed)
            {
                tcs.TrySetResult(true);
            }
        }

        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        ActivePhysicalQa.Changed += OnChanged;
        try
        {
            await tcs.Task;
        }
        finally
        {
            ActivePhysicalQa.Changed -= OnChanged;
            if (ReferenceEquals(_interactiveWaitTcs, tcs))
            {
                _interactiveWaitTcs = null;
                _waitingTestId = null;
            }
        }
    }

    private async Task RunSelectedAsync()
    {
        if (Diagnostics.IsStressSuiteRunning || _isBatchRunning || _isRemoteDisplay) return;

        _isBatchRunning = true;
        _batchCts = new CancellationTokenSource();
        var ct = _batchCts.Token;

        try
        {
            foreach (var id in AllTestIds)
            {
                if (!_selected.Contains(id) || ct.IsCancellationRequested) continue;

                _selectedTestId = id;

                switch (id)
                {
                    case "keyboard":
                        await WaitForPhysicalQaAsync("keyboard", ct);
                        break;
                    case "display":
                        await WaitForPhysicalQaAsync("display", ct);
                        break;
                    case "webcam":
                        await StartWebcamAsync();
                        break;
                    case "speakertomic":
                        await StartSpeakerToMicAsync();
                        break;
                    case "mictospeaker":
                        await StartMicToSpeakerAsync();
                        break;
                    case "soundcheck":
                        await StartSoundCheckAsync();
                        break;
                    case "charger":
                        await StartChargerAsync();
                        break;
                    case "wifi":
                        await StartWifiAsync();
                        break;
                    case "ethernet":
                        await StartEthernetAsync();
                        break;
                    case "usbports":
                        await StartUsbPortCheckAsync();
                        break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isBatchRunning = false;
            _batchCts?.Dispose();
            _batchCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopRunning()
    {
        _batchCts?.Cancel();
        _interactiveWaitTcs?.TrySetCanceled();
        CancelWebcam();
        CancelSpeakerToMic();
        CancelMicToSpeaker();
        CancelSoundCheck();
        CancelCharger();
        CancelWifi();
        CancelEthernet();
        CancelUsbPortCheck();
        Diagnostics.CancelStressSuite();
    }

