@using RemotePCDiagnostics.Core.Sensors
@inherits ModuleDetailsBase
@implements IAsyncDisposable
@{
    var r = Shown();
    var report = r.Payload as SensorReport;
}
<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="temp" Size="20" /></span><h1 data-testid="lhm-title">Temperatures &amp; fans</h1>
</div>
<p data-testid="lhm-status" class="status-line">
    <span class="@DotClass(r.Status)"></span>
    <span class="status-text">@if (r.Status is DiagnosticStatus.NotRun or DiagnosticStatus.Running && report is null) { <span>Checking temperatures and fan speeds…</span> } else { <CardList Text="@r.Message" Strong="true" /> }</span>
    @if (report is not null) { <button class="btn-small status-action" data-testid="lhm-requery" disabled="@_busy" @onclick="Refresh">Check again</button> }
</p>

@if (report is null && r.Status != DiagnosticStatus.Running)
{
    <p class="meta">Checking temperatures and fan speeds… (updates every 5 seconds)</p>
}
@if (report?.Snapshot.Note is { } note)
{
    <div class="notice notice-error">@note</div>
}

@if (report is not null)
{
    <div class="cards">
        @foreach (var g in report.VisibleGroups)
        {
            <div @key="g.Id" class="card card-click" data-testid="lhm-card-@g.Id" role="button" tabindex="0"
                 @onclick="() => _open = g.Id" @onkeydown='e => { if (e.Key is "Enter" or " ") _open = g.Id; }'>
                <div class="card-head"><span class="@LevelClass(g.Level)"></span><strong>@g.Title</strong></div>
                @if (g.Readings.Count == 0) { <div class="headline">No sensors</div> }
                else if (g.Id == "fans")
                {
                    var rpm = g.Readings.Where(x => x.Reading.Value is > 0).ToList();
                    <div class="headline">@rpm.Count of @g.Readings.Count spinning</div>
                    <CardList Items="@rpm.Take(3).Select(x => $"{x.Reading.Value:0} RPM")" />
                }
                else
                {
                    <div class="headline">Hottest @(g.Hottest is { } h ? $"{h:0.0}°C" : "—")</div>
                    @if (g.Readings.Any(x => x.Reading.IsApproximate)) { <div class="meta" data-testid="lhm-approx">Estimate (from Windows)</div> }
                    @if (g.Readings.Any(x => x.Reading.IsFromWindows)) { <div class="meta" data-testid="lhm-from-windows">From Windows (GPU driver)</div> }
                    <CardList Items="@([ $"{g.Readings.Count} sensor(s)", .. g.Readings.Select(x => x.Reading.HardwareName).Distinct().Take(2) ])" />
                }
                <div class="meta card-foot">Click for details</div>
            </div>
        }
    </div>
    @if (report.VisibleGroups.Count == 0)
    {
        <p class="meta" data-testid="lhm-none">@r.Message</p>
    }
    @if (report.MissingText is { } missing)
    {
        <p class="meta" data-testid="lhm-missing">@missing</p>
    }
    @if (report.Snapshot.CpuNote is { } cpuNote)
    {
        <p class="meta" data-testid="lhm-cpu-note">@cpuNote</p>
    }

    @if (_open is not null && report.Groups.FirstOrDefault(g => g.Id == _open) is { } open)
    {
        <div class="drawer-backdrop" @onclick="() => _open = null"></div>
        <aside class="drawer" role="dialog" aria-modal="true" aria-label="@open.Title" tabindex="-1" @onkeydown='e => { if (e.Key == "Escape") _open = null; }' data-testid="lhm-drawer-@open.Id">
            <div class="drawer-head"><strong title="@open.Title">@open.Title</strong><button data-testid="lhm-drawer-close" @onclick="() => _open = null">Close</button></div>
            @if (open.Readings.Count == 0) { <p class="meta">Nothing to show here.</p> }
            else
            {
                <table class="detail grid sticky-head">
                    <tr><th>Device</th><th>Reading</th><th>Value</th><th>Min</th><th>Max</th><th>Warning / critical</th></tr>
                    @foreach (var e in open.Readings)
                    {
                        <tr @key="(e.Reading.HardwareName, e.Reading.SensorName)">
                            <td>@e.Reading.FriendlyDevice</td>
                            <td><span class="@LevelClass(e.Level)"></span>@e.Reading.FriendlyName
                                @if (e.Reading.FriendlyName != e.Reading.SensorName) { <div class="meta">@e.Reading.SensorName</div> }</td>
                            <td>@Fmt(e.Reading.Value, e.Reading.Unit)</td>
                            <td>@Fmt(e.Reading.Min, e.Reading.Unit)</td>
                            <td>@Fmt(e.Reading.Max, e.Reading.Unit)</td>
                            <td title="@e.Threshold?.Basis">@(e.Reading.IsLimit ? "Reported by the drive" : e.Threshold is { } t ? $"{t.Warning:0} / {t.Critical:0} °C" : "No limit set")</td>
                        </tr>
                    }
                </table>
            }
        </aside>
    }
}

@code {
    private string? _openId;
    private string? _open { get => _openId; set { _openId = value; _uiDirty = true; } }
    private bool _busy;        // a read is in flight; no overlap
    private bool _uiDirty = true;
    private string? _lastSig;
    private DiagnosticResult? _lastDone;

    /// <summary>Latest finished result; while a read runs, keep showing the previous data (no flashing/loading state).</summary>
    private DiagnosticResult Shown()
    {
        var cur = Store.Get(LibreHardwareMonitorModule.ModuleName);
        if (cur.Status != DiagnosticStatus.Running) { _lastDone = cur; return cur; }
        return _lastDone ?? cur;
    }

    protected override bool ShouldRender()
    {
        var shown = Shown();
        var sig = SensorReport.Signature(shown.Status.ToString(), shown.Message, shown.Payload as SensorReport);
        if (!_uiDirty && sig == _lastSig) return false;
        _uiDirty = false; _lastSig = sig;
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = RunTimer(); // always refreshes every 5 s until the page closes
    }
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    private async Task Refresh()
    {
        if (_busy) return;
        _busy = true;
        try { await Diagnostics.RunAsync(LibreHardwareMonitorModule.ModuleName); }
        finally { _busy = false; }
    }

    private async Task RunTimer()
    {
        var cts = new CancellationTokenSource();
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        _cts = cts;
        _timer = timer;

        try
        {
            await Refresh();
            while (await timer.WaitForNextTickAsync(cts.Token))
                if (!_busy && Store.Get(LibreHardwareMonitorModule.ModuleName).Status != DiagnosticStatus.Running) await Refresh();
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Diagnostics.Log?.Invoke($"Sensor page timer error: {ex.Message}"); }
        finally
        {
            if (ReferenceEquals(_cts, cts)) _cts = null;
            if (ReferenceEquals(_timer, timer)) _timer = null;
            timer.Dispose();
            cts.Dispose();
        }
    }

    private void StopTimer()
    {
        var cts = _cts;
        var timer = _timer;

        _cts = null;
        _timer = null;

        cts?.Cancel();
        timer?.Dispose();
    }

    public ValueTask DisposeAsync() { StopTimer(); Dispose(); return ValueTask.CompletedTask; }

    // ...

    private static string LevelClass(SensorLevel l) => l switch
    {
        SensorLevel.Ok => "dot dot-ok", SensorLevel.Warning => "dot dot-warning", SensorLevel.Critical => "dot dot-error", _ => "dot dot-neutral",
    };
    private static string Fmt(double? v, string unit) => v is null ? "—" : unit == "RPM" ? $"{v:0} RPM" : $"{v:0.0} {unit}";
}
