@page "/module/cpustress"
@using RemotePCDiagnostics.Core.Stress
@inherits StoreAwareComponent
@implements IAsyncDisposable
@{
    var r = Store.Get(CpuStressModule.ModuleName);
    var running = r.Status == DiagnosticStatus.Running;
    var report = r.Payload as CpuStressReport;
    var p = running ? Module?.LastProgress : null;
}
<div class="toolbar">
    <h1 data-testid="cpustress-title">CPU stress test</h1>
    <label class="meta">Run for
        <select data-testid="cpustress-duration" disabled="@running" @onchange="SetDuration">
            @foreach (var d in CpuStressOptions.DurationChoices)
            {
                <option value="@d.TotalMinutes" selected="@(d == _duration)">@Minutes(d)</option>
            }
        </select>
    </label>
    <button data-testid="cpustress-start" @onclick="Start" disabled="@(running || Module is null)">Start</button>
    <button data-testid="cpustress-stop" @onclick="Stop" disabled="@(!running)">Stop</button>
</div>
<p class="meta">Puts every processor core under full load to check that it works correctly and stays cool. Your PC may get loud and slow while the test runs. The test stops by itself if the processor gets too hot.</p>

<p data-testid="cpustress-status" class="status-line">
    <span class="@DotClass(r.Status)"></span>
    @(r.Status switch { DiagnosticStatus.NotRun => "Not run yet. Press Start when you're ready.", DiagnosticStatus.Running => "Running…", _ => r.Message })
</p>

@if (running)
{
    <div class="progress" data-testid="cpustress-progress"><div style="width:@((p?.Fraction ?? 0) * 100)%"></div></div>
    <div class="cards">
        <div class="card" data-testid="cpustress-live-time">
            <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
            <div class="headline">@(p is null ? "Starting…" : $"{Clock(p.Elapsed)} of {Clock(p.Duration)}")</div>
        </div>
        <div class="card" data-testid="cpustress-live-temp">
            <div class="card-head"><span class="@TempDot(p)"></span><strong>CPU temperature</strong></div>
            <div class="headline">@(p?.CpuTemperatureC is { } t ? $"{t:0}°C" : p is { SensorsAvailable: false } ? "Not available on this PC" : "—")</div>
            @if (p?.CpuCriticalC is { } c) { <div class="meta">Stops automatically at @c.ToString("0")°C</div> }
        </div>
        <div class="card" data-testid="cpustress-live-fan">
            <div class="card-head"><span class="dot dot-neutral"></span><strong>Fan speed</strong></div>
            <div class="headline">@(p?.FanRpm is > 0 ? $"{p.FanRpm:0} RPM" : p is { SensorsAvailable: false } ? "Not available on this PC" : "—")</div>
        </div>
    </div>
}
else if (report is not null)
{
    <div class="cards">
        <div class="card" data-testid="cpustress-result">
            <div class="card-head"><span class="@DotClass(r.Status)"></span><strong>@report.Headline</strong></div>
            <div class="headline">@report.Explanation</div>
            <div class="meta">Ran for @Clock(report.Ran) on @report.Threads processor threads@(report.MaxCpuTemperatureC is { } mt ? $" · hottest {mt:0}°C" : "")</div>
            <div class="meta">Finished @r.Timestamp.ToLocalTime().ToString("g")</div>
        </div>
    </div>
}

@code {
    private CpuStressModule? Module => Diagnostics.Modules.OfType<CpuStressModule>().FirstOrDefault();
    private TimeSpan _duration = TimeSpan.FromMinutes(1);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Module is { } m) { _duration = m.Duration; m.ProgressChanged += OnProgress; }
    }

    private void OnProgress(object? s, CpuStressProgress p) => _ = InvokeAsync(StateHasChanged);

    private void SetDuration(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var min)) _duration = TimeSpan.FromMinutes(min);
    }

    private void Start()
    {
        if (Module is not { } m || Diagnostics.IsRunning(m.Name)) return;
        m.Duration = _duration;
        _ = Diagnostics.RunAsync(m.Name);
    }

    private void Stop() => Module?.Stop();

    private static string Minutes(TimeSpan d) => d.TotalMinutes == 1 ? "1 minute" : $"{d.TotalMinutes:0} minutes";
    private static string Clock(TimeSpan t) => $"{(int)t.TotalMinutes}:{t.Seconds:00}";
    private static string TempDot(CpuStressProgress? p) => p?.CpuTemperatureC is not { } t ? "dot dot-neutral"
        : p.CpuCriticalC is { } c && t >= c - 8 ? "dot dot-warning" : "dot dot-ok";

    public ValueTask DisposeAsync()
    {
        if (Module is { } m) m.ProgressChanged -= OnProgress;
        Dispose();
        return ValueTask.CompletedTask;
    }
}
