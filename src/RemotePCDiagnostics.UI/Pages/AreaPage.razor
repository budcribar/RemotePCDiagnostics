    // Sort choice per page+card; static so it survives auto-refresh and navigation.
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, (int Col, bool Desc)> _sorts = new();
    private static (int, bool) SortFor(string module, AreaCard c) =>
        _sorts.TryGetValue(module + "/" + c.Id, out var v) ? v : c.PreserveRowOrder ? (-1, false) : AreaSort.Default(c.Columns);
    private static string? ColumnClass(string column) => column switch
    {
        "When" or "Last seen" or "Last time" or "Installed" or "Date" or "Time" => "drawer-time",
        "Times" or "Count" or "Crashes" or "Freezes" or "Instances" => "drawer-count",
        _ => null
    };

    private static void ToggleSort(string module, AreaCard c, int col)
    {
        var (cur, desc) = SortFor(module, c);
        _sorts[module + "/" + c.Id] = cur == col ? (col, !desc) : (col, col < c.Columns.Count && AreaSort.FirstClickDescending(c.Columns[col]));
    }

    // Services: live status per service after a Start/Stop/Restart, so only that row updates (no full re-check).
    private ServiceActions? _svcUi;
    private RemediationActions? _remUi;
    private readonly Dictionary<string, string> _svcStatus = new(StringComparer.OrdinalIgnoreCase);
    private object? _svcSeen;
    /// <summary>Every service row with the buttons it gets, for the agent copy (area-report-data). Live status overrides apply.</summary>
    private IReadOnlyList<AreaReportExport.ExportedService>? ExportServices(IServiceRows? sm, ServiceActionService? actions)
    {
        if (sm is null || actions is null) return null;
        if (!ReferenceEquals(sm.Latest, _svcSeen)) { _svcSeen = sm.Latest; _svcStatus.Clear(); }
        // OptionsFor asks Windows whether each service is a driver: build the list once per run and per row change, not per render.
        if (ReferenceEquals(_svcExportFor, sm.Latest) && _svcExportVersion == _svcStatusVersion && _svcExport is not null) return _svcExport;
        _svcExport = sm.Latest.Values
            .Select(s => _svcStatus.TryGetValue(s.Name, out var st) ? s with { Status = st } : s)
            .OrderBy(s => s.Label, StringComparer.OrdinalIgnoreCase)
            .Take(AreaReportExport.MaxServices)
            .Select(s => AreaReportExport.Service(s, actions.OptionsFor(s)))
            .ToList();
        _svcExportFor = sm.Latest;
        _svcExportVersion = _svcStatusVersion;
        return _svcExport;
    }
    private IReadOnlyList<AreaReportExport.ExportedService>? _svcExport;
    private object? _svcExportFor;
    private int _svcExportVersion, _svcStatusVersion;

    private ServiceInfo? SvcInfo(IServiceRows? sm, AreaRow row)
    {
        if (sm is null || row.Key is null) return null;
        if (!ReferenceEquals(sm.Latest, _svcSeen)) { _svcSeen = sm.Latest; _svcStatus.Clear(); } // fresh check replaces live overrides
        if (!sm.Latest.TryGetValue(row.Key, out var s)) return null;
        return _svcStatus.TryGetValue(s.Name, out var st) ? s with { Status = st } : s;
    }
    private void RowChanged((string Name, string Status) c) { _svcStatus[c.Name] = c.Status; _svcStatusVersion++; }
    private static string Dot(AreaLevel l) => l switch
    {
        AreaLevel.Ok => "ok", AreaLevel.Warning => "warning", AreaLevel.Error => "error", _ => "neutral",
    };
