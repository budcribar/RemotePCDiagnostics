@page "/module/{Slug}"
@using RemotePCDiagnostics.Core.Areas
@inherits StoreAwareComponent
@inject IServiceProvider Sp
@* Generic card + drill-down page for area modules (drive health, services, programs, network, events, crashes, and new checks). *@
@{
    var m = Diagnostics.Modules.FirstOrDefault(x => string.Equals(x.Name, Slug, StringComparison.OrdinalIgnoreCase));
}
@if (m is null)
{
    <p class="meta" data-testid="area-missing">This page isn't available.</p>
}
else
{
    var r = Store.Get(m.Name);
    var rep = r.Payload as AreaReport;
    var busy = r.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
    var svcModule = m as ServicesModule;
    var svcActions = svcModule is null ? null : Sp.GetService(typeof(ServiceActionService)) as ServiceActionService;
    var memSvc = m is ResourceHogsModule ? Sp.GetService(typeof(RemotePCDiagnostics.Core.Memory.MemorySuggestionService)) as RemotePCDiagnostics.Core.Memory.MemorySuggestionService : null;
    var remActions = Sp.GetService(typeof(RemediationService)) as RemediationService;
    var hasRemActions = remActions is not null && rep is not null && rep.Cards.Any(c => c.Actions is { Count: > 0 } || c.Rows.Any(rw => rw.Actions is { Count: > 0 }));
    <div class="toolbar"><span class="icon-badge page-icon"><Icon Name="@m.Name" Size="20" /></span><h1 data-testid="area-title">@m.DisplayName</h1></div>
    <p data-testid="area-status" class="@(r.Status == DiagnosticStatus.Error ? "status-line error-text" : "status-line")">
        <span class="@DotClass(r.Status)"></span>
        <span class="status-text">@(busy ? "Checking…" : r.Message)</span>
        @if (!busy) { <button class="btn-small status-action" data-testid="area-requery" @onclick="() => Diagnostics.RunAsync(m.Name)">Check again</button> }
    </p>
    @if (!busy && rep?.Notice is { } notice) { <p class="meta" data-testid="area-notice">@notice</p> }

    @if (rep is not null && rep.Cards.Count > 0)
    {
        <div class="cards">
            @foreach (var c in rep.Cards)
            {
                @* EmptyText describes an empty drawer; only show it on the card when there really is nothing in it. *@
                <SummaryCard Id="@c.Id" Title="@c.Title" OnOpen="Open" ErrorText="@c.ErrorText" EmptyText="@(c.Rows.Count == 0 ? c.EmptyText : null)" Dot="@Dot(c.Level)">
                    <div class="headline">@c.Headline</div>
                    @if (c.Meta.Length > 0) { <div class="meta">@c.Meta</div> }
                    @if (remActions is not null && c.Actions is { Count: > 0 })
                    {
                        <div class="svc-actions" style="margin-top:0.5rem" @onclick:stopPropagation="true">
                            @foreach (var act in c.Actions)
                            {
                                var a = act;
                                <button class="btn-small" data-testid="remediation-card-@c.Id-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                            }
                        </div>
                    }
                </SummaryCard>
            }
        </div>

        @if (memSvc is not null) { <MemorySuggestionsPanel @ref="_memPanel" Svc="memSvc" /> }

        @if (_open is not null && rep.Cards.FirstOrDefault(c => c.Id == _open) is { } open)
        {
            var hasRowRemActions = remActions is not null && open.Rows.Any(rw => rw.Actions is { Count: > 0 });
            var isKeyValue = open.Columns is ["Detail", "Value"] && svcActions is null && !hasRowRemActions;
            <div class="drawer-backdrop" @onclick="Close"></div>
            <aside class="drawer" role="dialog" aria-modal="true" aria-label="@open.Title" tabindex="-1" @ref="_drawer" @onkeydown="DrawerKey" data-testid="area-drawer-@open.Id">
                <div class="drawer-head"><strong title="@open.Title">@open.Title</strong><button data-testid="area-drawer-close" @onclick="Close">Close</button></div>
                @if (open.Note is { } note) { <p class="meta">@note</p> }
                @if (open.Id == "memory" && memSvc is not null) { <p><button class="linklike" data-testid="mem-suggest-link" @onclick="ShowSuggestions">See ways to use less memory</button></p> }
                @if (remActions is not null && open.Actions is { Count: > 0 })
                {
                    <div class="svc-actions" style="margin-bottom:0.6rem">
                        @foreach (var act in open.Actions)
                        {
                            var a = act;
                            <button class="btn-small" data-testid="remediation-drawer-@open.Id-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                        }
                    </div>
                }
                @if (open.ErrorText is not null) { <div class="notice notice-error" data-testid="detail-error">@open.ErrorText</div> }
                else if (open.Rows.Count == 0) { <p class="meta" data-testid="detail-empty">@(open.EmptyText ?? "Nothing to show here.")</p> }
                else if (isKeyValue)
                {
                    <table class="detail" data-testid="area-table">
                        @foreach (var row in open.Rows)
                        {
                            <tr @key="row">
                                <th>@(row.Values.Count > 0 ? row.Values[0] : "")</th>
                                <td>@(row.Values.Count > 1 ? row.Values[1] : "")</td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    var (sc, sd) = SortFor(m.Name, open);
                    <table class="detail grid sticky-head sortable" data-testid="area-table">
                        <tr>
                            @for (var hi = 0; hi < open.Columns.Count; hi++)
                            {
                                var col = hi;
                                <th @key="col" class="sortable-th" scope="col" aria-sort="@(sc == col ? (sd ? "descending" : "ascending") : "none")" data-testid="area-th-@col">
                                    <button type="button" class="th-btn" @onclick="() => ToggleSort(m.Name, open, col)">@open.Columns[col]<span class="sort-arrow" aria-hidden="true">@(sc == col ? (sd ? " ▼" : " ▲") : "")</span></button></th>
                            }
                            @if (svcActions is not null || hasRowRemActions) { <th>Actions</th> }
                        </tr>
                        @foreach (var row in AreaSort.Sort(open.Rows, sc, sd))
                        {
                            var svc = SvcInfo(svcModule, row);
                            var level = svc is not null && _svcStatus.ContainsKey(svc.Name) ? (svc.IsRunning ? AreaLevel.Ok : svc.IsAutomatic ? AreaLevel.Warning : AreaLevel.Neutral) : row.Level;
                            var rowRef = row;
                            var expandable = row.Detail is not null;
                            var expanded = expandable && ReferenceEquals(_expanded, row) || expandable && _expandedKey is not null && _expandedKey == RowId(row);
                            <tr @key="row" data-testid="@(row.Key is null ? null : "svc-row-" + row.Key)" class="@(expandable ? "row-expandable" : null)"
                                tabindex="@(expandable ? "0" : null)" aria-expanded="@(expandable ? (expanded ? "true" : "false") : null)"
                                @onclick="() => ToggleRow(rowRef)" @onkeydown="e => RowKey(e, rowRef)">
                                @for (var i = 0; i < row.Values.Count; i++)
                                {
                                    var col = open.Columns.Count > i ? open.Columns[i] : "";
                                    <td>@if (i == 0) { @if (expandable) { <span class="row-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span> } <span class="dot dot-@Dot(level)"></span> }
                                        @if (col is "Type" or "Level") { <span class="badge badge-@row.Values[i].ToLowerInvariant()">@row.Values[i]</span> } else if (svc is not null && i == 1 && _svcStatus.ContainsKey(svc.Name)) { @svc.FriendlyStatus } else { @row.Values[i] }</td>
                                }
                                @if (svcActions is not null)
                                {
                                    <td class="svc-actions" @onclick:stopPropagation="true">
                                        @if (svc is not null)
                                        {
                                            var o = svcActions.OptionsFor(svc);
                                            @if (o.CanStart) { <button data-testid="svc-start" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Start)">Start</button> }
                                            @if (o.CanStop) { <button data-testid="svc-stop" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Stop)">Stop</button> }
                                            @if (o.CanRestart) { <button data-testid="svc-restart" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Restart)">Restart</button> }
                                            @if (o.IsProtected) { <span class="svc-lock" title="This service is needed by Windows and can't be stopped from here.">🔒 @o.ProtectedText</span> }
                                        }
                                    </td>
                                }
                                else if (hasRowRemActions)
                                {
                                    <td class="svc-actions" @onclick:stopPropagation="true">
                                        @if (row.Actions is { Count: > 0 })
                                        {
                                            @foreach (var act in row.Actions)
                                            {
                                                var a = act;
                                                <button data-testid="remediation-row-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                            @if (expanded)
                            {
                                <tr class="row-detail" data-testid="area-row-detail"><td colspan="@(open.Columns.Count + (svcActions is not null || hasRowRemActions ? 1 : 0))">@row.Detail</td></tr>
                            }
                        }
                    </table>
                }
            </aside>
        }
    }
    @if (svcActions is not null) { <ServiceActions @ref="_svcUi" Actions="svcActions" OnRowChanged="RowChanged" /> }
    @if (hasRemActions) { <RemediationActions @ref="_remUi" Actions="remActions" OnCompleted="() => Diagnostics.RunAsync(m.Name)" /> }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private string? _open;
    private void Open(string id) { _open = id; _expanded = null; _expandedKey = null; _focusDrawer = true; }
    private void Close() { _open = null; _expanded = null; _expandedKey = null; }
    private ElementReference _drawer;
    private bool _focusDrawer;
    // The row whose details are open; matched by content too, so an auto-refresh (new row objects) keeps it open.
    private AreaRow? _expanded;
    private string? _expandedKey;
    private static string RowId(AreaRow r) => r.Key ?? string.Join("\u001f", r.Values);
    private void ToggleRow(AreaRow r)
    {
        if (r.Detail is null) return;
        var open = ReferenceEquals(_expanded, r) || _expandedKey == RowId(r);
        _expanded = open ? null : r;
        _expandedKey = open ? null : RowId(r);
    }
    private void RowKey(KeyboardEventArgs e, AreaRow r) { if (e.Key is "Enter" or " ") ToggleRow(r); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDrawer || _open is null) return;
        _focusDrawer = false;
        try { await _drawer.FocusAsync(); } catch { /* drawer not rendered (no card) */ }
    }
    private MemorySuggestionsPanel? _memPanel;
    private async Task ShowSuggestions()
    {
        _open = null;
        StateHasChanged();
        await Task.Yield();
        if (_memPanel is not null) await _memPanel.FocusAsync();
    }
    private void DrawerKey(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }
    protected override void OnParametersSet() => _open = null;
    // Sort choice per page+card; static so it survives auto-refresh and navigation.
    private static readonly Dictionary<string, (int Col, bool Desc)> _sorts = new();
    private static (int, bool) SortFor(string module, AreaCard c) =>
        _sorts.TryGetValue(module + "/" + c.Id, out var v) ? v : AreaSort.Default(c.Columns);
    private static void ToggleSort(string module, AreaCard c, int col)
    {
        var (cur, desc) = SortFor(module, c);
        _sorts[module + "/" + c.Id] = cur == col ? (col, !desc) : (col, col < c.Columns.Count && AreaSort.FirstClickDescending(c.Columns[col]));
    }

    // Services: live status per service after a Start/Stop/Restart, so only that row updates (no full re-check).
    private ServiceActions? _svcUi;
    private RemediationActions? _remUi;
    private readonly Dictionary<string, string> _svcStatus = new(StringComparer.OrdinalIgnoreCase);
    private object? _svcSeen;
    private ServiceInfo? SvcInfo(ServicesModule? sm, AreaRow row)
    {
        if (sm is null || row.Key is null) return null;
        if (!ReferenceEquals(sm.Latest, _svcSeen)) { _svcSeen = sm.Latest; _svcStatus.Clear(); } // fresh check replaces live overrides
        if (!sm.Latest.TryGetValue(row.Key, out var s)) return null;
        return _svcStatus.TryGetValue(s.Name, out var st) ? s with { Status = st } : s;
    }
    private void RowChanged((string Name, string Status) c) => _svcStatus[c.Name] = c.Status;
    private static string Dot(AreaLevel l) => l switch
    {
        AreaLevel.Ok => "ok", AreaLevel.Warning => "warning", AreaLevel.Error => "error", _ => "neutral",
    };
}
