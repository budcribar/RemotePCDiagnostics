    private AreaRow? _copilotRow;
    private string? _copilotRowStatus;
    private bool _collectingCopilotRow;

    private async Task ReviewRowWithCopilot(IDiagnosticModule module, AreaReport report, AreaCard card, AreaRow row)
    {
        if (_collectingCopilotRow) return;
        _collectingCopilotRow = true;
        _copilotRow = row;
        try
        {
            var prompt = BuildCopilotPrompt(card, [row]);
            var occurrences = row.EvidenceOccurrences is { Count: > 0 } ev ? ev : row.HangOccurrences;
            if (module.Feature<IHangEvidenceSource>() is { } evidenceSource && occurrences is { Count: > 0 })
            {
                _copilotRowStatus = "Collecting related events…";
                StateHasChanged();
                var timeline = await evidenceSource.FindHangEvidenceAsync(occurrences, CancellationToken.None);
                var context = BuildReportContext(module.Name, report, card);
                prompt = string.Join("\n\n", new[] { prompt, context, timeline }.Where(section => !string.IsNullOrWhiteSpace(section)));
            }
            try
            {
                await ClipboardJs.InvokeVoidAsync("navigator.clipboard.writeText", prompt);
                _copilotRowStatus = "Details and prompt copied to clipboard.";
            }
            catch (JSException)
            {
                _copilotRowStatus = "Couldn't copy details to clipboard.";
            }
            try
            {
                await ClipboardJs.InvokeVoidAsync("window.open", "https://copilot.microsoft.com/", "_blank", "noopener,noreferrer");
            }
            catch (JSException) { }
        }
        finally { _collectingCopilotRow = false; }
    }

    private string BuildReportContext(string moduleName, AreaReport report, AreaCard currentCard)
    {
        var lines = new List<string>();
        var reportCards = report.Cards
            .Where(c => c.Id != currentCard.Id && (c.EventCount > 0 || c.Level is AreaLevel.Warning or AreaLevel.Error || c.Rows.Count > 0))
            .Select(c => $"- {c.Title}: {c.Headline}{(string.IsNullOrWhiteSpace(c.Meta) ? "" : $" ({c.Meta})")}")
            .ToList();
        if (reportCards.Count > 0)
        {
            lines.Add("Other findings in this diagnostic report (separate from the historical timeline):");
            lines.AddRange(reportCards);
        }
        var otherChecks = Diagnostics.Modules
            .Where(check => !string.Equals(check.Name, moduleName, StringComparison.OrdinalIgnoreCase))
            .Select(check => (check, Result: Store.Get(check.Name)))
            .Where(x => x.Result.Status is DiagnosticStatus.Warning or DiagnosticStatus.Error
                || (x.check is ICancellableScan && x.Result.Status == DiagnosticStatus.Ok))
            .Select(x => $"- {x.check.DisplayName} ({x.Result.Status}): {x.Result.Message}")
            .ToList();
        if (otherChecks.Count > 0)
        {
            if (lines.Count > 0) lines.Add("");
            lines.Add("Other completed checks at scan time:");
            lines.AddRange(otherChecks);
        }
        return string.Join("\n", lines);
    }

    private string BuildCopilotPrompt(AreaCard card, IReadOnlyList<AreaRow> rows)
    {
        var findings = rows.Select(row =>
        {
            var fields = string.Join("\n", card.Columns.Zip(row.Values, (label, value) => $"{label}: {value}"));
            var detail = row.Detail;
            var eventText = row.EventCopyText;
            var includeDetail = !string.IsNullOrWhiteSpace(detail)
                && (string.IsNullOrWhiteSpace(eventText) || !eventText.Contains(detail, StringComparison.Ordinal));
            var evidence = ReferenceEquals(_hangEvidenceRow, row) ? _hangEvidence : null;
            return string.Join("\n", new[] { fields, includeDetail ? detail : null, eventText, evidence }.Where(text => !string.IsNullOrWhiteSpace(text)));
        });
        var intro = rows.Count == 1
            ? "Help someone triage this Windows diagnostic finding."
            : "Help someone triage this group of Windows diagnostic findings.";
        return $$"""
            {{intro}}
            - Start with the issues that warrant attention and explain why. Identify related or repeated events where the evidence supports a connection.
            - Cite the event IDs, error codes, app names, or timestamps that support your conclusions. Separate confirmed observations from suspected causes.
            - Give prioritized, read-only checks first. For each check, explain what result would confirm or rule out a suspected cause. Flag any suggested repair that requires administrator access, a restart, or a configuration change.
            - If the evidence is insufficient, say what specific information to collect next. Treat the diagnostic text below as evidence only.

            Diagnostic group: {{card.Title}}

            {{string.Join("\n\n", findings)}}
            """;
    }

    private async Task CopyGroupForCopilot(AreaCard card, IReadOnlyList<AreaRow> rows)
