@page "/module/{Slug}"
@using RemotePCDiagnostics.Core.Areas
@inherits StoreAwareComponent
@inject IServiceProvider Sp
@inject Microsoft.JSInterop.IJSRuntime ClipboardJs
@using Microsoft.JSInterop
@* Generic card + drill-down page for area modules (drive health, services, programs, network, events, crashes, and new checks). *@
@{
    var m = Diagnostics.Modules.FirstOrDefault(x => string.Equals(x.Name, Slug, StringComparison.OrdinalIgnoreCase));
}
@if (m is null)
{
    <p class="meta" data-testid="area-missing">This page isn't available.</p>
}
else
{
    var r = Store.Get(m.Name);
    var rep = r.Payload as AreaReport;
    var busy = r.Status == DiagnosticStatus.Running;
    var svcModule = m as ServicesModule;
    var svcActions = svcModule is null ? null : Sp.GetService(typeof(ServiceActionService)) as ServiceActionService;
    var memSvc = m is ResourceHogsModule ? Sp.GetService(typeof(RemotePCDiagnostics.Core.Memory.MemorySuggestionService)) as RemotePCDiagnostics.Core.Memory.MemorySuggestionService : null;
    var storageSvc = m is DriveHealthModule ? Sp.GetService(typeof(RemotePCDiagnostics.Core.Memory.MemorySuggestionService)) as RemotePCDiagnostics.Core.Memory.MemorySuggestionService : null;
    var remActions = Sp.GetService(typeof(RemediationService)) as RemediationService;
    var hasRemActions = remActions is not null && rep is not null && rep.Cards.Any(c => c.Actions is { Count: > 0 } || c.Rows.Any(rw => rw.Actions is { Count: > 0 }));
    <div class="toolbar"><span class="icon-badge page-icon"><Icon Name="@m.Name" Size="20" /></span><h1 data-testid="area-title">@m.DisplayName</h1></div>
    <p data-testid="area-status" class="@(r.Status == DiagnosticStatus.Error ? "status-line error-text" : "status-line")">
        <span class="@DotClass(r.Status)"></span>
        <span class="status-text">@if (busy) { <span>@(!string.IsNullOrWhiteSpace(r.Message) && r.Message != "Running..." ? r.Message : "Checking…")</span> } else if (r.Status == DiagnosticStatus.NotRun) { <span>Not run yet. Press Run selected or Run just this to check.</span> } else { <CardList Text="@r.Message" Strong="true" /> }</span>
        @if (!busy) { <button class="btn-small status-action" data-testid="area-requery" @onclick="() => Diagnostics.RunAsync(m.Name)">@(r.Status == DiagnosticStatus.NotRun ? "Run check" : "Check again")</button> }
    </p>
    @if (r.Status == DiagnosticStatus.Running && Diagnostics.GetProgress(m.Name) is { HasProgress: true } areaProg)
    {
        <div class="progress run-progress" data-testid="area-progress"><div class="progress-bar" style="width:@($"{areaProg.Percent:0.#}%")"></div></div>
    }
    @if (!busy && rep?.Notice is { } notice) { <p class="meta" data-testid="area-notice">@notice</p> }
    @* Always mounted (even while the check re-runs after a fix), so the fix's result message stays visible near the top. *@
    @if (remActions is not null) { <RemediationActions @ref="_remUi" Actions="remActions" ShowRecent="hasRemActions" OnCompleted="() => Diagnostics.RunAsync(m.Name)" /> }

    @if (rep is not null && rep.Cards.Count > 0)
    {
        <div class="cards">
            @foreach (var c in rep.ReviewedCards is null ? rep.Cards.AsEnumerable() : rep.Cards.OrderByDescending(c => c.Level))
            {
                @* EmptyText describes an empty drawer; only show it on the card when there really is nothing in it. *@
                <SummaryCard Id="@c.Id" Title="@c.Title" OnOpen="Open" ErrorText="@c.ErrorText" EmptyText="@(c.Rows.Count == 0 && string.IsNullOrEmpty(c.Headline) ? c.EmptyText : null)" Dot="@Dot(c.Level)">
                    <div class="headline">@c.Headline</div>
                    <CardList Text="@c.Meta" />
                    @if (remActions is not null && c.Actions is { Count: > 0 })
                    {
                        <div class="svc-actions" style="margin-top:0.5rem" @onclick:stopPropagation="true" @onkeydown="DrawerKey" @onkeydown:stopPropagation="true">
                            @foreach (var act in c.Actions)
                            {
                                var a = act;
                                <button class="btn-small" data-testid="remediation-card-@c.Id-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                            }
                        </div>
                    }
                </SummaryCard>
            }
        </div>




        @if (_open is not null && rep.Cards.FirstOrDefault(c => c.Id == _open) is { } activeCard)
        {
            var reviewedCard = rep.ReviewedCards?.FirstOrDefault(c => c.Id == activeCard.Id);
            var hasReviewed = reviewedCard?.Rows.Any(row => row.ReviewKeys is { Count: > 0 }) == true;
            var open = _showReviewed && hasReviewed ? reviewedCard! : activeCard;
            var showingReviewed = _showReviewed && hasReviewed;
            var issueRows = open.Rows.Where(row => row.ReviewKeys is { Count: > 0 }).ToList();
            var groupKeys = issueRows.SelectMany(row => row.ReviewKeys!).Distinct().ToList();
            var hasRowRemActions = remActions is not null && open.Rows.Any(rw => rw.Actions is { Count: > 0 });
            var isKeyValue = open.Columns is ["Detail", "Value"] && svcActions is null && !hasRowRemActions;
            <div class="drawer-backdrop" @onclick="Close"></div>
            <aside class="drawer" role="dialog" aria-modal="true" aria-label="@open.Title" tabindex="-1" @onkeydown="DrawerKey" data-testid="area-drawer-@open.Id">
                <div class="drawer-head"><strong title="@open.Title">@open.Title</strong><button data-testid="area-drawer-close" @onclick="Close">Close</button></div>
                @if (hasReviewed)
                {
                    <button type="button" class="btn-small" @onclick="ToggleReviewed">@(showingReviewed ? "Show needs review" : "Show reviewed")</button>
                }
                @if (_reviewError is not null) { <p role="status">@_reviewError</p> }
                @if (groupKeys.Count > 0)
                {
                    <div class="svc-actions issue-group-actions">
                        <button type="button" class="btn-small" disabled="@_savingReview"
                            @onclick="() => SetReview(m.Name, groupKeys, !showingReviewed)">@(showingReviewed ? "Undo group review" : "Mark group as reviewed")</button>
                        <button type="button" class="btn-small" @onclick="() => CopyGroupForCopilot(open, issueRows)">Review group with Copilot</button>
                    </div>
                    @if (m is CrashesModule crashModule && open.Id == "hangs")
                    {
                        var selected = issueRows.Where(_selectedHangGroups.Contains).ToList();
                        <button type="button" class="btn-small" disabled="@(selected.Count == 0 || _findingHangEvidence || _sendingCopilot)"
                            @onclick="() => CollectHangGroups(crashModule, open, selected)">Collect evidence &amp; review with Copilot (@selected.Count selected)</button>
                        @if (_collectingHangGroups) { <p role="status">Collecting the shared timeline…</p> }
                    }
                    @if (_pendingCopilotPrompt is { } prompt)
                    {
                        <div class="row-detail-text">@prompt</div>
                        <button type="button" class="btn-small" disabled="@_sendingCopilot" @onclick="() => SendGroupToCopilot(prompt)">Send to Copilot</button>
                    }
                    @if (_copilotGroupStatus is not null)
                    {
                        <p class="meta" role="status">@_copilotGroupStatus
                            @if (_copilotGroupCopied)
                            {
                                <a href="https://copilot.microsoft.com/" target="_blank" rel="noopener noreferrer">Open Copilot</a>
                            }
                        </p>
                    }
                }
                @if (open.Note is { } note) { <p class="meta">@note</p> }
                @if (open.Id == "memory" && memSvc is not null) { <p><button class="linklike" data-testid="mem-suggest-link" @onclick="ShowSuggestions">See ways to use less memory</button></p> }
                @if (remActions is not null && open.Actions is { Count: > 0 })
                {
                    <div class="svc-actions" style="margin-bottom:0.6rem">
                        @foreach (var act in open.Actions)
                        {
                            var a = act;
                            <button class="btn-small" data-testid="remediation-drawer-@open.Id-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                        }
                    </div>
                }
                @if (open.ErrorText is not null) { <div class="notice notice-error" data-testid="detail-error">@open.ErrorText</div> }
                else if (open.Rows.Count == 0) { <p class="meta" data-testid="detail-empty">@(hasReviewed ? "No events need review." : open.EmptyText ?? "Nothing to show here.")</p> }
                else if (isKeyValue)
                {
                    <table class="detail" data-testid="area-table">
                        @foreach (var row in open.Rows)
                        {
                            <tr @key="row">
                                <th>@(row.Values.Count > 0 ? row.Values[0] : "")</th>
                                <td>@(row.Values.Count > 1 ? row.Values[1] : "")</td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    var (sc, sd) = SortFor(m.Name, open);
                    <table class="detail grid sticky-head sortable" data-testid="area-table">
                        <tr>
                            @for (var hi = 0; hi < open.Columns.Count; hi++)
                            {
                                var col = hi;
                                <th @key="col" class="sortable-th @ColumnClass(open.Columns[col])" scope="col" aria-sort="@(sc == col ? (sd ? "descending" : "ascending") : "none")" data-testid="area-th-@col">
                                    <button type="button" class="th-btn" @onclick="() => ToggleSort(m.Name, open, col)">@open.Columns[col]<span class="sort-arrow" aria-hidden="true">@(sc == col ? (sd ? " ▼" : " ▲") : "")</span></button></th>
                            }
                            @if (svcActions is not null || hasRowRemActions) { <th>Actions</th> }
                        </tr>
                        @foreach (var row in AreaSort.Sort(open.Rows, sc, sd))
                        {
                            var svc = SvcInfo(svcModule, row);
                            var level = svc is not null && _svcStatus.ContainsKey(svc.Name) ? (svc.IsRunning ? AreaLevel.Ok : svc.IsAutomatic ? AreaLevel.Warning : AreaLevel.Neutral) : row.Level;
                            var rowRef = row;
                            var expandable = row.Detail is not null || row.GetHelpUri is not null || row.EventCopyText is not null || row.ReviewKeys is { Count: > 0 };
                            var expanded = expandable && ReferenceEquals(_expanded, row) || expandable && _expandedKey is not null && _expandedKey == RowId(row);
                            <tr @key="row" data-testid="@(row.Key is null ? null : "svc-row-" + row.Key)" class="@(expandable ? "row-expandable" : null)"
                                tabindex="@(expandable ? "0" : null)" aria-expanded="@(expandable ? (expanded ? "true" : "false") : null)"
                                @onclick="() => ToggleRow(rowRef)" @onkeydown="e => RowKey(e, rowRef)">
                                @for (var i = 0; i < row.Values.Count; i++)
                                {
                                    var col = open.Columns.Count > i ? open.Columns[i] : "";
                                    <td class="@ColumnClass(col)">@if (i == 0) { @if (expandable) { <span class="row-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span> } <span class="dot dot-@Dot(level)"></span> }
                                        @if (col is "Type" or "Level") { <span class="badge badge-@row.Values[i].ToLowerInvariant()">@row.Values[i]</span> } else if (svc is not null && i == 1 && _svcStatus.ContainsKey(svc.Name)) { @svc.FriendlyStatus } else { @row.Values[i] }</td>
                                }
                                @if (svcActions is not null)
                                {
                                    <td class="svc-actions" @onclick:stopPropagation="true" @onkeydown="DrawerKey" @onkeydown:stopPropagation="true">
                                        @if (svc is not null)
                                        {
                                            var o = svcActions.OptionsFor(svc);
                                            @if (o.CanStart) { <button data-testid="svc-start" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Start)">Start</button> }
                                            @if (o.CanStop) { <button data-testid="svc-stop" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Stop)">Stop</button> }
                                            @if (o.CanRestart) { <button data-testid="svc-restart" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Restart)">Restart</button> }
                                            @if (o.IsProtected) { <span class="svc-lock" title="This service is needed by Windows and can't be stopped from here.">🔒 @o.ProtectedText</span> }
                                        }
                                    </td>
                                }
                                else if (hasRowRemActions)
                                {
                                    <td class="svc-actions" @onclick:stopPropagation="true" @onkeydown="DrawerKey" @onkeydown:stopPropagation="true">
                                        @if (row.Actions is { Count: > 0 })
                                        {
                                            @foreach (var act in row.Actions)
                                            {
                                                var a = act;
                                                <button data-testid="remediation-row-@a.Kind" @onclick="() => _remUi?.Ask(a)">@a.ButtonText</button>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                            @if (expanded)
                            {
                                <tr class="row-detail" data-testid="area-row-detail"><td colspan="@(open.Columns.Count + (svcActions is not null || hasRowRemActions ? 1 : 0))">
                                    @if (row.Detail is { } detail)
                                    {
                                        <div class="row-detail-text">@detail</div>
                                    }
                                    @if (m is CrashesModule crashes && row.HangOccurrences is { Count: > 0 } occurrences)
                                    {
                                        <label><input type="checkbox" checked="@_selectedHangGroups.Contains(row)"
                                            @onchange="e => SelectHangGroup(row, e.Value is true)" /> Include in shared timeline</label>
                                        <button type="button" class="btn-small" disabled="@_findingHangEvidence"
                                            @onclick="() => FindHangEvidence(crashes, row, occurrences)">Find related evidence</button>
                                        <button type="button" class="btn-small" @onclick="() => CopyGroupForCopilot(open, [row])">Review freeze group with Copilot</button>
                                        @if (ReferenceEquals(_hangEvidenceRow, row))
                                        {
                                            <div class="row-detail-text" role="status">@(_findingHangEvidence ? "Checking Windows logs…" : _hangEvidence)</div>
                                        }
                                    }
                                    @if (row.ReviewKeys is { Count: > 0 })
                                    {
                                        <a href="https://copilot.microsoft.com/" target="_blank" rel="noopener noreferrer">Review with Copilot</a>
                                    }
                                    @if (row.ReviewKeys is { Count: > 0 } keys)
                                    {
                                        <button type="button" class="btn-small" disabled="@_savingReview"
                                            @onclick="() => SetReview(m.Name, keys, !showingReviewed)">@(showingReviewed ? "Undo review" : "Mark as reviewed")</button>
                                    }
                                    @if (row.EventCopyText is { } eventText)
                                    {
                                        <button type="button" class="btn-small" @onclick="() => CopyEvent(eventText)">Copy event details</button>
                                        @if (_copyStatus is not null)
                                        {
                                            <span role="status">@_copyStatus</span>
                                        }
                                    }
                                    @if (row.GetHelpUri is { } helpUri)
                                    {
                                        <button type="button" class="btn-small" @onclick="() => OpenGetHelp(helpUri)">Open in Get Help</button>
                                        @if (_getHelpError is not null)
                                        {
                                            <p role="status">@_getHelpError</p>
                                        }
                                    }
                                    @if (row.DumpPath is { } dumpPath)
                                    {
                                        <div class="svc-actions" @onclick:stopPropagation="true" @onkeydown="DrawerKey" @onkeydown:stopPropagation="true">
                                            <button type="button" class="btn-small" disabled="@_analyzingDump" @onclick="() => AnalyzeDump(dumpPath)">Analyze dump</button>
                                        </div>
                                        @if (_analyzedDump == dumpPath)
                                        {
                                            <pre style="white-space:pre-wrap;overflow-wrap:anywhere" role="status">@(_analyzingDump ? "Analyzing dump…" : _dumpAnalysis)</pre>
                                        }
                                    }
                                </td></tr>
                            }
                        }
                    </table>
                }
            </aside>
        }
    }
    @if (memSvc is not null) { <MemorySuggestionsPanel @ref="_memPanel" Svc="memSvc" /> }
    @if (storageSvc is not null) { <StorageCleanupPanel Svc="storageSvc" /> }
    @if (svcActions is not null) { <ServiceActions @ref="_svcUi" Actions="svcActions" OnRowChanged="RowChanged" /> }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private string? _open;
    private bool _showReviewed;
    private bool _savingReview;
    private string? _reviewError;

    private void ToggleReviewed()
    {
        _showReviewed = !_showReviewed;
        _selectedHangGroups.Clear();
        _pendingCopilotPrompt = null;
        _copilotGroupStatus = null;
        _expanded = null;
        _expandedKey = null;
    }

    private async Task SetReview(string module, IReadOnlyList<string> keys, bool reviewed)
    {
        if (_savingReview) return;
        _savingReview = true;
        _reviewError = null;
        try
        {
            EventReviews.Set(keys, reviewed);
            _expanded = null;
            _expandedKey = null;
            await Diagnostics.RunAsync(module);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _reviewError = "Couldn't save the event review.";
        }
        finally { _savingReview = false; }
    }

    private string? _getHelpError;
    private string? _copyStatus;
    private readonly HashSet<AreaRow> _selectedHangGroups = new(ReferenceEqualityComparer.Instance);
    private bool _collectingHangGroups;
    private bool _findingHangEvidence;

    private void SelectHangGroup(AreaRow row, bool selected)
    {
        if (selected) _selectedHangGroups.Add(row);
        else _selectedHangGroups.Remove(row);
    }

    private async Task CollectHangGroups(CrashesModule module, AreaCard card, IReadOnlyList<AreaRow> rows)
    {
        if (_findingHangEvidence) return;
        _findingHangEvidence = _collectingHangGroups = true;
        _pendingCopilotPrompt = null;
        _copilotGroupStatus = null;
        try
        {
            var timeline = await module.FindHangEvidenceAsync(rows.SelectMany(r => r.HangOccurrences ?? []).ToList(), CancellationToken.None);
            var integrity = Diagnostics.Modules.OfType<WindowsIntegrityModule>()
                .Select(check => (check.DisplayName, Result: Store.Get(check.Name)))
                .Where(check => check.Result.Status is DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error)
                .Select(check => $"{check.DisplayName} · {check.Result.Timestamp:O} · {check.Result.Message}").ToList();
            if (_open == card.Id)
                _pendingCopilotPrompt = BuildCopilotPrompt(card, rows) +
                    "\n\nAssess whether the timeline supports a shared cause across the selected groups. Explain what remains uncertain.\n\n" + timeline +
                    (integrity.Count == 0 ? "" : "\n\nIntegrity findings at scan time (separate from the historical timeline)\n" + string.Join("\n", integrity));
        }
        finally { _findingHangEvidence = _collectingHangGroups = false; }
    }
    private AreaRow? _hangEvidenceRow;
    private string? _hangEvidence;

    private async Task FindHangEvidence(CrashesModule module, AreaRow row, IReadOnlyList<HangOccurrence> occurrences)
    {
        if (_findingHangEvidence) return;
        _findingHangEvidence = true;
        _hangEvidenceRow = row;
        _hangEvidence = null;
        try { _hangEvidence = await module.FindHangEvidenceAsync(occurrences, CancellationToken.None); }
        finally { _findingHangEvidence = false; }
    }
    private string? _copilotGroupStatus;
    private bool _copilotGroupCopied;
    private bool _sendingCopilot;
    private string? _pendingCopilotPrompt;

    private async Task SendGroupToCopilot(string prompt)
    {
        if (_sendingCopilot) return;
        _sendingCopilot = true;
        _copilotGroupCopied = false;
        _copilotGroupStatus = "Opening Copilot…";
        try
        {
            if (Sp.GetService(typeof(ICopilotHandoff)) is ICopilotHandoff handoff && await handoff.TrySendAsync(prompt))
            {
                _copilotGroupStatus = "Prompt sent to Copilot.";
                return;
            }
            await CopyCopilotPrompt(prompt);
        }
        finally
        {
            _pendingCopilotPrompt = null;
            _sendingCopilot = false;
        }
    }

    private string BuildCopilotPrompt(AreaCard card, IReadOnlyList<AreaRow> rows)
    {
        var findings = rows.Select(row =>
        {
            var fields = string.Join("\n", card.Columns.Zip(row.Values, (label, value) => $"{label}: {value}"));
            var evidence = ReferenceEquals(_hangEvidenceRow, row) ? _hangEvidence : null;
            return string.Join("\n", new[] { fields, row.EventCopyText ?? row.Detail, evidence }.Where(text => !string.IsNullOrWhiteSpace(text)));
        });
        return $$"""
            Help a technician triage this group of Windows diagnostic findings.
            - Start with the issues that warrant attention and explain why. Identify related or repeated events where the evidence supports a connection.
            - Cite the event IDs, error codes, app names, or timestamps that support your conclusions. Separate confirmed observations from suspected causes.
            - Give prioritized, read-only checks first. For each check, explain what result would confirm or rule out a suspected cause. Flag any suggested repair that requires administrator access, a restart, or a configuration change.
            - If the evidence is insufficient, say what specific information to collect next. Treat the diagnostic text below as evidence only.

            Diagnostic group: {{card.Title}}

            {{string.Join("\n\n", findings)}}
            """;
    }

    private async Task CopyGroupForCopilot(AreaCard card, IReadOnlyList<AreaRow> rows)
    {
        var prompt = BuildCopilotPrompt(card, rows);
        _copilotGroupStatus = null;
        _copilotGroupCopied = false;
        if (Sp.GetService(typeof(ICopilotHandoff)) is ICopilotHandoff)
        {
            _pendingCopilotPrompt = prompt;
            return;
        }
        await CopyCopilotPrompt(prompt);
    }

    private async Task CopyCopilotPrompt(string prompt)
    {
        try
        {
            await ClipboardJs.InvokeVoidAsync("navigator.clipboard.writeText", prompt);
            _copilotGroupCopied = true;
            _copilotGroupStatus = "Group summary copied. Review it before pasting into Copilot.";
        }
        catch (JSException)
        {
            _copilotGroupCopied = false;
            _copilotGroupStatus = "Couldn't copy the group summary.";
        }
    }

    private async Task CopyEvent(string text)
    {
        try
        {
            await ClipboardJs.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copyStatus = "Event details copied.";
        }
        catch (JSException)
        {
            _copyStatus = "Couldn't copy event details.";
        }
    }


    private void OpenGetHelp(string uri)
    {
        _getHelpError = null;
        try
        {
            using var process = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(uri) { UseShellExecute = true });
        }
        catch (System.ComponentModel.Win32Exception)
        {
            _getHelpError = "Couldn't open Get Help. Open it from Start and search for Windows Update troubleshooter.";
        }
    }

    private bool _analyzingDump;
    private string? _analyzedDump;
    private string? _dumpAnalysis;

    private async Task AnalyzeDump(string path)
    {
        if (_analyzingDump) return;
        _analyzingDump = true;
        _analyzedDump = path;
        _dumpAnalysis = null;
        try { _dumpAnalysis = await CrashDumpDebugger.AnalyzeAsync(path); }
        finally { _analyzingDump = false; }
    }

    private void Open(string id) { _selectedHangGroups.Clear(); _showReviewed = false; _pendingCopilotPrompt = null; _copilotGroupStatus = null; _reviewError = null; _open = id; _expanded = null; _expandedKey = null; }
    private void Close() { _open = null; _expanded = null; _expandedKey = null; }
    // The row whose details are open; matched by content too, so an auto-refresh (new row objects) keeps it open.
    private AreaRow? _expanded;
    private string? _expandedKey;
    private static string RowId(AreaRow r) => r.Key ?? string.Join("\u001f", r.Values);
    private void ToggleRow(AreaRow r)
    {
        if (r.Detail is null && r.GetHelpUri is null && r.EventCopyText is null && r.ReviewKeys is not { Count: > 0 }) return;
        _copyStatus = null;
        var open = ReferenceEquals(_expanded, r) || _expandedKey == RowId(r);
        _expanded = open ? null : r;
        _expandedKey = open ? null : RowId(r);
    }
    private void RowKey(KeyboardEventArgs e, AreaRow r) { if (e.Key is "Enter" or " ") ToggleRow(r); }

    private MemorySuggestionsPanel? _memPanel;
    private async Task ShowSuggestions()
    {
        _open = null;
        StateHasChanged();
        await Task.Yield();
        if (_memPanel is not null) await _memPanel.FocusAsync();
    }
    private void DrawerKey(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }
    protected override void OnParametersSet() => _open = null;
    // Sort choice per page+card; static so it survives auto-refresh and navigation.
    private static readonly Dictionary<string, (int Col, bool Desc)> _sorts = new();
    private static (int, bool) SortFor(string module, AreaCard c) =>
        _sorts.TryGetValue(module + "/" + c.Id, out var v) ? v : c.PreserveRowOrder ? (-1, false) : AreaSort.Default(c.Columns);
    private static string? ColumnClass(string column) => column switch
    {
        "When" or "Last seen" or "Last time" or "Installed" or "Date" or "Time" => "drawer-time",
        "Times" or "Count" or "Crashes" or "Freezes" or "Instances" => "drawer-count",
        _ => null
    };

    private static void ToggleSort(string module, AreaCard c, int col)
    {
        var (cur, desc) = SortFor(module, c);
        _sorts[module + "/" + c.Id] = cur == col ? (col, !desc) : (col, col < c.Columns.Count && AreaSort.FirstClickDescending(c.Columns[col]));
    }

    // Services: live status per service after a Start/Stop/Restart, so only that row updates (no full re-check).
    private ServiceActions? _svcUi;
    private RemediationActions? _remUi;
    private readonly Dictionary<string, string> _svcStatus = new(StringComparer.OrdinalIgnoreCase);
    private object? _svcSeen;
    private ServiceInfo? SvcInfo(ServicesModule? sm, AreaRow row)
    {
        if (sm is null || row.Key is null) return null;
        if (!ReferenceEquals(sm.Latest, _svcSeen)) { _svcSeen = sm.Latest; _svcStatus.Clear(); } // fresh check replaces live overrides
        if (!sm.Latest.TryGetValue(row.Key, out var s)) return null;
        return _svcStatus.TryGetValue(s.Name, out var st) ? s with { Status = st } : s;
    }
    private void RowChanged((string Name, string Status) c) => _svcStatus[c.Name] = c.Status;
    private static string Dot(AreaLevel l) => l switch
    {
        AreaLevel.Ok => "ok", AreaLevel.Warning => "warning", AreaLevel.Error => "error", _ => "neutral",
    };
}
