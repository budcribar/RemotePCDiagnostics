@using RemotePCDiagnostics.Core.Areas
@inherits StoreAwareComponent
@inject AppServices App
@inject Microsoft.JSInterop.IJSRuntime ClipboardJs
@inject NavigationManager Nav
@using Microsoft.JSInterop
@* Generic card + drill-down page for area modules (drive health, services, programs, network, events, crashes, and new checks). *@
@{
    var m = Diagnostics.Modules.FirstOrDefault(x => string.Equals(x.Name, Slug, StringComparison.OrdinalIgnoreCase));
}
@if (m is null)
{
    <p class="meta" data-testid="area-missing">This page isn't available.</p>
}
else
{
    var r = Store.Get(m.Name);
    var rep = r.Report() as AreaReport; // a per-device module (drive health) combines its devices into one report
    if (rep is not null) _lastReport = (m.Name, rep);
    var cachedRep = string.Equals(_lastReport.Module, m.Name, StringComparison.OrdinalIgnoreCase) ? _lastReport.Report : null;
    // Large files & folders before its first scan: how full the drive is, read live. It is not a result, so it stays out of
    // area-report-data and everything else that describes a finished run.
    var shown = rep ?? cachedRep ?? (m.Name == ModuleSlugs.DiskSpace ? CapacityPreview(m) : null);
    var busy = r.Status == DiagnosticStatus.Running;
    var svcModule = m.Feature<IServiceRows>(); // also from a stand-in for a module that runs out of process
    var svcActions = svcModule is null ? null : App.ServiceActions;
    var panels = m.Feature<IHasAreaPanels>()?.Panels ?? AreaPanels.None;
    var memSvc = panels.HasFlag(AreaPanels.MemorySuggestions) ? App.Memory : null;
    var storageSvc = panels.HasFlag(AreaPanels.StorageCleanup) ? App.Memory : null;
    var remActions = App.Remediation;
    var hasRemActions = remActions is not null && rep is not null && rep.Cards.Any(c => c.Actions is { Count: > 0 } || c.Rows.Any(rw => rw.Actions is { Count: > 0 }));
    <div class="toolbar"><span class="icon-badge page-icon"><Icon Name="@m.Name" Size="20" /></span><h1 data-testid="area-title">@m.DisplayName</h1></div>
    <p data-testid="area-status" class="@(r.Status == DiagnosticStatus.Error ? "status-line error-text" : "status-line")">
        <span class="@DotClass(r.Status)"></span>
        <span class="status-text">@if (busy) { <span>@(!string.IsNullOrWhiteSpace(r.Message) && r.Message != "Running..." ? r.Message : "Checking…")</span> } else if (r.Status == DiagnosticStatus.NotRun) { <span>Not run. Press Run selected or Run just this to check.</span> } else { <CardList Text="@r.Message" Strong="true" /> }</span>
        @if (!busy) { <button class="btn-small status-action" data-testid="area-requery" @onclick="() => Diagnostics.RunAsync(m.Name)">@(r.Status == DiagnosticStatus.NotRun ? "Run check" : "Check again")</button> }
    </p>
    @if (r.Status == DiagnosticStatus.Running && Diagnostics.GetProgress(m.Name) is { HasProgress: true } areaProg)
    {
        <div class="progress run-progress" data-testid="area-progress"><div class="progress-bar" style="width:@($"{areaProg.Percent:0.#}%")"></div></div>
    }
    @if (!busy && rep?.Notice is { } notice) { <p class="meta" data-testid="area-notice">@notice</p> }
    @* Always mounted (even while the check re-runs after a fix), so the fix's result message stays visible near the top. *@
    var remBannerCardId = _remUi?.ActiveCardId is { } activeRemCard && _expandedCards.Contains(activeRemCard) ? activeRemCard : null;
    @if (remActions is not null) { <RemediationActions @ref="_remUi" Actions="remActions" ShowRecent="hasRemActions" HideBanner="@(remBannerCardId is not null)" Origin="@m.Name" OnStateChanged="StateHasChanged" OnCompleted="() => Diagnostics.RefreshQuietlyAsync(m.Name)" /> }

    @if (!busy && rep is not null)
    {
        <AreaReportData Report="rep" CheckId="@m.Name" RunId="r.RunId" Services="@ExportServices(svcModule, svcActions)" />
    }
    @if (shown is not null && shown.Cards.Count > 0)
    {
        @if (!busy && m.Name == ModuleSlugs.DriveHealth)
        {
            var driveCards = shown.Cards.Where(c => c.Id != DriveHealthModule.CapacityCardId).ToList();
            <div hidden data-testid="drive-health-counts">
                <span data-field="reported-drive-count" data-unit="count" data-value="@driveCards.Count"></span>
                <span data-field="healthy-drive-count" data-unit="count" data-value="@driveCards.Count(c => c.Level == AreaLevel.Ok)"></span>
                <span data-field="warning-drive-count" data-unit="count" data-value="@driveCards.Count(c => c.Level == AreaLevel.Warning)"></span>
                <span data-field="critical-drive-count" data-unit="count" data-value="@driveCards.Count(c => c.Level == AreaLevel.Error)"></span>
                <span data-field="unknown-drive-count" data-unit="count" data-value="@driveCards.Count(c => c.Level == AreaLevel.Neutral)"></span>
                <StorageByteFields Card="@shown.Cards.FirstOrDefault(c => c.Id == DriveHealthModule.CapacityCardId)" />
            </div>
        }
        @* Without a run id (before the first scan) the numbers are the drive as it is now; with one, as that scan found it. *@
        @if (m.Name == ModuleSlugs.DiskSpace && (!busy || rep is null) && shown.Cards.FirstOrDefault(c => c.Id == DiskSpaceModule.CapacityCardId) is { } capacity)
        {
            <div hidden data-testid="disk-space-counts" data-check-id="@m.Name" data-result-run-id="@(rep is null ? null : r.RunId)">
                <StorageByteFields Card="capacity" />
            </div>
        }
        <div class="cards">
            @foreach (var c in shown.ReviewedCards is null ? shown.Cards.AsEnumerable() : shown.Cards.OrderByDescending(c => c.Level))
            {
                var cardId = c.Id;
                var isExpanded = _expandedCards.Contains(cardId);
                @* EmptyText describes an empty details panel; only show it on the card when there really is nothing in it. *@
                <SummaryCard @key="cardId" Id="@cardId" Title="@c.Title" Expanded="@isExpanded" DetailsTestId="@($"area-drawer-{cardId}")" OnOpen="ToggleCard" ErrorText="@c.ErrorText" EmptyText="@(c.Rows.Count == 0 && string.IsNullOrEmpty(c.Headline) ? c.EmptyText : null)" Dot="@Dot(c.Level)">
                    <ChildContent>
                        <div class="headline" data-field="@c.Id" data-outcome="@c.Level.ToString().ToLowerInvariant()"
                             data-event-count="@c.EventCount" data-window-days="@c.WindowDays"
                             data-recent-event-count="@c.RecentEventCount" data-recent-window-days="@c.RecentWindowDays"
                             data-unit="@(c.EventCount.HasValue ? "count" : null)" data-value="@c.EventCount">@c.Headline</div>
                        <CardList Text="@c.Meta" />
                        @if (c.RunCheck is { } link && Diagnostics.Modules.FirstOrDefault(x => x.Name == link.CheckId) is { } next)
                        {
                            var nextBusy = Store.Get(next.Name).Status == DiagnosticStatus.Running;
                            <div class="svc-actions" style="margin-top:0.5rem" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <button class="btn-small" data-testid="card-run-check-@c.Id" data-action="run-check" data-card-id="@c.Id" data-check-id="@next.Name"
                                        disabled="@nextBusy" @onclick="() => RunNext(next)">@(nextBusy ? "Running…" : link.ButtonText)</button>
                            </div>
                        }
                        @if (remActions is not null && c.Actions is { Count: > 0 })
                        {
                            <div class="svc-actions" style="margin-top:0.5rem" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                @foreach (var act in c.Actions)
                                {
                                    var a = act;
                                    <button class="btn-small" data-testid="remediation-card-@c.Id-@a.Kind" data-action="remediate" data-card-id="@c.Id" data-action-kind="@a.Kind" data-action-target="@a.Target" @onclick="() => _remUi?.Ask(a, cardId)">@a.ButtonText</button>
                                }
                            </div>
                        }
                    </ChildContent>
                    <Details>
                        @{
                            var reviewedCard = shown.ReviewedCards?.FirstOrDefault(rc => rc.Id == cardId);
                            var hasReviewed = reviewedCard?.Rows.Any(row => row.ReviewKeys is { Count: > 0 }) == true;
                            var showingReviewed = hasReviewed && _showReviewedCards.Contains(cardId);
                            var open = showingReviewed ? reviewedCard! : c;
                            var issueRows = open.Rows.Where(row => row.ReviewKeys is { Count: > 0 }).ToList();
                            var groupKeys = issueRows.SelectMany(row => row.ReviewKeys!).Distinct().ToList();
                            var hasRowRemActions = remActions is not null && open.Rows.Any(rw => rw.Actions is { Count: > 0 });
                            var isKeyValue = open.Columns is ["Detail", "Value"] && svcActions is null && !hasRowRemActions;
                        }
                        @if (remActions is not null && string.Equals(remBannerCardId, cardId, StringComparison.OrdinalIgnoreCase))
                        {
                            var remRunning = remActions.Running;
                            var remMine = remRunning is not null && remRunning.Origin == m.Name;
                            var remLast = remActions.LastRun is { } rl && rl.Origin == m.Name ? rl : null;
                            @if (remRunning is not null && remMine)
                            {
                                <div class="notice" data-testid="remediation-running" data-state="working"
                                     data-action-kind="@remRunning.Action.Kind" data-action-target="@remRunning.Action.Target">
                                    <strong>@remRunning.Title</strong>
                                    <span class="meta" data-testid="remediation-working">@(remRunning.Progress ?? "Working… please wait.") You can leave this page; it keeps running.</span>
                                    <button class="btn-small" data-testid="remediation-stop" @onclick="() => remActions.CancelRunning()">Cancel</button>
                                </div>
                            }
                            else if (remRunning is not null && _remUi?.IsBlocked == true)
                            {
                                <div class="notice" data-testid="remediation-busy">@remRunning.Title is still running. Wait for it to finish before starting another fix.</div>
                            }
                            @if (remLast is not null && !remMine)
                            {
                                <div class="notice @(remLast.Success ? "svc-result-ok" : "notice-error")" data-testid="remediation-result"
                                     data-outcome="@(remLast.Success ? "succeeded" : "failed")" data-action-kind="@remLast.Action.Kind" data-action-target="@remLast.Action.Target"
                                     data-restart-needed="@(remLast.RestartNeeded ? "true" : "false")"
                                     data-result-seq="@remLast.Seq">@remLast.Message</div>
                            }
                        }
                        @if (hasReviewed || groupKeys.Count > 0)
                        {
                            <div class="issue-group-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                @if (hasReviewed)
                                {
                                    <button type="button" class="btn-small" data-testid="area-show-reviewed" data-state="@(showingReviewed ? "reviewed" : "open")" @onclick="() => ToggleReviewed(cardId)">@(showingReviewed ? "Show needs review" : "Show reviewed")</button>
                                }
                                @if (groupKeys.Count > 0)
                                {
                                    <button type="button" class="btn-small" disabled="@_savingReview" data-action="review-group" data-card-id="@open.Id" data-state="@(showingReviewed ? "reviewed" : "open")"
                                        @onclick="() => SetReview(m.Name, groupKeys, !showingReviewed)">@(showingReviewed ? "Undo group review" : "Mark group as reviewed")</button>
                                    <button type="button" class="btn-small" @onclick="() => CopyGroupForCopilot(open, issueRows)">Review group with Copilot</button>
                                }
                            </div>
                        }
                        @if (_reviewError is not null) { <p role="status">@_reviewError</p> }
                        @if (groupKeys.Count > 0)
                        {
                            @if (m.Feature<IHangEvidenceSource>() is { } crashModule && open.Id == crashModule.HangCardId)
                            {
                                var selected = issueRows.Where(_selectedHangGroups.Contains).ToList();
                                <button type="button" class="btn-small" disabled="@(selected.Count == 0 || _findingHangEvidence || _sendingCopilot)"
                                    @onclick="() => CollectHangGroups(crashModule, open, selected)">Collect evidence &amp; review with Copilot (@selected.Count selected)</button>
                                @if (_collectingHangGroups) { <p role="status">Collecting the shared timeline…</p> }
                            }
                            @if (_copilotCardId == open.Id && _pendingCopilotPrompt is { } prompt)
                            {
                                <div class="row-detail-text">@prompt</div>
                                <button type="button" class="btn-small" disabled="@_sendingCopilot" @onclick="() => SendGroupToCopilot(prompt)">Send to Copilot</button>
                            }
                            @if (_copilotCardId == open.Id && _copilotGroupStatus is not null)
                            {
                                <p class="meta" role="status">@_copilotGroupStatus
                                    @if (_copilotGroupCopied)
                                    {
                                        <a href="https://copilot.microsoft.com/" target="_blank" rel="noopener noreferrer">Open Copilot</a>
                                    }
                                </p>
                            }
                        }
                        @if (open.Note is { } note) { <p class="meta">@note</p> }
                        @if (open.Id == "memory" && memSvc is not null) { <p><button class="linklike" data-testid="mem-suggest-link" @onclick="ShowSuggestions">See ways to use less memory</button></p> }
                        @if (remActions is not null && !ReferenceEquals(open, c) && open.Actions is { Count: > 0 })
                        {
                            <div class="svc-actions" style="margin-bottom:0.6rem" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                @foreach (var act in open.Actions)
                                {
                                    var a = act;
                                    <button class="btn-small" data-testid="remediation-drawer-@open.Id-@a.Kind" data-action="remediate" data-card-id="@open.Id" data-action-kind="@a.Kind" data-action-target="@a.Target" @onclick="() => _remUi?.Ask(a, cardId)">@a.ButtonText</button>
                                }
                            </div>
                        }
                        @if (open.ErrorText is not null) { <div class="notice notice-error" data-testid="detail-error">@open.ErrorText</div> }
                        else if (open.Rows.Count == 0) { <p class="meta" data-testid="detail-empty">@(hasReviewed ? "No events need review." : open.EmptyText ?? "Nothing to show here.")</p> }
                        else if (isKeyValue)
                        {
                            <div class="card-details-scroll">
                                <table class="detail" data-testid="area-table">
                                    @foreach (var row in open.Rows)
                                    {
                                        <tr @key="row">
                                            <th>@(row.Values.Count > 0 ? row.Values[0] : "")</th>
                                            <td>@(row.Values.Count > 1 ? row.Values[1] : "")</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        }
                        else
                        {
                            var (sc, sd) = SortFor(m.Name, open);
                            <div class="card-details-scroll">
                                <table class="detail grid sticky-head sortable" data-testid="area-table">
                                    <tr>
                                        @for (var hi = 0; hi < open.Columns.Count; hi++)
                                        {
                                            var col = hi;
                                            <th @key="col" class="sortable-th @ColumnClass(open.Columns[col])" scope="col" aria-sort="@(sc == col ? (sd ? "descending" : "ascending") : "none")" data-testid="area-th-@col">
                                                <button type="button" class="th-btn" @onclick="() => ToggleSort(m.Name, open, col)">@open.Columns[col]<span class="sort-arrow" aria-hidden="true">@(sc == col ? (sd ? " ▼" : " ▲") : "")</span></button></th>
                                        }
                                        @if (svcActions is not null || hasRowRemActions) { <th>Actions</th> }
                                    </tr>
                                    @foreach (var row in AreaSort.Sort(open.Rows, sc, sd))
                                    {
                                        var svc = SvcInfo(svcModule, row);
                                        var level = svc is not null && _svcStatus.ContainsKey(svc.Name) ? (svc.IsRunning ? AreaLevel.Ok : svc.IsAutomatic ? AreaLevel.Warning : AreaLevel.Neutral) : row.Level;
                                        var rowRef = row;
                                        var expandable = row.Detail is not null || row.GetHelpUri is not null || row.EventCopyText is not null || row.ReviewKeys is { Count: > 0 };
                                        var expanded = expandable && _expandedCardId == cardId && (ReferenceEquals(_expanded, row) || (_expandedKey is not null && _expandedKey == RowId(row)));
                                        <tr @key="row" data-testid="@(row.Key is null ? null : "svc-row-" + row.Key)" class="@(expandable ? "row-expandable" : null)"
                                            data-action="@(AreaReportExport.ReviewId(row) is null ? null : "review-expand")" data-card-id="@(AreaReportExport.ReviewId(row) is null ? null : open.Id)" data-review-id="@AreaReportExport.ReviewId(row)"
                                            tabindex="@(expandable ? "0" : null)" aria-expanded="@(expandable ? (expanded ? "true" : "false") : null)"
                                            @onclick="() => ToggleRow(cardId, rowRef)" @onkeydown="e => RowKey(e, cardId, rowRef)">
                                            @for (var i = 0; i < row.Values.Count; i++)
                                            {
                                                var col = open.Columns.Count > i ? open.Columns[i] : "";
                                                <td class="@ColumnClass(col)">@if (i == 0) { @if (expandable) { <span class="row-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span> } <span class="dot dot-@Dot(level)"></span> }
                                                    @if (col is "Type" or "Level" or "Storage") { <span class="badge badge-@row.Values[i].ToLowerInvariant().Replace(" ", "-")">@row.Values[i]</span> }
                                                    else if (svc is not null && i == 1 && _svcStatus.ContainsKey(svc.Name)) { @svc.FriendlyStatus }
                                                    else if (row.FilePath is { } fp && (col is "File" or "Folder" or "Drive" || (i == 0 && open.Id is "files" or "folders" or "drives")))
                                                    {
                                                        <button type="button" class="linklike" title="Open in file manager: @fp" @onclick="() => OpenFileManager(fp, row)" @onclick:stopPropagation="true">@row.Values[i]</button>
                                                    }
                                                    else { @row.Values[i] }</td>
                                            }
                                            @if (svcActions is not null)
                                            {
                                                <td class="svc-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    @if (svc is not null)
                                                    {
                                                        var o = svcActions.OptionsFor(svc);
                                                        @if (o.CanStart) { <button data-testid="svc-start" data-action="service" data-service="@svc.Name" data-service-action="start" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Start)">Start</button> }
                                                        @if (o.CanStop) { <button data-testid="svc-stop" data-action="service" data-service="@svc.Name" data-service-action="stop" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Stop)">Stop</button> }
                                                        @if (o.CanRestart) { <button data-testid="svc-restart" data-action="service" data-service="@svc.Name" data-service-action="restart" @onclick="() => _svcUi!.Ask(svc, ServiceAction.Restart)">Restart</button> }
                                                        @if (o.IsProtected) { <span class="svc-lock" title="This service is needed by Windows and can't be stopped from here.">🔒 @o.ProtectedText</span> }
                                                    }
                                                </td>
                                            }
                                            else if (hasRowRemActions)
                                            {
                                                <td class="svc-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    @if (row.Actions is { Count: > 0 })
                                                    {
                                                        @foreach (var act in row.Actions)
                                                        {
                                                            var a = act;
                                                            <button data-testid="remediation-row-@a.Kind" data-action="remediate" data-card-id="@open.Id" data-row-key="@row.Key" data-action-kind="@a.Kind" data-action-target="@a.Target" @onclick="() => _remUi?.Ask(a, cardId)">@a.ButtonText</button>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                        @if (expanded)
                                        {
                                            var hasHangActions = m.Feature<IHangEvidenceSource>() is not null && row.HangOccurrences is { Count: > 0 };
                                            var hasRowDetailActions = hasHangActions
                                                || row.ReviewKeys is { Count: > 0 }
                                                || row.EventCopyText is not null
                                                || row.GetHelpUri is not null
                                                || row.DumpPath is not null
                                                || row.FilePath is not null;
                                            <tr class="row-detail" data-testid="area-row-detail"><td colspan="@(open.Columns.Count + (svcActions is not null || hasRowRemActions ? 1 : 0))">
                                                @if (row.Detail is { } detail)
                                                {
                                                    <div class="row-detail-text">@detail</div>
                                                }
                                                @if (hasRowDetailActions)
                                                {
                                                    <div class="row-detail-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                        @if (m.Feature<IHangEvidenceSource>() is { } crashes && row.HangOccurrences is { Count: > 0 } occurrences)
                                                        {
                                                            <label class="row-detail-check"><input type="checkbox" checked="@_selectedHangGroups.Contains(row)"
                                                                @onchange="e => SelectHangGroup(row, e.Value is true)" /> Include in shared timeline</label>
                                                            <button type="button" class="btn-small" disabled="@_findingHangEvidence"
                                                                @onclick="() => FindHangEvidence(crashes, row, occurrences)">Find related evidence</button>
                                                            <button type="button" class="btn-small" @onclick="() => CopyGroupForCopilot(open, [row])">Review freeze group with Copilot</button>
                                                        }
                                                        @if (row.ReviewKeys is { Count: > 0 } keys)
                                                        {
                                                            <button type="button" class="btn-small" disabled="@_collectingCopilotRow" data-action="review-copilot-row" @onclick="() => ReviewRowWithCopilot(m, shown, open, rowRef)">Review with Copilot</button>
                                                            <button type="button" class="btn-small" disabled="@_savingReview" data-action="review-row" data-card-id="@open.Id" data-review-id="@AreaReportExport.ReviewId(row)" data-state="@(showingReviewed ? "reviewed" : "open")"
                                                                @onclick="() => SetReview(m.Name, keys, !showingReviewed)">@(showingReviewed ? "Undo review" : "Mark as reviewed")</button>
                                                            @if (ReferenceEquals(_copilotRow, row) && _copilotRowStatus is not null)
                                                            {
                                                                <span class="meta" role="status">@_copilotRowStatus</span>
                                                            }
                                                        }
                                                        @if (row.EventCopyText is { } eventText)
                                                        {
                                                            <button type="button" class="btn-small" @onclick="() => CopyEvent(eventText)">Copy event details</button>
                                                            @if (_copyStatus is not null)
                                                            {
                                                                <span class="meta" role="status">@_copyStatus</span>
                                                            }
                                                        }
                                                        @if (row.GetHelpUri is { } helpUri)
                                                        {
                                                            <button type="button" class="btn-small" @onclick="() => OpenGetHelp(helpUri)">Open in Get Help</button>
                                                        }
                                                        @if (row.DumpPath is { } dumpPath)
                                                        {
                                                            <button type="button" class="btn-small" disabled="@_analyzingDump" @onclick="() => AnalyzeDump(dumpPath)">Analyze dump</button>
                                                        }
                                                        @if (row.FilePath is { } filePath)
                                                        {
                                                            <button type="button" class="btn-small" data-testid="open-file-manager" @onclick="() => OpenFileManager(filePath, row)">Open in file manager</button>
                                                        }
                                                    </div>
                                                }
                                                @if (hasHangActions && ReferenceEquals(_hangEvidenceRow, row))
                                                {
                                                    <div class="row-detail-text" role="status">@(_findingHangEvidence ? "Checking Windows logs…" : _hangEvidence)</div>
                                                }
                                                @if (row.GetHelpUri is not null && _getHelpError is not null)
                                                {
                                                    <p role="status">@_getHelpError</p>
                                                }
                                                @if (row.DumpPath is { } analyzedDumpPath && _analyzedDump == analyzedDumpPath)
                                                {
                                                    <pre style="white-space:pre-wrap;overflow-wrap:anywhere" role="status">@(_analyzingDump ? "Analyzing dump…" : _dumpAnalysis)</pre>
                                                }
                                                @if (row.FilePath is not null && _fileManagerError is not null && ReferenceEquals(_fileManagerErrorRow, row))
                                                {
                                                    <p role="status" class="error-text">@_fileManagerError</p>
                                                }
                                            </td></tr>
                                        }
                                    }
                                </table>
                            </div>
                        }
                    </Details>
                </SummaryCard>
            }
        </div>
    }
    @if (memSvc is not null) { <MemorySuggestionsPanel @ref="_memPanel" Svc="memSvc" /> }
    @if (storageSvc is not null) { <StorageCleanupPanel Svc="storageSvc" /> }
    @if (svcActions is not null) { <ServiceActions @ref="_svcUi" Actions="svcActions" OnRowChanged="RowChanged" /> }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private readonly HashSet<string> _expandedCards = new(StringComparer.OrdinalIgnoreCase);
    private string? _lastSlug;
    private (string? Module, AreaReport? Report) _lastReport;

    protected override bool ShouldReactTo(DiagnosticResult r) =>
        string.Equals(r.ModuleName, Slug, StringComparison.OrdinalIgnoreCase)
        || _lastReport.Report?.Cards.Any(c => c.RunCheck is { } link && string.Equals(link.CheckId, r.ModuleName, StringComparison.OrdinalIgnoreCase)) == true;

    private (string Root, DateTimeOffset ReadAt, AreaReport? Report) _capacityPreview;
    private static readonly TimeSpan CapacityPreviewFor = TimeSpan.FromSeconds(30);

    /// <summary>The drive capacity card on its own, for Large files &amp; folders before a scan. Read at most every 30 seconds: this
    /// page renders on every store change, and a render must not go to the disk each time.</summary>
    private AreaReport? CapacityPreview(IDiagnosticModule m)
    {
        var root = m is DiskSpaceModule scan ? scan.RootPath : DiskSpaceModule.SystemRoot;
        var now = DateTimeOffset.UtcNow;
        if (_capacityPreview.Root != root || now - _capacityPreview.ReadAt > CapacityPreviewFor)
        {
            var drives = DiskSpaceModule.GetDrivesForScan(root);
            _capacityPreview = (root, now, drives.Count > 0 ? new AreaReport([DiskSpaceModule.BuildDriveCapacityCard(drives)], "", DiagnosticStatus.NotRun) : null);
        }
        return _capacityPreview.Report;
    }
