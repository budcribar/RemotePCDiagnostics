@page "/bios"
@using System.Text.Json
@using RemotePCDiagnostics.Core.Bios
@using RemotePCDiagnostics.Core.Osquery
@using RemotePCDiagnostics.Core.Session
@implements IDisposable
@inject AppServices App
@inject ISessionContext Session

<div data-rpcd-page="bios" data-rpcd-contract="@BrowserContract.Bios">
    <AgentData TestId="bios-report-data" Json="@ReportJson" />
    @if (IsBusy)
    {
        <div hidden data-testid="bios-busy"></div>
    }
    <div class="toolbar">
        <span class="icon-badge page-icon"><Icon Name="chip" Size="20" /></span>
        <h1 data-testid="bios-title">BIOS &amp; Firmware</h1>
        @if (App.Bios is not null)
        {
            <button type="button" class="btn btn-primary" data-testid="bios-check"
                    disabled="@(_checking || _installing)" @onclick="CheckForUpdatesAsync">
                <Icon Name="refresh" Size="14" /> @(_checking ? "Checking…" : "Check for updates")
            </button>
        }
    </div>

    @if (App.Bios is null)
    {
        <section class="card" data-testid="bios-unavailable">
            <p class="meta">BIOS update service is not available in this session.</p>
        </section>
    }
    else
    {
        @if (_error is not null)
        {
            <p class="notice notice-error" role="alert" data-testid="bios-error">@_error</p>
        }

        <section class="card" data-testid="bios-current-card" style="margin-bottom:14px">
            <div class="card-head">
                <strong>Current BIOS / UEFI</strong>
                @if (_loadingCurrent)
                {
                    <span class="meta">Reading firmware details…</span>
                }
                else if (MatchedProviderName is { Length: > 0 } provName)
                {
                    <span class="meta" data-testid="bios-matched-provider">Provider: @provName</span>
                }
            </div>
            @if (_current is not null || _outcome is not null)
            {
                var cur = _outcome?.Current ?? _current!;
                var sys = _outcome?.System;
                <dl>
                    @if (sys is not null && !string.IsNullOrWhiteSpace(sys.Manufacturer))
                    {
                        <dt>Manufacturer</dt><dd data-testid="bios-manufacturer">@sys.Manufacturer</dd>
                    }
                    @if (sys is not null && !string.IsNullOrWhiteSpace(sys.Model))
                    {
                        <dt>Model</dt><dd data-testid="bios-model">@sys.Model</dd>
                    }
                    @if (sys is not null && !string.IsNullOrWhiteSpace(sys.BoardProduct))
                    {
                        <dt>Baseboard</dt><dd data-testid="bios-board">@sys.BoardProduct</dd>
                    }
                    <dt>BIOS version</dt><dd data-testid="bios-current-version">@(string.IsNullOrWhiteSpace(cur.Version) ? "Not reported" : cur.Version)</dd>
                    @if (!string.IsNullOrWhiteSpace(cur.Vendor))
                    {
                        <dt>BIOS vendor</dt><dd data-testid="bios-current-vendor">@cur.Vendor</dd>
                    }
                    @if (cur.ReleaseDate is { } rel)
                    {
                        <dt>Release date</dt><dd data-testid="bios-current-date">@rel.ToString("yyyy-MM-dd")</dd>
                    }
                    else if (!string.IsNullOrWhiteSpace(cur.ReleaseDateRaw))
                    {
                        <dt>Release date</dt><dd data-testid="bios-current-date">@cur.ReleaseDateRaw</dd>
                    }
                    <dt>Firmware mode</dt><dd data-testid="bios-firmware-mode">@cur.FirmwareMode</dd>
                    @if (!string.IsNullOrWhiteSpace(cur.Family))
                    {
                        <dt>BIOS family</dt><dd data-testid="bios-current-family">@cur.Family</dd>
                    }
                </dl>
            }
        </section>

        @if (_outcome is { } outcome)
        {
            var latest = outcome.Latest;
            var provider = ResolveMatchedProvider(outcome);
            <section class="card" data-testid="bios-latest-card" style="margin-bottom:14px">
                <div class="card-head">
                    <span class="@CheckDotClass(latest.Status)"></span>
                    <strong data-testid="bios-check-status">@CheckStatusHeadline(latest)</strong>
                    @if (latest.Severity != BiosUpdateSeverity.Unknown && latest.Status == BiosCheckStatus.UpdateAvailable)
                    {
                        <span class="meta" data-testid="bios-severity">@latest.Severity</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(latest.Message))
                {
                    <p data-testid="bios-check-message">@latest.Message</p>
                }

                @if (latest.Status is BiosCheckStatus.UpdateAvailable or BiosCheckStatus.UpToDate)
                {
                    <dl>
                        @if (!string.IsNullOrWhiteSpace(latest.LatestVersion))
                        {
                            <dt>Latest version</dt><dd data-testid="bios-latest-version">@latest.LatestVersion</dd>
                        }
                        @if (latest.ReleaseDate is { } lDate)
                        {
                            <dt>Release date</dt><dd data-testid="bios-latest-date">@lDate.ToString("yyyy-MM-dd")</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(latest.PackageId))
                        {
                            <dt>Package</dt><dd data-testid="bios-package-id">@latest.PackageId</dd>
                        }
                        @if (latest.SizeBytes is > 0)
                        {
                            <dt>Size</dt><dd data-testid="bios-package-size">@HardwareInventory.FormatBytes(latest.SizeBytes)</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(latest.ReleaseSummary))
                        {
                            <dt>Summary</dt><dd data-testid="bios-release-summary">@latest.ReleaseSummary</dd>
                        }
                        @if (BiosPackageVerifier.IsSafeDownloadUrl(latest.ReleaseNotesUrl))
                        {
                            <dt>Release notes</dt>
                            <dd><a href="@latest.ReleaseNotesUrl" target="_blank" rel="noopener noreferrer" data-testid="bios-release-notes-link">View vendor release notes</a></dd>
                        }
                    </dl>
                }

                @if (latest.Status == BiosCheckStatus.UpdateAvailable)
                {
                    @if (provider?.Capabilities.CanInstall == true)
                    {
                        <div data-testid="bios-safety-card" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
                            <div class="card-head">
                                <strong>Pre-flash safety checks</strong>
                                <button type="button" class="btn-small" data-testid="bios-recheck-safety"
                                        disabled="@(_checkingSafety || _installing)" @onclick="EvaluateSafetyAsync">
                                    @(_checkingSafety ? "Checking…" : "Re-check prerequisites")
                                </button>
                            </div>

                            @if (_safety is { } safety)
                            {
                                @if (safety.BlockingReasons.Count > 0)
                                {
                                    <div class="notice notice-error" data-testid="bios-safety-blockers">
                                        <strong>Install blocked until resolved:</strong>
                                        <ul>
                                            @foreach (var reason in safety.BlockingReasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                        @if (App.Elevation is { HasAdminCapabilities: false })
                                        {
                                            <button type="button" class="btn-small" data-testid="bios-enable-admin"
                                                    disabled="@_enablingAdmin" @onclick="EnableAdminModeAsync">
                                                @(_enablingAdmin ? "Enabling Admin Repair Mode…" : "Enable Admin Repair Mode")
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="meta" data-testid="bios-safety-passed">All pre-flash prerequisites passed (AC power, battery reserve, elevation, and reboot state).</p>
                                }

                                @if (safety.Warnings.Count > 0)
                                {
                                    <ul class="meta" data-testid="bios-safety-warnings">
                                        @foreach (var warning in safety.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>

                        <div data-testid="bios-install-controls" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
                            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px">
                                <label>
                                    <input type="checkbox" data-testid="bios-suspend-bitlocker"
                                           data-checked="@(_suspendBitLocker ? "true" : "false")"
                                           checked="@_suspendBitLocker" disabled="@_installing"
                                           @onchange="OnSuspendBitLockerChangedAsync" />
                                    Suspend BitLocker for 1 reboot before flashing (recommended)
                                </label>
                                <label>
                                    <input type="checkbox" data-testid="bios-allow-reboot"
                                           data-checked="@(_allowReboot ? "true" : "false")"
                                           @bind="_allowReboot" disabled="@_installing" />
                                    Allow automatic restart after staging
                                </label>
                                <label>
                                    <input type="checkbox" data-testid="bios-approve"
                                           data-checked="@(_approved ? "true" : "false")"
                                           checked="@_approved" disabled="@_installing"
                                           @onchange="OnApprovedChangedAsync" />
                                    <strong>I approve installing BIOS @(latest.LatestVersion) and confirm uninterrupted AC power.</strong>
                                </label>
                            </div>

                            <button type="button" class="btn btn-primary" data-testid="bios-install"
                                    disabled="@(!CanInstall)" @onclick="InstallUpdateAsync">
                                @(_installing ? "Installing BIOS update…" : $"Install BIOS {latest.LatestVersion}")
                            </button>
                        </div>

                        @if (_progress is { } prog)
                        {
                            <div data-testid="bios-install-progress" style="margin-top:12px">
                                <div class="meta">
                                    <strong data-testid="bios-progress-stage">@prog.Stage</strong>:
                                    <span data-testid="bios-progress-detail">@prog.Detail</span>
                                    (@Math.Clamp(prog.Percent, 0, 100)%)
                                </div>
                                <div class="progress run-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Clamp(prog.Percent, 0, 100)">
                                    <div class="progress-bar" style="width:@($"{Math.Clamp(prog.Percent, 0, 100)}%")"></div>
                                </div>
                            </div>
                        }

                        @if (_installResult is { } res)
                        {
                            <div class="@(res.Succeeded ? "notice" : "notice notice-error")" role="status" data-testid="bios-install-result" style="margin-top:12px">
                                <strong>@InstallStatusHeadline(res.Status)</strong>
                                @if (!string.IsNullOrWhiteSpace(res.Message))
                                {
                                    <div>@res.Message</div>
                                }
                                @if (res.BitLockerSuspended)
                                {
                                    <div class="meta">BitLocker protection was suspended for the next restart and will resume automatically afterward.</div>
                                }
                                @if (res.ExitCode is { } exitCode && !res.Succeeded)
                                {
                                    <div class="meta">Installer exit code: @exitCode</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="notice" data-testid="bios-manual-install-note" style="margin-top:12px">
                            Automated installation is not supported for @(outcome.ProviderDisplayName ?? "this vendor").
                            Download and apply the update using the vendor's support page or firmware utility.
                            @if (BiosPackageVerifier.IsSafeDownloadUrl(latest.DownloadUrl))
                            {
                                <span> <a href="@latest.DownloadUrl" target="_blank" rel="noopener noreferrer" data-testid="bios-manual-download-link">Vendor download link</a></span>
                            }
                        </div>
                    }
                }
            </section>
        }

        <section class="card" data-testid="bios-providers-card">
            <div class="card-head">
                <strong>Registered BIOS Providers (@App.Bios.Providers.Count)</strong>
            </div>
            @if (App.Bios.Providers.Count == 0)
            {
                <p class="meta">No BIOS update providers are registered.</p>
            }
            else
            {
                <table class="about-plugins">
                    <thead>
                        <tr><th>Vendor</th><th>Priority</th><th>Check latest</th><th>Automated install</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in App.Bios.Providers)
                        {
                            <tr data-testid="bios-provider-row-@p.VendorId">
                                <td><strong>@p.DisplayName</strong> <span class="meta">(@p.VendorId)</span></td>
                                <td>@p.Priority</td>
                                <td>@(p.Capabilities.CanCheckLatest ? "Yes" : "No")</td>
                                <td>@(p.Capabilities.CanInstall ? "Yes" : "Manual only")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private BiosCurrentInfo? _current;
    private BiosUpdateCheckOutcome? _outcome;
    private BiosSafetyCheckResult? _safety;
    private BiosInstallProgress? _progress;
    private BiosInstallResult? _installResult;
    private string? _error;

    private bool _loadingCurrent;
    private bool _checking;
    private bool _checkingSafety;
    private bool _installing;
    private bool _enablingAdmin;

    private bool _approved;
    private bool _suspendBitLocker = true;
    private bool _allowReboot;

    private bool IsBusy => _loadingCurrent || _checking || _checkingSafety || _installing || _enablingAdmin;

    private string? ReportJson
    {
        get
        {
            if (App.Bios is null)
                return null;
            var cur = _outcome?.Current ?? _current;
            var sys = _outcome?.System;
            var provider = _outcome is not null
                ? ResolveMatchedProvider(_outcome)
                : (!string.IsNullOrWhiteSpace(cur?.ProviderId)
                    ? App.Bios.Providers.FirstOrDefault(p => string.Equals(p.VendorId, cur.ProviderId, StringComparison.OrdinalIgnoreCase))
                    : null);
            var latest = _outcome?.Latest;
            var payload = new
            {
                schema = 1,
                available = true,
                busy = IsBusy,
                loadingCurrent = _loadingCurrent,
                checking = _checking,
                checkingSafety = _checkingSafety,
                installing = _installing,
                system = sys is null ? null : new
                {
                    manufacturer = string.IsNullOrWhiteSpace(sys.Manufacturer) ? null : sys.Manufacturer,
                    model = string.IsNullOrWhiteSpace(sys.Model) ? null : sys.Model,
                    boardProduct = string.IsNullOrWhiteSpace(sys.BoardProduct) ? null : sys.BoardProduct,
                    osVersion = string.IsNullOrWhiteSpace(sys.OsVersion) ? null : sys.OsVersion,
                    architecture = string.IsNullOrWhiteSpace(sys.Architecture) ? null : sys.Architecture,
                },
                current = cur is null ? null : new
                {
                    vendor = string.IsNullOrWhiteSpace(cur.Vendor) ? null : cur.Vendor,
                    version = string.IsNullOrWhiteSpace(cur.Version) ? null : cur.Version,
                    releaseDate = cur.ReleaseDate?.ToString("yyyy-MM-dd") ?? (string.IsNullOrWhiteSpace(cur.ReleaseDateRaw) ? null : cur.ReleaseDateRaw),
                    firmwareMode = cur.FirmwareMode.ToString(),
                    family = string.IsNullOrWhiteSpace(cur.Family) ? null : cur.Family,
                    providerId = string.IsNullOrWhiteSpace(cur.ProviderId) ? null : cur.ProviderId,
                },
                provider = provider is null ? null : new
                {
                    id = provider.VendorId,
                    displayName = provider.DisplayName,
                    priority = provider.Priority,
                    canCheckLatest = provider.Capabilities.CanCheckLatest,
                    canInstall = provider.Capabilities.CanInstall,
                    supportsSilentInstall = provider.Capabilities.SupportsSilentInstall,
                    requiresReboot = provider.Capabilities.RequiresReboot,
                    requiresElevation = provider.Capabilities.RequiresElevation,
                },
                latest = latest is null ? null : new
                {
                    status = latest.Status.ToString(),
                    providerId = latest.ProviderId,
                    latestVersion = latest.LatestVersion,
                    releaseDate = latest.ReleaseDate?.ToString("yyyy-MM-dd"),
                    severity = latest.Severity.ToString(),
                    packageId = latest.PackageId,
                    sizeBytes = latest.SizeBytes,
                    releaseSummary = latest.ReleaseSummary,
                    releaseNotesUrl = BiosPackageVerifier.IsSafeDownloadUrl(latest.ReleaseNotesUrl) ? latest.ReleaseNotesUrl : null,
                    downloadUrl = BiosPackageVerifier.IsSafeDownloadUrl(latest.DownloadUrl) ? latest.DownloadUrl : null,
                    requiresReboot = latest.RequiresReboot,
                    message = latest.Message,
                },
                safety = _safety is null ? null : new
                {
                    passed = _safety.Passed,
                    blockingReasons = _safety.BlockingReasons,
                    warnings = _safety.Warnings,
                    hasElevation = App.Elevation?.HasAdminCapabilities,
                },
                progress = _progress is null ? null : new
                {
                    stage = _progress.Stage.ToString(),
                    percent = Math.Clamp(_progress.Percent, 0, 100),
                    detail = _progress.Detail,
                },
                installResult = _installResult is null ? null : new
                {
                    succeeded = _installResult.Succeeded,
                    status = _installResult.Status.ToString(),
                    requiresReboot = _installResult.RequiresReboot,
                    bitLockerSuspended = _installResult.BitLockerSuspended,
                    previousVersion = _installResult.PreviousVersion,
                    targetVersion = _installResult.TargetVersion,
                    message = _installResult.Message,
                    exitCode = _installResult.ExitCode,
                },
                providers = App.Bios.Providers.Select(p => new
                {
                    vendorId = p.VendorId,
                    displayName = p.DisplayName,
                    priority = p.Priority,
                    canCheckLatest = p.Capabilities.CanCheckLatest,
                    canInstall = p.Capabilities.CanInstall,
                }).ToArray(),
                error = _error,
            };
            return JsonSerializer.Serialize(payload);
        }
    }

    private string? MatchedProviderName =>
        _outcome?.ProviderDisplayName
        ?? (!string.IsNullOrWhiteSpace(_current?.ProviderId)
            ? App.Bios?.Providers.FirstOrDefault(p => string.Equals(p.VendorId, _current.ProviderId, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? _current.ProviderId
            : null);

    private bool CanInstall =>
        !_installing
        && !_checking
        && !_checkingSafety
        && _approved
        && _outcome is { Latest.Status: BiosCheckStatus.UpdateAvailable }
        && _safety is { Passed: true };

    protected override async Task OnInitializedAsync()
    {
        if (App.Elevation is not null)
            App.Elevation.Changed += OnElevationChanged;

        if (App.Bios is null)
            return;

        _loadingCurrent = true;
        try
        {
            _current = await App.Bios.GetCurrentVersionAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Could not read current BIOS information: {ex.Message}";
        }
        finally
        {
            _loadingCurrent = false;
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        if (App.Bios is null || _checking || _installing)
            return;

        _checking = true;
        _error = null;
        _safety = null;
        _progress = null;
        _installResult = null;
        _approved = false;

        try
        {
            _outcome = await App.Bios.CheckForUpdateAsync(_cts.Token);
            _current = _outcome.Current;
            if (_outcome.Latest.Status == BiosCheckStatus.UpdateAvailable
                && ResolveMatchedProvider(_outcome)?.Capabilities.CanInstall == true)
            {
                await EvaluateSafetyAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"BIOS update check failed: {ex.Message}";
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task EvaluateSafetyAsync()
    {
        if (App.Bios is null || _outcome is null || _checkingSafety)
            return;

        _checkingSafety = true;
        try
        {
            var req = BuildInstallRequest(approvedOverride: true);
            _safety = await App.Bios.EvaluateInstallSafetyAsync(req, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Could not evaluate pre-flash prerequisites: {ex.Message}";
        }
        finally
        {
            _checkingSafety = false;
        }
    }

    private async Task EnableAdminModeAsync()
    {
        if (App.Elevation is null || _enablingAdmin)
            return;

        _enablingAdmin = true;
        _error = null;
        try
        {
            var result = await App.Elevation.EnableAdminModeAsync(_cts.Token);
            if (!result.Success && !result.Cancelled)
                _error = result.Message;
            if (_outcome is { Latest.Status: BiosCheckStatus.UpdateAvailable })
                await EvaluateSafetyAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Could not enable Admin Repair Mode: {ex.Message}";
        }
        finally
        {
            _enablingAdmin = false;
        }
    }

    private async Task InstallUpdateAsync()
    {
        if (App.Bios is null || _outcome is null || !CanInstall)
            return;

        _installing = true;
        _error = null;
        _installResult = null;
        _progress = new BiosInstallProgress(BiosInstallStage.CheckingPrerequisites, 0, "Starting BIOS update…");

        var progress = new Progress<BiosInstallProgress>(p =>
        {
            _progress = p;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var request = BuildInstallRequest(approvedOverride: _approved);
            _installResult = await App.Bios.InstallUpdateAsync(request, progress, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _installResult = BiosInstallResult.Failed(ex.Message, _outcome.Current.Version, _outcome.Latest.LatestVersion);
        }
        finally
        {
            _installing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSuspendBitLockerChangedAsync(ChangeEventArgs e)
    {
        _suspendBitLocker = e.Value is true;
        if (_outcome is { Latest.Status: BiosCheckStatus.UpdateAvailable })
            await EvaluateSafetyAsync();
    }

    private Task OnApprovedChangedAsync(ChangeEventArgs e)
    {
        _approved = e.Value is true;
        return Task.CompletedTask;
    }

    private BiosInstallRequest BuildInstallRequest(bool approvedOverride) =>
        new(
            System: _outcome!.System,
            Current: _outcome.Current,
            Target: _outcome.Latest,
            Approved: approvedOverride,
            ApprovedBy: Session.Mode == SessionMode.Remote ? "remote-operator" : "local-operator",
            SuspendBitLocker: _suspendBitLocker,
            AllowReboot: _allowReboot,
            VerifyHash: true);

    private IBiosUpdateProvider? ResolveMatchedProvider(BiosUpdateCheckOutcome outcome)
    {
        if (App.Bios is null)
            return null;
        if (!string.IsNullOrWhiteSpace(outcome.ProviderId))
        {
            var byId = App.Bios.Providers.FirstOrDefault(p =>
                string.Equals(p.VendorId, outcome.ProviderId, StringComparison.OrdinalIgnoreCase));
            if (byId is not null)
                return byId;
        }
        return App.Bios.ResolveProvider(outcome.System);
    }

    private void OnElevationChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_outcome is { Latest.Status: BiosCheckStatus.UpdateAvailable } && !_installing)
                await EvaluateSafetyAsync();
            StateHasChanged();
        });
    }

    private static string CheckDotClass(BiosCheckStatus status) => status switch
    {
        BiosCheckStatus.UpToDate => "dot dot-ok",
        BiosCheckStatus.UpdateAvailable => "dot dot-warn",
        BiosCheckStatus.Failed => "dot dot-error",
        _ => "dot dot-neutral",
    };

    private static string CheckStatusHeadline(BiosLatestInfo latest) => latest.Status switch
    {
        BiosCheckStatus.UpToDate => "BIOS is up to date",
        BiosCheckStatus.UpdateAvailable => $"BIOS update available ({latest.LatestVersion})",
        BiosCheckStatus.UnsupportedHardware => "Hardware not supported for automated BIOS checks",
        BiosCheckStatus.ProviderUnavailable => "Vendor catalog unavailable",
        BiosCheckStatus.Offline => "Internet connection required",
        BiosCheckStatus.Failed => "BIOS update check failed",
        _ => latest.Status.ToString(),
    };

    private static string InstallStatusHeadline(BiosInstallStatus status) => status switch
    {
        BiosInstallStatus.StagedForReboot => "BIOS update staged for next restart",
        BiosInstallStatus.Completed => "BIOS update completed",
        BiosInstallStatus.AlreadyUpToDate => "BIOS is already up to date",
        BiosInstallStatus.BlockedByPrerequisites => "Blocked by safety prerequisites",
        BiosInstallStatus.Unsupported => "Automated installation not supported",
        BiosInstallStatus.Refused => "Installation refused",
        BiosInstallStatus.Failed => "BIOS update failed",
        _ => status.ToString(),
    };

    public void Dispose()
    {
        if (App.Elevation is not null)
            App.Elevation.Changed -= OnElevationChanged;
        try { _cts.Cancel(); } catch { }
        _cts.Dispose();
    }
}
