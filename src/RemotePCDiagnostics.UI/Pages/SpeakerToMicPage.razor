@using RemotePCDiagnostics.Core.Audio
@inherits ModuleDetailsBase
@* On-demand speaker → microphone test: plays a capped, faded 1 kHz tone while recording the mic and the speaker output (loopback). *@
@{
    var m = (DiagnosticModule as SpeakerToMicModule);
}
@if (m is null)
{
    <p class="meta" data-testid="area-missing">This page isn't available.</p>
}
else
{
    var r = Store.Get(m.Name);
    var rep = r.Payload as SpeakerToMicReport;
    var running = r.Status == DiagnosticStatus.Running;
    var suiteBusy = Diagnostics.IsStressSuiteRunning;
    <div class="toolbar toolbar-grouped">
        <span class="icon-badge page-icon"><Icon Name="audio" Size="20" /></span><h1 data-testid="s2m-title">@m.DisplayName</h1>
        @if (running) { <button data-testid="s2m-cancel" @onclick="m.Cancel">Cancel</button> }
        else { <button data-testid="s2m-start" disabled="@suiteBusy" @onclick="() => Start(m)">@(r.Status == DiagnosticStatus.NotRun ? "Start" : "Run again")</button> }
    </div>
    <p class="meta" data-testid="s2m-intro">Plays a short 1 kHz tone through the speaker (volume capped, fades in and out) while the microphone listens and the app records what Windows sends to the speaker. It then checks whether the tone reached the speaker output and the microphone. Over a remote session you won't hear the tone yourself; the result is measured on the PC.</p>
    <div class="toolbar">
        <label class="meta">Speaker
            <select data-testid="s2m-output" disabled="@running" @onchange="e => m.Settings.OutputId = Id(e)">
                @DeviceOptions(_outputs, m.Settings.OutputId)
            </select>
        </label>
        <label class="meta">Microphone
            <select data-testid="s2m-input" disabled="@running" @onchange="e => m.Settings.InputId = Id(e)">
                @DeviceOptions(_inputs, m.Settings.InputId)
            </select>
        </label>
        <label class="meta" title="Plays the tone twice and records the speaker output and the microphone one at a time, for PCs that can't do both at once."><input type="checkbox" data-testid="s2m-halfduplex" checked="@m.Settings.HalfDuplex" disabled="@running"
            @onchange="e => m.Settings.HalfDuplex = e.Value is true" /> Half-duplex (play, then record)</label>
        <button class="btn-small" data-testid="s2m-refresh-devices" disabled="@running" @onclick="() => LoadDevices(m)">Refresh devices</button>
    </div>
    <p data-testid="s2m-status" class="@(running ? "status-line is-running" : r.Status == DiagnosticStatus.Error && rep is null ? "status-line error-text" : "status-line")">
        <span class="@DotClass(r.Status)"></span>
        <span>@(r.Status switch { DiagnosticStatus.NotRun => "Not run yet. Press Start to begin.", DiagnosticStatus.Running => "Playing the test tone and listening…", _ => r.Message })</span>
        @if (running) { <span class="running-badge" data-testid="running-badge"><span class="running-badge-dot"></span>Running</span> }
    </p>
    @if (running) { <div class="run-progress run-progress-indeterminate" data-testid="s2m-run-progress" aria-hidden="true"><div></div></div> }
    @if (!running && rep?.Notice is { } notice) { <p class="notice" data-testid="s2m-notice">@notice</p> }
    @if (!running && rep is { OfferHalfDuplex: true, HalfDuplex: false })
    {
        <p class="notice" data-testid="s2m-offer-halfduplex">Feedback was detected. <button class="btn-small" @onclick="() => { m.Settings.HalfDuplex = true; Start(m); }">Run again in half-duplex</button></p>
    }
    @if (!running && rep is not null && rep.Verdict != AudioVerdict.NoDevice && rep.Verdict != AudioVerdict.MicAccessDenied)
    {
        <div class="cards">
            @LevelCard("loopback", "Speaker output", rep.Loopback, rep.Output, "What Windows sent to the speaker")
            @LevelCard("mic", "Microphone", rep.Mic, rep.Input, "What the microphone heard")
        </div>
        <table class="detail" data-testid="s2m-table">
            <tr><th>Test tone</th><td>@rep.FrequencyHz.ToString("0") Hz, @AudioMath.MaxToneDbfs.ToString("0") dBFS max</td></tr>
            <tr><th>Mode</th><td>@(rep.HalfDuplex ? "Half-duplex (one recording at a time)" : "Full duplex (play and record together)")</td></tr>
            <tr><th>Raw microphone mode</th><td>@(rep.RawMic ? "Yes" : "Not supported by this driver")</td></tr>
        </table>
    }
}

@code {
    private IReadOnlyList<AudioDevice> _outputs = [], _inputs = [];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if ((DiagnosticModule as SpeakerToMicModule) is { } m) LoadDevices(m);
    }

    private void LoadDevices(SpeakerToMicModule m) { _outputs = m.Devices(AudioFlow.Output); _inputs = m.Devices(AudioFlow.Input); }

    private void Start(SpeakerToMicModule m)
    {
        if (Diagnostics.IsStressSuiteRunning) return;
        _ = Diagnostics.RunAsync(m.Name);
    }

    private static string? Id(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } v ? v : null;

    private static RenderFragment DeviceOptions(IReadOnlyList<AudioDevice> devices, string? selected) => __builder =>
    {
        if (devices.Count == 0) { <option value="">None found</option> }
        else
        {
            <option value="" selected="@(selected is null)">Windows default</option>
            foreach (var d in devices) { <option value="@d.Id" selected="@(d.Id == selected)">@d.Label</option> }
        }
    };

    private static RenderFragment LevelCard(string id, string title, ToneMeasurement? t, string device, string meta) => __builder =>
    {
        var dot = t is null ? "neutral" : t.ToneDetected ? "ok" : "error";
        <div class="card" data-testid="s2m-card-@id">
            <div class="card-head"><span class="dot dot-@dot"></span><strong>@title</strong></div>
            <div class="headline">@(t is null ? "Not available" : t.ToneDetected ? "Tone found" : "No tone")</div>
            <CardList Items="@([ device, t is not null ? $"Tone {Db(t.ToneDbfs)} · noise {Db(t.NoiseDbfs)} · SNR {t.SnrDb:0.0} dB" : null, t is not null ? $"Peak {Db(t.PeakDbfs)} · RMS {Db(t.RmsDbfs)}{(t.Clipped ? " · clipping" : "")}" : null, meta ])" />
            @if (t is not null)
            {


            }

        </div>
    };

    private static string Db(double v) => v <= AudioMath.SilenceDbfs ? "silent" : $"{v:0.0} dBFS";
}
