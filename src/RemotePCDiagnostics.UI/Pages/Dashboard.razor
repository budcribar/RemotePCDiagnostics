@page "/"
@using RemotePCDiagnostics.Core.Osquery
@using RemotePCDiagnostics.Core.Sensors
@inherits StoreAwareComponent
@inject NavigationManager Nav
@inject RemotePCDiagnostics.Core.Session.ISessionContext Session
@implements IAsyncDisposable
@{
    var hw = Store.Get("Osquery");
    var inv = hw.Payload as HardwareInventory;
    var th = Store.Get(LibreHardwareMonitorModule.ModuleName);
    var thBusy = th.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
    var sensors = th.Payload as SensorReport;
    var cpuGroup = sensors?.Groups.FirstOrDefault(g => g.Id == "cpu");
    var cpuTemp = cpuGroup?.Hottest;
    var driveGroup = sensors?.Groups.FirstOrDefault(g => g.Id == "storage");
    var fanGroup = sensors?.Groups.FirstOrDefault(g => g.Id == "fans");
    var rpm = fanGroup?.Readings.Select(x => x.Reading.Value).Where(x => x is > 0).DefaultIfEmpty().Max();
    var querying = hw.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
    var checks = Diagnostics.Modules.Where(m => m.IncludeInRunAll).ToList();
    var tests = Diagnostics.Modules.Where(m => !m.IncludeInRunAll).ToList();
    var all = Diagnostics.Modules.Select(m => Store.Get(m.Name)).ToList();
    var checking = checks.Any(m => Store.Get(m.Name).Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun);
    var summary = DashboardSummary.Build(Diagnostics.Modules.Select(m => { var r = Store.Get(m.Name); return new BannerModule(m.Name, m.DisplayName, !m.IncludeInRunAll, m is IStressSuiteModule, r.Status, r.Message); }), suite);
    var problems = summary.Problems.Count;
    var last = all.Where(r => r.Status is not (DiagnosticStatus.NotRun or DiagnosticStatus.Running)).Select(r => (DateTimeOffset?)r.Timestamp).Max();
    var bannerKind = checking ? "run" : problems == 0 ? "ok" : summary.HasError ? "err" : "warn";
    var shownProblems = showAllProblems || problems <= MaxProblems ? summary.Problems : summary.Problems.Take(MaxProblems - 1).ToList();
}
<div class="toolbar"><h1 data-testid="dashboard-title">Dashboard</h1></div>

<section class="banner banner-@bannerKind" data-testid="dashboard-banner">
    <span class="banner-icon"><Icon Name="@(problems > 0 && !checking ? "crash" : "sec")" Size="26" /></span>
    <div class="banner-text">
        <div class="banner-title" data-testid="dashboard-health">
            @if (checking) { <span>Checking your PC…</span> }
            else if (problems == 0) { <span>Your PC looks healthy</span> }
            else
            {
                <span>@summary.TitleLead: </span>
                @for (var i = 0; i < shownProblems.Count; i++)
                {
                    var p = shownProblems[i];
                    <a href="" class="banner-problem banner-problem-@(p.IsError ? "err" : "warn")" data-testid="dashboard-problem-@p.Name.ToLowerInvariant()"
                       @onclick="() => Open(p.Name)" @onclick:preventDefault>@p.DisplayName</a>@(i < shownProblems.Count - 1 ? ", " : "")
                }
                @if (shownProblems.Count < problems)
                {
                    <span>, </span><button class="banner-more" data-testid="dashboard-problems-more" @onclick="() => showAllProblems = true">+@(problems - shownProblems.Count) more</button>
                }
            }
        </div>
        <div class="banner-sub" data-testid="dashboard-last-checked">@(last is { } l ? $"Last checked {l.ToLocalTime():g}" : "Not checked yet")</div>
        @if (summary.NotRunNote is { } note)
        {
            <div class="banner-note" data-testid="dashboard-notrun-note">
                <span>@note</span>
                @if (summary.NotRunHint is { } hint) { <span class="banner-hint">· @hint</span> }
            </div>
        }
    </div>
    <div class="banner-actions">
        <button class="btn btn-primary" data-testid="dashboard-runall" disabled="@(checking || suiteBusy)" @onclick="RunAll">
            <Icon Name="@(checking ? "refresh" : "play")" Size="14" />@(checking ? "Checking…" : "Run all tests")</button>
        <button class="btn btn-outline" data-testid="dashboard-runall-stress-short" disabled="@(checking || suiteBusy)" @onclick="() => RunSuite(StressSuiteMode.Short)">
            <Icon Name="play" Size="12" />Run all + stress tests (short, about 5 min)</button>
        <button class="btn btn-outline" data-testid="dashboard-runall-stress-extended" disabled="@(checking || suiteBusy)" @onclick="() => RunSuite(StressSuiteMode.Extended)">
            <Icon Name="play" Size="12" />Run all + stress tests (extended, about 25 min)</button>
    </div>
</section>

@if (suite is { } sp && (suiteBusy || sp.Finished))
{
    <section class="card suite-status" data-testid="dashboard-suite-status">
        <div class="suite-line">
            <strong data-testid="dashboard-suite-progress">@(suiteBusy ? sp.Headline : sp.Message)</strong>
            @if (suiteBusy)
            {
                <button class="btn" data-testid="dashboard-suite-cancel" disabled="@cancelling" @onclick="CancelSuite">@(cancelling ? "Cancelling…" : "Cancel")</button>
            }
        </div>
        <ul class="suite-steps">
            @foreach (var st in sp.Steps)
            {
                <li data-testid="dashboard-suite-step-@st.ModuleName.ToLowerInvariant()"><span class="@DotClass(StepStatus(st.State))"></span>@st.DisplayName: @StepText(st.State)</li>
            }
        </ul>
    </section>
}

<div class="dash-grid">
    <div class="card dash-card gauge-card card-click" data-testid="dashboard-card-sensors" role="link" tabindex="0"
         @onclick='() => Open(LibreHardwareMonitorModule.ModuleName)' @onkeydown='e => Key(e, LibreHardwareMonitorModule.ModuleName)'>
        <div class="card-head"><span class="icon-badge"><Icon Name="temp" /></span><strong>CPU temp</strong>
            <StatusChip Status="@(cpuTemp is null && !thBusy ? DiagnosticStatus.NotRun : th.Status)" Text="@(cpuTemp is null && !thBusy ? "No reading" : null)" /></div>
        <div class="gauge gauge-@Level(cpuGroup)" data-testid="dashboard-cpu-gauge">
            <svg viewBox="0 0 120 120" role="img" aria-label="@(cpuTemp is { } a ? $"CPU temperature {a:0} degrees" : "No CPU temperature reading")">
                <circle class="gauge-track" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="75 100" transform="rotate(135 60 60)" />
                @if (cpuTemp is { } t)
                {
                    <circle class="gauge-fill" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="@($"{Math.Clamp(t, 0, 100) * 0.75:0.#} 100")" transform="rotate(135 60 60)" />
                }
                <text class="gauge-num" x="60" y="62" text-anchor="middle">@(cpuTemp is { } v ? $"{v:0}°C" : "—")</text>
                <text class="gauge-sub" x="60" y="80" text-anchor="middle">@(cpuTemp is null ? (thBusy ? "Checking…" : "No reading") : "of 100°C")</text>
            </svg>
        </div>
        <div class="desc center" data-testid="dashboard-thermal">@(thBusy ? "Checking temperatures…" : th.Message)</div>
    </div>

    @if (sensors is not null)
    {
        <div class="card dash-card card-click" data-testid="dashboard-card-drivetemp" role="link" tabindex="0" @onclick='() => Open(LibreHardwareMonitorModule.ModuleName)'>
            <div class="card-head"><span class="icon-badge"><Icon Name="temp" /></span><strong>Drive temp</strong><StatusChip Status="@ToStatus(driveGroup)" Text="@(driveGroup?.Hottest is null ? "No reading" : null)" /></div>
            <div class="val">@(driveGroup?.Hottest is { } d ? $"{d:0}°C" : "—")</div>
            <div class="desc">@(driveGroup?.Hottest is null ? "Not reported by this PC" : Level(driveGroup) == "ok" ? "Normal range" : "Running warm")</div>
        </div>
        @if (fanGroup is { Readings.Count: > 0 })
        {
        <div class="card dash-card card-click" data-testid="dashboard-card-fans" role="link" tabindex="0" @onclick='() => Open(LibreHardwareMonitorModule.ModuleName)'>
            <div class="card-head"><span class="icon-badge"><Icon Name="fan" /></span><strong>Fans</strong><StatusChip Status="@ToStatus(fanGroup)" /></div>
            <div class="val">@(rpm is { } f ? $"{f:0} RPM" : "—")</div>
            <div class="desc">@fanGroup.Readings.Count fan(s) reported</div>
        </div>
        }
    }

    @foreach (var m in checks.Where(m => m.Name != LibreHardwareMonitorModule.ModuleName))
    {
        var r = Store.Get(m.Name);
        var busy = r.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
        var name = m.Name;
        <div class="card dash-card card-click" data-testid="dashboard-card-@m.Name.ToLowerInvariant()" role="link" tabindex="0"
             @onclick="() => Open(name)" @onkeydown="e => Key(e, name)">
            <div class="card-head"><span class="icon-badge icon-@StatusChip.Kind(r.Status)"><Icon Name="@Icon.ForModule(m.Name)" /></span><strong>@m.DisplayName</strong>
                <StatusChip Status="@(busy ? DiagnosticStatus.Running : r.Status)" Text="@(busy ? "Checking…" : null)" /></div>
            @if (m.Name == "Osquery")
            {
                <div data-testid="dashboard-status" class="@(hw.Status == DiagnosticStatus.Error ? "card-msg error-text" : "card-msg")">
                    @if (querying) { <span>Querying hardware…</span> }
                    else if (hw.Status == DiagnosticStatus.Error || inv is null) { <span>@hw.Message</span> }
                    else { <span>@inv.FriendlySummary()</span> }
                </div>
            }
            else { <div class="card-msg">@(busy ? "Checking…" : r.Message)</div> }
            @if (!busy) { <div class="meta">Updated @r.Timestamp.ToLocalTime().ToString("g")</div> }
        </div>
    }
</div>

<h2 class="section-title">Tests</h2>
<div class="test-grid">
    @foreach (var m in tests)
    {
        var r = Store.Get(m.Name);
        var name = m.Name;
        <div class="card test-card" data-testid="dashboard-card-@m.Name.ToLowerInvariant()">
            <span class="icon-badge icon-@StatusChip.Kind(r.Status)"><Icon Name="@Icon.ForModule(m.Name)" /></span>
            <div>
                <strong class="test-name">@TestName(m)</strong>
                <div class="desc" data-testid="dashboard-@TestId(m.Name)"><span class="@DotClass(r.Status)"></span>@(r.Status switch { DiagnosticStatus.NotRun => "Not run yet", DiagnosticStatus.Running => "Running…", _ => r.Message })@(Diagnostics.StressRunLabel(m.Name) is { } lbl && r.Status is not (DiagnosticStatus.NotRun or DiagnosticStatus.Running) ? $" ({lbl})" : "")</div>
            </div>
            <button class="btn btn-outline" data-testid="dashboard-start-@m.Name.ToLowerInvariant()" @onclick="() => Open(name)">
                <Icon Name="play" Size="12" />@(r.Status == DiagnosticStatus.Running ? "View" : r.Status == DiagnosticStatus.NotRun ? "Start" : "Run again")</button>
        </div>
    }
</div>

@code {
    private void Open(string module) => Nav.NavigateTo($"module/{module.ToLowerInvariant()}");
    private void Key(KeyboardEventArgs e, string module) { if (e.Key is "Enter" or " ") Open(module); }
    private void RunAll() => _ = Diagnostics.RunAllAsync();

    private StressSuiteProgress? suite;
    private bool suiteBusy => Diagnostics.IsStressSuiteRunning;
    private bool cancelling;
    private bool showAllProblems;
    private const int MaxProblems = 4;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        suite = Diagnostics.LastStressSuiteProgress;
        Diagnostics.StressSuiteProgressChanged += OnSuite;
    }
    private void OnSuite(object? s, StressSuiteProgress p) { suite = p; if (p.Finished) cancelling = false; _ = InvokeAsync(StateHasChanged); }
    public ValueTask DisposeAsync() { Diagnostics.StressSuiteProgressChanged -= OnSuite; Dispose(); return ValueTask.CompletedTask; }

    // One click, no confirmation (also in Remote mode: the user already let the technician in).
    private async Task RunSuite(StressSuiteMode mode)
    {
        if (Diagnostics.IsStressSuiteRunning) return;
        Diagnostics.Log?.Invoke($"Stress suite ({StressSuite.RunLabel(mode)}) requested from the Dashboard by the {(Session.Mode == RemotePCDiagnostics.Core.Session.SessionMode.Remote ? "remote technician" : "local user")}");
        cancelling = false;
        try { await Diagnostics.RunStressSuiteAsync(mode, null); }
        catch (InvalidOperationException) { /* already running: the other click won */ }
        catch (Exception ex) { Diagnostics.Log?.Invoke($"Stress suite failed: {ex.Message}"); }
        StateHasChanged();
    }
    private void CancelSuite() { cancelling = true; Diagnostics.CancelStressSuite(); }

    private static DiagnosticStatus StepStatus(StressSuiteStepState s) => s switch
    {
        StressSuiteStepState.Running => DiagnosticStatus.Running,
        StressSuiteStepState.Passed => DiagnosticStatus.Ok,
        StressSuiteStepState.Problem => DiagnosticStatus.Warning,
        _ => DiagnosticStatus.NotRun,
    };
    private static string StepText(StressSuiteStepState s) => s switch
    {
        StressSuiteStepState.Pending => "Waiting",
        StressSuiteStepState.Running => "Running…",
        StressSuiteStepState.Passed => "Passed",
        StressSuiteStepState.Problem => "Needs a look",
        StressSuiteStepState.Skipped => "Skipped (not available on this PC)",
        _ => "Not run",
    };

    // Previous dashboard test ids for the stress status lines.
    private static string TestId(string module) => module switch { "MemoryTest" => "memorytest", "NetworkTest" => "networktest", _ => module.ToLowerInvariant() };
    private static string TestName(IDiagnosticModule m) => m.Name switch { "DiskSpeed" => "Disk speed", "NetworkTest" => "Network test", "GpuStress" => "GPU stress test", _ => m.DisplayName };
    private static string Level(SensorGroup? g) => g is null || g.Readings.Count == 0 ? "na" : g.Level switch { SensorLevel.Critical => "err", SensorLevel.Warning => "warn", _ => "ok" };
    private static DiagnosticStatus ToStatus(SensorGroup? g) => Level(g) switch { "err" => DiagnosticStatus.Error, "warn" => DiagnosticStatus.Warning, "ok" => DiagnosticStatus.Ok, _ => DiagnosticStatus.NotRun };
}
