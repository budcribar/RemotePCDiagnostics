@page "/"
@using RemotePCDiagnostics.Core.Osquery
@using RemotePCDiagnostics.Core.Sensors
@inherits StoreAwareComponent
@inject NavigationManager Nav
@inject ChecksScreenState Screen
@inject RemotePCDiagnostics.Core.Session.ISessionContext Session
@implements IAsyncDisposable
@{
    var hw = Store.Get(ModuleSlugs.Osquery);
    var inv = hw.Payload as HardwareInventory;
    var th = Store.Get(LibreHardwareMonitorModule.ModuleName);
    var thBusy = th.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
    var sensors = th.Payload as SensorReport;
    var cpuGroup = sensors?.Groups.FirstOrDefault(g => g.Id == "cpu");
    var cpuTemp = cpuGroup?.Hottest;
    var querying = hw.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun;
    var all = Diagnostics.Modules.Select(m => Store.Get(m.Name)).ToList();
    var checkModules = Diagnostics.Modules.Where(m => m.IncludeInRunAll).ToList();
    var nonCardChecks = checkModules.Where(m => m.Name is not (ModuleSlugs.Osquery or LibreHardwareMonitorModule.ModuleName or ModuleSlugs.DriveHealth)).ToList();
    var checking = Screen.RunningGroup == CheckGroup.Checks || nonCardChecks.Any(m => Store.Get(m.Name).Status == DiagnosticStatus.Running);
    var checkItems = checking ? Screen.LiveCheckItems(Store) : [];
    var completedChecks = checkItems.Count(c => c.Status is DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error);
    var totalChecks = checkItems.Count;
    var checkFraction = totalChecks > 0 ? Math.Clamp(checkItems.Sum(c => c.Status is DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error ? 1.0 : c.Status == DiagnosticStatus.Running && c.Total > 0 ? Math.Clamp(c.Fraction, 0.0, 0.95) : 0.0) / totalChecks, 0.0, 1.0) : 0.0;
    var activeCheck = checkItems.FirstOrDefault(c => c.Status == DiagnosticStatus.Running);
    var checksNotRunCount = nonCardChecks.Count(m => Store.Get(m.Name).Status == DiagnosticStatus.NotRun);
    var stressBusy = suiteBusy || Diagnostics.IsAnyStressRunning;
    var summary = DashboardSummary.Build(Diagnostics.Modules.Select(m => { var r = Store.Get(m.Name); return new BannerModule(m.Name, m.DisplayName, !m.IncludeInRunAll, m is IStressSuiteModule, r.Status, r.Message, r.Cancelled); }), suite);
    var last = nonCardChecks.Select(m => Store.Get(m.Name)).Where(r => r.Status is not (DiagnosticStatus.NotRun or DiagnosticStatus.Running)).Select(r => (DateTimeOffset?)r.Timestamp).Max();
    var problemRanks = summary.Problems.ToDictionary(p => p.Name, p => p.IsError ? 0 : 1, StringComparer.OrdinalIgnoreCase);
    if (_cardRanks is null || (!checking && !stressBusy && !all.Any(r => r.Status == DiagnosticStatus.Running)))
        _cardRanks = problemRanks;
    string[] fixedCards = [LibreHardwareMonitorModule.ModuleName, ModuleSlugs.Osquery, ModuleSlugs.DriveHealth]; // always shown (auto-run at launch)
    // Drive health is detectable: it isn't in Diagnostics.Modules until its drive detection finishes (or at all when no drive is
    // found), so its card waits for the module instead of failing the first render. Sensors and Osquery have their own cards.
    var cards = fixedCards.Where(name => name is LibreHardwareMonitorModule.ModuleName or ModuleSlugs.Osquery
            || Diagnostics.Modules.Any(m => m.Name == name)).Concat(Diagnostics.Modules.Select(m => m.Name)
        .Where(name => !fixedCards.Contains(name) && _cardRanks.ContainsKey(name)))
        .OrderBy(name => _cardRanks.GetValueOrDefault(name, 2)).ToList();
    var attentionCount = cards.Count(_cardRanks.ContainsKey);
    var now = DateTimeOffset.Now;
}
<div class="toolbar"><h1 data-testid="dashboard-title">Dashboard</h1></div>

<div class="toolbar dash-controls" data-testid="dashboard-controls">
    <div class="meta">
        <div class="banner-sub">
            <span data-testid="dashboard-last-checked">@(last is { } l ? $"Last checked {RemotePCDiagnostics.Core.History.TimeText.Ago(l, now)}" : "Live readings only, checks not run yet")</span>
            @if (checksNotRunCount > 0 && !checking)
            {
                <span> · </span><a href="checks" class="banner-more banner-more-small" data-testid="dashboard-checks-notrun">@checksNotRunCount system @(checksNotRunCount == 1 ? "check" : "checks") not run</a>
            }
            @if (summary.StressNotRunCount > 0)
            {
                <span> · </span><a href="stress" class="banner-more banner-more-small" data-testid="dashboard-notrun-count" title="@summary.StressNotRunNote">@summary.StressNotRunCount on-demand @(summary.StressNotRunCount == 1 ? "test" : "tests") not run</a>
            }
            @if (summary.AuditNotRun)
            {
                <span> · </span><a href="security-audit" class="banner-more banner-more-small" data-testid="dashboard-audit-notrun">security audit not run</a>
            }
        </div>
    </div>
    <div class="banner-actions">
        <button class="btn btn-primary" data-testid="dashboard-runall" disabled="@(checking || stressBusy)" @onclick="RunAll" title="Runs every read-only check">
            <Icon Name="@(checking ? "refresh" : "play")" Size="14" />@(checking ? (totalChecks > 0 ? $"Checking… ({completedChecks}/{totalChecks})" : "Checking…") : "Run all checks")</button>
        <button class="btn btn-outline" data-testid="dashboard-runall-stress-short" disabled="@(checking || stressBusy)" @onclick="() => RunSuite(StressSuiteMode.Short)"
                title="Short: ~1 min per stress test, about 5 min in all">
            <Icon Name="play" Size="12" />Run checks + stress tests (short)</button>
        <button class="btn btn-outline" data-testid="dashboard-runall-stress-extended" disabled="@(checking || stressBusy)" @onclick="() => RunSuite(StressSuiteMode.Extended)"
                title="Extended: ~5 min per stress test, about 25 min in all">
            <Icon Name="play" Size="12" />Run checks + stress tests (extended)</button>
        <a class="btn btn-outline" href="certificates" data-testid="dashboard-bench-qa" title="10-minute refurbisher bench intake &amp; Buyer Hardware QA QR Certificate">
            <Icon Name="cert" Size="14" />10-min QA check</a>
    </div>
</div>

@if (suite is { } sp && (suiteBusy || sp.Finished))
{
    <section class="card suite-status @(suiteBusy ? "card-with-visual" : "")" data-testid="dashboard-suite-status">
        <div class="card-main">
            <div class="suite-line">
                <strong data-testid="dashboard-suite-progress">@(suiteBusy ? sp.Headline : sp.Message)</strong>
                @if (suiteBusy)
                {
                    <button class="btn" data-testid="dashboard-suite-cancel" disabled="@cancelling" @onclick="CancelSuite">@(cancelling ? "Cancelling…" : "Cancel")</button>
                }
            </div>
            <ul class="suite-steps">
                @foreach (var st in sp.Steps)
                {
                    <li data-testid="dashboard-suite-step-@st.ModuleName.ToLowerInvariant()"><span class="@DotClass(StepStatus(st.State))"></span>@st.DisplayName: @StepText(st.State)</li>
                }
            </ul>
        </div>
        @if (suiteBusy)
        {
            var activeStep = sp.Steps.FirstOrDefault(st => st.State == StressSuiteStepState.Running);
            <TestRunningVisual Slug="@(activeStep?.ModuleName ?? "benchmark")" TestId="dashboard-suite-visual" />
        }
    </section>
}

@if (checking && totalChecks > 0)
{
    <div class="progress run-progress wf-overall-progress" data-testid="dashboard-checks-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@totalChecks" aria-valuenow="@completedChecks">
        <div class="progress-bar" style="width:@($"{checkFraction * 100:0.#}%")"></div>
    </div>
    <section class="card wf-section" data-testid="dashboard-checking-list" style="margin-bottom: 14px">
        <div class="card-head">
            <strong data-testid="dashboard-checking-headline">@(activeCheck is { } ac ? $"Running {ac.Title}: {ac.Message}" : "Checks in progress")</strong>
            <span class="meta" data-testid="dashboard-checking-count">@completedChecks of @totalChecks completed</span>
            @if (Screen.RunningGroup == CheckGroup.Checks)
            {
                <button class="btn-small btn-stop" data-testid="dashboard-checks-stop" @onclick="Screen.Stop">Stop</button>
            }
        </div>
        <div class="wf-check-rows">
            @foreach (var c in checkItems)
            {
                var dot = c.Status switch
                {
                    DiagnosticStatus.Ok => "ok",
                    DiagnosticStatus.Warning => "warning",
                    DiagnosticStatus.Error => "error",
                    DiagnosticStatus.Running => "running",
                    _ => "neutral",
                };
                var chipClass = c.Status switch
                {
                    DiagnosticStatus.Ok => "chip-ok",
                    DiagnosticStatus.Warning => "chip-warn",
                    DiagnosticStatus.Error => "chip-bad",
                    DiagnosticStatus.Running => "chip-run",
                    _ => "chip-na",
                };
                var chipLabel = c.Status switch
                {
                    DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error => "Done",
                    DiagnosticStatus.Running => "Running",
                    _ => "Waiting",
                };
                <div class="wf-check-row @(c.Status == DiagnosticStatus.Running ? "wf-check-active" : "")" data-testid="dashboard-check-row-@c.Id.ToLowerInvariant()">
                    <div class="wf-check-main">
                        <span class="dot dot-@dot"></span>
                        <strong class="wf-check-name">@c.Title</strong>
                        <span class="meta wf-check-msg" data-testid="dashboard-check-msg-@c.Id.ToLowerInvariant()">@c.Message</span>
                    </div>
                    <div class="wf-check-side">
                        @if (c.Status == DiagnosticStatus.Running && c.HasProgress)
                        {
                            <span class="meta wf-check-step" data-testid="dashboard-check-step-@c.Id.ToLowerInvariant()">@c.Step / @c.Total</span>
                        }
                        <span class="chip @chipClass">@chipLabel</span>
                    </div>
                    @if (c.Status == DiagnosticStatus.Running && c.HasProgress)
                    {
                        <div class="progress run-progress wf-check-bar" data-testid="dashboard-check-bar-@c.Id.ToLowerInvariant()" role="progressbar" aria-valuemin="0" aria-valuemax="@c.Total" aria-valuenow="@c.Step">
                            <div class="progress-bar" style="width:@($"{c.Fraction * 100:0.#}%")"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<div class="dash-grid">
    @for (var index = 0; index < cards.Count; index++)
    {
        var name = cards[index];
        @if (attentionCount > 0 && (index == 0 || index == attentionCount))
        {
            <h2 class="ct-section-label" style="grid-column: 1 / -1">@(index == 0 ? $"Needs attention · {attentionCount}" : "Other checks")</h2>
        }
        if (name == LibreHardwareMonitorModule.ModuleName)
        {
    <div @key="name" class="card dash-card gauge-card card-click" data-testid="dashboard-card-sensors" role="link" tabindex="0"
         @onclick='() => Open(LibreHardwareMonitorModule.ModuleName)' @onkeydown='e => Key(e, LibreHardwareMonitorModule.ModuleName)'>
        <div class="card-head"><span class="icon-badge"><Icon Name="temp" /></span><strong>Temperatures &amp; fans</strong>
            <StatusChip Status="@(cpuTemp is null && !thBusy ? DiagnosticStatus.NotRun : th.Status)" Text="@(cpuTemp is null && !thBusy ? "No reading" : null)" /></div>
        <div class="gauge gauge-@Level(cpuGroup)" data-testid="dashboard-cpu-gauge">
            <svg viewBox="0 0 120 120" role="img" aria-label="@(cpuTemp is { } a ? $"CPU temperature {a:0} degrees" : "No CPU temperature reading")">
                <circle class="gauge-track" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="75 100" transform="rotate(135 60 60)" />
                @if (cpuTemp is { } t)
                {
                    <circle class="gauge-fill" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="@($"{Math.Clamp(t, 0, 100) * 0.75:0.#} 100")" transform="rotate(135 60 60)" />
                }
                <text class="gauge-num" x="60" y="62" text-anchor="middle">@(cpuTemp is { } v ? $"{v:0}°C" : "—")</text>
                <text class="gauge-sub" x="60" y="80" text-anchor="middle">@(cpuTemp is null ? (thBusy ? "Checking…" : "No reading") : "CPU temp")</text>
            </svg>
        </div>
        <div class="desc" data-testid="dashboard-thermal">@if (thBusy) { <span>Checking temperatures…</span> } else { <CardList Text="@th.Message" /> }</div>
    </div>

        }
        else if (name == ModuleSlugs.Osquery)
        {
    <div @key="name" class="card dash-card card-click" data-testid="dashboard-card-osquery" role="link" tabindex="0"
         @onclick='() => Open(ModuleSlugs.Osquery)' @onkeydown='e => Key(e, ModuleSlugs.Osquery)'>
        <div class="card-head"><span class="icon-badge icon-@StatusChip.Kind(hw.Status)"><Icon Name="@Icon.ForModule(ModuleSlugs.Osquery)" /></span><strong>Hardware inventory</strong>
            <StatusChip Status="@(querying ? DiagnosticStatus.Running : hw.Status)" Text="@(querying ? "Checking…" : null)" /></div>
        <div data-testid="dashboard-status" class="@(hw.Status == DiagnosticStatus.Error ? "card-msg error-text" : "card-msg card-msg-full")">
            @if (querying) { <span>Querying hardware…</span> }
            else if (hw.Status == DiagnosticStatus.Error || inv is null) { <span>@hw.Message</span> }
            else { <CardList Text="@inv.FriendlySummary()" Strong="true" /> }
        </div>
        @if (!querying) { <div class="meta card-foot updated-ago" title="@hw.Timestamp.ToLocalTime().ToString("g")">Updated @RemotePCDiagnostics.Core.History.TimeText.Ago(hw.Timestamp, now)</div> }
    </div>

        }
        else
        {
        var m = Diagnostics.Modules.FirstOrDefault(module => module.Name == name);
        if (m is null) continue; // the module list changed since the card list was built
        var r = Store.Get(name);
        <div @key="name" class="card dash-card card-click" data-testid="dashboard-card-@m.Name.ToLowerInvariant()" role="link" tabindex="0"
             @onclick="() => Open(name)" @onkeydown="e => Key(e, name)">
            <div class="card-head"><span class="icon-badge icon-@StatusChip.Kind(r.Status)"><Icon Name="@Icon.ForModule(m.Name)" /></span><strong title="@m.DisplayName">@m.DisplayName</strong>
                <StatusChip Status="@r.Status" /></div>
            @if (r.Status is DiagnosticStatus.Running or DiagnosticStatus.NotRun)
            {
                <div class="card-msg card-msg-full"><span>@(r.Status == DiagnosticStatus.Running ? "Checking…" : "Not checked yet")</span></div>
            }
            else
            {
                <div class="card-msg card-msg-full"><CardList Text="@r.Message" Strong="true" /></div>
                <div class="meta card-foot updated-ago" title="@r.Timestamp.ToLocalTime().ToString("g")">Updated @RemotePCDiagnostics.Core.History.TimeText.Ago(r.Timestamp, now)</div>
            }
        </div>
        }
    }
</div>

@code {
    private Dictionary<string, int>? _cardRanks;
    private void Open(string module)
    {
        Screen.FocusModule(module);
        Nav.NavigateTo(Screen.PageFor(module)); // Checks, Stress tests or Security audit, whichever shows this module
    }
    private void Key(KeyboardEventArgs e, string module) { if (e.Key is "Enter" or " ") Open(module); }
    private void RunAll() => _ = Screen.RunAllChecksAsync();

    private StressSuiteProgress? suite;
    private bool suiteBusy => Diagnostics.IsStressSuiteRunning;
    private bool cancelling;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        suite = Diagnostics.LastStressSuiteProgress;
        Diagnostics.StressSuiteProgressChanged += OnSuite;
        Screen.Changed += OnScreenChanged;
        // Keep "Updated 3 min ago" current without any user action.
        _tick = new System.Threading.Timer(_ => { try { _ = InvokeAsync(StateHasChanged); } catch { } }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }
    private System.Threading.Timer? _tick;
    private void OnSuite(object? s, StressSuiteProgress p) { suite = p; if (p.Finished) cancelling = false; _ = InvokeAsync(StateHasChanged); }
    private void OnScreenChanged() { try { _ = InvokeAsync(StateHasChanged); } catch { } }
    public async ValueTask DisposeAsync()
    {
        Diagnostics.StressSuiteProgressChanged -= OnSuite;
        Screen.Changed -= OnScreenChanged;
        if (_tick is not null) await _tick.DisposeAsync();
        Dispose();
    }

    private async Task RunSuite(StressSuiteMode mode)
    {
        if (Diagnostics.IsStressSuiteRunning) return;
        Diagnostics.Log.Info($"Stress suite ({StressSuite.RunLabel(mode)}) requested from the Dashboard by the {(Session.Mode == RemotePCDiagnostics.Core.Session.SessionMode.Remote ? "remote user" : "local user")}");
        cancelling = false;
        try { await Diagnostics.RunStressSuiteAsync(mode, null); }
        catch (InvalidOperationException) { /* already running: the other click won */ }
        catch (Exception ex) { Diagnostics.Log.Warn($"Stress suite failed: {ex.Message}"); }
        StateHasChanged();
    }
    private void CancelSuite() { cancelling = true; Diagnostics.CancelStressSuite(); }

    private static DiagnosticStatus StepStatus(StressSuiteStepState s) => s switch
    {
        StressSuiteStepState.Running => DiagnosticStatus.Running,
        StressSuiteStepState.Passed => DiagnosticStatus.Ok,
        StressSuiteStepState.Problem => DiagnosticStatus.Warning,
        _ => DiagnosticStatus.NotRun,
    };
    private static string StepText(StressSuiteStepState s) => s switch
    {
        StressSuiteStepState.Pending => "Waiting",
        StressSuiteStepState.Running => "Running…",
        StressSuiteStepState.Passed => "Passed",
        StressSuiteStepState.Problem => "Needs a look",
        StressSuiteStepState.Skipped => "Skipped (not available on this PC)",
        _ => "Not run",
    };

    private static string Level(SensorGroup? g) => g is null || g.Readings.Count == 0 ? "na" : g.Level switch { SensorLevel.Critical => "err", SensorLevel.Warning => "warn", _ => "ok" };
}
