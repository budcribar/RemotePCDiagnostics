@page "/workflow"
@using RemotePCDiagnostics.Core.Workflow
@using RemotePCDiagnostics.Core.Benchmarks
@using RemotePCDiagnostics.Core.Optimizations
@implements IDisposable
@inject WorkflowService Flow
@inject BenchmarkService Bench
@inject DiagnosticsService Diagnostics
@inject AppServices App
@inject ISessionContext Session
@* Service workflow: the tech reviews once; the rest (restarts, benchmarks, fixes, report) runs by itself. *@
@{
    var s = Flow.State;
    var approved = s.Fixes.Count(f => s.IsApproved(f.Id));
    var checkCount = Diagnostics.Modules.Count(m => m.IncludeInRunAll); // the same checks as Checks & tests > Run all
    var status = Flow.Status ?? (s.Stage == WorkflowStage.Checking ? "Running checks…" : null);
}
<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="play" Size="20" /></span><h1 data-testid="wf-title">Service workflow</h1>
</div>
<p class="meta">Runs every check, lets you choose the fixes once, then does the rest by itself: restart → before benchmark → apply the fixes →
    restart → after benchmark → client report. Plan on 20–40 minutes, mostly waiting for restarts and updates.</p>

<ol class="wf-steps" data-testid="wf-steps">
    @foreach (var (label, stages) in Steps)
    {
        var state = StepState(s.Stage, stages);
        <li class="wf-step wf-@state">@label</li>
    }
</ol>

@if (status is { } st && s.Stage is not (WorkflowStage.Idle or WorkflowStage.Review)) { <p class="status-line" data-testid="wf-status"><span class="dot dot-@(s.IsRunning || Flow.Busy ? "running" : "ok")"></span>@st</p> }
@if (s.Error is { } err) { <p class="notice notice-error" data-testid="wf-error">@err</p> }
@if (_message is { } m) { <p class="notice" data-testid="wf-message">@m</p> }

@if (s.AutoLogonRestoreError is not null) { <p class="notice notice-error" data-testid="wf-autologon-left-on">Automatic sign-in could NOT be turned off: this PC may still sign in without a password. Turn it off by hand (netplwiz, or Sysinternals Autologon &gt; Disable).</p> }
@if (s.ResumeTaskRemoved == false) { <p class="notice notice-error" data-testid="wf-task-left">The scheduled task "@WorkflowService.ResumeTaskName" couldn't be removed. Delete it in Task Scheduler.</p> }

@switch (s.Stage)
{
    case WorkflowStage.Idle or WorkflowStage.Cancelled or WorkflowStage.Failed:
        @if (s.Stage != WorkflowStage.Idle && s.StartedUtc is not null)
        {
            @* What the stopped run already did to the PC: same report as the saved file. *@
            <p class="meta" data-testid="wf-report-path">@(s.ReportPath is { } sp ? $"Report saved on this PC: {sp}" : "The report couldn't be saved as a file; it's shown below.")</p>
            <iframe class="wf-report" data-testid="wf-report" sandbox="allow-same-origin" title="Client report" srcdoc="@ReportHtml(s)"></iframe>
        }
        <button class="btn btn-primary" data-testid="wf-start-checks" disabled="@Flow.Busy" @onclick="RunChecks"><Icon Name="play" Size="12" /> Start: run all checks</button>
        break;

    case WorkflowStage.Checking:
        @if (Flow.TotalChecksCount > 0)
        {
            <div class="progress run-progress wf-overall-progress" data-testid="wf-checks-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@Flow.TotalChecksCount" aria-valuenow="@Flow.CompletedChecksCount">
                <div class="progress-bar" style="width:@($"{Flow.CheckProgressFraction * 100:0.#}%")"></div>
            </div>
            <section class="card wf-section" data-testid="wf-checking-list">
                <div class="card-head">
                    <strong>Checks in progress</strong>
                    <span class="meta" data-testid="wf-checking-count">@Flow.CompletedChecksCount of @Flow.TotalChecksCount completed</span>
                </div>
                <div class="wf-check-rows">
                    @foreach (var c in Flow.CheckItems)
                    {
                        var dot = c.Status switch
                        {
                            DiagnosticStatus.Ok => "ok",
                            DiagnosticStatus.Warning => "warning",
                            DiagnosticStatus.Error => "error",
                            DiagnosticStatus.Running => "running",
                            _ => "neutral",
                        };
                        var chipClass = c.Status switch
                        {
                            DiagnosticStatus.Ok => "chip-ok",
                            DiagnosticStatus.Warning => "chip-warn",
                            DiagnosticStatus.Error => "chip-bad",
                            DiagnosticStatus.Running => "chip-run",
                            _ => "chip-na",
                        };
                        var chipLabel = c.Status switch
                        {
                            DiagnosticStatus.Ok or DiagnosticStatus.Warning or DiagnosticStatus.Error => "Done",
                            DiagnosticStatus.Running => "Running",
                            _ => "Waiting",
                        };
                        <div class="wf-check-row @(c.Status == DiagnosticStatus.Running ? "wf-check-active" : "")" data-testid="wf-check-row-@c.Id.ToLowerInvariant()">
                            <div class="wf-check-main">
                                <span class="dot dot-@dot"></span>
                                <strong class="wf-check-name">@c.Title</strong>
                                <span class="meta wf-check-msg" data-testid="wf-check-msg-@c.Id.ToLowerInvariant()">@c.Message</span>
                            </div>
                            <div class="wf-check-side">
                                @if (c.Status == DiagnosticStatus.Running && c.HasProgress)
                                {
                                    <span class="meta wf-check-step" data-testid="wf-check-step-@c.Id.ToLowerInvariant()">@c.Step / @c.Total</span>
                                }
                                <span class="chip @chipClass">@chipLabel</span>
                            </div>
                            @if (c.Status == DiagnosticStatus.Running && c.HasProgress)
                            {
                                <div class="progress run-progress wf-check-bar" data-testid="wf-check-bar-@c.Id.ToLowerInvariant()" role="progressbar" aria-valuemin="0" aria-valuemax="@c.Total" aria-valuenow="@c.Step">
                                    <div class="progress-bar" style="width:@($"{c.Fraction * 100:0.#}%")"></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }
        break;

    case WorkflowStage.Review:
        <p class="meta" data-testid="wf-snapshot">Saved scan snapshot: @(s.ReviewedUtc is { } reviewed ? reviewed.ToLocalTime().ToString("f") : "scan time unavailable for this saved review"). Memory and space figures are estimates from that scan. To refresh, cancel this review and run the checks again.</p>
        <section class="card wf-section" data-testid="wf-findings"><div class="card-head"><strong>What the checks found</strong>
                <span class="meta" data-testid="wf-check-count">Ran @checkCount checks · @(s.Findings.Count == 0 ? "nothing wrong found" : $"{s.Findings.Count} found something")</span></div>
            @if (s.Findings.Count > 0) { <ul>@foreach (var f in s.Findings) { <li>@f</li> }</ul> }
        </section>
        <section class="card wf-section" data-testid="wf-fixes">
            <div class="card-head"><strong>Fixes to apply (@approved of @s.Fixes.Count ticked)</strong>
                <span class="svc-actions"><button class="btn-small" data-testid="wf-expand-all" @onclick="() => ToggleAllAreas(s)">@(AllOpen(s) ? "Collapse all" : "Expand all")</button><button class="btn-small" data-testid="wf-select-recommended" @onclick="Flow.SetRecommendedApproved">Select recommended</button><button class="btn-small" @onclick="() => Flow.SetAllApproved(true)">Select all</button><button class="btn-small" @onclick="() => Flow.SetAllApproved(false)">Select none</button></span></div>
            @if (s.Fixes.Count == 0) { <p class="meta">The checks didn't find anything to fix automatically.</p> }
            else { <p class="meta" data-testid="wf-fixes-note">Suggested by the @checkCount checks plus the memory, storage and app scans. One check can suggest several fixes (each startup app, service or cache is its own line).</p> }
            @foreach (var g in s.Fixes.GroupBy(f => f.GroupKey))
            {
                var area = g.Key;                 // stable key (remembered open areas)
                var areaName = g.First().Area;    // what's shown
                var open = _openAreas.Contains(area);
                <h3 class="wf-area"><button type="button" class="wf-area-toggle" data-testid="wf-area-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleArea(area)">
                    <span class="wf-caret" aria-hidden="true">@(open ? "▾" : "▸")</span> @areaName <span class="meta">(@g.Count(f => s.IsApproved(f.Id)) of @g.Count() ticked)</span></button></h3>
                @if (!open) { continue; }
                @foreach (var f in g)
                {
                    var id = f.Id;
                    <label class="wf-fix" data-testid="wf-fix">
                        <input type="checkbox" checked="@s.IsApproved(id)" @onchange="e => Flow.SetApproved(id, e.Value is true)" />
                        <span><strong>@f.Title</strong>@if (f.Risk != SuggestionRisk.Low) { <span class="chip chip-warn">@f.Risk risk</span> }@if (f.Slow) { <span class="chip chip-na">can take a while</span> }@if (!f.DefaultOn) { <span class="chip chip-na" data-testid="wf-fix-optin" title="Not ticked by default: tick it only if it's worth it for this client.">opt-in</span> }@if ((f.UndoChip ?? RemotePCDiagnostics.Core.Changes.Undoability.Chip(f.Undo)) is { } undoChip) { <span class="chip @(f.Undo == RemotePCDiagnostics.Core.Changes.UndoSupport.None && f.UndoChip is null ? "chip-warn" : "chip-na")" data-testid="wf-fix-undo">@undoChip</span> }
                            <span class="meta wf-why">@f.Why</span></span>
                    </label>
                }
            }
            <p class="meta">@FixCatalog.NotNeededNote</p>
        </section>
        @if (s.Recommendations.Count > 0)
        {
            <section class="card wf-section"><div class="card-head"><strong>For the client to do (goes in the report)</strong></div>
                <ul>@foreach (var r in s.Recommendations) { <li>@r</li> }</ul></section>
        }
        <section class="card wf-section" data-testid="wf-signin">
            <div class="card-head"><strong>Signing in after each restart</strong></div>
            @if (_logon is { AlreadyAutomatic: true }) { <p>This PC already signs in by itself, so nothing is needed.</p> }
            else
            {
                @if (_logon is { BlockedByWindowsHello: true, Note: { } note }) { <p class="notice" data-testid="wf-hello-note">@note</p> }
                <p class="meta">The workflow restarts the PC twice. To carry on without anyone at the PC, Windows can sign in automatically for exactly those two restarts.
                    The password is checked first, stored only the way Windows' own automatic sign-in stores it, and removed when the workflow ends or is cancelled.</p>
                <label class="wf-field">Account <input data-testid="wf-user" @bind="_user" placeholder="user name" /></label>
                <label class="wf-field">Password <input type="@(_showPassword ? "text" : "password")" data-testid="wf-password" @ref="_passwordBox" @bind="_password" autocomplete="off" />
                    <button type="button" class="btn-small" data-testid="wf-password-toggle" aria-label="@(_showPassword ? "Hide password" : "Show password")" title="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@(_showPassword ? "true" : "false")" @onclick="() => _showPassword = !_showPassword"><Icon Name="@(_showPassword ? "eye-off" : "eye")" Size="12" /></button></label>
                <p class="meta">@(_logon?.MicrosoftAccountEmail is not null ? "This PC signs in with a Microsoft account, so the box shows its email address. " : "Microsoft account? Use the account's email address. ")The password must be the account's password, not the PIN.</p>
                <label><input type="checkbox" @bind="_clientSignsIn" /> Skip: the client will sign in after each restart</label>
            }
        </section>
        @if (_startError is { } se) { <p class="notice notice-error" role="alert" data-testid="wf-signin-error">@se</p> }
        <div class="toolbar">
            <button class="btn btn-primary" data-testid="wf-go" disabled="@(_starting || !CanStart)" @onclick="Start"><Icon Name="play" Size="12" /> @(_starting ? "Starting…" : $"Start: restart, benchmark, apply {approved} fix{(approved == 1 ? "" : "es")}, report")</button>
            <button class="btn-small" @onclick="StartOver">Start over</button>
        </div>
        break;

    case WorkflowStage.Done:
        @if (Bench.Before is not null && Bench.After is not null) { <section class="banner banner-ok"><div class="banner-text"><div class="banner-title">@Bench.Comparison.OverallText</div></div></section> }
        @* The next action and the run's date come before the tall report frame, so they're visible without scrolling. *@
        <div class="toolbar wf-done-actions">
            @if (s.FinishedUtc is { } fin) { <span class="meta" data-testid="wf-finished">Workflow finished @fin.ToLocalTime().ToString("g")</span> }
            <div class="banner-actions">
                @if (CanPublishHostedReport)
                {
                    <button type="button"
                            class="btn btn-primary"
                            data-testid="publish-hosted-report"
                            disabled="@_publishingReport"
                            @onclick="() => PublishHostedReportAsync(s)">
                        <Icon Name="cert" Size="12" />
                        @(_publishingReport ? "Publishing…" : "Publish Hosted Service Report")
                    </button>
                }
                <a class="btn btn-outline" href="certificates" data-testid="wf-branding-link"><Icon Name="cert" Size="12" /> QA &amp; branding</a>
                <button class="btn btn-outline" data-testid="wf-new" @onclick="ResetWorkflow">New workflow</button>
            </div>
        </div>
        @if (_publishReportError is not null)
        {
            <p class="notice notice-error" role="alert" data-testid="publish-report-error">@_publishReportError</p>
        }
        @if (_publishedReportUrl is not null)
        {
            <div class="svc-result-ok relay-published-banner">
                <div>
                    <strong>Hosted service report live:</strong>
                    <a href="@_publishedReportUrl" target="_blank" rel="noopener noreferrer" data-testid="published-report-url">@_publishedReportUrl</a>
                    @if (!string.IsNullOrWhiteSpace(_publishedReportShortHash))
                    {
                        <span class="chip chip-ok" style="margin-left: 8px">SHA-256 @_publishedReportShortHash</span>
                    }
                </div>
            </div>
        }
        <p class="meta" data-testid="wf-report-path">@(s.ReportPath is { } p ? $"Report saved on this PC: {p}" : "The report couldn't be saved as a file; it's shown below.")</p>
        <iframe class="wf-report" data-testid="wf-report" sandbox="allow-same-origin" title="Client report" srcdoc="@ReportHtml(s)"></iframe>
        break;

    default:
        <div class="toolbar">
            @if (Flow.WaitingForRestart) { <button class="btn btn-outline" data-testid="wf-restart-now" @onclick="RestartNow">Restart now</button> }
            <button class="btn btn-stop" data-testid="wf-cancel" @onclick="Cancel">Cancel workflow</button>
        </div>
        @if (s.Stage is WorkflowStage.BeforeBenchmark or WorkflowStage.AfterBenchmark)
        {
            @if (Flow.SettleFraction is { } sf && Flow.SettleRemaining is { } rem && Flow.SettleTotal is { } total)
            {
                <div class="progress run-progress wf-overall-progress" data-testid="wf-settle-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@((int)Math.Ceiling(total.TotalSeconds))" aria-valuenow="@((int)Math.Round(total.TotalSeconds - rem.TotalSeconds))">
                    <div class="progress-bar" style="width:@($"{sf * 100:0.#}%")"></div>
                </div>
                <div class="cards">
                    <div class="card is-running card-with-visual" data-testid="wf-bench-live">
                        <div class="card-main">
                            <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                            <div class="headline">@(s.Stage == WorkflowStage.BeforeBenchmark ? "Before benchmark" : "After benchmark")</div>
                            <p class="meta" data-testid="wf-settle-countdown">@BenchmarkService.FormatCountdown(rem) remaining before the @(s.Stage == WorkflowStage.BeforeBenchmark ? "before" : "after") benchmark starts</p>
                        </div>
                        <TestRunningVisual Slug="benchmark" TestId="wf-bench-visual" />
                    </div>
                </div>
            }
            else if (Bench.Running is not null)
            {
                <div class="run-progress run-progress-indeterminate wf-overall-progress" data-testid="wf-bench-progress" aria-hidden="true"><div></div></div>
                <div class="cards">
                    <div class="card is-running card-with-visual" data-testid="wf-bench-live">
                        <div class="card-main">
                            <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                            <div class="headline">@(s.Stage == WorkflowStage.BeforeBenchmark ? "Before benchmark" : "After benchmark")</div>
                            @if (!string.IsNullOrEmpty(Bench.Progress)) { <p class="meta" data-testid="wf-bench-step">@Bench.Progress</p> }
                        </div>
                        <TestRunningVisual Slug="benchmark" TestId="wf-bench-visual" />
                    </div>
                </div>
            }
        }
        @if (s.Stage == WorkflowStage.Applying && approved > 0)
        {
            <div class="progress run-progress wf-overall-progress" data-testid="wf-apply-progress"><div class="progress-bar" style="width:@($"{Math.Clamp((s.Outcomes.Count + (Flow.RepairFraction ?? 0)) / approved * 100, 0, 100):0.#}%")"></div></div>
            @if (Flow.RepairFraction is { } rf)
            {
                <div class="progress run-progress wf-check-bar" data-testid="wf-repair-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@($"{rf * 100:0}")"><div class="progress-bar" style="width:@($"{rf * 100:0.#}%")"></div></div>
            }
            else if (Flow.Busy && Flow.Status is { } rs && rs.Contains("Repair", StringComparison.OrdinalIgnoreCase))
            {
                <div class="run-progress run-progress-indeterminate wf-check-bar" data-testid="wf-repair-progress" aria-hidden="true"><div></div></div>
            }
            <div class="cards">
                <div class="card is-running card-with-visual" data-testid="wf-apply-live">
                    <div class="card-main">
                        <div class="card-head"><span class="dot dot-running"></span><strong>Progress</strong></div>
                        <div class="headline">Applying fixes (@s.Outcomes.Count of @approved completed)</div>
                        @if (Flow.Status is { } fs) { <div class="meta">@fs</div> }
                    </div>
                    <TestRunningVisual Slug="dism-scan" TestId="wf-apply-visual" />
                </div>
            </div>
        }
        @if (s.Outcomes.Count > 0)
        {
            <table class="detail grid"><tr><th scope="col">Fix</th><th scope="col">Result</th></tr>
                @foreach (var o in s.Outcomes) { <tr><td>@o.Title</td><td><span class="dot dot-@(o.Success ? "ok" : o.Skipped ? "neutral" : "warning")"></span>@o.Message</td></tr> }
            </table>
        }
        break;
}

@if (s.Log.Count > 0)
{
    <details class="wf-log"><summary class="meta">Workflow log</summary><ul>@foreach (var l in s.Log.Reverse()) { <li class="meta">@l</li> }</ul></details>
}

@code {
    // Fix areas start collapsed: the review shows each area's ticked count; open only the ones worth checking.
    // The areas the remote user left open are remembered on this PC.
    private readonly HashSet<string> _openAreas = new(StringComparer.Ordinal);
    private RemotePCDiagnostics.Core.Preferences.PreferencesService? Prefs =>
        App.Preferences;
    private void SaveOpenAreas() { var open = _openAreas.ToList(); Prefs?.Update(p => p with { WorkflowOpenAreas = open }); }
    private void ToggleArea(string area) { if (!_openAreas.Remove(area)) _openAreas.Add(area); SaveOpenAreas(); }
    private bool AllOpen(WorkflowState s) => s.Fixes.Select(f => f.GroupKey).Distinct().All(_openAreas.Contains);
    private void ToggleAllAreas(WorkflowState s)
    {
        if (AllOpen(s)) _openAreas.Clear();
        else foreach (var a in s.Fixes.Select(f => f.GroupKey).Distinct()) _openAreas.Add(a);
        SaveOpenAreas();
    }

    private static readonly (string Label, WorkflowStage[] Stages)[] Steps =
    [
        ("Checks", [WorkflowStage.Checking]), ("Review", [WorkflowStage.Review]), ("Restart", [WorkflowStage.RestartBefore]),
        ("Before benchmark", [WorkflowStage.BeforeBenchmark]), ("Apply fixes", [WorkflowStage.Applying]), ("Restart", [WorkflowStage.RestartAfter]),
        ("After benchmark", [WorkflowStage.AfterBenchmark]), ("Report", [WorkflowStage.Reporting, WorkflowStage.Done]),
    ];

    private static string StepState(WorkflowStage current, WorkflowStage[] stages)
    {
        if (current is WorkflowStage.Idle or WorkflowStage.Cancelled or WorkflowStage.Failed) return "todo";
        var order = Steps.Select(x => x.Stages).ToList();
        int Index(WorkflowStage st) => order.FindIndex(a => a.Contains(st));
        var mine = Index(stages[0]); var cur = Index(current);
        return current == WorkflowStage.Done || mine < cur ? "done" : mine == cur ? "now" : "todo";
    }

    /// <summary>The report exactly as it was saved (so page and file agree); rebuilt only for runs saved by an older version.</summary>
    private string ReportHtml(WorkflowState s) =>
        s.ReportHtml ?? ClientReport.Build(s, Bench.Before, Bench.After, Bench.Comparison, s.FinishedUtc?.ToLocalTime() ?? DateTimeOffset.Now, s.Branding ?? Prefs?.Current.Branding);

    private readonly ShopRelayClient _fallbackRelay = new();
    private ShopRelayClient ActiveRelay => App.ShopRelay ?? _fallbackRelay;

    private string? ConfiguredRelayServerUrl =>
        !string.IsNullOrWhiteSpace(Prefs?.Current.RelayServerUrl)
            ? Prefs!.Current.RelayServerUrl
            : Session.ServerUri?.ToString();

    private bool CanPublishHostedReport =>
        Prefs?.Current.ShopApiKey is { Length: > 0 } key
        && key.Trim().StartsWith(ShopRelayClient.ApiKeyPrefix, StringComparison.Ordinal)
        && ShopRelayClient.TryParseRelayUri(ConfiguredRelayServerUrl, out _);

    private bool _publishingReport;
    private string? _publishedReportUrl;
    private string? _publishedReportShortHash;
    private string? _publishReportError;

    private AutoLogonStatus? _logon;
    private string _user = "", _password = "";
    private bool _clientSignsIn, _starting, _showPassword;
    private string? _message, _startError;
    private ElementReference _passwordBox;

    private bool CanStart => _logon is { AlreadyAutomatic: true } || _clientSignsIn || (_user.Length > 0 && _password.Length > 0);

    protected override void OnInitialized()
    {
        Flow.Changed += OnChanged;
        Bench.Changed += OnChanged;
        if (Prefs is not null) Prefs.Changed += OnChanged;
        LoadLogon();
        foreach (var a in Prefs?.Current.WorkflowOpenAreas ?? []) _openAreas.Add(a);
        if (Flow.State.Stage == WorkflowStage.Idle && !Flow.Busy && Flow.HasCompletedCheckModuleResults)
            _ = Flow.RunChecksAsync();
    }

    private void LoadLogon()
    {
        try { _logon = Flow.AutoLogonStatus(); _user = _logon.PrefillUser; } catch { _logon = null; }
    }

    private void OnChanged() { try { _ = InvokeAsync(StateHasChanged); } catch { } }
    public void Dispose()
    {
        Flow.Changed -= OnChanged;
        Bench.Changed -= OnChanged;
        if (Prefs is not null) Prefs.Changed -= OnChanged;
        _password = "";
        _showPassword = false;
    }

    private void ResetWorkflow()
    {
        _publishedReportUrl = null;
        _publishedReportShortHash = null;
        _publishReportError = null;
        Flow.Reset();
    }

    private async Task PublishHostedReportAsync(WorkflowState s)
    {
        _publishReportError = null;
        _publishedReportUrl = null;
        _publishedReportShortHash = null;

        var apiKey = Prefs?.Current.ShopApiKey?.Trim() ?? "";
        if (!ShopRelayClient.TryParseRelayUri(ConfiguredRelayServerUrl, out var relayUri) || relayUri is null)
        {
            _publishReportError = "Configure a valid Relay Server URL on the QA & branding page first.";
            return;
        }

        var html = ReportHtml(s);
        var uploadReq = ShopRelayClient.CreateServiceReportRequest(Session.MachineName, html, s.FinishedUtc ?? DateTimeOffset.UtcNow);

        _publishingReport = true;
        try
        {
            var result = await ActiveRelay.PublishReportAsync(relayUri, apiKey, uploadReq);
            switch (result)
            {
                case ShopReportPublishResult.Published pub:
                    _publishedReportUrl = pub.Url;
                    _publishedReportShortHash = pub.ShortHash;
                    break;

                case ShopReportPublishResult.Unauthorized:
                    _publishReportError = "Shop API key was rejected (401 Unauthorized). Check your rpd_live_... key on QA & branding.";
                    break;

                case ShopReportPublishResult.PaymentRequired:
                    _publishReportError = "Shop subscription or trial is inactive (402 Payment Required). Renew billing on the relay /shop portal.";
                    break;

                case ShopReportPublishResult.InvalidRequest inv:
                    _publishReportError = $"Relay rejected service report upload: {inv.Error}";
                    break;

                case ShopReportPublishResult.NetworkError net:
                    _publishReportError = $"Could not upload service report to relay: {net.Message}";
                    break;
            }
        }
        finally
        {
            _publishingReport = false;
        }
    }

    private void RunChecks() { _message = null; _ = Flow.RunChecksAsync(forceRerun: _forceRerunNext); _forceRerunNext = false; }
    private bool _forceRerunNext;
    private void StartOver() { _forceRerunNext = true; Flow.Reset(); }

    private async Task Start()
    {
        _starting = true; _message = null; _startError = null;
        try
        {
            AutoLogonRequest? req = null;
            if (_logon is { CanUse: true } && !_clientSignsIn)
            {
                // "user@outlook.com" = Microsoft account; otherwise a local or domain account on this PC's domain.
                var user = _user.Trim();
                var domain = user.Contains('@') ? "MicrosoftAccount" : user.Contains('\\') ? user[..user.IndexOf('\\')] : _logon.Domain;
                if (user.Contains('\\')) user = user[(user.IndexOf('\\') + 1)..];
                req = new AutoLogonRequest(user, domain, _password);
            }
            // A failed start is shown next to the Start button (not at the top of the page), and focus goes back to the password box.
            _startError = await Flow.StartAsync(req);
        }
        finally { _password = ""; _showPassword = false; _starting = false; }
        if (_startError is not null)
        {
            StateHasChanged();
            await Task.Yield();
            try { await _passwordBox.FocusAsync(preventScroll: false); } catch { }
        }
    }

    private async Task RestartNow() => _message = await Flow.RestartNowAsync();
    private async Task Cancel() => await Flow.CancelAsync();
}
