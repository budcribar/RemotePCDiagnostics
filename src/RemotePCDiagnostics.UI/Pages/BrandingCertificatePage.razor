@page "/certificates"
@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Workflow
@inherits StoreAwareComponent
@inject AppServices App
@inject ISessionContext Session
@inject IJSRuntime JS
@{
    var snap = EnsureCertificateSnapshot();
    var certHtml = _cachedCertHtml;
    var verdictChip = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "ok",
        HardwareQaVerdict.PassedWithNotes => "warn",
        HardwareQaVerdict.AttentionRequired => "err",
        _ => "na",
    };
    var verdictLabel = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "Certified pass",
        HardwareQaVerdict.PassedWithNotes => "Passed with notes",
        HardwareQaVerdict.AttentionRequired => "Attention required",
        _ => "Bench intake snapshot",
    };
    var benchRunning = ActiveBenchQa.IsRunning;
    var benchBusyElsewhere = !benchRunning && Diagnostics.IsAnyStressRunning;
    // Waiting on the person (keyboard, display): every automated check is done, so what failed can be fixed and re-checked now.
    var waitingFor = benchRunning ? ActiveBenchQa.WaitingFor : null;
    var automatedRunning = benchRunning && waitingFor is null;
    var canRecheck = !automatedRunning && !benchBusyElsewhere && !ActiveBenchQa.IsRecheckRunning;
}

<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="cert" Size="20" /></span>
    <h1 data-rpcd-page="certificates" data-rpcd-contract="@BrowserContract.Certificates" data-testid="branding-title">QA Certificate</h1>
</div>
<p class="meta">Run a hardware QA check and save or publish a 1-page QR certificate for this PC.</p>

<section class="card wf-section bench-qa-banner" data-testid="bench-qa-banner" style="margin-bottom: 16px">
    <div>
        <strong>Hardware QA Check</strong>
        <span class="meta"> · SMBIOS, SMART, battery, WHEA, DISM/SFC, optional stress &amp; I/O checks</span>
    </div>
    <div class="bench-qa-options">
        <div class="bench-qa-select-all">
            <label class="bench-kind">
                <input type="checkbox" data-testid="bench-qa-select-all" checked="@AllQaOptionsSelected" @onchange="ToggleAllQaOptions" disabled="@benchRunning" />
                <span>Select all / none</span>
            </label>
            <span class="meta">@_selectedItems.Count of @HardwareQaCertificate.AllSelectableItemIds.Count selected</span>
        </div>
        <div class="bench-qa-tree" data-testid="bench-qa-tree">
            @foreach (var group in HardwareQaCertificate.Groups)
            {
                var g = group;
                var isExpanded = _expandedGroups.Contains(g.Id);
                var selectedCount = g.Items.Count(i => _selectedItems.Contains(i.Id));
                var allInGroup = selectedCount == g.Items.Count;
                var partialInGroup = selectedCount > 0 && !allInGroup;
                <div @key="g.Id" class="bench-qa-group @(isExpanded ? "is-open" : "")" data-testid="bench-qa-node-@g.Id">
                    <div class="bench-qa-group-head">
                        <button type="button"
                                class="bench-qa-toggle"
                                aria-expanded="@(isExpanded ? "true" : "false")"
                                aria-label="@(isExpanded ? $"Collapse {g.Label}" : $"Expand {g.Label}")"
                                data-testid="bench-qa-toggle-@g.Id"
                                @onclick="() => ToggleGroupExpanded(g.Id)">
                            @(isExpanded ? "▾" : "▸")
                        </button>
                        <label class="bench-kind bench-qa-group-label">
                            <input type="checkbox"
                                   data-testid="bench-qa-group-@g.Id"
                                   data-partial="@(partialInGroup ? "true" : "false")"
                                   checked="@allInGroup"
                                   @onchange="e => ToggleGroupSelection(g, e.Value is true)"
                                   disabled="@benchRunning" />
                            <span>@g.Label</span>
                        </label>
                        <span class="bench-qa-count @(partialInGroup ? "is-partial" : selectedCount > 0 ? "is-full" : "")">@selectedCount/@g.Items.Count</span>
                    </div>
                    @if (isExpanded)
                    {
                        <div class="bench-qa-children">
                            @foreach (var item in g.Items)
                            {
                                var it = item;
                                <label @key="it.Id" class="bench-kind meta bench-qa-child">
                                    <input type="checkbox"
                                           data-testid="bench-qa-include-@it.Id"
                                           checked="@_selectedItems.Contains(it.Id)"
                                           @onchange="e => ToggleItemSelection(it.Id, e.Value is true)"
                                           disabled="@benchRunning" />
                                    <span>@it.Label</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="banner-actions">
        <button type="button"
                class="btn btn-primary"
                data-testid="bench-qa-start"
                disabled="@(benchRunning || benchBusyElsewhere || _selectedItems.Count == 0)"
                @onclick="StartBenchQa">
            <Icon Name="@(benchRunning ? "refresh" : "play")" Size="14" />
            @(benchRunning ? RunningLabel : "Start QA check")
        </button>
        @if (benchRunning)
        {
            <button type="button" class="btn btn-outline" data-testid="bench-qa-stop" @onclick="StopBenchQa">Stop</button>
        }
    </div>
    @if (benchRunning && (ActiveBenchQa.RunItemIds.Count > 0 || ActiveBenchQa.TotalSteps > 0))
    {
        var (progressDone, progressTotal) = ProgressCounts;
        <div class="progress wf-overall-progress" style="max-width:none;margin:10px 0 6px" data-testid="bench-qa-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@progressTotal" aria-valuenow="@progressDone">
            <div style="width:@($"{(progressTotal == 0 ? 0 : 100.0 * progressDone / progressTotal):0.#}%")"></div>
        </div>
    }
    @if (ActiveBenchQa.SkippedItemIds.Count > 0)
    {
        <p class="meta" style="margin:4px 0 0" data-testid="bench-qa-skipped">
            @ActiveBenchQa.SkippedItemIds.Count of @ActiveBenchQa.SelectedItemIds.Count selected can't run on this PC and @(benchRunning ? "will be" : "were") skipped: @string.Join(", ", ActiveBenchQa.SkippedItemIds.Select(ItemLabel)).
        </p>
    }
    @if (benchRunning && !string.IsNullOrWhiteSpace(ActiveBenchQa.Status))
    {
        <p class="meta" style="margin:4px 0 0;color:var(--text, #cbd5e1)" data-testid="bench-qa-status">@ActiveBenchQa.Status</p>
    }
</section>

@if (waitingFor is { Length: > 0 })
{
    @* The run waits on this check, not the page: leaving the page and coming back shows it again, and the run carries on. *@
    <PhysicalBenchQaCard Service="ActivePhysicalQa" FilterSection="@waitingFor" RemoteSessionActive="@(Session.Mode == SessionMode.Remote || _isRemoteDisplay)" />
}

@{
    // What failed or has a note on the certificate, with a fix where the app has one and Re-run for the checks behind it.
    var problems = snap.Items.Where(i => !i.Cancelled && i.Status is DiagnosticStatus.Error or DiagnosticStatus.Warning).ToList();
    var rerunnable = BenchQaRunner.RerunnableProblems(snap);
}
@if (App.Remediation is { } qaFixes)
{
    <RemediationActions @ref="_qaFixUi" Actions="qaFixes" ShowRecent="false" Origin="@ModuleSlugs.SecurityAudit" OnCompleted="() => RerunItems([SecurityItemId])" />
}
@if (problems.Count > 0 && !automatedRunning)
{
    <section class="card wf-section qa-attention" data-testid="qa-attention" data-count="@problems.Count">
        <div class="qa-attention-top">
            <strong>@(problems.Count == 1 ? "1 item needs attention" : $"{problems.Count} items need attention")</strong>
            <button type="button" class="btn btn-outline" data-testid="qa-rerun-failed" disabled="@(!canRecheck || rerunnable.Count == 0)"
                    @onclick="() => RerunItems(rerunnable.Select(i => i.Id))">
                <Icon Name="refresh" Size="14" /> Re-run @(rerunnable.Count == 1 ? "it" : $"failed ({rerunnable.Count})")
            </button>
        </div>
        <ul class="qa-attention-list">
            @foreach (var problem in problems)
            {
                var item = problem;
                var fail = item.Status == DiagnosticStatus.Error;
                <li data-testid="qa-attention-@item.Id" data-status="@(fail ? "fail" : "note")">
                    <div class="qa-attention-head">
                        <span class="chip chip-@(fail ? "err" : "warn")">@(fail ? "FAIL" : "NOTE")</span>
                        <strong>@item.Label</strong>
                        <span class="meta">@item.Summary</span>
                        <span class="qa-attention-actions">
                            @if (PageFor(item.Id) is { } path)
                            {
                                <a class="btn-small" data-testid="qa-open-@item.Id" href="@path">Open</a>
                            }
                            @if (BenchQaRunner.CanRerun(item.Id))
                            {
                                <button type="button" class="btn-small" data-testid="qa-rerun-@item.Id" disabled="@(!canRecheck)"
                                        @onclick="() => RerunItems([item.Id])">Re-run</button>
                            }
                        </span>
                    </div>
                    @if (item.Id == SecurityItemId && Store.Get(ModuleSlugs.SecurityAudit).Payload is RemotePCDiagnostics.Core.Security.SecurityAuditReport audit)
                    {
                        <ul class="qa-attention-findings" data-testid="qa-security-findings">
                            @foreach (var f in audit.NeedsAttention)
                            {
                                var finding = f;
                                var fix = RemotePCDiagnostics.Core.Security.SecurityAuditFixes.For(finding) is { } a && RemotePCDiagnostics.Core.Areas.FixAccess.CanOffer(a, App.AgentFixes) && App.Remediation is not null ? a : null;
                                <li data-testid="qa-security-finding-@finding.Id">
                                    <span>@finding.Name</span>
                                    <span class="meta"> · now @Blank(finding.CurrentValue), recommended @Blank(finding.RecommendedValue)</span>
                                    @if (fix is not null)
                                    {
                                        <button type="button" class="btn-small" data-testid="qa-security-fix-@finding.Id" data-action="remediate" data-action-kind="@fix.Kind" data-action-target="@fix.Target"
                                                disabled="@(automatedRunning || App.Remediation?.Running is not null)" @onclick="() => _qaFixUi?.Ask(fix)">@fix.ButtonText</button>
                                    }
                                    else
                                    {
                                        <span class="meta" data-testid="qa-security-nofix-@finding.Id"> · no automatic fix: change it in Windows, then Re-run</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </section>
}

<section class="card wf-section @(automatedRunning ? "qa-cert-updating" : "")" data-testid="qa-cert-card" data-running="@(benchRunning ? "true" : "false")">
    <div class="toolbar" style="margin-bottom: 8px">
        <div>
            <strong data-testid="qa-live-id">@snap.CertificateId</strong>
            <span> · </span>
            @if (automatedRunning)
            {
                @* The preview holds still while the checks run (it showed the store's results changing one by one); it updates when they finish. *@
                <span class="chip chip-na" data-testid="qa-live-verdict">QA running</span>
                <span class="meta" data-testid="qa-live-note"> · this is the last certificate; it updates when the automated checks finish</span>
            }
            else if (waitingFor is not null)
            {
                <span class="chip chip-na" data-testid="qa-live-verdict">Waiting on the @waitingFor check</span>
                <span class="meta" data-testid="qa-live-note"> · automated checks done; finish the @waitingFor check to complete the certificate</span>
            }
            else
            {
                <span class="chip chip-@verdictChip" data-testid="qa-live-verdict">@verdictLabel</span>
                <span class="meta"> · @snap.TestedCount of @snap.Items.Count subsystems checked</span>
            }
        </div>
        <div class="banner-actions">
            @if (_isRemoteDisplay)
            {
                <button type="button"
                        class="btn btn-primary"
                        data-testid="publish-hosted-cert"
                        disabled="@(_publishingCert || benchRunning)"
                        @onclick="PublishToAdminAsync">
                    <Icon Name="cert" Size="14" />
                    @(_publishingCert ? "Publishing…" : "Publish to Admin")
                </button>
            }
            @if (App.Workflow is not null)
            {
                <button type="button"
                        class="btn @(_isRemoteDisplay ? "btn-outline" : "btn-primary")"
                        data-testid="qa-save-html"
                        disabled="@benchRunning"
                        @onclick="SaveCertificate">
                    <Icon Name="cert" Size="14" /> @(_isRemoteDisplay ? "Download HTML" : "Save HTML")
                </button>
            }
        </div>
    </div>
    @if (_publishError is not null)
    {
        <p class="notice notice-error" role="alert" data-testid="publish-cert-error">@_publishError</p>
    }
    @if (_publishedCertUrl is not null)
    {
        <div class="svc-result-ok relay-published-banner" style="margin-bottom: 10px">
            <div>
                <strong>Published on Admin:</strong>
                <a href="@_publishedCertUrl" target="_blank" rel="noopener noreferrer" data-testid="published-cert-url">@_publishedCertUrl</a>
                @if (!string.IsNullOrWhiteSpace(_publishedCertShortHash))
                {
                    <span class="chip chip-ok" style="margin-left: 8px">SHA-256 @_publishedCertShortHash</span>
                }
            </div>
        </div>
    }
    @if ((_savedCertPath ?? ActiveBenchQa.LastSavedCertificatePath) is { } shownCertPath)
    {
        <p class="meta" data-testid="qa-saved-path">Saved: @shownCertPath (upload on your Admin portal to brand &amp; host, or press Ctrl+P in a browser to print).</p>
    }
    else if (_saveError is not null)
    {
        <p class="notice notice-error" role="alert">@_saveError</p>
    }
    <details class="qa-preview" data-testid="qa-preview" open="@_previewOpen">
        <summary class="bench-customize-summary qa-preview-summary" data-testid="qa-preview-toggle" aria-expanded="@(_previewOpen ? "true" : "false")"
                 @onclick="() => _previewOpen = !_previewOpen" @onclick:preventDefault="true">
            <span class="bench-customize-title">Certificate preview</span>
            <span class="chevron-icon @(_previewOpen ? "is-open" : "")" aria-hidden="true">▾</span>
        </summary>
        @if (_previewOpen)
        {
            @* data-keep-scroll: frame-scroll.js keeps the reader's place when a running QA check refreshes the preview. *@
            <iframe class="wf-report" data-testid="qa-preview-frame" data-keep-scroll sandbox="allow-same-origin" title="Hardware QA certificate preview" srcdoc="@certHtml"></iframe>
        }
    </details>
</section>

@code {
    private readonly PhysicalBenchQaService _fallbackPhysicalQa = new();
    private readonly ShopRelayClient _fallbackRelay = new();
    private BenchQaRunner? _fallbackBenchQa;
    private PhysicalBenchQaService ActivePhysicalQa => App.PhysicalQa ?? _fallbackPhysicalQa;
    private ShopRelayClient ActiveRelay => App.ShopRelay ?? _fallbackRelay;
    private BenchQaRunner ActiveBenchQa => App.BenchQa ?? (_fallbackBenchQa ??= new BenchQaRunner(Diagnostics, Store, App.Workflow, App.Preferences, ActivePhysicalQa));

    private readonly HashSet<string> _selectedItems = new(HardwareQaCertificate.DefaultSelectedItemIds, StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedGroups = new(StringComparer.OrdinalIgnoreCase);

    private bool AllQaOptionsSelected =>
        HardwareQaCertificate.AllSelectableItemIds.All(_selectedItems.Contains);

    private void ToggleAllQaOptions(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            foreach (var id in HardwareQaCertificate.AllSelectableItemIds) _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleGroupExpanded(string groupId)
    {
        if (!_expandedGroups.Remove(groupId)) _expandedGroups.Add(groupId);
    }

    private void ToggleGroupSelection(HardwareQaGroup group, bool selected)
    {
        foreach (var item in group.Items)
        {
            if (selected) _selectedItems.Add(item.Id);
            else _selectedItems.Remove(item.Id);
        }
    }

    private void ToggleItemSelection(string itemId, bool selected)
    {
        if (selected) _selectedItems.Add(itemId);
        else _selectedItems.Remove(itemId);
    }

    // Progress in QA items, the unit the page lists (16 selected → 14 run + 2 skipped); a Re-run has no item plan, so it counts steps.
    private (int Done, int Total) ProgressCounts =>
        ActiveBenchQa.RunItemIds.Count > 0
            ? (ActiveBenchQa.CompletedItems, ActiveBenchQa.RunItemIds.Count)
            : (ActiveBenchQa.CompletedSteps, Math.Max(1, ActiveBenchQa.TotalSteps));

    private string RunningLabel
    {
        get
        {
            var (done, total) = ProgressCounts;
            return ActiveBenchQa.RunItemIds.Count > 0 ? $"Running QA ({done} of {total} checked)…" : $"Re-running ({done}/{total})…";
        }
    }

    private static string ItemLabel(string itemId) =>
        HardwareQaCertificate.Groups.SelectMany(g => g.Items).FirstOrDefault(i => string.Equals(i.Id, itemId, StringComparison.OrdinalIgnoreCase))?.Label ?? itemId;

    // The certificate preview starts collapsed; the header above it already shows the live ID and verdict.
    private bool _previewOpen;


    private bool _isRemoteDisplay;
    private bool _publishingCert;
    private string? _publishError;
    private string? _publishedCertUrl;
    private string? _publishedCertShortHash;

    private string? _savedCertPath;
    private string? _saveError;

    private ShopBranding? _sessionBranding;
    private DateTimeOffset _certGeneratedAt = DateTimeOffset.Now;
    private HardwareQaSnapshot? _cachedSnap;
    private string _cachedCertHtml = "";
    private bool _wasBenchRunning;

    private Uri? EffectiveRelayUri =>
        Session.ServerUri
        ?? (ShopRelayClient.TryParseRelayUri(App.Preferences?.Current?.RelayServerUrl, out var prefParsed) ? prefParsed : null)
        ?? (ShopRelayClient.TryParseRelayUri(Environment.GetEnvironmentVariable("REMOTEPC_RELAY_URL"), out var envParsed) ? envParsed : null)
        ?? (ShopRelayClient.TryParseRelayUri(SessionLaunchOptions.DefaultServerUrl, out var defParsed) ? defParsed : null);

    private string EffectiveGroupSlug =>
        SessionLaunchOptions.NormalizeGroup(Session.Group ?? App.Preferences?.Current?.ShopGroupSlug) ?? "";

    private HardwareQaSnapshot EnsureCertificateSnapshot(bool force = false)
    {
        // While the automated checks run, keep the certificate as it was: rebuilding it from the store after every result made it (and its
        // ID and hash) change all through the run. It is built again when they finish and once more when the run ends.
        if (!force && _cachedSnap is not null && ActiveBenchQa.IsRunning && ActiveBenchQa.WaitingFor is null)
            return _cachedSnap;
        _cachedSnap = HardwareQaCertificate.Capture(Store, Session.MachineName, _certGeneratedAt, _sessionBranding, physicalQa: ActivePhysicalQa.Current);
        _cachedCertHtml = HardwareQaCertificate.BuildHtml(_cachedSnap);
        return _cachedSnap;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _sessionBranding = App.Preferences?.Current?.Branding;
        _certGeneratedAt = DateTimeOffset.Now;
        SyncActiveBenchOptions();
        ActivePhysicalQa.Changed += OnBenchStateChanged;
        ActiveBenchQa.Changed += OnBenchStateChanged;
        EnsureCertificateSnapshot(force: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var server = EffectiveRelayUri;
        var group = EffectiveGroupSlug;
        if (server is not null && !string.IsNullOrWhiteSpace(group))
        {
            try
            {
                var result = await ActiveRelay.FetchBrandingAsync(server, group);
                if (result is ShopRelayBrandingResult.Found found)
                {
                    _sessionBranding = found.Branding.Normalized();
                    if (App.Workflow is { State.Stage: WorkflowStage.Done } wf)
                        wf.RefreshReportBranding(_sessionBranding.HasAny ? _sessionBranding : null);
                    EnsureCertificateSnapshot(force: true);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var isRemote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
                if (isRemote != _isRemoteDisplay)
                {
                    _isRemoteDisplay = isRemote;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private void SyncActiveBenchOptions()
    {
        if (ActiveBenchQa.IsRunning)
        {
            _selectedItems.Clear();
            foreach (var id in ActiveBenchQa.SelectedItemIds) _selectedItems.Add(id);
        }
    }

    private void OnBenchStateChanged()
    {
        SyncActiveBenchOptions();
        var isRunning = ActiveBenchQa.IsRunning;
        if (_wasBenchRunning && !isRunning)
        {
            _certGeneratedAt = DateTimeOffset.Now;
            EnsureCertificateSnapshot(force: true);
        }
        _wasBenchRunning = isRunning;
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        ActivePhysicalQa.Changed -= OnBenchStateChanged;
        ActiveBenchQa.Changed -= OnBenchStateChanged;
        // The run keeps going after the page closes (it waits on the keyboard and display checks itself).
        base.Dispose();
    }

    private Task StartBenchQa()
    {
        _savedCertPath = null;
        _saveError = null;
        _publishError = null;
        _publishedCertUrl = null;
        _publishedCertShortHash = null;
        _certGeneratedAt = DateTimeOffset.Now;
        _ = ActiveBenchQa.StartBenchQaAsync(_selectedItems.ToList());
        return Task.CompletedTask;
    }

    private void StopBenchQa() => ActiveBenchQa.Cancel();

    private sealed record PublishQaResult(bool Ok, int Status, string? Id, string? Url, string? ShortHash, string? Error);

    private async Task PublishToAdminAsync()
    {
        _publishError = null;
        _publishedCertUrl = null;
        _publishedCertShortHash = null;
        _publishingCert = true;

        try
        {
            _certGeneratedAt = DateTimeOffset.Now;
            var snapshot = EnsureCertificateSnapshot(force: true);
            var snapshotJson = HardwareQaCertificate.ToSnapshotJson(snapshot);
            var res = await JS.InvokeAsync<PublishQaResult>("rpdSession.publishQaCertificate", snapshotJson);

            if (res.Ok && !string.IsNullOrWhiteSpace(res.Url))
            {
                _publishedCertUrl = res.Url;
                _publishedCertShortHash = res.ShortHash;
            }
            else if (res.Status == 401)
            {
                _publishError = "Sign in to your Admin portal in this browser to publish QA certificates.";
            }
            else if (res.Status == 402)
            {
                _publishError = "Shop subscription or trial is inactive. Activate billing on your Admin portal to publish hosted QR links.";
            }
            else
            {
                _publishError = $"Could not publish QA certificate: {res.Error ?? $"HTTP {res.Status}"}";
            }
        }
        catch (Exception ex)
        {
            _publishError = $"Could not publish QA certificate: {ex.Message}";
        }
        finally
        {
            _publishingCert = false;
        }
    }

    private async Task SaveCertificate()
    {
        _savedCertPath = null;
        _saveError = null;
        if (App.Workflow is null) return;
        _certGeneratedAt = DateTimeOffset.Now;
        var path = App.Workflow.SaveHardwareQaCertificate(out var certSnap, out var html, _sessionBranding, ActivePhysicalQa.Current);
        if (path is not null)
        {
            _savedCertPath = path;
            EnsureCertificateSnapshot(force: true);
        }
        else _saveError = "Could not write the HTML certificate to disk on this PC.";

        try
        {
            var isRemote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
            if (isRemote && !string.IsNullOrWhiteSpace(html))
            {
                var filename = !string.IsNullOrWhiteSpace(path)
                    ? Path.GetFileName(path)
                    : $"qa-certificate-{certSnap.CertificateId}.html";
                await JS.InvokeVoidAsync("rpdSession.saveAsFile", filename, html, "text/html;charset=utf-8");
            }
        }
        catch
        {
            // Non-fatal if browser download / JS interop fails
        }
    }
}

@code {
    // Needs attention: fixes for the security audit's failed settings, and Re-run for what failed.
    private const string SecurityItemId = "security";
    private RemediationActions? _qaFixUi;

    /// <summary>The page with a failed item's details and fixes; null for items without one (the interactive checks).</summary>
    private static string? PageFor(string itemId)
    {
        if (itemId == SecurityItemId) return "security-audit";
        return BenchQaRunner.SlugsForItem(itemId) is [var slug, ..] ? $"module/{Uri.EscapeDataString(slug)}" : null;
    }

    private static string Blank(string v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    /// <summary>
    /// Runs the checks behind these items again and refreshes the certificate when they finish. While the QA check waits on the keyboard or
    /// display check, they re-check beside it (after a fix here, or on the item's own page) and the run carries on.
    /// </summary>
    private void RerunItems(IEnumerable<string> itemIds)
    {
        if (Diagnostics.IsAnyStressRunning || ActiveBenchQa.IsRecheckRunning) return;
        if (ActiveBenchQa.IsRunning && ActiveBenchQa.WaitingFor is null) return;
        if (!ActiveBenchQa.IsRunning)
        {
            _savedCertPath = null;
            _certGeneratedAt = DateTimeOffset.Now;
        }
        _ = ActiveBenchQa.RerunAsync(itemIds.ToList());
    }
}
