@page "/certificates"
@using Microsoft.AspNetCore.Components.Forms
@using RemotePCDiagnostics.Core.Workflow
@inherits StoreAwareComponent
@inject AppServices App
@inject ISessionContext Session
@{
    var effectiveBranding = BuildCurrentBranding();
    var snap = HardwareQaCertificate.Capture(Store, Session.MachineName, DateTimeOffset.Now, effectiveBranding, physicalQa: ActivePhysicalQa.Current);
    var certHtml = HardwareQaCertificate.BuildHtml(snap);
    var verdictChip = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "ok",
        HardwareQaVerdict.PassedWithNotes => "warn",
        HardwareQaVerdict.AttentionRequired => "err",
        _ => "na",
    };
    var verdictLabel = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "Certified pass",
        HardwareQaVerdict.PassedWithNotes => "Passed with notes",
        HardwareQaVerdict.AttentionRequired => "Attention required",
        _ => "Bench intake snapshot",
    };
    var benchRunning = ActiveBenchQa.IsRunning;
    var benchBusyElsewhere = !benchRunning && Diagnostics.IsAnyStressRunning;
}

<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="cert" Size="20" /></span>
    <h1 data-testid="branding-title">QA Certificate &amp; Shop Branding</h1>
</div>
<p class="meta">White-label your client service reports (with measured before/after Windows speedups) and export 1-page scannable Buyer Hardware QA QR Certificates for refurbished PCs with zero hardware dongles.</p>

<section class="card wf-section bench-qa-banner" data-testid="bench-qa-banner" style="margin-bottom: 16px">
    <div class="toolbar" style="margin-bottom: 6px">
        <div>
            <strong>10-Minute Hardware Intake / QA Check</strong>
            <span class="meta"> · Hands-free refurbisher bench pass (SMBIOS, SMART, battery, WHEA, DISM/SFC, short thermal stress, audio &amp; webcam → auto-saved QR certificate)</span>
        </div>
        <div class="banner-actions">
            <button type="button"
                    class="btn btn-primary"
                    data-testid="bench-qa-start"
                    disabled="@(benchRunning || benchBusyElsewhere)"
                    @onclick="StartBenchQa">
                <Icon Name="@(benchRunning ? "refresh" : "play")" Size="14" />
                @(benchRunning ? $"Running QA ({ActiveBenchQa.CompletedSteps}/{Math.Max(1, ActiveBenchQa.TotalSteps)})…" : "Start 10-min QA check")
            </button>
            @if (benchRunning)
            {
                <button type="button" class="btn btn-outline" data-testid="bench-qa-stop" @onclick="StopBenchQa">Stop</button>
            }
        </div>
    </div>
    <div class="bench-qa-options">
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-stress" @bind="_includeStress" disabled="@benchRunning" />
            <span>Short thermal-guarded stress (CPU, RAM, Disk, GPU — offline bench safe)</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-audio" @bind="_includeAudioCamera" disabled="@benchRunning" />
            <span>Dongle-free WASAPI speaker→mic loopback &amp; webcam check</span>
        </label>
    </div>
    @if (benchRunning && ActiveBenchQa.TotalSteps > 0)
    {
        <div class="progress wf-overall-progress" style="max-width:none;margin:10px 0 6px" data-testid="bench-qa-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@ActiveBenchQa.TotalSteps" aria-valuenow="@ActiveBenchQa.CompletedSteps">
            <div style="width:@($"{ActiveBenchQa.ProgressFraction * 100:0.#}%")"></div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ActiveBenchQa.Status))
    {
        <p class="meta" style="margin:6px 0 0" data-testid="bench-qa-status">@ActiveBenchQa.Status</p>
    }
</section>

<PhysicalBenchQaCard Service="ActivePhysicalQa" />

<details class="card wf-section" open data-testid="branding-card" style="margin-bottom: 16px">
    <summary style="cursor:pointer;font-weight:600;padding:4px 0">
        Shop branding &amp; warranty settings
        @if (!string.IsNullOrWhiteSpace(_shopName)) { <span class="meta"> — @_shopName</span> }
        else { <span class="meta"> — unbranded (optional)</span> }
    </summary>
    <div style="margin-top: 12px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 16px;">
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Shop / business name</span>
            <input data-testid="branding-shop-name" @bind="_shopName" @bind:event="oninput" maxlength="120" placeholder="e.g. Acme PC Repair &amp; Refurb" style="width:100%" />
        </label>
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Technician name</span>
            <input data-testid="branding-tech-name" @bind="_techName" @bind:event="oninput" maxlength="80" placeholder="e.g. Alex Rivera" style="width:100%" />
        </label>
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Phone</span>
            <input data-testid="branding-phone" @bind="_phone" @bind:event="oninput" maxlength="60" placeholder="(555) 019-2834" style="width:100%" />
        </label>
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Email</span>
            <input data-testid="branding-email" @bind="_email" @bind:event="oninput" maxlength="120" placeholder="service@acmepc.example" style="width:100%" />
        </label>
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Website</span>
            <input data-testid="branding-website" @bind="_website" @bind:event="oninput" maxlength="200" placeholder="https://acmepc.example" style="width:100%" />
        </label>
        <label class="wf-field" style="flex-direction:column;align-items:stretch">
            <span class="meta">Location / address</span>
            <input data-testid="branding-address" @bind="_address" @bind:event="oninput" maxlength="200" placeholder="120 Main St, Suite B" style="width:100%" />
        </label>
    </div>

    <div style="margin-top: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
        <label class="meta">
            Shop logo (PNG, JPEG, WebP, or GIF, up to 55 KB — embedded offline in HTML/PDF):
            <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/webp,image/gif" data-testid="branding-logo-input" />
        </label>
        @if (ShopBranding.SanitizeLogoDataUri(_logoDataUri) is { } safeLogo)
        {
            <img src="@safeLogo" alt="Shop logo preview" data-testid="branding-logo-preview" style="max-height:42px;max-width:140px;object-fit:contain;border:1px solid var(--border);border-radius:6px;padding:2px;background:#fff" />
            <button type="button" class="btn-small" data-testid="branding-logo-clear" @onclick="ClearLogo">Remove logo</button>
        }
    </div>
    @if (_logoError is not null)
    {
        <p class="notice notice-error" role="alert" data-testid="branding-logo-error">@_logoError</p>
    }

    <div style="margin-top: 10px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px 16px;">
        <label style="display:flex;flex-direction:column;gap:4px">
            <span class="meta">Warranty / return policy footer (shown on service reports &amp; QA certificates)</span>
            <input data-testid="branding-warranty" @bind="_warrantyFooter" @bind:event="oninput" maxlength="500" placeholder="e.g. Backed by our 90-Day Parts &amp; Labor Warranty." style="width:100%" />
        </label>
        <label style="display:flex;flex-direction:column;gap:4px">
            <span class="meta">Hosted QR verification base URL (optional)</span>
            <input data-testid="branding-verify-url" @bind="_verificationBaseUrl" @bind:event="oninput" maxlength="200" placeholder="Leave blank for offline self-verifying QR payload" style="width:100%" />
        </label>
    </div>

    <label style="display:flex;flex-direction:column;gap:4px;margin-top:10px">
        <span class="meta">Technician QA / service notes</span>
        <textarea data-testid="branding-notes" @bind="_techNotes" @bind:event="oninput" rows="2" maxlength="2000" placeholder="Optional bench summary (e.g. thermal paste replaced, BIOS updated, passed 25-min extended burn-in)." style="width:100%;font-family:inherit;padding:6px 8px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:inherit"></textarea>
    </label>

    <div class="toolbar" style="margin-top: 12px">
        <button type="button" class="btn btn-primary" data-testid="branding-save" @onclick="SaveBranding">Save shop branding</button>
        <button type="button" class="btn btn-outline" data-testid="branding-clear" @onclick="ResetBranding">Clear branding</button>
        @if (_statusMessage is not null)
        {
            <span class="meta" data-testid="branding-status">@_statusMessage</span>
        }
    </div>
</details>

<section class="card wf-section relay-publish-card" data-testid="relay-publish-card" style="margin-bottom: 16px">
    <div class="toolbar" style="margin-bottom: 6px">
        <div>
            <strong>Hosted QR Verification &amp; Relay Sync</strong>
            <span class="meta"> · Pull shop branding from your relay or publish tamper-evident QR certificates to live <code>/r/{id}</code> buyer verification URLs</span>
        </div>
        <div class="banner-actions">
            <button type="button"
                    class="btn btn-outline"
                    data-testid="relay-pull-branding"
                    disabled="@(_pullingBranding || _publishingCert)"
                    @onclick="PullBrandingFromRelayAsync">
                <Icon Name="refresh" Size="14" />
                @(_pullingBranding ? "Pulling branding…" : "Pull Branding from Relay")
            </button>
            <button type="button"
                    class="btn btn-primary"
                    data-testid="publish-hosted-cert"
                    disabled="@(_publishingCert || _pullingBranding)"
                    @onclick="PublishHostedCertificateAsync">
                <Icon Name="cert" Size="14" />
                @(_publishingCert ? "Publishing…" : "Publish Hosted QR Certificate")
            </button>
        </div>
    </div>

    <div class="relay-publish-grid">
        <label class="connect-tech-field">
            <span class="meta">Relay Server URL</span>
            <input data-testid="relay-server-url"
                   @bind="_relayServerUrl"
                   @bind:event="oninput"
                   maxlength="240"
                   placeholder="https://remoteblazorwebview.com:34544"
                   autocomplete="url" />
        </label>
        <label class="connect-tech-field">
            <span class="meta">Shop Group Slug</span>
            <input data-testid="relay-group-slug"
                   @bind="_relayGroupSlug"
                   @bind:event="oninput"
                   maxlength="64"
                   placeholder="e.g. acme-pc"
                   autocomplete="off" />
        </label>
        <label class="connect-tech-field">
            <span class="meta">Shop API Key (<code>rpd_live_…</code> — kept local, never in HTML)</span>
            <div class="relay-key-row">
                <input type="@(_showApiKey ? "text" : "password")"
                       data-testid="relay-api-key"
                       @bind="_relayApiKey"
                       @bind:event="oninput"
                       maxlength="160"
                       placeholder="rpd_live_..."
                       autocomplete="off" />
                <button type="button"
                        class="btn-small"
                        data-testid="relay-api-key-toggle"
                        aria-label="@(_showApiKey ? "Hide API key" : "Show API key")"
                        title="@(_showApiKey ? "Hide API key" : "Show API key")"
                        aria-pressed="@(_showApiKey ? "true" : "false")"
                        @onclick="() => _showApiKey = !_showApiKey">
                    <Icon Name="@(_showApiKey ? "eye-off" : "eye")" Size="12" />
                </button>
            </div>
        </label>
    </div>

    @if (_relayMessage is not null)
    {
        <p class="meta" style="margin: 8px 0 0" data-testid="relay-sync-status">@_relayMessage</p>
    }
    @if (_publishError is not null)
    {
        <p class="notice notice-error" role="alert" data-testid="publish-cert-error">@_publishError</p>
    }
    @if (_publishedCertUrl is not null)
    {
        <div class="svc-result-ok relay-published-banner" style="margin-top: 10px; margin-bottom: 0">
            <div>
                <strong>Hosted QR certificate live:</strong>
                <a href="@_publishedCertUrl" target="_blank" rel="noopener noreferrer" data-testid="published-cert-url">@_publishedCertUrl</a>
                @if (!string.IsNullOrWhiteSpace(_publishedCertShortHash))
                {
                    <span class="chip chip-ok" style="margin-left: 8px">SHA-256 @_publishedCertShortHash</span>
                }
            </div>
        </div>
    }
</section>

<section class="card wf-section" data-testid="qa-cert-card">
    <div class="toolbar" style="margin-bottom: 8px">
        <div>
            <strong data-testid="qa-live-id">@snap.CertificateId</strong>
            <span> · </span>
            <span class="chip chip-@verdictChip" data-testid="qa-live-verdict">@verdictLabel</span>
            <span class="meta"> · @snap.TestedCount of @snap.Items.Count subsystems checked</span>
        </div>
        <div class="banner-actions">
            @if (App.Workflow is not null)
            {
                <button type="button" class="btn btn-primary" data-testid="qa-save-html" @onclick="SaveCertificate">
                    <Icon Name="cert" Size="14" /> Save 1-page HTML certificate
                </button>
            }
            <a class="btn btn-outline" href="checks">Checks</a>
            <a class="btn btn-outline" href="stress">Stress tests</a>
        </div>
    </div>
    @if ((_savedCertPath ?? ActiveBenchQa.LastSavedCertificatePath) is { } shownCertPath)
    {
        <p class="meta" data-testid="qa-saved-path">Certificate saved on this PC: @shownCertPath (open in any browser and press Ctrl+P to print or save as a 1-page PDF).</p>
    }
    else if (_saveError is not null)
    {
        <p class="notice notice-error" role="alert">@_saveError</p>
    }
    <iframe class="wf-report" data-testid="qa-preview-frame" sandbox="allow-same-origin" title="Hardware QA certificate preview" srcdoc="@certHtml"></iframe>
</section>

@code {
    private const long MaxLogoUploadBytes = 56_320; // 55 KB raw -> ~75 KB base64 (< 80,000 char cap)

    private readonly PhysicalBenchQaService _fallbackPhysicalQa = new();
    private readonly ShopRelayClient _fallbackRelay = new();
    private BenchQaRunner? _fallbackBenchQa;
    private PhysicalBenchQaService ActivePhysicalQa => App.PhysicalQa ?? _fallbackPhysicalQa;
    private ShopRelayClient ActiveRelay => App.ShopRelay ?? _fallbackRelay;
    private BenchQaRunner ActiveBenchQa => App.BenchQa ?? (_fallbackBenchQa ??= new BenchQaRunner(Diagnostics, Store, App.Workflow, App.Preferences, ActivePhysicalQa));

    private bool _includeStress = true;
    private bool _includeAudioCamera = true;

    private string _shopName = "";
    private string? _logoDataUri;
    private string _phone = "";
    private string _email = "";
    private string _website = "";
    private string _address = "";
    private string _techName = "";
    private string _techNotes = "";
    private string _warrantyFooter = "";
    private string _verificationBaseUrl = "";

    private string _relayServerUrl = "";
    private string _relayGroupSlug = "";
    private string _relayApiKey = "";
    private bool _showApiKey;
    private bool _pullingBranding;
    private bool _publishingCert;
    private string? _relayMessage;
    private string? _publishError;
    private string? _publishedCertUrl;
    private string? _publishedCertShortHash;

    private string? _logoError;
    private string? _statusMessage;
    private string? _savedCertPath;
    private string? _saveError;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var prefs = App.Preferences?.Current;
        LoadFromPreferences(prefs?.Branding);
        _relayServerUrl = !string.IsNullOrWhiteSpace(prefs?.RelayServerUrl)
            ? prefs!.RelayServerUrl!
            : Environment.GetEnvironmentVariable("REMOTEPC_RELAY_URL")
                ?? (Session.ServerUri is { } su ? ShopRelayClient.BaseUrl(su) : SessionLaunchOptions.DefaultServerUrl);
        _relayGroupSlug = Session.Group ?? prefs?.ShopGroupSlug ?? "";
        _relayApiKey = prefs?.ShopApiKey ?? "";
        ActivePhysicalQa.Changed += OnBenchStateChanged;
        ActiveBenchQa.Changed += OnBenchStateChanged;
    }

    private void OnBenchStateChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        ActivePhysicalQa.Changed -= OnBenchStateChanged;
        ActiveBenchQa.Changed -= OnBenchStateChanged;
        _showApiKey = false;
        base.Dispose();
    }

    private Task StartBenchQa()
    {
        _savedCertPath = null;
        _saveError = null;
        var current = BuildCurrentBranding();
        PersistRelayAndBranding(current);
        _ = ActiveBenchQa.RunIntakeAsync(_includeStress, _includeAudioCamera);
        return Task.CompletedTask;
    }

    private void StopBenchQa() => ActiveBenchQa.Cancel();

    private void LoadFromPreferences(ShopBranding? b)
    {
        _shopName = b?.ShopName ?? "";
        _logoDataUri = b?.SafeLogoDataUri;
        _phone = b?.Phone ?? "";
        _email = b?.Email ?? "";
        _website = b?.Website ?? "";
        _address = b?.Address ?? "";
        _techName = b?.TechnicianName ?? "";
        _techNotes = b?.TechnicianNotes ?? "";
        _warrantyFooter = b?.WarrantyFooter ?? "";
        _verificationBaseUrl = b?.VerificationBaseUrl ?? "";
    }

    private ShopBranding BuildCurrentBranding() => new ShopBranding
    {
        ShopName = _shopName,
        LogoDataUri = _logoDataUri,
        Phone = _phone,
        Email = _email,
        Website = _website,
        Address = _address,
        TechnicianName = _techName,
        TechnicianNotes = _techNotes,
        WarrantyFooter = _warrantyFooter,
        VerificationBaseUrl = _verificationBaseUrl,
    }.Normalized();

    private void PersistRelayAndBranding(ShopBranding branding)
    {
        var savedBranding = branding.HasAny ? branding : null;
        var cleanServer = ShopRelayClient.TryParseRelayUri(_relayServerUrl, out var parsedUri) && parsedUri is not null
            ? ShopRelayClient.BaseUrl(parsedUri)
            : (string.IsNullOrWhiteSpace(_relayServerUrl) ? null : _relayServerUrl.Trim());
        var cleanGroup = SessionLaunchOptions.NormalizeGroup(_relayGroupSlug);
        var cleanKey = string.IsNullOrWhiteSpace(_relayApiKey) ? null : _relayApiKey.Trim();

        App.Preferences?.Update(p => p with
        {
            Branding = savedBranding,
            RelayServerUrl = cleanServer,
            ShopGroupSlug = cleanGroup,
            ShopApiKey = cleanKey,
        });
    }

    private async Task PullBrandingFromRelayAsync()
    {
        _relayMessage = null;
        _publishError = null;

        var normalizedGroup = SessionLaunchOptions.NormalizeGroup(_relayGroupSlug);
        if (string.IsNullOrEmpty(normalizedGroup))
        {
            _publishError = "Enter a shop group slug (for example, acme-pc) to pull branding from the relay.";
            return;
        }

        if (!ShopRelayClient.TryParseRelayUri(_relayServerUrl, out var relayUri) || relayUri is null)
        {
            _publishError = "Enter a valid http:// or https:// relay server URL.";
            return;
        }

        _pullingBranding = true;
        try
        {
            var result = await ActiveRelay.FetchBrandingAsync(relayUri, normalizedGroup);
            switch (result)
            {
                case ShopRelayBrandingResult.Found found:
                    var preservedNotes = _techNotes;
                    LoadFromPreferences(found.Branding);
                    if (!string.IsNullOrWhiteSpace(preservedNotes))
                        _techNotes = preservedNotes;
                    _relayGroupSlug = found.GroupSlug;
                    var merged = BuildCurrentBranding();
                    PersistRelayAndBranding(merged);
                    if (App.Workflow is { State.Stage: WorkflowStage.Done } wf)
                        wf.RefreshReportBranding(merged.HasAny ? merged : null);
                    _relayMessage = $"Pulled live branding for '{found.Branding.ShopName ?? found.GroupSlug}' ({found.GroupSlug}).";
                    break;

                case ShopRelayBrandingResult.NotFoundOrInactive:
                    _publishError = "Shop group not found or subscription inactive.";
                    break;

                case ShopRelayBrandingResult.NetworkError err:
                    _publishError = $"Could not reach relay server: {err.Message}";
                    break;
            }
        }
        finally
        {
            _pullingBranding = false;
        }
    }

    private async Task PublishHostedCertificateAsync()
    {
        _publishError = null;
        _relayMessage = null;
        _publishedCertUrl = null;
        _publishedCertShortHash = null;

        if (!ShopRelayClient.TryParseRelayUri(_relayServerUrl, out var relayUri) || relayUri is null)
        {
            _publishError = "Enter a valid http:// or https:// relay server URL before publishing.";
            return;
        }

        var trimmedKey = _relayApiKey.Trim();
        if (!trimmedKey.StartsWith(ShopRelayClient.ApiKeyPrefix, StringComparison.Ordinal) || trimmedKey.Length <= ShopRelayClient.ApiKeyPrefix.Length)
        {
            _publishError = "Enter a valid Shop API key starting with 'rpd_live_' (from your relay /shop portal).";
            return;
        }

        // Ensure the certificate's embedded QR badge encodes {relayBase}/r/{id}?h={shortHash} before building the HTML!
        var relayVerifyBase = $"{ShopRelayClient.BaseUrl(relayUri)}/r";
        if (string.IsNullOrWhiteSpace(_verificationBaseUrl))
            _verificationBaseUrl = relayVerifyBase;

        var branding = BuildCurrentBranding();
        if (branding.SafeVerificationBaseUrl is null)
        {
            branding = (branding with { VerificationBaseUrl = relayVerifyBase }).Normalized();
            _verificationBaseUrl = branding.VerificationBaseUrl ?? relayVerifyBase;
        }

        PersistRelayAndBranding(branding);

        var snapshot = HardwareQaCertificate.Capture(Store, Session.MachineName, DateTimeOffset.Now, branding, physicalQa: ActivePhysicalQa.Current);
        var html = HardwareQaCertificate.BuildHtml(snapshot);
        var uploadReq = ShopRelayClient.CreateQaCertificateRequest(snapshot, html);

        _publishingCert = true;
        try
        {
            var result = await ActiveRelay.PublishReportAsync(relayUri, trimmedKey, uploadReq);
            switch (result)
            {
                case ShopReportPublishResult.Published pub:
                    _publishedCertUrl = pub.Url;
                    _publishedCertShortHash = pub.ShortHash;
                    break;

                case ShopReportPublishResult.Unauthorized:
                    _publishError = "Shop API key was rejected (401 Unauthorized). Check your rpd_live_... key in the relay /shop portal.";
                    break;

                case ShopReportPublishResult.PaymentRequired:
                    _publishError = "Shop subscription or trial is inactive (402 Payment Required). Activate billing on the relay /shop portal to publish hosted QR links.";
                    break;

                case ShopReportPublishResult.InvalidRequest inv:
                    _publishError = $"Relay rejected certificate upload: {inv.Error}";
                    break;

                case ShopReportPublishResult.NetworkError net:
                    _publishError = $"Could not upload certificate to relay: {net.Message}";
                    break;
            }
        }
        finally
        {
            _publishingCert = false;
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoError = null;
        _statusMessage = null;
        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxLogoUploadBytes)
        {
            _logoError = $"Logo image is {file.Size / 1024:0} KB; please choose a PNG, JPEG, WebP, or GIF under 55 KB.";
            return;
        }

        var mime = file.ContentType?.ToLowerInvariant() switch
        {
            "image/png" => "image/png",
            "image/jpeg" or "image/jpg" => "image/jpeg",
            "image/webp" => "image/webp",
            "image/gif" => "image/gif",
            _ => Path.GetExtension(file.Name).ToLowerInvariant() switch
            {
                ".png" => "image/png",
                ".jpg" or ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => null,
            },
        };

        if (mime is null)
        {
            _logoError = "Unsupported image type. Please choose a PNG, JPEG, WebP, or GIF file.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxLogoUploadBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var uri = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
            var safe = ShopBranding.SanitizeLogoDataUri(uri);
            if (safe is null)
            {
                _logoError = "Could not validate the selected logo image.";
                return;
            }
            _logoDataUri = safe;
        }
        catch (Exception ex)
        {
            _logoError = $"Could not read logo file: {ex.Message}";
        }
    }

    private void ClearLogo()
    {
        _logoDataUri = null;
        _logoError = null;
    }

    private void SaveBranding()
    {
        var normalized = BuildCurrentBranding();
        PersistRelayAndBranding(normalized);
        var saved = normalized.HasAny ? normalized : null;
        if (App.Workflow is { State.Stage: WorkflowStage.Done } wf)
            wf.RefreshReportBranding(saved);
        _statusMessage = saved is not null ? "Saved shop branding and relay settings." : "Saved (unbranded).";
    }

    private void ResetBranding()
    {
        LoadFromPreferences(null);
        _logoError = null;
        App.Preferences?.Update(p => p with { Branding = null });
        if (App.Workflow is { State.Stage: WorkflowStage.Done } wf)
            wf.RefreshReportBranding(null);
        _statusMessage = "Cleared shop branding.";
    }

    private void SaveCertificate()
    {
        _savedCertPath = null;
        _saveError = null;
        if (App.Workflow is null) return;
        var current = BuildCurrentBranding();
        PersistRelayAndBranding(current);
        var path = App.Workflow.SaveHardwareQaCertificate(out _, out _, current, ActivePhysicalQa.Current);
        if (path is not null) _savedCertPath = path;
        else _saveError = "Could not write the HTML certificate to disk on this PC.";
    }
}
