@page "/certificates"
@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Workflow
@inherits StoreAwareComponent
@inject AppServices App
@inject ISessionContext Session
@inject IJSRuntime JS
@{
    var snap = EnsureCertificateSnapshot();
    var certHtml = _cachedCertHtml;
    var verdictChip = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "ok",
        HardwareQaVerdict.PassedWithNotes => "warn",
        HardwareQaVerdict.AttentionRequired => "err",
        _ => "na",
    };
    var verdictLabel = snap.Verdict switch
    {
        HardwareQaVerdict.CertifiedPass => "Certified pass",
        HardwareQaVerdict.PassedWithNotes => "Passed with notes",
        HardwareQaVerdict.AttentionRequired => "Attention required",
        _ => "Bench intake snapshot",
    };
    var benchRunning = ActiveBenchQa.IsRunning;
    var benchBusyElsewhere = !benchRunning && Diagnostics.IsAnyStressRunning;
}

<div class="toolbar">
    <span class="icon-badge page-icon"><Icon Name="cert" Size="20" /></span>
    <h1 data-rpcd-page="certificates" data-rpcd-contract="@BrowserContract.Certificates" data-testid="branding-title">QA Certificate</h1>
</div>
<p class="meta">Run a hardware QA check and save or publish a 1-page QR certificate for this PC.</p>

<section class="card wf-section bench-qa-banner" data-testid="bench-qa-banner" style="margin-bottom: 16px">
    <div>
        <strong>Hardware QA Check</strong>
        <span class="meta"> · SMBIOS, SMART, battery, WHEA, DISM/SFC, optional stress &amp; I/O checks</span>
    </div>
    <div class="bench-qa-options">
        <label class="bench-kind bench-qa-select-all">
            <input type="checkbox" data-testid="bench-qa-select-all" checked="@AllQaOptionsSelected" @onchange="ToggleAllQaOptions" disabled="@benchRunning" />
            <span>Select all / none</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-stress" checked="@_includeStress" @onchange="e => _includeStress = e.Value is true" disabled="@benchRunning" />
            <span>Thermal-guarded stress test (CPU, RAM, Disk, GPU)</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-audio" checked="@_includeAudioCamera" @onchange="e => _includeAudioCamera = e.Value is true" disabled="@benchRunning" />
            <span>Audio loopback &amp; webcam check</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-security" checked="@_includeSecurityAudit" @onchange="e => _includeSecurityAudit = e.Value is true" disabled="@benchRunning" />
            <span>Windows security &amp; baseline audit (HardeningKitty)</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-keyboard" checked="@_includeKeyboard" @onchange="e => _includeKeyboard = e.Value is true" disabled="@benchRunning" />
            <span>Physical keyboard matrix &amp; rollover check</span>
        </label>
        <label class="bench-kind meta">
            <input type="checkbox" data-testid="bench-qa-include-display" checked="@_includeDisplay" @onchange="e => _includeDisplay = e.Value is true" disabled="@benchRunning" />
            <span>Physical display dead-pixel &amp; touch check</span>
        </label>
    </div>
    <div class="banner-actions">
        <button type="button"
                class="btn btn-primary"
                data-testid="bench-qa-start"
                disabled="@(benchRunning || benchBusyElsewhere)"
                @onclick="StartBenchQa">
            <Icon Name="@(benchRunning ? "refresh" : "play")" Size="14" />
            @(benchRunning ? $"Running QA ({ActiveBenchQa.CompletedSteps}/{Math.Max(1, ActiveBenchQa.TotalSteps)})…" : "Start QA check")
        </button>
        @if (benchRunning)
        {
            <button type="button" class="btn btn-outline" data-testid="bench-qa-stop" @onclick="StopBenchQa">Stop</button>
        }
    </div>
    @if (benchRunning && ActiveBenchQa.TotalSteps > 0)
    {
        <div class="progress wf-overall-progress" style="max-width:none;margin:10px 0 6px" data-testid="bench-qa-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@ActiveBenchQa.TotalSteps" aria-valuenow="@ActiveBenchQa.CompletedSteps">
            <div style="width:@($"{ActiveBenchQa.ProgressFraction * 100:0.#}%")"></div>
        </div>
    }
    @if (benchRunning && !string.IsNullOrWhiteSpace(ActiveBenchQa.Status))
    {
        <p class="meta" style="margin:4px 0 0;color:var(--text, #cbd5e1)" data-testid="bench-qa-status">@ActiveBenchQa.Status</p>
    }
</section>

@if (benchRunning && _activeInteractiveSection is { Length: > 0 })
{
    <PhysicalBenchQaCard Service="ActivePhysicalQa" FilterSection="@_activeInteractiveSection" OnOutcomeChanged="OnBenchInteractiveOutcomeChanged" />
}

<section class="card wf-section" data-testid="qa-cert-card">
    <div class="toolbar" style="margin-bottom: 8px">
        <div>
            <strong data-testid="qa-live-id">@snap.CertificateId</strong>
            <span> · </span>
            <span class="chip chip-@verdictChip" data-testid="qa-live-verdict">@verdictLabel</span>
            <span class="meta"> · @snap.TestedCount of @snap.Items.Count subsystems checked</span>
        </div>
        <div class="banner-actions">
            @if (_isRemoteDisplay)
            {
                <button type="button"
                        class="btn btn-primary"
                        data-testid="publish-hosted-cert"
                        disabled="@_publishingCert"
                        @onclick="PublishToAdminAsync">
                    <Icon Name="cert" Size="14" />
                    @(_publishingCert ? "Publishing…" : "Publish to Admin")
                </button>
            }
            @if (App.Workflow is not null)
            {
                <button type="button"
                        class="btn @(_isRemoteDisplay ? "btn-outline" : "btn-primary")"
                        data-testid="qa-save-html"
                        @onclick="SaveCertificate">
                    <Icon Name="cert" Size="14" /> @(_isRemoteDisplay ? "Download HTML" : "Save HTML")
                </button>
            }
        </div>
    </div>
    @if (_publishError is not null)
    {
        <p class="notice notice-error" role="alert" data-testid="publish-cert-error">@_publishError</p>
    }
    @if (_publishedCertUrl is not null)
    {
        <div class="svc-result-ok relay-published-banner" style="margin-bottom: 10px">
            <div>
                <strong>Published on Admin:</strong>
                <a href="@_publishedCertUrl" target="_blank" rel="noopener noreferrer" data-testid="published-cert-url">@_publishedCertUrl</a>
                @if (!string.IsNullOrWhiteSpace(_publishedCertShortHash))
                {
                    <span class="chip chip-ok" style="margin-left: 8px">SHA-256 @_publishedCertShortHash</span>
                }
            </div>
        </div>
    }
    @if ((_savedCertPath ?? ActiveBenchQa.LastSavedCertificatePath) is { } shownCertPath)
    {
        <p class="meta" data-testid="qa-saved-path">Saved: @shownCertPath (upload on your Admin portal to brand &amp; host, or press Ctrl+P in a browser to print).</p>
    }
    else if (_saveError is not null)
    {
        <p class="notice notice-error" role="alert">@_saveError</p>
    }
    <iframe class="wf-report" data-testid="qa-preview-frame" sandbox="allow-same-origin" title="Hardware QA certificate preview" srcdoc="@certHtml"></iframe>
</section>

@code {
    private readonly PhysicalBenchQaService _fallbackPhysicalQa = new();
    private readonly ShopRelayClient _fallbackRelay = new();
    private BenchQaRunner? _fallbackBenchQa;
    private PhysicalBenchQaService ActivePhysicalQa => App.PhysicalQa ?? _fallbackPhysicalQa;
    private ShopRelayClient ActiveRelay => App.ShopRelay ?? _fallbackRelay;
    private BenchQaRunner ActiveBenchQa => App.BenchQa ?? (_fallbackBenchQa ??= new BenchQaRunner(Diagnostics, Store, App.Workflow, App.Preferences, ActivePhysicalQa));

    private bool _includeStress = true;
    private bool _includeAudioCamera = true;
    private bool _includeSecurityAudit;
    private bool _includeKeyboard;
    private bool _includeDisplay;

    private bool AllQaOptionsSelected =>
        _includeStress && _includeAudioCamera && _includeSecurityAudit && _includeKeyboard && _includeDisplay;

    private void ToggleAllQaOptions(ChangeEventArgs e)
    {
        var selected = e.Value is true;
        _includeStress = selected;
        _includeAudioCamera = selected;
        _includeSecurityAudit = selected;
        _includeKeyboard = selected;
        _includeDisplay = selected;
    }

    private string? _activeInteractiveSection;
    private TaskCompletionSource<bool>? _benchInteractiveTcs;

    private bool _isRemoteDisplay;
    private bool _publishingCert;
    private string? _publishError;
    private string? _publishedCertUrl;
    private string? _publishedCertShortHash;

    private string? _savedCertPath;
    private string? _saveError;

    private ShopBranding? _sessionBranding;
    private DateTimeOffset _certGeneratedAt = DateTimeOffset.Now;
    private HardwareQaSnapshot? _cachedSnap;
    private string _cachedCertHtml = "";
    private int _lastBenchCompletedSteps = -1;
    private bool _wasBenchRunning;
    private long _lastPreviewUpdateTicks;

    private Uri? EffectiveRelayUri =>
        Session.ServerUri
        ?? (ShopRelayClient.TryParseRelayUri(App.Preferences?.Current?.RelayServerUrl, out var prefParsed) ? prefParsed : null)
        ?? (ShopRelayClient.TryParseRelayUri(Environment.GetEnvironmentVariable("REMOTEPC_RELAY_URL"), out var envParsed) ? envParsed : null)
        ?? (ShopRelayClient.TryParseRelayUri(SessionLaunchOptions.DefaultServerUrl, out var defParsed) ? defParsed : null);

    private string EffectiveGroupSlug =>
        SessionLaunchOptions.NormalizeGroup(Session.Group ?? App.Preferences?.Current?.ShopGroupSlug) ?? "";

    private HardwareQaSnapshot EnsureCertificateSnapshot(bool force = false)
    {
        var benchRunning = ActiveBenchQa.IsRunning;
        var nowTicks = Environment.TickCount64;

        if (!force && _cachedSnap is not null)
        {
            if (benchRunning)
            {
                var stepChanged = ActiveBenchQa.CompletedSteps != _lastBenchCompletedSteps;
                var debounceElapsed = nowTicks - _lastPreviewUpdateTicks >= 1000;
                if (!stepChanged && !debounceElapsed)
                    return _cachedSnap;
            }
        }

        _lastPreviewUpdateTicks = nowTicks;
        _lastBenchCompletedSteps = ActiveBenchQa.CompletedSteps;
        _cachedSnap = HardwareQaCertificate.Capture(Store, Session.MachineName, _certGeneratedAt, _sessionBranding, physicalQa: ActivePhysicalQa.Current);
        _cachedCertHtml = HardwareQaCertificate.BuildHtml(_cachedSnap);
        return _cachedSnap;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _sessionBranding = App.Preferences?.Current?.Branding;
        _certGeneratedAt = DateTimeOffset.Now;
        SyncActiveBenchOptions();
        ActivePhysicalQa.Changed += OnBenchStateChanged;
        ActiveBenchQa.Changed += OnBenchStateChanged;
        EnsureCertificateSnapshot(force: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var server = EffectiveRelayUri;
        var group = EffectiveGroupSlug;
        if (server is not null && !string.IsNullOrWhiteSpace(group))
        {
            try
            {
                var result = await ActiveRelay.FetchBrandingAsync(server, group);
                if (result is ShopRelayBrandingResult.Found found)
                {
                    _sessionBranding = found.Branding.Normalized();
                    if (App.Workflow is { State.Stage: WorkflowStage.Done } wf)
                        wf.RefreshReportBranding(_sessionBranding.HasAny ? _sessionBranding : null);
                    EnsureCertificateSnapshot(force: true);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var isRemote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
                if (isRemote != _isRemoteDisplay)
                {
                    _isRemoteDisplay = isRemote;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private void SyncActiveBenchOptions()
    {
        if (ActiveBenchQa.IsRunning)
        {
            _includeStress = ActiveBenchQa.IncludeStress;
            _includeAudioCamera = ActiveBenchQa.IncludeAudioCamera;
            _includeSecurityAudit = ActiveBenchQa.IncludeSecurityAudit;
            _includeKeyboard = ActiveBenchQa.IncludeKeyboard;
            _includeDisplay = ActiveBenchQa.IncludeDisplay;
        }
    }

    private void OnBenchStateChanged()
    {
        SyncActiveBenchOptions();
        var isRunning = ActiveBenchQa.IsRunning;
        if (_wasBenchRunning && !isRunning)
        {
            _certGeneratedAt = DateTimeOffset.Now;
            EnsureCertificateSnapshot(force: true);
        }
        else if (!_wasBenchRunning && isRunning)
        {
            EnsureCertificateSnapshot(force: true);
        }
        else if (isRunning && ActiveBenchQa.CompletedSteps != _lastBenchCompletedSteps)
        {
            EnsureCertificateSnapshot(force: true);
        }
        _wasBenchRunning = isRunning;
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        ActivePhysicalQa.Changed -= OnBenchStateChanged;
        ActiveBenchQa.Changed -= OnBenchStateChanged;
        _benchInteractiveTcs?.TrySetCanceled();
        _activeInteractiveSection = null;
        base.Dispose();
    }

    private Task StartBenchQa()
    {
        _savedCertPath = null;
        _saveError = null;
        _publishError = null;
        _publishedCertUrl = null;
        _publishedCertShortHash = null;
        _certGeneratedAt = DateTimeOffset.Now;
        _activeInteractiveSection = null;
        EnsureCertificateSnapshot(force: true);
        _ = ActiveBenchQa.StartBenchQaAsync(
            _includeStress,
            _includeAudioCamera,
            _includeSecurityAudit,
            _includeKeyboard,
            _includeDisplay,
            WaitForInteractiveBenchQaAsync);
        return Task.CompletedTask;
    }

    private void StopBenchQa()
    {
        _benchInteractiveTcs?.TrySetCanceled();
        _activeInteractiveSection = null;
        ActiveBenchQa.Cancel();
        StateHasChanged();
    }

    private async Task WaitForInteractiveBenchQaAsync(string section, CancellationToken ct)
    {
        var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _benchInteractiveTcs = tcs;
        _activeInteractiveSection = section;
        await InvokeAsync(StateHasChanged);

        var startUtc = DateTimeOffset.UtcNow;
        var initialOutcome = section == "keyboard"
            ? ActivePhysicalQa.Current.KeyboardOutcome
            : ActivePhysicalQa.Current.DisplayOutcome;

        void OnQaChanged()
        {
            var snap = ActivePhysicalQa.Current;
            var currentOutcome = section == "keyboard" ? snap.KeyboardOutcome : snap.DisplayOutcome;
            if (currentOutcome != PhysicalCheckOutcome.NotRun && (snap.UpdatedUtc >= startUtc || currentOutcome != initialOutcome))
            {
                tcs.TrySetResult(true);
            }
        }

        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        ActivePhysicalQa.Changed += OnQaChanged;

        try
        {
            await tcs.Task;
        }
        finally
        {
            ActivePhysicalQa.Changed -= OnQaChanged;
            if (ReferenceEquals(_benchInteractiveTcs, tcs))
                _benchInteractiveTcs = null;
            _activeInteractiveSection = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnBenchInteractiveOutcomeChanged(string section, PhysicalCheckOutcome outcome)
    {
        if (outcome != PhysicalCheckOutcome.NotRun)
        {
            _benchInteractiveTcs?.TrySetResult(true);
        }
    }

    private sealed record PublishQaResult(bool Ok, int Status, string? Id, string? Url, string? ShortHash, string? Error);

    private async Task PublishToAdminAsync()
    {
        _publishError = null;
        _publishedCertUrl = null;
        _publishedCertShortHash = null;
        _publishingCert = true;

        try
        {
            _certGeneratedAt = DateTimeOffset.Now;
            var snapshot = EnsureCertificateSnapshot(force: true);
            var snapshotJson = HardwareQaCertificate.ToSnapshotJson(snapshot);
            var res = await JS.InvokeAsync<PublishQaResult>("rpdSession.publishQaCertificate", snapshotJson);

            if (res.Ok && !string.IsNullOrWhiteSpace(res.Url))
            {
                _publishedCertUrl = res.Url;
                _publishedCertShortHash = res.ShortHash;
            }
            else if (res.Status == 401)
            {
                _publishError = "Sign in to your Admin portal in this browser to publish QA certificates.";
            }
            else if (res.Status == 402)
            {
                _publishError = "Shop subscription or trial is inactive. Activate billing on your Admin portal to publish hosted QR links.";
            }
            else
            {
                _publishError = $"Could not publish QA certificate: {res.Error ?? $"HTTP {res.Status}"}";
            }
        }
        catch (Exception ex)
        {
            _publishError = $"Could not publish QA certificate: {ex.Message}";
        }
        finally
        {
            _publishingCert = false;
        }
    }

    private async Task SaveCertificate()
    {
        _savedCertPath = null;
        _saveError = null;
        if (App.Workflow is null) return;
        _certGeneratedAt = DateTimeOffset.Now;
        var path = App.Workflow.SaveHardwareQaCertificate(out var certSnap, out var html, _sessionBranding, ActivePhysicalQa.Current);
        if (path is not null)
        {
            _savedCertPath = path;
            EnsureCertificateSnapshot(force: true);
        }
        else _saveError = "Could not write the HTML certificate to disk on this PC.";

        try
        {
            var isRemote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay");
            if (isRemote && !string.IsNullOrWhiteSpace(html))
            {
                var filename = !string.IsNullOrWhiteSpace(path)
                    ? Path.GetFileName(path)
                    : $"qa-certificate-{certSnap.CertificateId}.html";
                await JS.InvokeVoidAsync("rpdSession.saveAsFile", filename, html, "text/html;charset=utf-8");
            }
        }
        catch
        {
            // Non-fatal if browser download / JS interop fails
        }
    }
}
