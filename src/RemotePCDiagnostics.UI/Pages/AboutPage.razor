@page "/about"
@implements IDisposable
@inject ISessionContext Session
@inject AppServices App
@inject AgentModeMonitor AgentLink
@using RemotePCDiagnostics.Agent.Core
@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.Plugins

<div data-rpcd-page="about" data-rpcd-contract="@BrowserContract.About">
<AgentData TestId="about-report-data" Json="@ReportJson" />
<div class="toolbar"><span class="icon-badge page-icon"><Icon Name="pc" Size="20" /></span><h1 data-testid="about-title">About Remote PC Diagnostics</h1></div>
<div class="about-accent-line" aria-hidden="true"></div>
<section class="card about-card">
    <h2>Version @AppBuildInfo.Release</h2>
    <p>Use the full build version below when reporting a problem or comparing logs.</p>
    <dl>
        <dt>Build version</dt><dd data-testid="about-version" data-rpcd-version="@AppBuildInfo.Version" style="overflow-wrap:anywhere">@AppBuildInfo.Version</dd>
        <dt>Git commit</dt><dd style="overflow-wrap:anywhere">@AppBuildInfo.Commit</dd>
        <dt>Session</dt><dd>@Session.Mode</dd>
        <dt>Computer</dt><dd>@Session.MachineName</dd>
        <dt>Runtime</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</dd>
        <dt>Operating system</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</dd>
        <dt>Process architecture</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</dd>
    </dl>
</section>
@{
    var plugins = GetPlugins();
    var builtInDlls = GetBuiltInDlls();
}
@if (plugins.Count > 0)
{
    <details class="card about-card bench-customize" data-testid="about-plugins" open="@_pluginsOpen">
        <summary class="bench-customize-summary" data-testid="about-plugins-toggle" aria-expanded="@(_pluginsOpen ? "true" : "false")"
                 @onclick="() => _pluginsOpen = !_pluginsOpen" @onclick:preventDefault="true">
            <span class="bench-customize-title">
                <span>Module plugins</span>
                <span class="meta">(@plugins.Count @(plugins.Count == 1 ? "module" : "modules"))</span>
            </span>
            <span class="chevron-icon @(_pluginsOpen ? "is-open" : "")" aria-hidden="true">▾</span>
        </summary>
        <div class="bench-customize-body">
            <p>Modules installed in the modules folder. Signed modules run inside the app; unsigned ones never do.</p>
            <table class="about-plugins">
                <thead><tr><th>Module</th><th>Version</th><th>Signature</th><th>State</th></tr></thead>
                <tbody>
                @foreach (var p in plugins)
                {
                    <tr data-testid="about-plugin">
                        <td><strong>@(p.DisplayName ?? p.PluginId)</strong><div class="meta">@p.PluginId@(p.ModuleId is { } id ? $" · {id}" : "")</div></td>
                        <td>@(p.Version ?? "—")</td>
                        <td>@(p.Signature ?? "—")</td>
                        <td>@(p.UserMode ? "User mode" : p.State.ToString())@if (p.Reason is { Length: > 0 } && !p.UserMode) {<div class="meta">@p.Reason</div>}</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
}

@if (builtInDlls.Count > 0)
{
    <details class="card about-card bench-customize" data-testid="about-builtin-modules" open="@_builtInOpen">
        <summary class="bench-customize-summary" data-testid="about-builtin-modules-toggle" aria-expanded="@(_builtInOpen ? "true" : "false")"
                 @onclick="() => _builtInOpen = !_builtInOpen" @onclick:preventDefault="true">
            <span class="bench-customize-title">
                <span>Built-in modules</span>
                <span class="meta">(@builtInDlls.Count(p => p.State == PluginState.Loaded) of @builtInDlls.Count loaded)</span>
            </span>
            <span class="chevron-icon @(_builtInOpen ? "is-open" : "")" aria-hidden="true">▾</span>
        </summary>
        <div class="bench-customize-body">
            <p>Modules that ship with the app as their own DLLs (builtin-modules folder next to the app).</p>
            <table class="about-plugins">
                <thead><tr><th>Module</th><th>File</th><th>State</th></tr></thead>
                <tbody>
                @foreach (var p in builtInDlls)
                {
                    <tr data-testid="about-builtin-module">
                        <td><strong>@(p.DisplayName ?? p.PluginId)</strong>@if (p.ModuleId is { } id) {<div class="meta">@id</div>}</td>
                        <td class="meta" style="overflow-wrap:anywhere">@System.IO.Path.GetFileName(p.Path)</td>
                        <td>@p.State@if (p.Reason is { Length: > 0 }) {<div class="meta">@p.Reason</div>}</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
}

@if (Session.Mode == SessionMode.Local)
{
    <section class="card about-card" data-testid="about-unsigned">
        <h2>Unsigned modules</h2>
        <label><input type="checkbox" data-testid="about-unsigned-toggle" checked="@_unsigned" @onchange="ToggleUnsigned" />
            Run unsigned modules in user mode</label>
        <p class="meta">Unsigned modules run in a separate process without administrator rights and can't change this PC. Takes effect the next
            time the app starts. Only someone at this PC can change this.</p>
        @if (_unsignedError is not null) { <div class="notice notice-error">@_unsignedError</div> }
    </section>
}
</div>

@code {
    private bool _unsigned = UnsignedModulesSetting.IsOn();
    private string? _unsignedError;
    private bool _pluginsOpen;
    private bool _builtInOpen;

    private void ToggleUnsigned(ChangeEventArgs e)
    {
        if (Session.Mode != SessionMode.Local) return;
        var on = e.Value is true;
        try { UnsignedModulesSetting.Set(on); _unsigned = on; _unsignedError = null; }
        catch (Exception ex) { _unsignedError = $"Couldn't change the setting: {ex.Message}"; }
    }

    private IReadOnlyList<PluginRecord> GetBuiltInDlls() =>
        App.Plugins?.Records.Where(r => r.Source == RemotePCDiagnostics.Core.ModuleSource.BuiltIn && r.Path is not null).ToList() ?? [];

    private IReadOnlyList<PluginRecord> GetPlugins() =>
        App.Plugins?.Records.Where(r => r.Source == RemotePCDiagnostics.Core.ModuleSource.Plugin).ToList() ?? [];

    private AboutMachineFacts? _machine;
    private DateTimeOffset _machineAt;
    private AgentEnrollmentFacts? _enrollment;
    private int _enrollmentAsking;

    private string ReportJson => AboutReport.ToJson(BuildInput());

    protected override void OnInitialized()
    {
        AgentLink.Changed += OnChanged;
        if (App.AppUpdate is { } updates)
            updates.Changed += OnChanged;
        _ = AskEnrollmentAsync();
    }

    /// <summary>agent.json is admin and SYSTEM only, so the machine id and shop group come from the Agent over the admin pipe.</summary>
    private async Task AskEnrollmentAsync()
    {
        if (_enrollment is not null || App.Elevation is not IElevatedCommandBridge bridge)
            return;
        if (Interlocked.Exchange(ref _enrollmentAsking, 1) != 0)
            return;
        try
        {
            var facts = await bridge.ReadAgentEnrollmentAsync();
            if (facts is not null)
            {
                _enrollment = facts;
                _machine = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
        finally
        {
            Volatile.Write(ref _enrollmentAsking, 0);
        }
    }

    public void Dispose()
    {
        AgentLink.Changed -= OnChanged;
        if (App.AppUpdate is { } updates)
            updates.Changed -= OnChanged;
    }

    private void OnChanged()
    {
        _machine = null;
        _ = AskEnrollmentAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private AboutReportInput BuildInput()
    {
        var machine = Machine();
        var prefs = App.Preferences?.Current;
        var snap = AgentLink.Current;
        var connected = snap.Kind == AgentModeKind.Connected;
        var check = App.AppUpdate?.LastCheck;
        return new AboutReportInput
        {
            AppVersion = AppBuildInfo.Release,
            InformationalVersion = AppBuildInfo.Version,
            ProcessArchitecture = System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture.ToString(),
            OsArchitecture = System.Runtime.InteropServices.RuntimeInformation.OSArchitecture.ToString(),
            OsVersion = System.Runtime.InteropServices.RuntimeInformation.OSDescription,
            MachineName = Session.MachineName,
            SessionMode = Session.Mode,
            AgentConnected = connected,
            AgentVersion = machine.AgentVersion,
            AgentServiceStatus = machine.AgentServiceStatus,
            ShopGroup = AboutReport.FirstShopGroup(Session.Group, prefs?.ShopGroupSlug, connected ? snap.ShopGroup : null, machine.ShopGroup),
            ShopName = prefs?.Branding?.ShopName,
            AgentId = machine.AgentId,
            InstallPath = AppContext.BaseDirectory,
            UserName = Environment.UserName,
            UserProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
            LastUpdateCheck = check?.AtUtc,
            UpdateAvailable = check?.UpdateAvailable == true,
            LatestVersion = check?.LatestVersion,
            UpdateError = check?.Error,
        };
    }

    private AboutMachineFacts Machine()
    {
        var now = DateTimeOffset.UtcNow;
        if (_machine is not null && now >= _machineAt && now - _machineAt < TimeSpan.FromSeconds(5))
            return _machine;
        try
        {
            _machine = AboutMachineFacts.Read().WithEnrollment(_enrollment);
            _machineAt = now;
            return _machine;
        }
        catch
        {
            return _machine ?? AboutMachineFacts.Empty;
        }
    }
}
