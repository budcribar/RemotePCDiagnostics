@page "/about"
@inject ISessionContext Session
@inject AppServices App
@using RemotePCDiagnostics.Core.Plugins

<div class="toolbar"><span class="icon-badge page-icon"><Icon Name="pc" Size="20" /></span><h1 data-testid="about-title">About Remote PC Diagnostics</h1></div>
<div class="about-accent-line" aria-hidden="true"></div>
<section class="card about-card">
    <h2>Version @AppBuildInfo.Release</h2>
    <p>Use the full build version below when reporting a problem or comparing logs.</p>
    <dl>
        <dt>Build version</dt><dd data-testid="about-version" style="overflow-wrap:anywhere">@AppBuildInfo.Version</dd>
        <dt>Git commit</dt><dd style="overflow-wrap:anywhere">@AppBuildInfo.Commit</dd>
        <dt>Session</dt><dd>@Session.Mode</dd>
        <dt>Computer</dt><dd>@Session.MachineName</dd>
        <dt>Runtime</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</dd>
        <dt>Operating system</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</dd>
        <dt>Process architecture</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</dd>
    </dl>
    <p class="meta">CI builds include a build number, attempt and Git revision. Local builds are marked local and may include uncommitted changes. Older logs retain the version information originally recorded.</p>
</section>
@if (Plugins.Count > 0)
{
    <section class="card about-card" data-testid="about-plugins">
        <h2>Module plugins</h2>
        <p>Modules installed in the modules folder. Signed modules run inside the app; unsigned ones never do.</p>
        <table class="about-plugins">
            <thead><tr><th>Module</th><th>Version</th><th>Signature</th><th>State</th></tr></thead>
            <tbody>
            @foreach (var p in Plugins)
            {
                <tr data-testid="about-plugin">
                    <td><strong>@(p.DisplayName ?? p.PluginId)</strong><div class="meta">@p.PluginId@(p.ModuleId is { } id ? $" · {id}" : "")</div></td>
                    <td>@(p.Version ?? "—")</td>
                    <td>@(p.Signature ?? "—")</td>
                    <td>@(p.UserMode ? "User mode" : p.State.ToString())@if (p.Reason is { Length: > 0 } && !p.UserMode) {<div class="meta">@p.Reason</div>}</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}

@if (Session.Mode == SessionMode.Local)
{
    <section class="card about-card" data-testid="about-unsigned">
        <h2>Unsigned modules</h2>
        <label><input type="checkbox" data-testid="about-unsigned-toggle" checked="@_unsigned" @onchange="ToggleUnsigned" />
            Run unsigned modules in user mode</label>
        <p class="meta">Unsigned modules run in a separate process without administrator rights and can't change this PC. Takes effect the next
            time the app starts. Only someone at this PC can change this.</p>
        @if (_unsignedError is not null) { <div class="notice notice-error">@_unsignedError</div> }
    </section>
}

@code {
    private bool _unsigned = UnsignedModulesSetting.IsOn();
    private string? _unsignedError;

    private void ToggleUnsigned(ChangeEventArgs e)
    {
        if (Session.Mode != SessionMode.Local) return;
        var on = e.Value is true;
        try { UnsignedModulesSetting.Set(on); _unsigned = on; _unsignedError = null; }
        catch (Exception ex) { _unsignedError = $"Couldn't change the setting: {ex.Message}"; }
    }

    private IReadOnlyList<PluginRecord> Plugins =>
        App.Plugins?.Records.Where(r => r.Source == RemotePCDiagnostics.Core.ModuleSource.Plugin).ToList() ?? [];
}
