@page "/about"
@inject ISessionContext Session
@inject AppServices App
@using RemotePCDiagnostics.Core.Plugins

<div class="toolbar"><span class="icon-badge page-icon"><Icon Name="pc" Size="20" /></span><h1 data-testid="about-title">About Remote PC Diagnostics</h1></div>
<div class="about-accent-line" aria-hidden="true"></div>
<section class="card about-card">
    <h2>Version @AppBuildInfo.Release</h2>
    <p>Use the full build version below when reporting a problem or comparing logs.</p>
    <dl>
        <dt>Build version</dt><dd data-testid="about-version" style="overflow-wrap:anywhere">@AppBuildInfo.Version</dd>
        <dt>Git commit</dt><dd style="overflow-wrap:anywhere">@AppBuildInfo.Commit</dd>
        <dt>Session</dt><dd>@Session.Mode</dd>
        <dt>Computer</dt><dd>@Session.MachineName</dd>
        <dt>Runtime</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</dd>
        <dt>Operating system</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</dd>
        <dt>Process architecture</dt><dd>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</dd>
    </dl>
    <p class="meta">CI builds include a build number, attempt and Git revision. Local builds are marked local and may include uncommitted changes. Older logs retain the version information originally recorded.</p>
</section>
@if (Plugins.Count > 0)
{
    <section class="card about-card" data-testid="about-plugins">
        <h2>Module plugins</h2>
        <p>Modules installed in the modules folder. Signed modules run inside the app; unsigned ones never do.</p>
        <table class="about-plugins">
            <thead><tr><th>Module</th><th>Version</th><th>Signature</th><th>State</th></tr></thead>
            <tbody>
            @foreach (var p in Plugins)
            {
                <tr data-testid="about-plugin">
                    <td><strong>@(p.DisplayName ?? p.PluginId)</strong><div class="meta">@p.PluginId@(p.ModuleId is { } id ? $" · {id}" : "")</div></td>
                    <td>@(p.Version ?? "—")</td>
                    <td>@(p.Signature ?? "—")</td>
                    <td>@(p.UserMode ? "User mode" : p.State.ToString())@if (p.Reason is { Length: > 0 } && !p.UserMode) {<div class="meta">@p.Reason</div>}</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}

@if (BuiltInDlls.Count > 0)
{
    <section class="card about-card" data-testid="about-builtin-modules">
        <h2>Built-in modules</h2>
        <p>Modules that ship with the app as their own DLLs (builtin-modules folder next to the app). @BuiltInDlls.Count(p => p.State == PluginState.Loaded) of @BuiltInDlls.Count loaded.</p>
        <table class="about-plugins">
            <thead><tr><th>Module</th><th>File</th><th>State</th><th>Runs</th></tr></thead>
            <tbody>
            @foreach (var p in BuiltInDlls)
            {
                <tr data-testid="about-builtin-module">
                    <td><strong>@(p.DisplayName ?? p.PluginId)</strong>@if (p.ModuleId is { } id) {<div class="meta">@id</div>}</td>
                    <td class="meta" style="overflow-wrap:anywhere">@System.IO.Path.GetFileName(p.Path)</td>
                    <td>@p.State@if (p.Reason is { Length: > 0 }) {<div class="meta">@p.Reason</div>}</td>
                    <td data-testid="about-module-process">
                        @(p.Hosting?.Describe() ?? "In process")
                        @if (p.Hosting?.InProcessOnly is { } stays) {<div class="meta">Stays in process: @stays</div>}
                        @if (CanSwitch && p.Hosting is { CanRunOutOfProcess: true } && Slug(p) is { } slug)
                        {
                            <div><select data-testid="about-module-process-mode" aria-label="Where @(p.DisplayName ?? slug) runs"
                                         value="@_modes.Modules.GetValueOrDefault(slug)" @onchange="e => SetMode(slug, e)">
                                <option value="@ModuleProcessMode.Default">Default</option>
                                <option value="@ModuleProcessMode.InProcess">In process</option>
                                <option value="@ModuleProcessMode.OutOfProcess">Out of process</option>
                            </select></div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (CanSwitch)
        {
            <p data-testid="about-process-mode">
                <label>All modules that ship with the app:
                    <select data-testid="about-process-mode-all" value="@_modes.All" @onchange="e => SetMode(null, e)">
                        <option value="@ModuleProcessMode.Default">As each module says</option>
                        <option value="@ModuleProcessMode.InProcess">In process</option>
                        <option value="@ModuleProcessMode.OutOfProcess">Out of process</option>
                    </select>
                </label>
            </p>
            <p class="meta">Out of process, a module runs in its own process (RemotePCDiagnostics.ModuleHost): in user mode, or with the app's
                administrator rights when it needs them. Its page looks the same either way. Takes effect the next time the app starts. Only
                someone at this PC can change this.@if (_modesSaved) {<strong> Saved: restart the app to apply.</strong>}</p>
            @if (_modesError is not null) { <div class="notice notice-error">@_modesError</div> }
        }
    </section>
}

@if (Session.Mode == SessionMode.Local)
{
    <section class="card about-card" data-testid="about-unsigned">
        <h2>Unsigned modules</h2>
        <label><input type="checkbox" data-testid="about-unsigned-toggle" checked="@_unsigned" @onchange="ToggleUnsigned" />
            Run unsigned modules in user mode</label>
        <p class="meta">Unsigned modules run in a separate process without administrator rights and can't change this PC. Takes effect the next
            time the app starts. Only someone at this PC can change this.</p>
        @if (_unsignedError is not null) { <div class="notice notice-error">@_unsignedError</div> }
    </section>
}

@code {
    private bool _unsigned = UnsignedModulesSetting.IsOn();
    private string? _unsignedError;

    private void ToggleUnsigned(ChangeEventArgs e)
    {
        if (Session.Mode != SessionMode.Local) return;
        var on = e.Value is true;
        try { UnsignedModulesSetting.Set(on); _unsigned = on; _unsignedError = null; }
        catch (Exception ex) { _unsignedError = $"Couldn't change the setting: {ex.Message}"; }
    }

    private ModuleProcessModeSetting _modes = ModuleProcessModeSetting.Read();
    private string? _modesError;
    private bool _modesSaved;

    /// <summary>The process-mode switch, like unsigned modules, is for the person at this PC.</summary>
    private bool CanSwitch => Session.Mode == SessionMode.Local;

    private static string? Slug(PluginRecord p) =>
        p.ModuleId is { } id ? RemotePCDiagnostics.Core.BuiltInModules.Descriptors.FirstOrDefault(d => d.Id == id)?.Slug : null;

    /// <summary>Sets one module's mode (or every module's, for a null slug) and saves it for the next start.</summary>
    private void SetMode(string? slug, ChangeEventArgs e)
    {
        if (!CanSwitch || !Enum.TryParse<ModuleProcessMode>(e.Value?.ToString(), out var mode)) return;
        var next = slug is null ? _modes with { All = mode } : _modes.With(slug, mode);
        try { next.Save(); _modes = next; _modesError = null; _modesSaved = true; }
        catch (Exception ex) { _modesError = $"Couldn't change the setting: {ex.Message}"; }
    }

    private IReadOnlyList<PluginRecord> BuiltInDlls =>
        App.Plugins?.Records.Where(r => r.Source == RemotePCDiagnostics.Core.ModuleSource.BuiltIn && r.Path is not null).ToList() ?? [];

    private IReadOnlyList<PluginRecord> Plugins =>
        App.Plugins?.Records.Where(r => r.Source == RemotePCDiagnostics.Core.ModuleSource.Plugin).ToList() ?? [];
}
