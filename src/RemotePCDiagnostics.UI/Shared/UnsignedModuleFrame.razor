@using RemotePCDiagnostics.Core.Plugins
@using RemotePCDiagnostics.ModuleUi
@implements IDisposable
@inject AppServices App
@inject ResultStore Store
@* An unsigned module's own UI. It runs in its own user-mode process and is framed with an opaque origin (ModuleUiFrame, generated from
   the IModuleUi contract): it can't read this page, its storage or cookies, or another module's frame. The only thing it can tell this
   page is its height. The module's latest result goes to its process whenever it changes, over the process's stdin. *@
<ModuleUiFrame Open="OpenAsync" LastResult="_last" Title="@Module.Source.Manifest.DisplayName" class="module-ui-frame" data-testid="module-ui-frame">
    <ProblemContent Context="problem">
        <div class="notice notice-error" data-testid="module-ui-problem">This module's own UI couldn't start: @problem</div>
    </ProblemContent>
</ModuleUiFrame>

@code {
    [Parameter, EditorRequired] public IUserModeModule Module { get; set; } = default!;

    private ModuleUiResult? _last;

    /// <summary>Shown only where the host can do it (Local mode); otherwise the module page shows the generic report alone.</summary>
    public static bool IsAvailable(AppServices app, IUserModeModule module) =>
        module.Source.Manifest.HasUi && app.ModuleUiFrames is not null;

    protected override void OnInitialized()
    {
        _last = ModuleUiResult.From(Store.Get(Module.Name));
        Store.Changed += OnResult;
    }

    private Task<PeakSWC.RemoteBlazorWebView.RemoteComponents.RemoteComponentSession> OpenAsync(CancellationToken cancellationToken) =>
        (App.ModuleUiFrames ?? throw new InvalidOperationException("this host can't show a module's own UI")).OpenAsync(Module.Source, cancellationToken);

    /// <summary>A run finished (or a result was stored): re-rendering passes it to the frame, which sends it if it changed.</summary>
    private void OnResult(object? sender, DiagnosticResult result)
    {
        if (!string.Equals(result.ModuleName, Module.Name, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(() => { _last = ModuleUiResult.From(result); StateHasChanged(); });
    }

    public void Dispose() => Store.Changed -= OnResult;
}
