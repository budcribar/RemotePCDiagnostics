@using RemotePCDiagnostics.Core.Changes
@using RemotePCDiagnostics.Core.Workflow
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IDisposable
@inject WorkflowService Flow
@inject IServiceProvider Services
@inject IJSRuntime JS
@* The client report after a run: a short summary, every change colour-coded with its label and its own Undo / Reinstall / Apply again
   button, and "Open report" for the full report (the saved file). The full report shows here only on request, so the page stays short.
   Every button runs through WorkflowService and UndoService, whose admin parts run in the Agent: the app itself never runs as administrator. *@
@{
    var s = Flow.State;
    var rows = Rows(s);
    var shown = _filter is null ? rows : rows.Where(r => r.Filter == _filter).ToList();
    var areaGroups = shown.GroupBy(r => r.AreaKey, StringComparer.OrdinalIgnoreCase).ToList();
    var canAct = Flow.CanQueueChangeAfterRun;
}
<section class="card wf-section wf-report-box" data-testid="wf-report-box">
    <div class="card-head">
        <strong>Client report</strong>
        <span class="wf-report-links">
            @if (areaGroups.Count > 0)
            {
                <button type="button" class="linklike" data-testid="wf-changes-expand-all" @onclick="() => ToggleAllTree(areaGroups)">@(AllTreeOpen(areaGroups) ? "Collapse all" : "Expand all")</button>
            }
            <button type="button" class="btn btn-primary btn-small" data-testid="wf-open-report" @onclick="OpenReport"><Icon Name="cert" Size="12" /> Open report</button>
            <button type="button" class="linklike" data-testid="wf-toggle-preview" aria-expanded="@(_preview ? "true" : "false")" @onclick="() => _preview = !_preview">@(_preview ? "Hide preview" : "Show preview")</button>
        </span>
    </div>
    <p class="meta" data-testid="wf-report-path">@(s.ReportPath is { } p ? $"Saved on this PC: {p}" : "The report couldn't be saved as a file. Open report shows it in a browser tab.")</p>
    @* The counts are filters: click one to show only those rows, click it again (or Show all) for every row. *@
    <div class="wf-report-counts" data-testid="wf-report-counts" role="group" aria-label="Show only">
        @foreach (var (filter, css, label) in Filters)
        {
            var f = filter;
            var n = rows.Count(r => r.Filter == f);
            if (n == 0) continue;
            <button type="button" class="tag tag-@css wf-filter @(_filter == f ? "is-active" : _filter is null ? "" : "is-dimmed")" data-testid="wf-filter" data-tag="@f"
                    aria-pressed="@(_filter == f ? "true" : "false")" @onclick="() => _filter = _filter == f ? null : f">@n · @label</button>
        }
        @if (_filter is not null) { <button type="button" class="linklike" data-testid="wf-filter-clear" @onclick="() => _filter = null">Show all</button> }
    </div>
    @if (_message is { } m) { <p class="notice" role="status" data-testid="wf-change-message">@m</p> }
    @if (rows.Count == 0)
    {
        <p class="meta">Nothing lasting was changed, so there's nothing to undo.</p>
    }
    else
    {
        <div class="wf-tree" data-testid="wf-changes">
            @foreach (var areaGroup in areaGroups)
            {
                var areaKey = areaGroup.Key;
                var areaName = areaGroup.First().AreaName;
                var areaOpen = IsAreaOpen(areaKey);
                var fixGroups = areaGroup.GroupBy(r => r.FixId, StringComparer.OrdinalIgnoreCase).ToList();
                <details class="wf-tree-group" data-testid="wf-change-group" data-area-key="@areaKey" open="@areaOpen">
                    <summary class="wf-tree-summary" data-testid="wf-change-group-toggle" @onclick:preventDefault @onclick="() => ToggleArea(areaKey)">
                        <span class="wf-caret" aria-hidden="true">@(areaOpen ? "▾" : "▸")</span>
                        <strong class="wf-tree-title">@areaName</strong>
                        <span class="meta wf-tree-count">@CountLabel(areaGroup.Count())</span>
                    </summary>
                    <ul class="wf-changes wf-tree-list">
                        @foreach (var fixGroup in fixGroups)
                        {
                            var fixRows = fixGroup.ToList();
                            if (fixRows.Count == 1)
                            {
                                var row = fixRows[0];
                                @RenderChangeRow(row, showTitle: row.Text != row.Title, canAct)
                            }
                            else
                            {
                                var fixKey = fixGroup.Key;
                                var fixTitle = fixRows[0].Title;
                                var hasReapply = fixRows.Any(r => r.Item is { CanReapply: true });
                                var fixOpen = IsFixOpen(fixKey, fixRows.Count, hasReapply);
                                <li class="wf-tree-fix-item">
                                    <details class="wf-tree-fix" data-testid="wf-change-fix-group" data-fix-id="@fixKey" open="@fixOpen">
                                        <summary class="wf-tree-fix-summary" data-testid="wf-change-fix-toggle" @onclick:preventDefault @onclick="() => ToggleFix(fixKey, fixRows.Count, hasReapply)">
                                            <span class="wf-caret" aria-hidden="true">@(fixOpen ? "▾" : "▸")</span>
                                            <span class="wf-tree-fix-title">@fixTitle</span>
                                            <span class="meta wf-tree-count">@CountLabel(fixRows.Count)</span>
                                        </summary>
                                        <ul class="wf-changes wf-tree-sublist">
                                            @foreach (var r in fixRows)
                                            {
                                                @RenderChangeRow(r, showTitle: false, canAct)
                                            }
                                        </ul>
                                    </details>
                                </li>
                            }
                        }
                    </ul>
                </details>
            }
        </div>
        _firstUndone.Clear();
    }
    @if (_preview)
    {
        <iframe class="wf-report" data-testid="wf-report" sandbox="allow-same-origin" title="Client report" srcdoc="@Html"></iframe>
    }
</section>

@code {
    /// <summary>The report exactly as shown in the file (built by the page for runs saved by an older version).</summary>
    [Parameter, EditorRequired] public string Html { get; set; } = "";
    /// <summary>The last Undo / Reinstall / Apply again result (or null while one runs), for the page's workflow-data.</summary>
    [Parameter] public EventCallback<string?> MessageChanged { get; set; }

    /// <summary>Multi-item fixes with more than this many entries start collapsed so long lists (like Defender exclusions) stay scannable.</summary>
    private const int AutoCollapseFixThreshold = 5;

    private bool _preview;
    private string? _message;
    private readonly HashSet<string> _firstUndone = [];
    private readonly HashSet<string> _collapsedAreas = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> _fixOpenOverrides = new(StringComparer.OrdinalIgnoreCase);

    private string? _filter;

    protected override void OnInitialized() => Flow.Changed += OnFlowChanged;
    private void OnFlowChanged() { try { _ = InvokeAsync(StateHasChanged); } catch { } }
    public void Dispose() => Flow.Changed -= OnFlowChanged;

    private static string QueueStateAttr(PostRunChangeState state) => state switch
    {
        PostRunChangeState.Queued => "queued",
        PostRunChangeState.Running => "running",
        PostRunChangeState.Done => "done",
        _ => "idle",
    };

    private static string QueueButtonCss(PostRunChangeState state) => state switch
    {
        PostRunChangeState.Queued => " wf-act-queued",
        PostRunChangeState.Running => " wf-act-running",
        PostRunChangeState.Done => " wf-act-done",
        _ => "",
    };

    private static string QueueRowCss(PostRunChangeState state) => state switch
    {
        PostRunChangeState.Queued => " wf-change-queued",
        PostRunChangeState.Running => " wf-change-running",
        PostRunChangeState.Done => " wf-change-done",
        _ => "",
    };

    private RenderFragment RenderChangeRow(Row row, bool showTitle, bool canAct) => __builder =>
    {
        var item = row.Item;
        var key = item?.JournalId?.ToString("N") ?? row.FixId;
        var showUndo = item is { CanUndo: true };
        var showReapply = !showUndo && item is { CanReapply: true } && _firstUndone.Add(item.FixId);
        var qState = showUndo ? Flow.GetChangeQueueState(key)
            : showReapply ? Flow.GetChangeQueueState(item!.FixId)
            : PostRunChangeState.Idle;
        var rowClass = $"wf-change wf-edge-{row.Css}{QueueRowCss(qState)}";
        <li class="@rowClass" data-testid="wf-change" data-change-id="@key" data-fix-id="@row.FixId" data-tag="@row.Filter" data-queue-state="@QueueStateAttr(qState)">
            <span class="wf-change-text">
                @if (showTitle) { <span class="meta">@row.Title</span> }
                @row.Text
            </span>
            @* A row with a button shows only the button (its colour edge already says what kind it is); the others show their label. *@
            @if (showUndo)
            {
                var undoItem = item!;
                var btnClass = $"btn-small wf-act-{row.Css}{QueueButtonCss(qState)}";
                var btnLabel = qState switch
                {
                    PostRunChangeState.Running => undoItem.Tag == ReportTag.Reinstallable ? "Reinstalling…" : "Undoing…",
                    PostRunChangeState.Queued => "Queued ×",
                    _ => undoItem.Tag == ReportTag.Reinstallable ? "Reinstall" : "Undo",
                };
                var btnTitle = qState == PostRunChangeState.Queued ? "Queued — click to remove from queue" : null;
                <button type="button" class="@btnClass" data-testid="wf-change-undo" data-change-id="@key" data-fix-id="@undoItem.FixId" data-action="@(undoItem.Tag == ReportTag.Reinstallable ? "reinstall" : "undo")" data-queue-state="@QueueStateAttr(qState)" disabled="@(!canAct || qState == PostRunChangeState.Running)" title="@btnTitle"
                        @onclick="() => ToggleUndoAsync(undoItem, key)">@btnLabel</button>
            }
            else if (showReapply)
            {
                var reapplyItem = item!;
                var btnClass = $"btn-small{QueueButtonCss(qState)}";
                var btnLabel = qState switch
                {
                    PostRunChangeState.Running => reapplyItem.WasReinstall ? "Removing…" : "Applying…",
                    PostRunChangeState.Queued => "Queued ×",
                    _ => reapplyItem.WasReinstall ? "Remove again" : "Apply again",
                };
                var btnTitle = qState == PostRunChangeState.Queued
                    ? "Queued — click to remove from queue"
                    : reapplyItem.UndoneUtc is { } u ? $"{ReportItems.Label(reapplyItem.Tag, reapplyItem.WasReinstall)} at {u.ToLocalTime():t}" : null;
                @* One button per fix: it runs the whole fix again. *@
                <button type="button" class="@btnClass" data-testid="wf-change-reapply" data-change-id="@key" data-fix-id="@reapplyItem.FixId" data-action="reapply" data-queue-state="@QueueStateAttr(qState)" disabled="@(!canAct || qState == PostRunChangeState.Running)" title="@btnTitle"
                        @onclick="() => ToggleReapplyAsync(reapplyItem)">@btnLabel</button>
            }
            else
            {
                <span class="tag tag-@row.Css" data-testid="wf-change-label">@row.Label</span>
            }
        </li>
    };

    private bool IsAreaOpen(string areaKey) => !_collapsedAreas.Contains(areaKey);

    private void ToggleArea(string areaKey)
    {
        if (!_collapsedAreas.Remove(areaKey))
            _collapsedAreas.Add(areaKey);
    }

    private bool IsFixOpen(string fixKey, int count, bool hasReapply = false) =>
        _fixOpenOverrides.TryGetValue(fixKey, out var open) ? open : hasReapply || count <= AutoCollapseFixThreshold;

    private void ToggleFix(string fixKey, int count, bool hasReapply = false) =>
        _fixOpenOverrides[fixKey] = !IsFixOpen(fixKey, count, hasReapply);

    private bool AllTreeOpen(List<IGrouping<string, Row>> areaGroups) =>
        areaGroups.All(ag => IsAreaOpen(ag.Key)
            && ag.GroupBy(r => r.FixId, StringComparer.OrdinalIgnoreCase)
                 .Where(fg => fg.Count() > 1)
                 .All(fg => IsFixOpen(fg.Key, fg.Count(), fg.Any(r => r.Item is { CanReapply: true }))));

    private void ToggleAllTree(List<IGrouping<string, Row>> areaGroups)
    {
        var open = !AllTreeOpen(areaGroups);
        if (open) _collapsedAreas.Clear();
        else foreach (var ag in areaGroups) _collapsedAreas.Add(ag.Key);

        foreach (var fg in areaGroups.SelectMany(ag => ag.GroupBy(r => r.FixId, StringComparer.OrdinalIgnoreCase)).Where(fg => fg.Count() > 1))
            _fixOpenOverrides[fg.Key] = open;
    }

    private static string CountLabel(int n) => n == 1 ? "1 change" : $"{n} changes";

    /// <summary>One row of the list: a change (or a fix that journaled nothing), a skipped fix, or one that couldn't be applied.</summary>
    private sealed record Row(string AreaKey, string AreaName, string Filter, string Css, string Label, string FixId, string Title, string Text, ReportItem? Item);

    /// <summary>The filter pills, in order. Rows with a filter that has no rows get no pill.</summary>
    private static readonly (string Filter, string Css, string Label)[] Filters =
    [
        (nameof(ReportTag.Undoable), "undo", ReportItems.Label(ReportTag.Undoable)),
        (nameof(ReportTag.Reinstallable), "reinstall", ReportItems.Label(ReportTag.Reinstallable)),
        (nameof(ReportTag.Permanent), "perm", ReportItems.Label(ReportTag.Permanent)),
        (nameof(ReportTag.NothingToUndo), "none", ReportItems.Label(ReportTag.NothingToUndo)),
        (nameof(ReportTag.Undone), "none", ReportItems.Label(ReportTag.Undone)),
        ("Skipped", "none", "Skipped"),
        ("Failed", "perm", "Couldn't be applied"),
    ];

    private static List<Row> Rows(WorkflowState s)
    {
        var fixById = new Dictionary<string, WorkflowFix>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in s.Fixes) fixById.TryAdd(f.Id, f);

        var rows = new List<Row>();
        foreach (var o in s.Outcomes)
        {
            var (areaKey, areaName) = fixById.TryGetValue(o.FixId, out var fix) && !string.IsNullOrWhiteSpace(fix.Area)
                ? (fix.GroupKey, fix.Area)
                : ("Other", "Other");
            if (o.Skipped) { rows.Add(new(areaKey, areaName, "Skipped", "none", "Skipped", o.FixId, o.Title, o.Message, null)); continue; }
            var lines = ReportItems.For(s, o);
            if (!o.Success) rows.Add(new(areaKey, areaName, "Failed", "perm", "Couldn't be applied", o.FixId, o.Title, o.Message, null));
            foreach (var i in lines)
                rows.Add(new(areaKey, areaName, i.Tag.ToString(), ReportItems.Css(i.Tag),
                    ReportItems.Label(i.Tag, i.WasReinstall) + (i.UndoneUtc is { } u ? " " + u.ToLocalTime().ToString("t") : ""), i.FixId, i.FixTitle, i.Text, i));
        }
        return rows;
    }

    private async Task ToggleUndoAsync(ReportItem item, string key)
    {
        if (Flow.GetChangeQueueState(key) == PostRunChangeState.Queued)
        {
            Flow.DequeueChange(key);
            return;
        }
        if (item.JournalId is not { } id) return;
        if (Services.GetService<UndoService>() is not { } undo) { await Say("Undo isn't available in this window."); return; }
        if (!Flow.Busy) await Say(null);
        await Say(await Flow.UndoChangeAsync(undo, id));
    }

    private async Task ToggleReapplyAsync(ReportItem item)
    {
        if (Flow.GetChangeQueueState(item.FixId) == PostRunChangeState.Queued)
        {
            Flow.DequeueChange(item.FixId);
            return;
        }
        if (!Flow.Busy) await Say(null);
        await Say(await Flow.ReapplyFixAsync(item.FixId));
    }

    private Task Say(string? message)
    {
        _message = message;
        return MessageChanged.InvokeAsync(message);
    }

    /// <summary>
    /// On this PC: the saved file in the default browser. For a remote technician (Admin), or when there's no file: the same report in a
    /// new browser tab on their side.
    /// </summary>
    private async Task OpenReport()
    {
        _message = null;
        var remote = true;
        try { remote = await JS.InvokeAsync<bool>("rpdSession.isRemoteDisplay"); } catch { }
        var path = Flow.State.ReportPath;
        if (!remote && path is { Length: > 0 } && path.EndsWith(".html", StringComparison.OrdinalIgnoreCase) && File.Exists(path))
        {
            try { using var _ = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true }); return; }
            catch (Exception) { /* no default browser: fall back to a tab */ }
        }
        try
        {
            if (!await JS.InvokeAsync<bool>("rpdSession.openHtml", Html)) _message = "Couldn't open the report. Use Show preview instead.";
        }
        catch (JSException) { _message = "Couldn't open the report. Use Show preview instead."; }
    }
}
