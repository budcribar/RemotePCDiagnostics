@using Microsoft.JSInterop
@using RemotePCDiagnostics.Core.Theming
@inject IJSRuntime JS
@inject AppServices App
@* Dark / System / Light segmented control. Applied by window.rpdTheme (index.html); remembered on this PC (preferences.json), so it's the same
   in the local window and for a remote user, and survives a browser that doesn't keep localStorage. *@
<div class="theme-switch" role="radiogroup" aria-label="Theme" data-testid="theme-switch">
    @foreach (var (choice, icon) in Options)
    {
        var name = choice.ToString();
        <button type="button" role="radio" aria-checked="@(choice == _choice ? "true" : "false")" title="@name theme"
                class="@(choice == _choice ? "on" : null)" data-testid="theme-@ThemePreference.ToStorage(choice)"
                @onclick="() => SetAsync(choice)"><Icon Name="@icon" Size="14" /> @name</button>
    }
</div>
@code {
    static readonly (ThemeChoice, string)[] Options = [(ThemeChoice.Dark, "moon"), (ThemeChoice.System, "system"), (ThemeChoice.Light, "sun")];
    ThemeChoice _choice = ThemePreference.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var prefs = App.Preferences;
        try
        {
            if (prefs?.Current.Theme is { } saved)
            {
                _choice = ThemePreference.Parse(saved);
                await JS.InvokeAsync<string>("rpdTheme.set", ThemePreference.ToStorage(_choice));
            }
            else
            {
                _choice = ThemePreference.Parse(await JS.InvokeAsync<string>("rpdTheme.get"));
                if (_choice != ThemePreference.Default) prefs?.Update(p => p with { Theme = ThemePreference.ToStorage(_choice) }); // keep a choice made before this existed
            }
            StateHasChanged();
        }
        catch (Exception) { /* script missing: keep default */ }
    }

    async Task SetAsync(ThemeChoice c)
    {
        _choice = c;
        (App.Preferences)
            ?.Update(p => p with { Theme = ThemePreference.ToStorage(c) });
        try { await JS.InvokeAsync<string>("rpdTheme.set", ThemePreference.ToStorage(c)); }
        catch (Exception) { /* no JS: selection is visual only */ }
    }
}
