@using RemotePCDiagnostics.Core.Areas
@* Start/Stop/Restart for the Services page: confirmation dialog, progress with Cancel, result message and the Recent actions list. *@
<style>
    .svc-actions { white-space: nowrap; }
    .svc-actions button { margin-right: 4px; font-size: 12px; padding: 2px 8px; }
    .svc-lock { font-size: 12px; color: #555; white-space: nowrap; }
    .svc-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 20; }
    .svc-modal { position: fixed; z-index: 21; top: 15vh; left: 50%; transform: translateX(-50%); width: min(480px, 92vw); background: #fff; border-radius: 8px; padding: 16px; box-shadow: 0 8px 32px rgba(0,0,0,.25); }
    .svc-modal .buttons { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    .svc-warn { background: #fffbeb; border: 1px solid #fde68a; color: #78350f; padding: 8px 10px; border-radius: 6px; }
    .svc-result-ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #14532d; }
    .svc-recent { margin-top: 16px; } .svc-recent li { font-size: 13px; }
</style>
@if (_plan is not null && _target is not null)
{
    <div class="svc-modal-backdrop"></div>
    <div class="svc-modal" role="dialog" aria-modal="true" data-testid="svc-confirm">
        <strong>@_plan.Title</strong>
        <p>@_plan.WhatItIs</p>
        <p>@_plan.WhatWillHappen</p>
        @if (_plan.Warning is { } w) { <p class="svc-warn" data-testid="svc-warning">@w</p> }
        @if (_busy)
        {
            <p class="meta" data-testid="svc-working">Working… this can take up to @((int)Actions!.Timeout.TotalSeconds) seconds.</p>
            <div class="buttons"><button data-testid="svc-cancel" @onclick="CancelRun">Cancel</button></div>
        }
        else
        {
            <div class="buttons">
                <button data-testid="svc-cancel" @onclick="CloseDialog">Cancel</button>
                @if (_plan.Allowed) { <button data-testid="svc-confirm-go" @onclick="Run">@ServiceActionService.Verb(_plan.Action)</button> }
            </div>
        }
    </div>
}
@if (_lastMessage is { } msg)
{
    <div class="notice @(_lastOk ? "svc-result-ok" : "notice-error")" data-testid="svc-result">@msg</div>
}
@if (Actions is not null && Actions.Recent.Count > 0)
{
    <div class="svc-recent" data-testid="svc-recent">
        <strong>Recent actions</strong>
        <ul>
            @foreach (var a in Actions.Recent)
            {
                <li>@a.When.ToString("t") · @a.Actor · @a.Message</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public ServiceActionService? Actions { get; set; }
    /// <summary>Called with the service name and its new raw status so the page can update just that row.</summary>
    [Parameter] public EventCallback<(string Name, string Status)> OnRowChanged { get; set; }

    private ServiceActionPlan? _plan;
    private ServiceInfo? _target;
    private bool _busy;
    private CancellationTokenSource? _cts;
    private string? _lastMessage;
    private bool _lastOk;

    public void Ask(ServiceInfo s, ServiceAction action)
    {
        if (Actions is null || _busy) return;
        _target = s;
        _plan = Actions.Plan(s, action);
        StateHasChanged();
    }

    private void CloseDialog() { _plan = null; _target = null; }
    private void CancelRun() => _cts?.Cancel();

    private async Task Run()
    {
        if (Actions is null || _plan is null || _target is null) return;
        _busy = true;
        _cts = new CancellationTokenSource();
        var s = _target; var action = _plan.Action;
        try
        {
            var r = await Task.Run(() => Actions.ExecuteAsync(s, action, _cts.Token));
            _lastOk = r.Success; _lastMessage = r.Message;
            var status = ServiceActionService.StatusText(r.NewState);
            if (status.Length > 0) await OnRowChanged.InvokeAsync((s.Name, status));
        }
        finally
        {
            _busy = false; _cts.Dispose(); _cts = null; _plan = null; _target = null;
        }
    }
}
