@inherits LayoutComponentBase
@implements IDisposable
@using RemotePCDiagnostics.Agent.Core
@using RemotePCDiagnostics.Core.Session
@using RemotePCDiagnostics.Core.Workflow
@inject ISessionContext Session
@inject NavigationManager Nav
@inject AppServices App
@inject RemoteUsers Remote
@inject AgentModeMonitor AgentLink
<div class="app @(_navigationOpen ? "nav-open" : "")" data-rpcd-version="@AppBuildInfo.Version"
     data-rpcd-control="unknown" data-rpcd-connection="unknown">
    <header class="topbar">
        <button class="nav-toggle" aria-label="Toggle navigation" aria-controls="main-navigation" aria-expanded="@(_navigationOpen ? "true" : "false")" @onclick="() => _navigationOpen = !_navigationOpen">Menu</button>
        <span class="title"><Icon Name="health" Size="22" Class="logo" />RemotePCDiagnostics</span>
        <button type="button"
                class="agent-shop-pill @AgentPillCssClass"
                data-testid="shop-connection-pill"
                title="@AgentPillTooltip"
                aria-label="@AgentPillTooltip"
                @onclick="OpenConnectDialog">
            <Icon Name="net" Size="14" />
            <span class="agent-shop-pill-label" data-testid="agent-mode-badge" title="@AgentPillTooltip">@AgentPillLabel</span>
            @if (Remote.Count > 0)
            {
                <span class="badge shop-users-badge" data-testid="shop-users-count">@Remote.Count</span>
            }
        </button>
        <span class="topbar-spacer"></span>
        @if (App.Elevation is { } elevation && elevation.HasAdminCapabilities)
        {
            <span class="admin-mode-slot" data-testid="admin-mode-badge">
                <span class="badge admin-mode-pill admin-mode-ready"
                      data-testid="admin-mode-ready"
                      title="@(elevation.IsProcessElevated ? "Running with Administrator privileges" : "Elevated helper connected. Low-level hardware sensors and system repairs are unlocked.")"
                      aria-label="@(elevation.IsProcessElevated ? "Running with Administrator privileges" : "Elevated helper connected. Low-level hardware sensors and system repairs are unlocked.")">
                    <Icon Name="cert" Size="14" />
                    <span>Advanced Mode</span>
                </span>
            </span>
        }
        @if (Session.Mode == SessionMode.Remote)
        {
            @* RemoteBlazorWebView draws each browser's own give/take/voice bar over this placeholder. *@
            <div id="rbwv-session-controls" class="topbar-control" data-restart="true"></div>
        }
        <ThemeSwitcher />
        <span class="pc" title="Computer name"><Icon Name="pc" Size="16" />@Session.MachineName</span>
    </header>
    <NavRail />
    <main class="content">
        @if (BuildShopWarningBanner() is { } shopWarning)
        {
            <section class="banner banner-warn shop-warning-banner" role="alert" data-testid="shop-session-warning">
                <span class="banner-icon"><Icon Name="crash" Size="20" /></span>
                <div class="banner-text">
                    <div class="banner-title">@shopWarning.Title</div>
                    <div class="banner-sub">@shopWarning.Detail</div>
                </div>
                <div class="banner-actions">
                    <button type="button" class="btn btn-outline" @onclick="OpenShopInfoDialog">View shop info</button>
                </div>
            </section>
        }
        <AppFaultData />
        <AppActivityData />
        <PageErrorBoundary>@Body</PageErrorBoundary>
    </main>

    @if (_shopInfoDialogOpen)
    {
        <div class="svc-modal-backdrop" @onclick="CloseShopInfoDialog"></div>
        <div class="svc-modal shop-info-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="shop-info-heading"
             tabindex="-1"
             data-testid="shop-info-dialog"
             @onkeydown="OnDialogKeyDown">
            <div class="shop-info-head">
                <div class="shop-info-title-wrap">
                    <Icon Name="cert" Size="20" Class="shop-info-cert-icon" />
                    <h3 id="shop-info-heading">Repair Shop Details</h3>
                </div>
                <button type="button" class="btn-small" data-testid="shop-info-close" aria-label="Close dialog" @onclick="CloseShopInfoDialog">Close</button>
            </div>
            <p class="meta">Verified repair shop branding and contact details for this remote diagnostic session.</p>

            <div class="shop-info-card" data-testid="shop-info-card">
                <div class="shop-info-card-header">
                    @if (EffectiveLogoDataUri is { } logo)
                    {
                        <img src="@logo" alt="Shop logo" class="shop-info-logo" data-testid="shop-info-logo" />
                    }
                    <div class="shop-info-header-meta">
                        <strong class="shop-info-name" data-testid="shop-info-name">@(EffectiveShopName ?? "Remote Repair Shop")</strong>
                        <div class="shop-info-badges">
                            @if (!string.IsNullOrWhiteSpace(EffectiveShopGroup))
                            {
                                <span class="badge badge-remote" data-testid="shop-info-group">@EffectiveShopGroup</span>
                            }
                            <span class="chip chip-ok">Verified Shop</span>
                        </div>
                    </div>
                </div>

                <div class="shop-info-details">
                    <div class="shop-info-row">
                        <span class="shop-info-label">Active Session</span>
                        <span class="shop-info-value" data-testid="shop-info-users">
                            <strong>@RemoteUsers.Label(Remote.Count)</strong>
                        </span>
                    </div>

                    <div class="shop-info-row">
                        <span class="shop-info-label">Shop Code</span>
                        <strong class="shop-info-value" data-testid="shop-info-group-value">@(EffectiveShopGroup ?? "—")</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(EffectivePhone))
                    {
                        <div class="shop-info-row">
                            <span class="shop-info-label">Phone</span>
                            <span class="shop-info-value" data-testid="shop-info-phone">
                                <a href="tel:@EffectivePhone">@EffectivePhone</a>
                            </span>
                        </div>
                    }

                    @if (EffectiveWebsiteHref is { } href)
                    {
                        <div class="shop-info-row">
                            <span class="shop-info-label">Website</span>
                            <span class="shop-info-value" data-testid="shop-info-website">
                                <a href="@href" target="_blank" rel="noopener noreferrer">@(EffectiveWebsite ?? href)</a>
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(EffectiveAddress))
                    {
                        <div class="shop-info-row">
                            <span class="shop-info-label">Address</span>
                            <span class="shop-info-value" data-testid="shop-info-address">@EffectiveAddress</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(EffectiveEmail))
                    {
                        <div class="shop-info-row">
                            <span class="shop-info-label">Email</span>
                            <span class="shop-info-value" data-testid="shop-info-email">
                                <a href="mailto:@EffectiveEmail">@EffectiveEmail</a>
                            </span>
                        </div>
                    }

                    @if (Session.ServerUri is { } serverUri)
                    {
                        <div class="shop-info-row shop-info-relay-row">
                            <span class="shop-info-label">Relay</span>
                            <span class="shop-info-value meta">@ShopRelayClient.BaseUrl(serverUri)</span>
                        </div>
                    }
                </div>
            </div>

            <div class="buttons" style="justify-content: flex-end; margin-top: 14px;">
                <button type="button"
                        class="btn btn-outline"
                        data-testid="shop-info-done"
                        @onclick="CloseShopInfoDialog">
                    Close
                </button>
            </div>
        </div>
    }
</div>

@code {
    private readonly ShopRelayClient _fallbackRelay = new();
    private ShopRelayClient ActiveRelay => App.ShopRelay ?? _fallbackRelay;

    private bool _navigationOpen;
    private bool _shopInfoDialogOpen;

    private ShopBranding? _activeRemoteBranding;
    private bool _remoteGroupInactive;
    private string? _remoteBrandingNetworkError;

    private string? ActiveShopGroup => !string.IsNullOrWhiteSpace(Session.Group)
        ? Session.Group
        : App.Preferences?.Current?.ShopGroupSlug;

    private ShopBranding? ActiveShopBranding => _activeRemoteBranding
        ?? App.Preferences?.Current?.Branding;

    private string? EffectiveShopName =>
        ActiveShopBranding?.ShopName
        ?? ActiveShopGroup;

    private string? EffectiveShopGroup => ActiveShopGroup;

    private string? EffectiveLogoDataUri => ActiveShopBranding?.SafeLogoDataUri;

    private string? EffectivePhone => ActiveShopBranding?.Phone;

    private string? EffectiveWebsite => ActiveShopBranding?.Website;

    private string? EffectiveWebsiteHref => ActiveShopBranding?.SafeWebsiteHref;

    private string? EffectiveAddress => ActiveShopBranding?.Address;

    private string? EffectiveEmail => ActiveShopBranding?.Email;
    
    private bool IsAgentConnected =>
        AgentShopPillState.IsConnected(Session.Mode, AgentLink.Current.Kind);

    private bool IsAgentInstalledNotConnected =>
        AgentShopPillState.IsInstalledNotConnected(Session.Mode, AgentLink.Current.Kind);

    private string AgentPillLabel =>
        AgentShopPillState.FormatLabel(Session.Mode, AgentLink.Current.Kind);

    private string AgentPillCssClass =>
        AgentShopPillState.FormatCssClass(Session.Mode, AgentLink.Current.Kind);

    private string AgentPillTooltip =>
        AgentShopPillState.FormatTooltip(
            Session.Mode,
            AgentLink.Current.Kind,
            ActiveShopBranding?.ShopName,
            Remote.Count);

    private string ShopConnectionTooltip => AgentPillTooltip;

    private void OpenConnectDialog() => OpenShopInfoDialog();

    // After the workflow's restart the app is relaunched (on the start page): go straight back to the Service workflow page.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += CloseNavigation;
        Remote.Changed += RemoteUsersChanged;
        AgentLink.Changed += AgentLinkChanged;
        if (App.RemoteHealth is { } health)
            health.Changed += RemoteHealthChanged;
        if (App.Elevation is { } elevation)
            elevation.Changed += ElevationChanged;

        try
        {
            if (App.Workflow is { ShouldOpenWorkflowPage: true }
                && Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0)
                Nav.NavigateTo("workflow", replace: true);
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.Mode == SessionMode.Remote
            && Session.ServerUri is { } serverUri
            && !string.IsNullOrWhiteSpace(Session.Group))
        {
            await RefreshActiveRemoteShopAsync(serverUri, Session.Group);
        }
    }

    private async Task RefreshActiveRemoteShopAsync(Uri serverUri, string groupSlug)
    {
        var result = await ActiveRelay.FetchBrandingAsync(serverUri, groupSlug);
        switch (result)
        {
            case ShopRelayBrandingResult.Found found:
                _activeRemoteBranding = found.Branding;
                _remoteGroupInactive = false;
                _remoteBrandingNetworkError = null;
                ApplyBrandingFallbackToPreferences(serverUri, found.GroupSlug, found.Branding);
                break;

            case ShopRelayBrandingResult.NotFoundOrInactive:
                _activeRemoteBranding = null;
                _remoteGroupInactive = true;
                _remoteBrandingNetworkError = null;
                break;

            case ShopRelayBrandingResult.NetworkError err:
                _remoteBrandingNetworkError = err.Message;
                break;
        }
    }

    private void ApplyBrandingFallbackToPreferences(Uri serverUri, string groupSlug, ShopBranding branding)
    {
        if (App.Preferences is not { } prefs) return;
        var current = prefs.Current;
        var cleanServer = ShopRelayClient.BaseUrl(serverUri);
        var shouldImportBranding = current.Branding is null || !current.Branding.HasAny;
        if (shouldImportBranding
            || !string.Equals(current.RelayServerUrl, cleanServer, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(current.ShopGroupSlug, groupSlug, StringComparison.Ordinal))
        {
            prefs.Update(p => p with
            {
                RelayServerUrl = string.IsNullOrWhiteSpace(p.RelayServerUrl) ? cleanServer : p.RelayServerUrl,
                ShopGroupSlug = string.IsNullOrWhiteSpace(p.ShopGroupSlug) ? groupSlug : p.ShopGroupSlug,
                Branding = (p.Branding is null || !p.Branding.HasAny) && branding.HasAny ? branding : p.Branding,
            });
        }
    }

    private (string Title, string Detail)? BuildShopWarningBanner()
    {
        if (Session.Mode != SessionMode.Remote || string.IsNullOrWhiteSpace(Session.Group))
            return null;

        var issue = App.RemoteHealth?.Issue ?? RemoteRelayIssueKind.None;
        if (_remoteGroupInactive || issue == RemoteRelayIssueKind.GroupInactive)
        {
            return (
                $"Shop code \"{Session.Group}\" is not found or subscription is inactive",
                "The relay reported that this shop group is not active. Ask your technician to confirm their shop code or renew their relay plan.");
        }

        if (issue == RemoteRelayIssueKind.SessionLimitReached
            || (issue == RemoteRelayIssueKind.CreateFailedOrDenied && _activeRemoteBranding is not null))
        {
            return (
                $"Shop \"{Session.Group}\" has reached its concurrent remote session limit",
                "All active remote technician slots on this shop's plan are currently in use. Ask the shop to close an finished session or upgrade their plan tier.");
        }

        if (issue == RemoteRelayIssueKind.RelayUnreachable || _remoteBrandingNetworkError is not null)
        {
            return (
                $"Could not verify shop \"{Session.Group}\" on the relay",
                _remoteBrandingNetworkError ?? "Check your internet connection and relay server URL.");
        }

        return null;
    }

    private void OpenShopInfoDialog()
    {
        _shopInfoDialogOpen = true;
        if (_activeRemoteBranding is null)
        {
            var serverUri = Session.ServerUri ?? (Uri.TryCreate(App.Preferences?.Current?.RelayServerUrl, UriKind.Absolute, out var u) ? u : null);
            var group = ActiveShopGroup;
            if (serverUri is not null && !string.IsNullOrWhiteSpace(group))
            {
                _ = InvokeAsync(async () =>
                {
                    await RefreshActiveRemoteShopAsync(serverUri, group);
                    StateHasChanged();
                });
            }
        }
    }

    private void CloseShopInfoDialog()
    {
        _shopInfoDialogOpen = false;
    }

    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseShopInfoDialog();
    }

    // Phone layout: picking a page from the menu closes it, so the chosen page isn't pushed below the open menu.
    private void CloseNavigation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_navigationOpen) return;
        _navigationOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void RemoteUsersChanged() => _ = InvokeAsync(StateHasChanged);
    private void AgentLinkChanged() => _ = InvokeAsync(StateHasChanged);
    private void RemoteHealthChanged() => _ = InvokeAsync(StateHasChanged);
    private void ElevationChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= CloseNavigation;
        Remote.Changed -= RemoteUsersChanged;
        AgentLink.Changed -= AgentLinkChanged;
        if (App.RemoteHealth is { } health)
            health.Changed -= RemoteHealthChanged;
        if (App.Elevation is { } elevation)
            elevation.Changed -= ElevationChanged;
    }
}
