@using RemotePCDiagnostics.Core.Areas
@implements IDisposable
@* Confirmation modal, running notice with Cancel, result banner, and recent audit list for one-click remediations.
   A fix runs in RemediationService, not in this component: leaving the page doesn't cut off a repair that takes half an hour,
   and coming back shows it still running. Only one fix runs at a time. *@
@{
    var running = Actions?.Running;
    var mine = running is not null && running.Origin == Origin;
    var last = Actions?.LastRun is { } l && l.Origin == Origin ? l : null;
}
@if (Actions is not null)
{
    <AgentData TestId="fix-data" Json="@AgentExports.FixState(running, Actions.LastRun)" />
}
@if (_plan is not null && running is null)
{
    <div class="svc-modal-backdrop" @onclick="CloseDialog"></div>
    <div class="svc-modal" role="dialog" aria-modal="true" aria-label="@_plan.Title" tabindex="-1"
         @onkeydown='e => { if (e.Key == "Escape") CloseDialog(); }' data-testid="remediation-confirm"
         data-action-kind="@_plan.Action.Kind" data-action-target="@_plan.Action.Target" data-allowed="@(_plan.Allowed ? "true" : "false")"
         data-state="confirm">
        <strong>@_plan.Title</strong>
        @if (_plan.WhatItIs.Length > 0) { <p>@_plan.WhatItIs</p> }
        @if (_plan.WhatWillHappen.Length > 0) { <p>@_plan.WhatWillHappen</p> }
        @if (_plan.Warning is { } w) { <p class="svc-warn" data-testid="remediation-warning">@w</p> }
        <div class="buttons">
            <button data-testid="remediation-cancel" @onclick="CloseDialog">Cancel</button>
            @if (_plan.Allowed) { <button data-testid="remediation-confirm-go" @onclick="Run">@_plan.Action.ButtonText</button> }
        </div>
    </div>
}
@if (!HideBanner)
{
    @if (running is not null && mine)
    {
        <RemediationRunningBanner Run="running" OnCancel="() => Actions?.CancelRunning()" />
    }
    else if (running is not null && _blocked)
    {
        <div class="notice" data-testid="remediation-busy">@running.Title is still running. Wait for it to finish before starting another fix.</div>
    }
    @if (last is not null && !mine)
    {
        <div class="notice @(last.Success ? "svc-result-ok" : "notice-error")" data-testid="remediation-result"
             data-outcome="@(last.Success ? "succeeded" : "failed")" data-action-kind="@last.Action.Kind" data-action-target="@last.Action.Target"
             data-restart-needed="@(last.RestartNeeded ? "true" : "false")"
             data-result-seq="@last.Seq">@last.Message</div>
    }
}
@if (ShowRecent && Actions is not null && Actions.Recent.Count > 0)
{
    <div class="svc-recent" data-testid="remediation-recent">
        <strong>Recent automated fixes</strong>
        <ul>
            @foreach (var a in Actions.Recent)
            {
                <li class="@(a.Success ? "svc-recent-ok" : "svc-recent-fail")" data-outcome="@(a.Success ? "succeeded" : "failed")">
                    <span class="dot @(a.Success ? "dot-ok" : "dot-error")" aria-hidden="true"></span>
                    <span>@a.When.ToString("t") · @a.Actor · @a.Message</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public RemediationService? Actions { get; set; }
    /// <summary>Runs after a fix from this page succeeded while the page is still open (the page runs its check again).</summary>
    [Parameter] public EventCallback OnCompleted { get; set; }
    /// <summary>Notifies the parent when running/result state changes (used when the status banner is rendered inline in a card).</summary>
    [Parameter] public EventCallback OnStateChanged { get; set; }
    [Parameter] public bool ShowRecent { get; set; } = true;
    /// <summary>When true, the parent renders the running/result banner inline inside the triggering card instead of at the top of the page.</summary>
    [Parameter] public bool HideBanner { get; set; }
    /// <summary>The check this page shows. The running notice and the result appear on the page of the check the fix belongs to.</summary>
    [Parameter] public string Origin { get; set; } = "";

    public string? ActiveCardId { get; private set; }
    public bool IsBlocked => _blocked;

    private RemediationPlan? _plan;
    private string? _pendingCardId;
    private bool _blocked;
    private RemediationService? _subscribed;
    // The last result this component has already reacted to, so a result is followed by one re-run of the check.
    private int _seenSeq;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Actions)) return;
        if (_subscribed is not null) _subscribed.RunChanged -= OnRunChanged;
        _subscribed = Actions;
        _seenSeq = Actions?.LastRun?.Seq ?? 0;
        if (Actions is not null) Actions.RunChanged += OnRunChanged;
    }

    public void Ask(AreaAction action, string? cardId = null)
    {
        if (Actions is null) return;
        _blocked = Actions.Running is not null;
        _pendingCardId = cardId;
        if (_blocked)
        {
            ActiveCardId = cardId;
            _plan = null;
        }
        else if (action.Kind == RemediationKind.OpenSettings && Actions.Plan(action).Allowed)
        {
            ActiveCardId = cardId;
            _plan = null;
            _pendingCardId = null;
            _ = Actions.RunTrackedAsync(action, Origin);
        }
        else
        {
            _plan = Actions.Plan(action);
        }
        StateHasChanged();
        if (OnStateChanged.HasDelegate) _ = OnStateChanged.InvokeAsync();
    }

    private void CloseDialog() { _plan = null; _pendingCardId = null; }

    private void Run()
    {
        if (Actions is null || _plan is null) return;
        var act = _plan.Action;
        ActiveCardId = _pendingCardId;
        _plan = null;
        _pendingCardId = null;
        // Not awaited: the fix belongs to the service and ends there; OnRunChanged shows its progress and result.
        _ = Actions.RunTrackedAsync(act, Origin);
        if (OnStateChanged.HasDelegate) _ = OnStateChanged.InvokeAsync();
    }

    private int _renderQueued;
    private void OnRunChanged()
    {
        if (_disposed || Interlocked.Exchange(ref _renderQueued, 1) != 0) return;
        try
        {
            _ = InvokeAsync(async () =>
            {
                Interlocked.Exchange(ref _renderQueued, 0);
                if (_disposed) return;
                if (Actions?.Running is null) _blocked = false;
                StateHasChanged();
                if (OnStateChanged.HasDelegate) await OnStateChanged.InvokeAsync();
                if (Actions?.LastRun is { } done && done.Seq != _seenSeq)
                {
                    _seenSeq = done.Seq;
                    if (done.Success && done.Origin == Origin && !RemediationService.IsReadOnly(done.Action.Kind) && OnCompleted.HasDelegate)
                        await OnCompleted.InvokeAsync();
                }
            });
        }
        catch { Interlocked.Exchange(ref _renderQueued, 0); }
    }

    private bool _disposed;
    public void Dispose()
    {
        _disposed = true;
        if (_subscribed is not null) _subscribed.RunChanged -= OnRunChanged;
    }
}
