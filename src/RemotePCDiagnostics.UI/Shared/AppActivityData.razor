@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.Benchmarks
@implements IDisposable
@inject DiagnosticsService Diagnostics
@inject ChecksScreenState Screen
@inject BenchmarkService Bench
@inject AppServices App
@* What is running now, hidden, on every page (it sits in the layout, outside the page). An agent that takes over the session reads
   it first, so it can ask the person before stopping anything, and on any page, also while it is view-only. *@
<AgentData TestId="activity-data" Json="@AgentExports.Activity(Snapshot())" />

@code {
    private AgentExports.ActivitySnapshot Snapshot()
    {
        var checks = Diagnostics.RunningModules.Select(run => new AgentExports.RunningCheck(run.ModuleName,
            Diagnostics.Modules.FirstOrDefault(m => string.Equals(m.Name, run.ModuleName, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? run.ModuleName,
            run.RunId, Diagnostics.GetProgress(run.ModuleName))).ToList();
        var sequence = Screen.RunningGroup is { } group
            ? new AgentExports.SequenceRun(group, Screen.IsRunAll, Screen.Progress, Screen.RemainingSteps())
            : null;
        var flow = App.Workflow is { } workflow
            ? new AgentExports.WorkflowActivity(workflow.State.Stage, workflow.Busy, workflow.Status)
            : null;
        return new(checks, sequence, Diagnostics.IsStressSuiteRunning ? Diagnostics.LastStressSuiteProgress : null, App.Remediation?.Running, flow,
            Bench.Running, Bench.Settling is not null, Bench.Progress);
    }

    protected override void OnInitialized()
    {
        Diagnostics.ProgressChanged += OnProgress;
        Diagnostics.StressSuiteProgressChanged += OnStress;
        Screen.Changed += OnChanged;
        Bench.Changed += OnChanged;
        if (App.Remediation is { } fixes) fixes.RunChanged += OnChanged;
        if (App.Workflow is { } workflow) workflow.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnProgress(object? sender, (string ModuleName, CheckProgress? Progress) e) => OnChanged();
    private void OnStress(object? sender, StressSuiteProgress e) => OnChanged();

    public void Dispose()
    {
        Diagnostics.ProgressChanged -= OnProgress;
        Diagnostics.StressSuiteProgressChanged -= OnStress;
        Screen.Changed -= OnChanged;
        Bench.Changed -= OnChanged;
        if (App.Remediation is { } fixes) fixes.RunChanged -= OnChanged;
        if (App.Workflow is { } workflow) workflow.Changed -= OnChanged;
    }
}
