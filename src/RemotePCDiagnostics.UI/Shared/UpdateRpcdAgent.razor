@using RemotePCDiagnostics.Agent.Core
@using RemotePCDiagnostics.Core.Areas
@using RemotePCDiagnostics.Core.Benchmarks
@using RemotePCDiagnostics.Core.Session
@implements IDisposable
@inject DiagnosticsService Diagnostics
@inject ChecksScreenState Screen
@inject BenchmarkService Bench
@inject AppServices App
@inject ISessionContext Session
@* Hidden controls for update_rpcd. Nothing here is drawn. A browser agent sets the fields and clicks start, then reads update-rpcd-data. *@
<div hidden data-testid="update-rpcd-panel">
    <input data-testid="update-rpcd-channel" @bind="_channel" @bind:event="oninput" />
    <input data-testid="update-rpcd-version" @bind="_version" @bind:event="oninput" />
    <input data-testid="update-rpcd-approved-by" @bind="_approvedBy" @bind:event="oninput" />
    <input type="checkbox" data-testid="update-rpcd-approved" @bind="_approved" />
    <button type="button" data-testid="update-rpcd-start" @onclick="StartAsync">Start update</button>
    <AgentData TestId="update-rpcd-data" Json="@_json" />
</div>

@code {
    private string _channel = "prerelease";
    private string _version = "";
    private string _approvedBy = "";
    private bool _approved;
    private string? _json;
    private CancellationTokenSource? _poll;
    private readonly object _busyGate = new();
    /// <summary>This page's share of the update lock while something runs. The agent refuses a hub update while any app holds it.</summary>
    private IDisposable? _busy;
    private bool _disposed;
    private readonly CancellationTokenSource _recheck = new();

    /// <summary>A missed "finished" event must not keep the lock: the state is read again this often.</summary>
    private static readonly TimeSpan RecheckInterval = TimeSpan.FromSeconds(10);

    protected override void OnInitialized()
    {
        Diagnostics.ProgressChanged += OnProgress;
        Diagnostics.StressSuiteProgressChanged += OnStress;
        Screen.Changed += OnChanged;
        Bench.Changed += OnChanged;
        if (App.Remediation is { } fixes) fixes.RunChanged += OnChanged;
        if (App.Workflow is { } workflow) workflow.Changed += OnChanged;
        UpdateBusy();
        _ = RefreshAsync();
        _ = RecheckAsync(_recheck.Token);
    }

    private async Task RecheckAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RecheckInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                UpdateBusy();
        }
        catch (OperationCanceledException) { }
    }

    private AgentExports.ActivitySnapshot Snapshot()
    {
        var checks = Diagnostics.RunningModules.Select(run => new AgentExports.RunningCheck(run.ModuleName,
            Diagnostics.Modules.FirstOrDefault(m => string.Equals(m.Name, run.ModuleName, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? run.ModuleName,
            run.RunId, Diagnostics.GetProgress(run.ModuleName), Diagnostics.IsBackgroundAutoRun(run.ModuleName))).ToList();
        var sequence = Screen.RunningGroup is { } group
            ? new AgentExports.SequenceRun(group, Screen.IsRunAll, Screen.Progress, Screen.RemainingSteps())
            : null;
        var flow = App.Workflow is { } workflow
            ? new AgentExports.WorkflowActivity(workflow.State.Stage, workflow.Busy, workflow.Status)
            : null;
        return new(checks, sequence, Diagnostics.IsStressSuiteRunning ? Diagnostics.LastStressSuiteProgress : null, App.Remediation?.Running, flow,
            Bench.Running, Bench.Settling is not null, Bench.Progress);
    }

    private async Task StartAsync()
    {
        if (App.Elevation is not IElevatedCommandBridge bridge)
        {
            Show(new RpcdUpdateStatus
            {
                Stage = RpcdUpdateStages.Failed,
                Terminal = true,
                Error = "The agent is not connected, so Remote PC Diagnostics was not changed.",
                Detail = "The agent is not connected, so Remote PC Diagnostics was not changed.",
                UpdatedUtc = DateTimeOffset.UtcNow,
            });
            return;
        }

        var busy = AgentExports.UpdateBlockReason(Snapshot());
        IReadOnlyList<string>? relaunch = null;
        if (Session.Mode == SessionMode.Remote && Session.ServerUri is { } server && Session.SessionId != Guid.Empty)
            relaunch = SessionLaunchOptions.RestartArguments(server, Session.SessionId, Session.Unattended, Session.Voice, Session.Group, Session.Admin);

        var status = await bridge.StartRpcdUpdateAsync(new RpcdUpdateRequest(
            string.IsNullOrWhiteSpace(_channel) ? "prerelease" : _channel.Trim(),
            string.IsNullOrWhiteSpace(_version) ? null : _version.Trim(),
            _approved,
            string.IsNullOrWhiteSpace(_approvedBy) ? null : _approvedBy.Trim(),
            busy ?? ""), relaunch);
        status ??= new RpcdUpdateStatus
        {
            Stage = RpcdUpdateStages.Failed,
            Terminal = true,
            Error = "The agent is not connected, so Remote PC Diagnostics was not changed.",
            Detail = "The agent is not connected, so Remote PC Diagnostics was not changed.",
            UpdatedUtc = DateTimeOffset.UtcNow,
        };
        Show(status);
        if (status is { Terminal: false })
            _ = PollAsync(bridge, status.RequestId);
    }

    private async Task PollAsync(IElevatedCommandBridge bridge, string requestId)
    {
        if (_poll is not null) await _poll.CancelAsync();
        var cts = new CancellationTokenSource();
        _poll = cts;
        try
        {
            while (!cts.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cts.Token);
                var status = await bridge.GetRpcdUpdateStatusAsync(requestId, cts.Token);
                if (status is null)
                    continue;
                Show(status);
                if (status.Terminal)
                    return;
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync()
    {
        if (App.Elevation is not IElevatedCommandBridge bridge)
            return;
        try
        {
            var status = await bridge.GetRpcdUpdateStatusAsync();
            if (status is not null)
                Show(status);
        }
        catch { }
    }

    /// <summary>
    /// Holds the update lock while a check, fix, workflow stage, stress test or benchmark runs, and lets it go when nothing does.
    /// Windows releases it if the app ends, so a crash cannot leave updates blocked.
    /// </summary>
    private void UpdateBusy()
    {
        var running = AgentExports.UpdateBlockReason(Snapshot()) is not null;
        IDisposable? release = null;
        lock (_busyGate)
        {
            if (running && _busy is null && !_disposed)
                _busy = UpdateBusyHold.App.Enter();
            else if (running && _busy is not null)
                UpdateBusyHold.App.Retry(); // The first try can miss (another holder at that moment); keep trying while busy.
            else if (!running && _busy is not null)
            {
                release = _busy;
                _busy = null;
            }
        }
        release?.Dispose();
    }

    private void Show(RpcdUpdateStatus? status)
    {
        _json = status?.ToJson();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnChanged() => UpdateBusy();

    private void OnProgress(object? sender, (string ModuleName, CheckProgress? Progress) e) => OnChanged();

    private void OnStress(object? sender, StressSuiteProgress e) => OnChanged();

    public void Dispose()
    {
        try { _poll?.Cancel(); } catch { }
        _poll?.Dispose();
        try { _recheck.Cancel(); } catch { }
        _recheck.Dispose();
        lock (_busyGate)
        {
            _disposed = true;
            _busy?.Dispose();
            _busy = null;
        }
        Diagnostics.ProgressChanged -= OnProgress;
        Diagnostics.StressSuiteProgressChanged -= OnStress;
        Screen.Changed -= OnChanged;
        Bench.Changed -= OnChanged;
        if (App.Remediation is { } fixes) fixes.RunChanged -= OnChanged;
        if (App.Workflow is { } workflow) workflow.Changed -= OnChanged;
    }
}
