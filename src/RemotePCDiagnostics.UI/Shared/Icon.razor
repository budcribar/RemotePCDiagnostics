        ["disk"] = "M4 12a8 8 0 1 0 16 0a8 8 0 1 0-16 0M12 12h.01",
        ["mem"] = "M3 8h18v8H3zM7 8v8M11 8v8M15 8v8",
        ["net"] = "M2 9a15 15 0 0 1 20 0M5 13a10 10 0 0 1 14 0M8.5 16.5a5 5 0 0 1 7 0M12 20h.01",
        ["gpu"] = "M3 7h18v10H3zM8 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0M15 10h3M15 14h3",
        ["health"] = "M22 12h-4l-3 8L9 4l-3 8H2",
        ["svc"] = "M12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6zM19 12l2-1-1-3-2 .5-1.5-1.5.5-2-3-1-1 2h-2l-1-2-3 1 .5 2L6 7.5 4 7 3 10l2 1v2l-2 1 1 3 2-.5L7.5 18 7 20l3 1 1-2h2l1 2 3-1-.5-2 1.5-1.5 2 .5 1-3-2-1z",
