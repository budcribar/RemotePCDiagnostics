        ["moon"] = "M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z",
        ["hist"] = "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 7v5l3 3",
        ["system"] = "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 3v18",
    };

    /// <summary>Icon key for a diagnostic module name (falls back to the pulse icon).</summary>
    public static string ForModule(string module) => module switch
    {
        ModuleSlugs.Osquery => "hw", ModuleSlugs.Sensors => "temp", ModuleSlugs.CpuStress => "cpu", ModuleSlugs.DiskSpeed => "disk", ModuleSlugs.MemoryTest => "mem",
        ModuleSlugs.NetworkTest => "net", ModuleSlugs.GpuStress => "gpu", ModuleSlugs.DriveHealth => "health", ModuleSlugs.Services => "svc", ModuleSlugs.Programs => "prog",
        ModuleSlugs.Network => "adp", ModuleSlugs.EventLog => "log", ModuleSlugs.Crashes => "crash", ModuleSlugs.SecurityAudit => "sec", ModuleSlugs.SpeakerToMic => "audio", ModuleSlugs.MicToSpeaker => "audio", ModuleSlugs.Webcam => "camera",
        ModuleSlugs.NpuTest => "chip",
        ModuleSlugs.ResourceHogs => "cpu", ModuleSlugs.DeviceDrivers => "hw", ModuleSlugs.BsodHistory => "crash", ModuleSlugs.BatteryPower => "health", ModuleSlugs.WifiConfig => "net",
        _ => "health",
    };

    static string PathFor(string n) => Paths.TryGetValue(n, out var p) ? p : Paths[ForModule(n)];
}
