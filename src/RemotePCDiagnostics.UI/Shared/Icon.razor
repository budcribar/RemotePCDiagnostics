        ["log"] = "M6 3h9l4 4v14H6zM9 12h7M9 16h7",
        ["crash"] = "M12 3l10 18H2zM12 10v4M12 18h.01",
        ["sec"] = "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z",
        ["chip"] = "M7 7h10v10H7zM10 10h4v4h-4zM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4",
        ["audio"] = "M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6M19.5 6.5a8 8 0 0 1 0 11",
