@typeparam T
@using RemotePCDiagnostics.Core.Osquery
@* Drawer body: one table per item (label/value), or a friendly message. Diagnostics go to the log, not here. *@
@if (Section.Error is not null)
{
    <div class="notice notice-error" data-testid="detail-error">@ErrorText</div>
}
else if (Section.Items.Count == 0)
{
    <p class="meta" data-testid="detail-empty">@EmptyText</p>
}
else
{
    @foreach (var (item, i) in Section.Items.Select((x, i) => (x, i)))
    {
        @if (Section.Items.Count > 1) { <h3>#@(i + 1)</h3> }
        <table class="detail">
            @foreach (var (label, get) in Columns)
            {
                var v = get(item);
                if (string.IsNullOrWhiteSpace(v) || v == "—") continue;
                <tr><th>@label</th><td>@v</td></tr>
            }
        </table>
    }
}
@code {
    [Parameter, EditorRequired] public InventorySection<T> Section { get; set; } = default!;
    [Parameter, EditorRequired] public (string Label, Func<T, string> Get)[] Columns { get; set; } = [];
    [Parameter] public string ErrorText { get; set; } = "Couldn't read these details on this PC.";
    [Parameter] public string EmptyText { get; set; } = "No details are available on this PC.";
}
