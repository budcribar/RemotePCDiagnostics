<Project Sdk="Microsoft.NET.Sdk">
  <!-- On-demand elevated repair helper launched via ShellExecute ("runas") when RemotePCDiagnostics.Host.exe
       runs in Microsoft Store asInvoker mode. Talks to the parent Host over a PipeSecurity-hardened Named Pipe,
       verifies parent PID + executable path, and terminates automatically if the parent Host exits. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\RemotePCDiagnostics.Host\Assets\diagnostics.ico</ApplicationIcon>
    <AssemblyTitle>Remote PC Diagnostics Admin Repair Helper</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same shared framework as Host so DI/Logging assemblies resolve from Microsoft.AspNetCore.App when deployed side-by-side. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
  </ItemGroup>
</Project>
