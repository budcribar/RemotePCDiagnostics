<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemotePCDiagnostics.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="8.0.0" />
    <!-- UserModePlugin builds a plugin's own container inside a user-mode process. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <!-- WindowsAdminSettings: the Agent starts and stops services for the app. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixed PowerShell scripts, loaded by name (PowerShellScripts.Get). -->
    <EmbeddedResource Include="Scripts\*.ps1" LogicalName="Scripts/%(Filename).ps1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in modules use exactly the contract types a plugin uses. -->
    <ProjectReference Include="..\RemotePCDiagnostics.Abstractions\RemotePCDiagnostics.Abstractions.csproj" />
    <!-- Module signatures use the agent's manifest signature scheme. -->
    <ProjectReference Include="..\RemotePCDiagnostics.Agent.Core\RemotePCDiagnostics.Agent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logging: ILogger plus the plain-line helpers (LoggerLines), without importing Microsoft.Extensions.Logging, whose LogLevel
         would clash with RemotePCDiagnostics.Core.Logging.LogLevel. -->
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
  </ItemGroup>
</Project>
