<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <!-- UserModePlugin builds a plugin's own container inside a user-mode process. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in modules use exactly the contract types a plugin uses. -->
    <ProjectReference Include="..\RemotePCDiagnostics.Abstractions\RemotePCDiagnostics.Abstractions.csproj" />
    <!-- Module signatures use the agent's manifest signature scheme. -->
    <ProjectReference Include="..\RemotePCDiagnostics.Agent.Core\RemotePCDiagnostics.Agent.Core.csproj" />
  </ItemGroup>
</Project>
