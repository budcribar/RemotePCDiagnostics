<Project Sdk="Microsoft.NET.Sdk">
  <!-- The contract a diagnostic module compiles against. Plugins reference only this assembly, never Core, the UI or the Host.
       Anything public here is API: add new interfaces or default interface members, never change an existing signature. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Contract version, separate from the app's version (see ContractVersion). -->
    <Version>2.0.0</Version>
    <RootNamespace>RemotePCDiagnostics.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logging: ILogger plus the plain-line helpers (LoggerLines), without importing Microsoft.Extensions.Logging, whose LogLevel
         would clash with RemotePCDiagnostics.Core.Logging.LogLevel. -->
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
  </ItemGroup>
</Project>
