<Project Sdk="Microsoft.NET.Sdk">
  <!-- A minimal module plugin: build it, sign it (tools/Sign-Module.ps1) and copy SampleModule.dll and SampleModule.dll.sig to
       %ProgramFiles%\RemotePCDiagnostics\modules. Unsigned, it is listed on the About page and never loads into the app. -->
  <Import Project="..\..\build\RemotePCDiagnostics.Module.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The contract only. Private=false: the host supplies it at run time. -->
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Abstractions\RemotePCDiagnostics.Abstractions.csproj" Private="false" />
  </ItemGroup>
</Project>
