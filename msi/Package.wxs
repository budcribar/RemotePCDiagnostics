<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Remote PC Diagnostics Agent"
      Manufacturer="Remote PC Diagnostics"
      Version="$(var.AppNumericVersion)"
      UpgradeCode="D4B8E7A2-91F3-4C65-8E12-7F3A9C5D21E4"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation
        Description="Remote PC Diagnostics Windows Service Agent"
        Manufacturer="Remote PC Diagnostics" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DiagnosticsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DiagnosticsIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Optional RMM / msiexec CLI overrides (take precedence over tokenized .pkg.msi filenames). -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="ENROLLMENT_KEY" Secure="yes" Hidden="yes" />
    <Property Id="CONSENT" Secure="yes" />
    <Property Id="LIFETIME" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemotePCDiagnosticsAgent">
        <Component Id="AgentExecutable" Guid="8A4F2C91-5E7B-4D13-9C84-1F2E6B7A90D3">
          <File Id="AgentExe" Source="$(var.AgentExePath)" Name="RemotePCDiagnostics.Agent.exe" KeyPath="yes" />
          <ServiceControl Id="StopExistingAgentService" Name="RemotePCDiagnosticsAgent" Stop="both" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Remote PC Diagnostics Agent" Level="1">
      <ComponentRef Id="AgentExecutable" />
    </Feature>

    <SetProperty
        Id="InstallAgentService"
        Value="&quot;[#AgentExe]&quot; install --from-msi=&quot;[OriginalDatabase]&quot; --server=&quot;[SERVER_URL]&quot; --key=&quot;[ENROLLMENT_KEY]&quot; --consent=&quot;[CONSENT]&quot; --lifetime=&quot;[LIFETIME]&quot;"
        Before="InstallAgentService"
        Sequence="execute" />
    <CustomAction
        Id="InstallAgentService"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <SetProperty
        Id="UninstallAgentService"
        Value="&quot;[#AgentExe]&quot; uninstall"
        Before="UninstallAgentService"
        Sequence="execute" />
    <CustomAction
        Id="UninstallAgentService"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="UninstallAgentService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallAgentService" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
