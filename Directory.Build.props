<Project>
  <!-- One version for every assembly (shown in History details and written to the Event Log). Bump on release. -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <!-- The SDK appends the Git revision to InformationalVersion. CI retries stay distinguishable. -->
    <InformationalVersion Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(Version)-ci.$(GITHUB_RUN_NUMBER).$(GITHUB_RUN_ATTEMPT)</InformationalVersion>
    <InformationalVersion Condition="'$(GITHUB_RUN_NUMBER)' == ''">$(Version)-local</InformationalVersion>
    <!-- RemoteBlazorWebView packages (Wpf, RemoteWebView, RemoteWebViewService.Lib, RemoteComponents), from nuget.org since
         10.0.15. third_party/RemoteBlazorWebView/packages holds the earlier local 10.0.14-embedded.8 build and is no longer used. -->
    <RbwvVersion Condition="'$(RbwvVersion)' == ''">10.0.15.1</RbwvVersion>
    <RbwvLibVersion Condition="'$(RbwvLibVersion)' == ''">$(RbwvVersion)</RbwvLibVersion>
    <!-- Local source wiring: reference the sibling RemoteBlazorWebView repo's projects directly so RBWV source edits are
         picked up on build - no pack/publish step. Active ONLY for the dev solution (RemotePCDiagnostics.Dev.sln), which
         loads those projects so VS can restore them; cross-repo ProjectReferences outside a solution that contains them
         give NU1105 in VS. The normal solution, CI, and plain project builds stay on the NuGet package (RbwvVersion, above).
         Force either way with -p:UseRbwvSource=true/false; point elsewhere with -p:RbwvSourceRoot=<path>. -->
    <RbwvSourceRoot Condition="'$(RbwvSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\RemoteBlazorWebView</RbwvSourceRoot>
    <UseRbwvSource Condition="'$(UseRbwvSource)' == '' and '$(SolutionName)' == 'RemotePCDiagnostics.Dev' and Exists('$(RbwvSourceRoot)\src\RemoteBlazorWebView.Wpf\RemoteBlazorWebView.Wpf.csproj')">true</UseRbwvSource>
    <UseRbwvSource Condition="'$(UseRbwvSource)' == ''">false</UseRbwvSource>
  </PropertyGroup>
</Project>
