<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Database.ManagedEsent" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <Compile Include="../../tools/prototypes/NetworkUsagePrototype/SrumReader.cs" Link="Prototype/SrumReader.cs" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- For the sample module's Razor component (a package, not the ASP.NET Core framework: the module host started from this folder
         must still find the DI assemblies here). -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.Core\RemotePCDiagnostics.Core.csproj" />
    <!-- The modules that ship with the app (src/Modules), referenced so their code can be tested directly. -->
    <ProjectReference Include="..\..\src\Modules\*\*.csproj" />
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.ModuleUi\RemotePCDiagnostics.ModuleUi.csproj" />
    <!-- Real memory test helper for the end-to-end helper process test. -->
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.MemTest\RemotePCDiagnostics.MemTest.csproj" />
    <!-- A real module DLL for the loader tests: built, not referenced, copied to sample-module/ (outside the default load context). -->
    <ProjectReference Include="..\..\samples\SampleModule\SampleModule.csproj" ReferenceOutputAssembly="false" />
    <!-- A module with its own UI, for UserModePlugin (its Razor component needs Components in this process: package reference above). -->
    <ProjectReference Include="..\..\samples\SampleModuleUi\SampleModuleUi.csproj" ReferenceOutputAssembly="false" />
    <!-- The user-mode module host, started for real by the proxy tests (RemotePCDiagnostics.ModuleHost.dll lands in the test output). -->
    <ProjectReference Include="..\..\src\RemotePCDiagnostics.ModuleHost\RemotePCDiagnostics.ModuleHost.csproj" />
  </ItemGroup>

  <Target Name="CopySampleModule" AfterTargets="Build">
    <MSBuild Projects="..\..\samples\SampleModule\SampleModule.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_SampleModuleDll" />
    </MSBuild>
    <Copy SourceFiles="@(_SampleModuleDll)" DestinationFolder="$(OutDir)sample-module" SkipUnchangedFiles="true" />
    <MSBuild Projects="..\..\samples\SampleModuleUi\SampleModuleUi.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_SampleModuleUiDll" />
    </MSBuild>
    <Copy SourceFiles="@(_SampleModuleUiDll)" DestinationFolder="$(OutDir)sample-module-ui" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Logging: ILogger plus the plain-line helpers (LoggerLines), without importing Microsoft.Extensions.Logging, whose LogLevel
         would clash with RemotePCDiagnostics.Core.Logging.LogLevel. -->
    <Using Include="Microsoft.Extensions.Logging.ILogger" Alias="ILogger" />
    <Using Include="RemotePCDiagnostics.Logging" />
  </ItemGroup>
</Project>
