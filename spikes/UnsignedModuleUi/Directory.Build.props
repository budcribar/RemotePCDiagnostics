<Project>
  <!-- The spike is not part of RemotePCDiagnostics.sln: it needs RemoteBlazorWebView packages built from net10 with the embedded relay
       (PeakSWC.RemoteWebViewService.Lib), built on Windows. See README.md. -->
  <PropertyGroup>
    <SpikeRbwvVersion Condition="'$(SpikeRbwvVersion)' == ''">10.0.14-embedded.1</SpikeRbwvVersion>
    <SpikeLibVersion Condition="'$(SpikeLibVersion)' == ''">$(SpikeRbwvVersion)</SpikeLibVersion>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
