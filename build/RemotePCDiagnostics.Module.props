<Project>
  <!--
    Import from a module project (see samples/SampleModule). One project builds one module DLL:
      module.json        embedded as "module.json" (read by the host before any of the module's code runs)
      strings/*.json     embedded as "strings/<culture>.json" (display names in other languages; copied to the catalog)
      private packages   embedded as "lib/<name>.dll" (loaded into the module's own load context)
    The contract assembly, the DI and logging abstractions and Components / JSInterop come from the host, so they are referenced but never embedded.
  -->
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="module.json" LogicalName="module.json" Condition="Exists('module.json')" />
    <EmbeddedResource Include="strings\*.json" LogicalName="strings/%(Filename).json" />
  </ItemGroup>
  <Target Name="EmbedModuleLibraries" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ModuleLib Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'
          and !$([System.String]::Copy('%(Filename)').StartsWith('RemotePCDiagnostics.Abstractions'))
          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.DependencyInjection.Abstractions'))
          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.Logging.Abstractions'))
          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Components'))
          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.JSInterop'))" />
      <EmbeddedResource Include="@(_ModuleLib)" LogicalName="lib/%(Filename).dll" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>
</Project>
