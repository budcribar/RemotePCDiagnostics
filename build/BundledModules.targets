<Project>
  <!--
    Builds the modules that ship with the app (src/Modules/*/*.csproj) and copies each DLL to builtin-modules\ in the output and publish
    folders, where ModuleLoader.LoadBundled finds them. Imported by the Host and by Host.Tests (which builds the app's real container).
    ReferenceOutputAssembly="false": the app never references a module; it only loads its DLL.
  -->
  <ItemGroup>
    <BundledModuleProject Include="$(MSBuildThisFileDirectory)..\src\Modules\*\*.csproj" />
    <ProjectReference Include="@(BundledModuleProject)" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishProfile;PublishDir" />
  </ItemGroup>
  <Target Name="ResolveBundledModules">
    <MSBuild Projects="@(BundledModuleProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishProfile;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledModuleDll" />
    </MSBuild>
  </Target>
  <Target Name="CopyBundledModules" AfterTargets="Build" DependsOnTargets="ResolveBundledModules" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_BundledModuleDll)" DestinationFolder="$(OutDir)builtin-modules" SkipUnchangedFiles="true" />
  </Target>
  <!-- Published as ordinary publish items (not copied afterwards), so the single-file Portable profile bundles them like the app's other files. -->
  <Target Name="PublishBundledModules" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeResolvedFilesToPublishTypes;_ComputeFilesToBundle" DependsOnTargets="ResolveBundledModules">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledModuleDll)" RelativePath="builtin-modules\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
